<Project>

  <!--
    إعدادات مشتركة لكل مشاريع الحل.
    MSBuild بيقرا الملف ده تلقائيًا لكل مشروع تحت المجلد ده — يعني أي إعداد عام
    يتكتب هنا مرة واحدة بدل ما يتكرر (ويتنسى) في كل ملف .csproj على حدة.

    ملاحظة: TargetFramework مش هنا عن قصد — مشروع UI بيستهدف net8.0-windows
    عشان WPF، والباقي net8.0 عادي، فكل مشروع بيحدده لنفسه.
  -->

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      استبعاد ملفات ترجمة المكتبات الخارجية (13 لغة: روسي، ياباني، ألماني، كوري...).
      دي رسائل أخطاء مترجمة جاية مع EF Core و MaterialDesign، والبرنامج عربي
      بالكامل ومش بيستخدم ولا واحدة منها — وكانت بتزوّد ~16 ميجا على كل نسخة نشر.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!--
      embedded = معلومات التصحيح جوه الـ dll نفسه، من غير ملفات .pdb منفصلة.
      كده نسخة التوزيع تطلع من غير ملفات زيادة، وفي نفس الوقت لو حصل كراش
      عند المستخدم الـ stack trace بيفضل فيه أرقام السطور — وده اللي بيخلي
      تشخيص أي مشكلة في المصنع ممكن أصلًا. (DebugType=none كان هيوفر ~100 كيلو
      ويضيّع أرقام السطور — صفقة خسرانة.)
    -->
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- هوية النسخة — مكان واحد لتغيير رقم الإصدار لكل المشاريع مرة واحدة -->
  <PropertyGroup>
    <Company>WorkforceManager</Company>
    <Product>نظام إدارة إنتاجية وأجور العمال</Product>
    <Version>1.6.5</Version>
    <FileVersion>1.6.5.0</FileVersion>

    <!--
      تواريخ الإصدار — بتتعرض في سطر المعلومات آخر شاشة الإعدادات
      (SettingsViewModel.AppCreditText).

      أول إصدار ثابت تاريخيًا ومابيتغيرش. آخر إصدار **بيتحدّث مع رقم
      الإصدار فوقه** — هما الاتنين بيتغيروا في نفس اللحظة (وقت الإصدار)،
      فحطّهم جنب بعض معناه إن حد ينسى يحدّث واحد فيهم أصعب.

      مكتوب هنا مش في الكود لأنه بيتحفر في التجميعة وقت البناء: النشر
      بوضع SingleFile بيخلي Assembly.Location فاضي، فقراءة تاريخ الملف
      نفسه مكانتش هتشتغل على كل أوضاع التوزيع.
    -->
    <FirstReleaseDate>2026-08-25</FirstReleaseDate>
    <LatestReleaseDate>2026-09-13</LatestReleaseDate>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FirstReleaseDate</_Parameter1>
      <_Parameter2>$(FirstReleaseDate)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LatestReleaseDate</_Parameter1>
      <_Parameter2>$(LatestReleaseDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
