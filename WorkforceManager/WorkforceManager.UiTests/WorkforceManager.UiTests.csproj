<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- الإعدادات المشتركة (ImplicitUsings / Nullable / اللغات) في Directory.Build.props -->
    <!--
      net8.0-windows + UseWPF لازمين: الاختبار ده بيحمّل XAML حقيقي، يعني
      محتاج WPF نفسه. عشان كده هو مشروع لوحده مش جوه WorkforceManager.Tests
      (اللي هو net8.0 عشان يفضل بعيد عن الواجهة).
      و RuntimeIdentifier لازم يطابق مشروع الواجهة.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>WorkforceManager.UiTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkforceManager.UI\WorkforceManager.UI.csproj" />
  </ItemGroup>

</Project>
