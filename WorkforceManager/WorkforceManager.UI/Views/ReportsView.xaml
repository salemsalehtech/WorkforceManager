<UserControl x:Class="WorkforceManager.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة التقييم والمتابعة: بتتشاف وبيتصرّف منها، مش بتطلّع ورق.
         التقارير اللي بتتصدّر في شاشة "التقارير".

         **تبويب "تقييم اليوم" اتشال.** كان بيكرر أرقام "إنتاج اليوم"
         بصياغة تانية، وجدوله (كل عامل مقارن بمتوسط زمايله) موجود في
         مُنشئ التقارير وبيتصدّر Excel كمان. -->
    <TabControl>

        <!-- ============ إنتاج اليوم: خلص كام ودخل كام واتهلك كام ============ -->
        <TabItem Header="  إنتاج اليوم  ">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="اليوم:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding OutputDate}" Width="160" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="6" Padding="9,4"
                                Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding OutputIsClosed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LockCheck" Width="13" Height="13"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="اليوم مقفول — الأرقام دي نهائية" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ملخص اليوم في تلات أرقام: خلص، دخل، واتهلك -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,8">
                    <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputCompletedText}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="قطعة خلصت الخط كامل" FontSize="11.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,11" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputStartedText}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource GoldDeepBrush}" />
                            <TextBlock Text="قطعة دخلت الخط النهارده" FontSize="11.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- الهالك جنب الإنتاج مش في شاشة تانية: الرقمين
                         بيتقروا مع بعض أو ميقولوش حاجة -->
                    <Border Style="{StaticResource Card}" Padding="14,11" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputScrapText}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutputHasScrap}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="قطعة هالك" FontSize="11.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding OutputScrapRateText}" FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="مفيش أي حركة إنتاج في اليوم ده" FontSize="13" Margin="4,10,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding OutputIsEmpty, Converter={StaticResource BoolToVis}}" />

                        <!-- كارت لكل منتج: خلص منه كام ودخل منه كام النهارده -->
                        <ItemsControl ItemsSource="{Binding OutputProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="{DynamicResource SuccessBgBrush}"
                                                    CornerRadius="7" Padding="11,5" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CompletedPieces, StringFormat=N0}"
                                                               FontSize="17" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                    <TextBlock Text="مكتمل" FontSize="10" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock FontSize="11.5" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}">
                                                    <Run Text="دخل الخط النهارده:" />
                                                    <Run Text="{Binding StartedPieces, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" />
                                                    <Run Text="قطعة" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ============ رسم إنتاج المنتجات ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="إنتاج المنتجات" Margin="6,0,0,0" />
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="10">
                <!--
                  كارت الرسم بياخد ارتفاعه من محتواه (Auto) والفاضي
                  بيروح للسطر اللي بعده. كان نجمة، فالكارت بيتمدّ لآخر
                  الشاشة والأعمدة ثابتة 200 بكسل في قاعه — نص الكارت
                  كان بياض من غير سبب.
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== التقسيم + المدة + فلتر المنتجات ===== -->
                <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
                    <DockPanel>
                        <!-- شرايح التقسيم: يوم / أسبوع / شهر. شرايح مش
                             قايمة عشان التلاتة يبانوا مع بعض — ده أول
                             سؤال بيتسأل على الشاشة دي -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Chip}" Content="بيوم" GroupName="ChartGrain"
                                         IsChecked="{Binding IsGrainDay, Mode=OneWay}"
                                         Command="{Binding SetGrainCommand}" CommandParameter="day" />
                            <RadioButton Style="{StaticResource Chip}" Content="بأسبوع" GroupName="ChartGrain"
                                         IsChecked="{Binding IsGrainWeek, Mode=OneWay}"
                                         Command="{Binding SetGrainCommand}" CommandParameter="week" />
                            <RadioButton Style="{StaticResource Chip}" Content="بشهر" GroupName="ChartGrain"
                                         IsChecked="{Binding IsGrainMonth, Mode=OneWay}"
                                         Command="{Binding SetGrainCommand}" CommandParameter="month" />
                        </StackPanel>

                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding RangeOptions}"
                                  SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Display"
                                  Width="130" Margin="10,0,0,0" VerticalAlignment="Center" />

                        <!-- فلتر المنتجات — نفس نمط الفلاتر في باقي الشاشات -->
                        <Grid DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="ProductToggle" Style="{StaticResource ToolbarToggle}"
                                          IsChecked="{Binding IsProductMenuOpen, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShapeOutline" Width="15" Height="15"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProductFilterText}" Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                             Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsProductMenuOpen, Mode=TwoWay}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=ProductToggle}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   HorizontalOffset="-6" VerticalOffset="2">
                                <Border Style="{StaticResource ToolbarPopupCard}"
                                        FlowDirection="RightToLeft" Width="260" MaxHeight="360">
                                    <StackPanel>
                                        <TextBlock Text="شيل العلامة عن اللي مش عايز تشوفه" FontSize="11"
                                                   Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ChartProducts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                                                  FontSize="12.5" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Text="{Binding ChartHint}" Style="{StaticResource HintText}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- ===== الخلاصة: الإجمالي والمقارنة والهالك والمتوسط ===== -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasChartTrend, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="17" Height="17"
                                                     VerticalAlignment="Center"
                                                     ui:ThemeBrush.ForegroundKey="{Binding ChartTrendColor}" />
                            <TextBlock Text="{Binding ChartTrendText}" FontSize="13" FontWeight="SemiBold"
                                       Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       ui:ThemeBrush.ForegroundKey="{Binding ChartTrendColor}" />
                        </StackPanel>

                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="الهالك:" FontSize="12" Margin="5,0,4,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ChartScrapText}" FontSize="12.5" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{Binding ChartScrapRateText}" FontSize="11.5" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartLine" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ChartAverageText}" FontSize="12" Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- مفتاح الألوان (منتج = لون) — دايمًا ظاهر: الهوية عمرها
                     ما تكون باللون لوحده -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding ChartLegend}" Margin="4,0,4,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                                <Border Width="13" Height="13" CornerRadius="3" ui:ThemeBrush.BackgroundKey="{Binding Color}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="6,0,4,0" />
                                <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChangeText}" FontSize="11.5" FontWeight="Bold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           ui:ThemeBrush.ForegroundKey="{Binding ChangeColor}"
                                           Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- الرسم البياني -->
                <Border Grid.Row="3" Style="{StaticResource Card}" MinHeight="330">
                    <Grid>
                        <!-- رسالة لما مفيش بيانات -->
                        <TextBlock Text="مفيش إنتاج مكتمل متسجل في الفترة دي — سجّل رحلات إنتاج توصل لآخر مرحلة وهتظهر هنا"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="400">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChartHasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- محور الزمن ثابت شمال ← يمين زي أي رسم بياني (مع بقاء النصوص عربي) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      FlowDirection="LeftToRight" VerticalAlignment="Bottom">
                            <ItemsControl ItemsSource="{Binding ChartBuckets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- عمود مكدّس لفترة واحدة: طول العمود = إنتاج
                                             الفترة كلها، والشرايح = نصيب كل منتج،
                                             والشريحة الحمرا اللي فوق = الهالك. -->
                                        <StackPanel Margin="9,0" MinWidth="46">
                                            <TextBlock Text="{Binding TotalText}" FontSize="11.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- لازم يفضل أكبر شوية من MaxBarHeight
                                                 في الـ ViewModel، وإلا أطول عمود
                                                 بيتقص من فوق -->
                                            <Grid Height="272">
                                                <!-- خط المتوسط: كل عمود بيرسم قطعته منه،
                                                     فمع بعض بيقروا خط واحد. المسافة من
                                                     تحت بترتفع بارتفاع فاضي مش بـ Margin
                                                     مربوط — Thickness نوع قيمة والربط
                                                     عليه بيكسر القالب وقت التشغيل. -->
                                                <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                            Visibility="{Binding ShowAverage, Converter={StaticResource BoolToVis}}">
                                                    <Border Height="1.2" Background="{DynamicResource LineStrongBrush}"
                                                            Opacity="0.85" />
                                                    <Border Height="{Binding AverageOffset}" Background="Transparent" />
                                                </StackPanel>

                                                <!-- الشرايح مثبتة على خط الأرض -->
                                                <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom"
                                                              HorizontalAlignment="Center">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- الفاصل تحت كل شريحة بيخلي حدود المنتجات
                                                                 تبان من غير خط إضافي. رقم ثابت مش Binding:
                                                                 Thickness نوع قيمة مش عنصر، فالربط عليه
                                                                 بيكسر القالب كله وقت التشغيل. -->
                                                            <Border Width="26" Height="{Binding Height}"
                                                                    ui:ThemeBrush.BackgroundKey="{Binding Color}" CornerRadius="3"
                                                                    Margin="0,0,0,2"
                                                                    ToolTip="{Binding Tooltip}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- خط الأرض + تاريخ الفترة -->
                                            <Border Height="1.5" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <!-- الفترة الجارية: المقارنة بيها ناقصة لأنها لسه مكملتش -->
                                            <TextBlock Text="{Binding CurrentNote}" FontSize="9.5"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
</UserControl>
