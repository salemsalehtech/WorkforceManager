<UserControl x:Class="WorkforceManager.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة التقييم والمتابعة: بتتشاف وبيتصرّف منها، مش بتطلّع ورق.
         التقارير اللي بتتصدّر اتنقلت لشاشة "التقارير" وبقت قوالب في
         مُنشئ التقارير — نفس الأربعة، بس بقى ينفع تعدّلهم وتعمل زيّهم. -->
    <TabControl>

        <!-- ============ تبويب تقييم اليوم ============ -->
        <TabItem Header="  تقييم اليوم  ">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== محتاج تصرّف =====
                     فوق كل حاجة عن قصد: باقي الشاشة بيقول "إيه اللي
                     حصل"، والقايمة دي بتقول "اعمل إيه". المدير بيفتح
                     الشاشة عشان يتصرّف، مش عشان يقرا متوسطات. -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10"
                        Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource WarnBrush}" />
                            <TextBlock Text="محتاج تصرّف" FontWeight="Bold" FontSize="14"
                                       Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding AttentionSummary}" FontSize="12"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Attention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8"
                                            Padding="11,8" Margin="0,0,0,5">
                                        <DockPanel>
                                            <!-- الإجراء من نفس الصف -->
                                            <Button DockPanel.Dock="Left"
                                                    Command="{Binding DataContext.OpenWorkerCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center" FontSize="11.5">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WorkerId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountOutline" Width="13" Height="13"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="افتح العامل" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- شريط الخطورة: اللي بيوقف الإنتاج أحمر -->
                                            <Border DockPanel.Dock="Right" Width="4" CornerRadius="2"
                                                    Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="0">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- اختيار اليوم + سطر الملخص -->
                <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="اليوم:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding DailyDate}" Width="160" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DailySummaryText}" Foreground="{DynamicResource BrandBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="20,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== اليوم في سطر =====
                     خمس حقايق المدير بيسأل عنها أول ما يفتح الشاشة، كلها
                     محسوبة من سجلات اليوم. المنتجات من ProductActivityService —
                     نفس خدمة شاشة المنتجات، مفيش حساب موازي. -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- إنتاج اليوم + أكتر منتج -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="إنتاج النهارده" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding DailyTotalPiecesText}" FontSize="26" FontWeight="Bold"
                                       Margin="0,2,0,0" Foreground="{DynamicResource BrandBrush}" />
                            <TextBlock Text="قطعة تامة على كل المنتجات" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="7"
                                    Padding="9,6" Margin="0,9,0,0">
                                <StackPanel>
                                    <TextBlock Text="أكتر منتج شغل" FontSize="10.5"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding DailyTopProductText}" FontSize="13" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DailyTopProductPiecesText}" FontSize="10.5"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- المنتجات اللي اتشغل عليها -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="اتشغل على" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,7"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <TextBlock Text="مفيش شغل مسجّل النهارده" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding HasDailyProducts, Converter={StaticResource InverseBoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding DailyProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="7"
                                                Padding="9,6" Margin="0,0,0,4">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PiecesText}"
                                                           FontSize="11.5" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrandBrush}" />
                                                <StackPanel Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding WorkersText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- أحسن وأقل عامل -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="أحسن وأقل عامل" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,7"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="7" Padding="9,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrendingUp" Width="13" Height="13"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="{Binding DailyBestWorkerText}" FontSize="12.5" FontWeight="Bold"
                                                   Margin="5,0,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DailyBestWorkerDetail}" FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- بيختفي لما يكون فيه عامل واحد منتج: الأحسن
                                 والأقل هيبقوا هو، وعرضهم مرتين بيوحي بمقارنة محصلتش -->
                            <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="7" Padding="9,6"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding DailyHasComparison, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrendingDown" Width="13" Height="13"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource WarnBrush}" />
                                        <TextBlock Text="{Binding DailyWorstWorkerText}" FontSize="12.5" FontWeight="Bold"
                                                   Margin="5,0,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DailyWorstWorkerDetail}" FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource WarnBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="المقارنة بين اللي أنتجوا فعلاً — الغايبين مش داخلين"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- جدول التقييم اليومي -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,10,0,0">
                <DataGrid ItemsSource="{Binding DailyRows}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم العامل" Binding="{Binding WorkerName}" Width="*" />
                        <DataGridTextColumn Header="القطع" Binding="{Binding TotalPieces}" Width="70" />
                        <DataGridTextColumn Header="اليوميات" Binding="{Binding TotalWorkdays}" Width="80" />
                        <DataGridTextColumn Header="مقارنة بالمتوسط" Binding="{Binding PercentText}" Width="110" />
                        <!-- التقييم بلونه المميز (اللون جاي جاهز من الـ ViewModel) -->
                        <DataGridTemplateColumn Header="التقييم" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RatingText}" ui:ThemeBrush.ForegroundKey="{Binding RatingColor}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الحضور" Binding="{Binding AttendanceText}" Width="100" />
                        <DataGridTextColumn Header="اشتغل على" Binding="{Binding BreakdownText}" Width="2*" />
                        <DataGridTextColumn Header="جزاءات اليوم" Binding="{Binding PenaltiesText}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ تبويب إنتاج اليوم: خلص كام ودخل كام ============ -->
        <TabItem Header="  إنتاج اليوم  ">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="اليوم:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding OutputDate}" Width="160" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="6" Padding="9,4"
                                Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding OutputIsClosed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LockCheck" Width="13" Height="13"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="اليوم مقفول — الأرقام دي نهائية" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ملخص اليوم في رقمين -->
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,8">
                    <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputCompletedText}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="قطعة خلصت الخط كامل" FontSize="11.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,11" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputStartedText}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrandBrush}" />
                            <TextBlock Text="قطعة دخلت الخط النهارده" FontSize="11.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="مفيش أي حركة إنتاج في اليوم ده" FontSize="13" Margin="4,10,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding OutputIsEmpty, Converter={StaticResource BoolToVis}}" />

                        <!-- كارت لكل منتج: خلص منه كام ودخل منه كام النهارده -->
                        <ItemsControl ItemsSource="{Binding OutputProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                    <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="7"
                                                            Padding="11,5" VerticalAlignment="Center">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding CompletedPieces, StringFormat=N0}"
                                                                       FontSize="17" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                            <TextBlock Text="مكتمل" FontSize="10" HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock FontSize="11.5" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="دخل الخط النهارده:" />
                                                        <Run Text="{Binding StartedPieces, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" />
                                                        <Run Text="قطعة" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ============ تبويب كشف الأسبوع ============ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="إنتاج المنتجات" Margin="6,0,0,0" />
                </StackPanel>
            </TabItem.Header>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- اختيار المدة -->
                <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="المدة: آخر" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ChartWeeksOptions}"
                                  SelectedItem="{Binding SelectedChartWeeks}" Width="70" />
                        <TextBlock Text="أسبوع" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,16,0" />
                        <TextBlock Style="{StaticResource HintText}" FontSize="12" VerticalAlignment="Center"
                                   Text="القطع المكتملة فقط: المسجلة على آخر مرحلة لكل منتج — الشغل الجاري على المراحل الأبكر مش بيتحسب" />
                    </StackPanel>
                </Border>

                <!-- ===== اتجاه الإنتاج =====
                     الرقم اللي المدير بياخد منه قرار: طالع ولا نازل؟
                     الرسمة بتوريه التفاصيل، والسطر ده بيقول الخلاصة. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"
                        Visibility="{Binding HasChartTrend, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="17" Height="17"
                                                 VerticalAlignment="Center"
                                                 ui:ThemeBrush.ForegroundKey="{Binding ChartTrendColor}" />
                        <TextBlock Text="{Binding ChartTrendText}" FontSize="13" FontWeight="SemiBold"
                                   Margin="7,0,0,0" VerticalAlignment="Center"
                                   ui:ThemeBrush.ForegroundKey="{Binding ChartTrendColor}" />
                    </StackPanel>
                </Border>

                <!-- مفتاح الألوان (منتج = لون) — دايمًا ظاهر: الهوية عمرها
                     ما تكون باللون لوحده -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding ChartLegend}" Margin="4,0,4,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                                <Border Width="13" Height="13" CornerRadius="3" ui:ThemeBrush.BackgroundKey="{Binding Color}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="6,0,4,0" />
                                <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- الرسم البياني -->
                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <!-- رسالة لما مفيش بيانات -->
                        <TextBlock Text="مفيش إنتاج مكتمل متسجل في الفترة دي — سجّل رحلات إنتاج توصل لآخر مرحلة وهتظهر هنا"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="400">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChartHasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- محور الزمن ثابت شمال ← يمين زي أي رسم بياني (مع بقاء النصوص عربي) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      FlowDirection="LeftToRight" VerticalAlignment="Bottom">
                            <ItemsControl ItemsSource="{Binding ChartWeekGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- عمود مكدّس لأسبوع واحد: طول العمود = إنتاج
                                             الأسبوع كله، والشرايح = نصيب كل منتج.
                                             كانت أعمدة متجاورة (عمود لكل منتج): الأسبوع
                                             مكانش ليه رقم واحد يتقري، والمقارنة بين
                                             الأسابيع كانت محتاجة جمع بالعين. -->
                                        <StackPanel Margin="9,0" MinWidth="46">
                                            <!-- الإجمالي فوق العمود: رقم واحد لكل أسبوع
                                                 بدل رقم على كل شريحة -->
                                            <TextBlock Text="{Binding TotalText}" FontSize="11.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- الشرايح مثبتة على خط الأرض -->
                                            <Grid Height="200">
                                                <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom"
                                                              HorizontalAlignment="Center">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- الفاصل تحت كل شريحة بيخلي حدود المنتجات
                                                                 تبان من غير خط إضافي. رقم ثابت مش Binding:
                                                                 Thickness نوع قيمة مش عنصر، فالربط عليه
                                                                 بيكسر القالب كله وقت التشغيل. -->
                                                            <Border Width="26" Height="{Binding Height}"
                                                                    ui:ThemeBrush.BackgroundKey="{Binding Color}" CornerRadius="3"
                                                                    Margin="0,0,0,2"
                                                                    ToolTip="{Binding Tooltip}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- خط الأرض + تاريخ الأسبوع -->
                                            <Border Height="1.5" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding WeekLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <!-- الأسبوع الجاري: المقارنة بيه ناقصة لأنه لسه مكملش -->
                                            <TextBlock Text="{Binding CurrentWeekNote}" FontSize="9.5"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
</UserControl>
