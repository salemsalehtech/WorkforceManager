<Window x:Class="WorkforceManager.UI.Views.LateSignOffCatchUpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="أيام لسه ما اتوقّعتش" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- ديالوج حاجز عند بدء التشغيل — البرنامج قفل قبل ما يوم يتوقّع
         (كرش، إغلاق قسري، انقطاع كهرباء). مفيش زرار إلغاء حقيقي هنا:
         الإغلاق (X أو Alt+F4) بيتلغى في الكود ورا (Window_Closing)،
         والمستخدم لازم يقرّ بباسورد عملياته إن العمليات دي كانت فعلاً بتاعته. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource WarnBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="أيام لسه ما اتوقّعتش" Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                    <TextBlock Text="البرنامج قفل قبل ما توقّع عليها آخر مرة (كرش، إغلاق قسري، أو انقطاع كهرباء)"
                               Foreground="{DynamicResource SidebarInkBrush}" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <TextBlock Text="لازم تقرّ إن العمليات دي كانت فعلاً بتاعتك قبل ما تكمّل — البرنامج مش هيفتح غير بعد كده."
                           FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                <ItemsControl x:Name="DatesList" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="8"
                                    Padding="10,6" Margin="0,0,0,4">
                                <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{DynamicResource WarnBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="NotConfiguredBox" Background="{DynamicResource WarnBgBrush}"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource WarnBrush}"
                               Text="مفيش كلمة سر عمليات متسجّلة — دوس تأكيد للمتابعة." />
                </Border>

                <StackPanel x:Name="PasswordSection">
                    <TextBlock Text="كلمة سر العمليات" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox" Padding="8,6" FontSize="14" />
                </StackPanel>

                <Border x:Name="ErrorBox" Background="{DynamicResource DangerBgBrush}" CornerRadius="7"
                        Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Padding="16,8"
                        HorizontalAlignment="Left" Margin="0,14,0,0" IsDefault="True" Click="Confirm_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="تأكيد ومتابعة" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
