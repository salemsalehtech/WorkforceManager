<Window x:Class="WorkforceManager.UI.Views.SensitiveActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تأكيد عملية حساسة" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة واحدة لكل العمليات الحساسة — الشاشات بتناديها ومبتعملش نسخة منها -->
    <Border CornerRadius="18" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource DangerBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="White"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إلغاء">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="15.5" FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12" Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <!-- تحذير إن مفيش كلمة سر متسجّلة — بيظهر بدل خانة الكلمة -->
                <Border x:Name="NotConfiguredBox" Background="{StaticResource WarnBgBrush}"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource WarnBrush}"
                               Text="مفيش كلمة سر عمليات متسجّلة، فالعملية دي هتتنفّذ من غير تأكيد. حطّ كلمة سر من شاشة الإعدادات عشان تحمي الحذف والتعديلات المالية." />
                </Border>

                <StackPanel x:Name="PasswordSection">
                    <TextBlock Text="كلمة سر العمليات" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox" Padding="8,6" FontSize="14" />
                </StackPanel>

                <!-- بيختفي للعمليات المتكررة اللي مش بتمسح حاجة (حفظ الحضور) -->
                <StackPanel x:Name="ReasonSection">
                    <TextBlock Text="سبب الحذف" FontWeight="Bold" FontSize="12.5" Margin="0,12,0,4" />
                    <TextBox x:Name="ReasonBox" Padding="8,6" FontSize="13.5"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="السبب بيتسجّل في سجل العمليات — اكتبه واضح عشان اللي هيراجع بعدين يفهم."
                               FontSize="11" TextWrapping="Wrap" Margin="2,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="7"
                        Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Padding="16,8" IsCancel="True" Content="إلغاء" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Padding="16,8"
                            Margin="8,0,0,0" IsDefault="True" Click="Confirm_Click" Content="أكّد الحذف" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
