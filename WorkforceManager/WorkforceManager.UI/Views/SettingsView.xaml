<UserControl x:Class="WorkforceManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة الإعدادات: النسخ الاحتياطي المحلي والخارجي والاسترجاع -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Right">

            <!-- النسخ المحلي -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseOutline" Width="18" Height="18"
                                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="النسخ الاحتياطي المحلي" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="نسخة تلقائية بتتاخد كل يوم أول ما البرنامج يفتح، والنسخ الأقدم من 30 يوم بتتمسح لوحدها." />
                    <TextBlock Text="{Binding LocalFolderText}" FontSize="12.5"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LocalStatusText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding BackupNowCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="خد نسخة دلوقتي" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenLocalFolderCommand}" Style="{StaticResource GhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="فتح مجلد النسخ" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ===== خيارات النسخ ===== -->
                    <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="8"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AutoBackupOnStartup}"
                                          VerticalAlignment="Center" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="نسخة تلقائية عند فتح البرنامج" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="مرة واحدة في اليوم مهما فتحت البرنامج، وقبل أي تعديل على قاعدة البيانات."
                                               Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="احتفظ بالنسخ لمدة:" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=LostFocus}"
                                         Width="60" Margin="8,0,6,0" Padding="6,4" FontSize="13"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="يوم" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RetentionText}" Style="{StaticResource HintText}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- النسخ الخارجي -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="النسخ الخارجي (فلاشة / قرص تاني)" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="أهم حماية لبياناتك: النسخة المحلية على نفس الهارد — لو الهارد نفسه باظ بتضيع معاه. المجلد الخارجي بياخد نسخة تانية تلقائيًا كل يوم." />
                    <TextBlock Text="{Binding ExternalFolderText}" FontSize="12.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ExternalStatusText}" FontSize="12.5"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ChooseExternalFolderCommand}"
                                Style="{StaticResource SuccessButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="اختيار المجلد الخارجي" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="إيقاف النسخ الخارجي" Command="{Binding DisableExternalCommand}"
                                Foreground="{StaticResource DangerBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExternal}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== تنظيف سجل العمليات =====
                 مدتين مش واحدة عن قصد: كل حدث في السجل ده إما حذف أو
                 حركة فلوس، واللي فيه فلوس السؤال عليه بييجي بعد شهور. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HistoryeraserOutline" Width="18" Height="18"
                                                 Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="تنظيف سجل العمليات" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="سجل العمليات بيقول مين عمل إيه وإمتى وليه. السطور القديمة بتتمسح لوحدها عشان الشاشة تفضل مقروءة — البيانات نفسها (الإنتاج والأجور والجزاءات) مش بتتمس." />

                    <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="أحداث الحذف (مسح يوم / سجل / عامل / منتج / مرحلة):"
                                           FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=LostFocus}"
                                         Width="60" Margin="8,0,6,0" Padding="6,4" FontSize="13"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="يوم" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="أحداث الفلوس (أجر / جزاء / سلفة / تصحيح قطع):"
                                           FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBox Text="{Binding LogFinancialRetentionDays, UpdateSourceTrigger=LostFocus}"
                                         Width="60" Margin="8,0,6,0" Padding="6,4" FontSize="13"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="يوم" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="{Binding LogRetentionText}" Style="{StaticResource HintText}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== الحساب: اسم الدخول وكلمة مروره وحسابات إضافية ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCircleOutline" Width="18" Height="18"
                                                 Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="الحساب" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="كلمة الدخول بتفتح البرنامج. كلمة سر العمليات (تحت) هي اللي بتحمي الحذف والأجور — الاتنين منفصلين عن قصد." />

                    <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="8" Padding="12,9"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="داخل باسم:" FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding CurrentUsername}" FontSize="13" FontWeight="Bold"
                                           Margin="6,0,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AccountsSummary}" FontSize="11.5" Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ChangeUsernameCommand}"
                                Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountEditOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="غيّر اسم المستخدم" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ChangeLoginPasswordCommand}"
                                Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormTextboxPassword" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="غيّر كلمة الدخول" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddAccountCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="ضيف حساب دخول" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== المظهر ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ThemeLightDark" Width="18" Height="18"
                                                 Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="المظهر" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding DarkMode}"
                                  VerticalAlignment="Center" />
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="الوضع الليلي" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="ألوان غامقة أريح للعين في الإضاءة الواطية. بيتفعّل بعد إعادة تشغيل البرنامج."
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- كلمة سر العمليات — أول قسم عن قصد: من غيرها كل الحماية مقفولة -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLockOutline" Width="18" Height="18"
                                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="كلمة سر العمليات" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="كلمة منفصلة عن كلمة الدخول: الدخول بيقول مين انت، ودي بتتطلب قبل الحذف وتعديل الأجور والجزاءات. الشغل اليومي (الحضور وتسجيل الإنتاج) مبيطلبهاش." />

                    <!-- حالة التفعيل: أخضر لو متسجّلة، أحمر لو لأ -->
                    <Border CornerRadius="7" Padding="10,7" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOperationsPassword}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding OperationsStatusText}" FontSize="12.5" TextWrapping="Wrap"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOperationsPassword}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Command="{Binding SetOperationsPasswordCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyVariant" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OperationsButtonText}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- الاسترجاع -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="استرجاع نسخة احتياطية" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="لو حصلت مشكلة كبيرة في البيانات، تقدر ترجع لأي نسخة سابقة. البيانات الحالية بتتستبدل — وبناخد نسخة أمان منها الأول تلقائيًا، والبرنامج بيعيد تشغيل نفسه بعد الاسترجاع." />
                    <Button Command="{Binding RestoreBackupCommand}"
                            Style="{StaticResource DangerButton}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="استرجاع من نسخة..." Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
