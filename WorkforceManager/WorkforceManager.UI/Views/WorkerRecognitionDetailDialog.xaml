<Window x:Class="WorkforceManager.UI.Views.WorkerRecognitionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ليه فاز؟" Width="620" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- شرح ترتيب عامل واحد في أسبوع معيّن: تفصيل المراحل، معامل التنوّع
         والصعوبة، الحضور/الجزاءات، ودرجة الترتيب النهائية. كل ده للعرض
         بس — التوضيح الصريح في آخر الشاشة إن مالوش أثر على الأجر. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="{DynamicResource SidebarInkBrush}"
                                   FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource SidebarInkSoftBrush}"
                                   FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                            Padding="18,8" IsCancel="True" Content="إغلاق" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Padding="18,8" Content="فتح بروفايل العامل الكامل"
                            Click="OpenProfile_Click" />
                </DockPanel>
            </Border>

            <ScrollViewer Margin="18,14,18,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- المركز + الدرجة النهائية -->
                    <Border Background="{DynamicResource GoldTintBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource GoldBrush}">
                                <TextBlock x:Name="ScoreText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkOnAccentBrush}" />
                            </Border>
                            <TextBlock x:Name="RankText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource GoldDeepBrush}" />
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" FontSize="13.5" LineHeight="21"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="تفصيل الإنتاج حسب المرحلة" Style="{DynamicResource SectionLabel}" Margin="0,0,0,6" />
                    <ItemsControl x:Name="StageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="9"
                                        Padding="12,9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProductStageText}" FontWeight="Bold" FontSize="13"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding PieceMathText}" FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="7" Padding="8,4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCustomDifficulty}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource GoldTintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DifficultyText}" FontSize="11.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource GoldDeepBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8,0,12" />

                    <TextBlock x:Name="AttendanceText" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                    <StackPanel x:Name="PenaltiesPanel" Margin="0,0,0,8">
                        <TextBlock Text="الجزاءات المسجّلة الأسبوع ده" Style="{DynamicResource SectionLabel}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="PenaltiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{Binding DeductionName}" FontSize="12" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="9" Padding="12,10" Margin="0,4,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="الترتيب ده للتقييم بس ومالوش أي علاقة بالأجر ولا بعدد القطع المسجّلة فعليًا." />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
