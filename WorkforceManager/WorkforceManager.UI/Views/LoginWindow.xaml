<Window x:Class="WorkforceManager.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="تسجيل الدخول — إدارة الإنتاجية"
        Icon="/Assets/app.ico"
        Width="880" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" FontSize="14">

    <!--
      **شاشة الدخول فاتحة دايمًا، حتى والبرنامج على الوضع الليلي.**

      دي أول حاجة بتظهر قبل ما البرنامج يفتح أصلاً، ومالهاش سياق شغل
      لسه — الأسود هنا بيخليها تبان زي شاشة تحميل مش زي باب البرنامج.
      لوحة الفاتح متحطوطة على النافذة نفسها، وموارد النافذة بتتحل قبل
      موارد التطبيق، فالشاشة دي بتاخد الفاتح والباقي بياخد ثيم المستخدم.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Palette.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- شاشة الدخول الترحيبية: بطاقة عائمة بلا إطار نظام —
         يمين: لوحة الهوية بتدرج SidebarBrush (أسود دافي)، شمال: فورم الدخول -->
    <Border CornerRadius="20" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="Window_Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.25" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════ لوحة الهوية (يمين) ══════ -->
            <!-- تدرج الهوية من اللوحة مش متكتب هنا: نفس التدرج المستخدم
                 في الكروت البطلة، فلو الهوية اتظبطت مرة بتتظبط في
                 الاتنين -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20"
                    Background="{DynamicResource InkGradientBrush}">

                <Grid>
                    <!-- دواير زخرفية شفافة — عمق بصري بسيط من غير زحمة -->
                    <Ellipse Width="220" Height="220" Fill="#0DFFFFFF"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-60,0,0" />
                    <Ellipse Width="160" Height="160" Fill="#0DFFFFFF"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-40" />

                    <StackPanel VerticalAlignment="Center" Margin="34,0">
                        <!-- لوجو WMS نفسه بدل الرمز التعبيري القديم — نفس
                             العنصر اللي في الشريط الجانبي وكارت العمال
                             الفاضي، فالهوية واحدة من أول شاشة يشوفها المستخدم -->
                        <views:WmsLogo Width="76" Height="76" HorizontalAlignment="Right" />
                        <TextBlock Text="إدارة الإنتاجية" Foreground="{DynamicResource SidebarInkBrush}" FontSize="26" FontWeight="Bold"
                                   Margin="0,18,0,4" />
                        <TextBlock Text="نظام اليوميات والأجور والتقييم" Foreground="{DynamicResource SidebarInkBrush}" FontSize="14" />
                        <Border Height="3" Width="52" CornerRadius="2" Background="{DynamicResource GoldBrush}"
                                HorizontalAlignment="Right" Margin="0,16,0,16" />
                        <TextBlock Foreground="{DynamicResource SidebarInkSoftBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                   Text="تسجيل الإنتاج برحلات المنتجات، حساب اليوميات والخصومات تلقائيًا، وكشف الأسبوع جاهز بضغطة واحدة." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════ فورم الدخول (شمال) ══════ -->
            <Grid Grid.Column="1">
                <!-- زرار إغلاق البرنامج -->
                <Button Foreground="{DynamicResource InkFaintBrush}"
                        Style="{StaticResource IconButton}" Padding="8,4"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                        ToolTip="إغلاق البرنامج" Click="Close_Click">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                </Button>

                <StackPanel VerticalAlignment="Center" Margin="56,0">
                    <TextBlock Text="أهلاً بيك 👋" Style="{StaticResource DisplayText}" FontSize="24" />
                    <TextBlock Text="سجّل دخولك عشان تكمل شغلك" FontSize="13.5"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,26" />

                    <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UsernameBox" FontSize="14" Margin="0,0,0,16" />

                    <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordBox" FontSize="14" Margin="0,0,0,8" />

                    <!-- رسالة الخطأ (بتظهر بس لما الدخول يفشل) -->
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                               Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <Button Content="تسجيل الدخول" Click="Login_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" FontSize="14.5"
                            Padding="0,11" Margin="0,10,0,14"
                            HorizontalAlignment="Stretch" />

                    <!-- تغيير كلمة المرور من غير ما يدخل البرنامج -->
                    <TextBlock HorizontalAlignment="Center">
                        <Hyperlink Click="ChangePassword_Click" TextDecorations="None">
                            <Run Text="تغيير كلمة المرور" Foreground="{DynamicResource GoldDeepBrush}" FontSize="12.5" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
