<Window x:Class="WorkforceManager.UI.Views.QualifiedWorkersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="العمال المؤهلين للمرحلة" Width="560" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- مين يعرف يعمل المرحلة دي، مرتبين من الأحسن للأضعف.
         نفس ترتيب شاشة التسجيل اليومي بالظبط (SkillRatingService) —
         عشان اللي المدير بيشوفه هنا هو اللي هيلاقيه هناك. -->
    <Border CornerRadius="18" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BrandBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="White"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="15.5" FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}"
                        Padding="18,8" IsCancel="True" Content="إغلاق" />
            </Border>

            <Grid Margin="18,14,18,10">
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarnBrush}"
                           Text="مفيش أي عامل مؤهل للمرحلة دي — مش هتقدر تسجّل عليها إنتاج"
                           Visibility="Collapsed" />

                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WorkersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="9"
                                        Padding="12,9" Margin="0,0,0,7">
                                    <DockPanel>
                                        <views:WorkerAvatar DockPanel.Dock="Left" Diameter="40"
                                                            PhotoData="{Binding PhotoData}"
                                                            Initials="{Binding Initials}"
                                                            VerticalAlignment="Center" Margin="0,0,11,0" />

                                        <!-- الترتيب: رقم العامل في القايمة -->
                                        <Border DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="13"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Background="{DynamicResource ChipBgBrush}">
                                            <TextBlock Text="{Binding Rank}" FontSize="11.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrandBrush}" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WorkerName}" FontSize="13.5" FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding StarsText}" FontSize="12.5"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                                                <TextBlock Text="{Binding StarsLabel}" FontSize="11.5" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MeasuredText}" FontSize="11" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
