<Window x:Class="WorkforceManager.UI.Views.ScrapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تسجيل هالك" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!--
      القطع اللي اتشالت من الخط ومش هتتكمّل.

      الرقم بييجي مملّي بالفرق كله: الحالة الغالبة إن الفرق كله هالك،
      فضغطة واحدة تكفي. واللي عايز يقسّم (300 هالك و200 هيتكملوا بكرة)
      يغيّر الرقم والباقي بيفضل واقف زي ما هو.
    -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="تسجيل هالك" Foreground="{DynamicResource SidebarInkBrush}"
                                   FontSize="15.5" FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource SidebarInkSoftBrush}"
                                   FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">

                <!-- الفرق اللي البرنامج لقاه -->
                <Border x:Name="GapCard" Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="GapHeadline" FontSize="13.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="GapDetail" FontSize="12" Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- المرحلة: بتتقفل لما البرنامج هو اللي لقى الفرق -->
                <TextBlock Text="المرحلة اللي القطع خلصتها قبل ما تتشال"
                           Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="StageBox" DisplayMemberPath="Display" Margin="0,0,0,12"
                          SelectionChanged="Stage_Changed" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="عدد الهالك" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PiecesBox" FontSize="14" TextChanged="Pieces_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="السبب" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ReasonBox" DisplayMemberPath="Name" FontSize="13.5" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ملاحظة (اختيارية)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NoteBox" FontSize="13.5" Margin="0,0,0,10" />

                <!-- الباقي بعد الهالك — بيتحدّث وانت بتكتب عشان تشوف
                     النتيجة قبل ما تحفظ -->
                <TextBlock x:Name="RemainderText" FontSize="12" Margin="0,0,0,4"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                    <Button Content="سجّل الهالك" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="24,9" Margin="0,0,8,0" />
                    <Button x:Name="KeepPendingButton" Content="كلهم هيتكملوا بكرة"
                            Click="Cancel_Click" IsCancel="True"
                            Style="{StaticResource GhostButton}" Padding="20,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
