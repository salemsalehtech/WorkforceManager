<Window x:Class="WorkforceManager.UI.Views.ScrapBalanceRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تحويل رصيد لهالك"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="تحويل رصيد لهالك" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock x:Name="BalanceText" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock x:Name="RangeText" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock x:Name="RemainingText" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                <TextBlock Text="عدد القطع المحوّلة لهالك" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="QuantityBox" Margin="0,0,0,12" />

                <TextBlock Text="تاريخ التحويل" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="DateBox" Margin="0,0,0,12" />

                <TextBlock Text="السبب" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ReasonBox" DisplayMemberPath="Name" FontSize="13.5" Margin="0,0,0,12" />

                <TextBlock Text="ملاحظة (اختيارية)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NoteBox" FontSize="13.5" Margin="0,0,0,16" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="تحويل لهالك" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource DangerButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
