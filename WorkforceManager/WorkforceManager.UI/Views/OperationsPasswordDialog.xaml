<Window x:Class="WorkforceManager.UI.Views.OperationsPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="كلمة سر العمليات" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إلغاء">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                        <TextBlock Foreground="{DynamicResource SidebarInkBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="كلمة منفصلة عن كلمة الدخول — بتتطلب قبل الحذف والتعديلات المالية." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <!-- الكلمة الحالية: بتظهر وقت التغيير بس -->
                <StackPanel x:Name="CurrentSection" Margin="0,0,0,12">
                    <TextBlock Text="كلمة السر الحالية" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4" />
                    <PasswordBox x:Name="CurrentBox" Padding="8,6" FontSize="14" />
                </StackPanel>

                <TextBlock Text="كلمة السر الجديدة" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4" />
                <PasswordBox x:Name="NewBox" Padding="8,6" FontSize="14" />

                <TextBlock Text="تأكيد كلمة السر الجديدة" FontWeight="Bold" FontSize="12.5" Margin="0,12,0,4" />
                <PasswordBox x:Name="ConfirmBox" Padding="8,6" FontSize="14" />

                <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="7" Padding="10,7" Margin="0,12,0,0">
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                               Text="مفيش طريقة تسترجع الكلمة دي لو نسيتها — اكتبها في مكان آمن." />
                </Border>

                <Border x:Name="ErrorBox" Background="{DynamicResource DangerBgBrush}" CornerRadius="7"
                        Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Padding="16,8" IsCancel="True" Content="إلغاء" />
                    <Button Style="{StaticResource PrimaryButton}" Padding="16,8"
                            Margin="8,0,0,0" IsDefault="True" Click="Confirm_Click" Content="حفظ" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
