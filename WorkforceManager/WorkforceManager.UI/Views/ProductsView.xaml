<UserControl x:Class="WorkforceManager.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة المنتجات: شريط أدوات فوق + قائمة المنتجات + لوحة مراحل المنتج المحدد -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط الأدوات -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding AddProductCommand}"
                        Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="إضافة منتج جديد" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <CheckBox DockPanel.Dock="Left" Content="إظهار الموقوف"
                          IsChecked="{Binding ShowInactive}"
                          VerticalAlignment="Center" Margin="16,0" />

                <!-- البحث الفوري: باسم المنتج أو كوده أو اسم أي مرحلة فيه -->
                <TextBox VerticalAlignment="Center" Padding="8,6" FontSize="14"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- قائمة المنتجات -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" Width="80" />
                    <DataGridTextColumn Header="المراحل" Binding="{Binding StagesCountText}" Width="90" />
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="70" />
                </DataGrid.Columns>
                <!-- المنتج الموقوف بيظهر باهت بخط مائل (مبني على النمط الموحد) -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            </Border>

            <!-- لوحة مراحل المنتج المحدد -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <Grid>
                    <!-- رسالة لما مفيش منتج محدد -->
                    <TextBlock Text="اختار منتج من القائمة لعرض مراحله"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- رأس المنتج + أزرار الإدارة -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding SelectedProduct.Name}" Style="{StaticResource HeadingText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedProduct.Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                <Button Command="{Binding EditProductCommand}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="تعديل" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,0"
                                        Command="{Binding ToggleProductActiveCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="PackageVariantRemove" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="إيقاف المنتج" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IsActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Text="إعادة تفعيل" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding AddStageCommand}" Style="{StaticResource SuccessButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="إضافة مرحلة" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="مراحل التصنيع (بكوتة اليومية لكل مرحلة)"
                                   FontWeight="Bold" Margin="0,0,0,4" />

                        <!-- جدول المراحل -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Stages}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="40" />
                                <DataGridTextColumn Header="المرحلة" Binding="{Binding StageName}" Width="*" />
                                <DataGridTextColumn Header="كوتة اليومية" Binding="{Binding PiecesPerWorkday}" Width="95" />
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="65" />
                                <!-- أزرار تعديل/إيقاف لكل مرحلة -->
                                <DataGridTemplateColumn Header="" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource IconButton}" ToolTip="تعديل المرحلة"
                                                        Command="{Binding DataContext.EditStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="13" Height="13" />
                                                </Button>
                                                <Button Command="{Binding DataContext.ToggleStageActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="ToolTip" Value="إيقاف المرحلة" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <materialDesign:PackIcon Kind="Restore" Width="13" Height="13" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="ToolTip" Value="إعادة تفعيل" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <!-- المرحلة الموقوفة باهتة بخط مائل (مبنية على النمط الموحد) -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
