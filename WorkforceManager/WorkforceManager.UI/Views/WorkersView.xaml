<UserControl x:Class="WorkforceManager.UI.Views.WorkersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <!--
      ═══════════ شاشة العمال والمهارات ═══════════

      التخطيط: ترويسة الصفحة، بعدين صف تحكّم واحد، بعدين عمودين —
      قائمة العمال على اليمين وبروفايل المحدد على الشمال.

      قواعد التصميم اللي الشاشة دي ماشية عليها (وباقي الشاشات هتمشي
      عليها بعد كده):
        • الدهبي أكسنت مش لون نص: بيروح على الرقم البطل، والعنصر
          النشط، والشريط اللي على حرف الكارت المختار.
        • أرقام كبيرة وعناوين صغيرة: العين بتمسك الرقم الأول، والكلمة
          اللي تحته بتفسّره.
        • كل الأيقونات 15 في القوائم و17 في الترويسات — المقاسات
          المختلطة هي أكتر حاجة بتخلي الشاشة تبان عشوائية.
        • كل الألوان DynamicResource عشان الوضع الليلي يتبدّل لحظيًا.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ ترويسة الصفحة ═══════════
             العنوان + سطر أرقام + الفعل الرئيسي. الأرقام سطر واحد مش
             مربعات كبيرة: دي حقايق للعلم مش أزرار، ومربع لكل واحدة كان
             بياخد ربع الشاشة من غير ما يضيف. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="العمال والمهارات" Style="{DynamicResource Title}" />

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Style="{DynamicResource Muted}">
                        <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" عامل نشط" />
                    </TextBlock>

                    <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource InkFaintBrush}" />

                    <TextBlock Style="{DynamicResource Muted}">
                        <Run Text="{Binding HourlyCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" بالساعة" />
                    </TextBlock>

                    <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource InkFaintBrush}" />

                    <TextBlock Style="{DynamicResource Muted}">
                        <Run Text="{Binding InactiveCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" موقوف" />
                    </TextBlock>

                    <!-- المحتاجين انتباه: زرار مش نص، لأنه بيعمل حاجة -->
                    <Button Command="{Binding ShowNeedsAttentionCommand}"
                            Margin="14,0,0,0" Padding="10,3"
                            ToolTip="اعرض العمال دول بس">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsAttentionCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" />
                            <TextBlock Margin="5,0,0,0" FontSize="{DynamicResource FontTiny}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding NeedsAttentionCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" محتاج انتباه" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding AddWorkerCommand}"
                    Style="{DynamicResource GoldButton}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="17" Height="17"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="عامل جديد" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════ تذكير مراجعة التقييمات ═══════════
             بيظهر مرة كل شهر ولو فيه اقتراحات فعلاً بس. التذكير من غير
             حاجة تستاهل بيتحوّل لضوضاء المستخدم بيتعلّم يتجاهلها. -->
        <Border Grid.Row="1" Margin="0,0,0,14" Padding="16,13"
                CornerRadius="{DynamicResource RadiusCard}"
                Background="{DynamicResource GoldTintBrush}"
                BorderBrush="{DynamicResource GoldLineBrush}" BorderThickness="1"
                Visibility="{Binding NeedsSkillReview, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding OpenSkillReviewCommand}"
                        Style="{DynamicResource GoldButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StarCog" Width="15" Height="15"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="راجع دلوقتي" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource SurfaceBrush}">
                        <materialDesign:PackIcon Kind="StarCheckOutline" Width="18" Height="18"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource GoldDeepBrush}" />
                    </Border>
                    <TextBlock Text="{Binding SkillReviewText}" FontSize="{DynamicResource FontBase}"
                               FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GoldDeepBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════ صف التحكّم ═══════════
             بحث + شرايط + عدّاد + فلاتر. صف واحد بس. -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- البحث: بيشتغل مع كل حرف، مفيش زرار ولا Enter -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,0" Height="38">
                <Grid>
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                 Width="16" Height="16" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource InkFaintBrush}" />
                        <Button DockPanel.Dock="Right" Command="{Binding ClearSearchCommand}"
                                Padding="5" ToolTip="مسح البحث">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                        </Button>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent" Padding="0">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </DockPanel>

                    <TextBlock Text="دوّر بالاسم أو بالمهارة…" Margin="30,0,0,0"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource InkFaintBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <RadioButton Content="الكل" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
                <RadioButton Content="بالإنتاج" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterPiece, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="piece" />
                <RadioButton Content="بالساعة" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterHourly, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="hourly" />
                <RadioButton Content="موقوفين" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterInactive, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="inactive" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding ResultsText}" VerticalAlignment="Center"
                       Margin="16,0,0,0" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkSoftBrush}" />

            <!-- الفلاتر والترتيب جوّه زرار واحد -->
            <Grid Grid.Column="3" VerticalAlignment="Center">
                <ToggleButton x:Name="FilterToggle" Style="{DynamicResource ToolbarToggle}"
                              IsChecked="{Binding IsFilterMenuOpen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tune" Width="15" Height="15"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="فلاتر وترتيب" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource GoldBrush}" CornerRadius="8"
                                Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasExtraFilters, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveFilterCount}"
                                       FontSize="{DynamicResource FontMicro}" FontWeight="Bold"
                                       Foreground="{DynamicResource InkOnAccentBrush}" />
                        </Border>
                        <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                 Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsFilterMenuOpen, Mode=TwoWay}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{DynamicResource ToolbarPopupCard}"
                            FlowDirection="RightToLeft" Width="300">
                        <StackPanel>
                            <TextBlock Text="المرحلة" Style="{DynamicResource SectionLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding StageFilterOptions}"
                                      SelectedItem="{Binding SelectedStageFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="العمال المؤهلين لمرحلة معينة" />

                            <TextBlock Text="المنتج" Style="{DynamicResource SectionLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding ProductFilterOptions}"
                                      SelectedItem="{Binding SelectedProductFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="العمال اللي عندهم مهارة في المنتج ده" />

                            <TextBlock Text="التقييم" Style="{DynamicResource SectionLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding StarsFilterOptions}"
                                      SelectedItem="{Binding SelectedStarsFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="متوسط تقييم العامل على كل مهاراته" />

                            <TextBlock Text="الحضور النهارده" Style="{DynamicResource SectionLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding AttendanceFilterOptions}"
                                      SelectedItem="{Binding SelectedAttendanceFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="حالة الحضور المسجّلة النهارده" />

                            <Border Height="1" Margin="0,14,0,12"
                                    Background="{DynamicResource LineBrush}" />

                            <TextBlock Text="الترتيب" Style="{DynamicResource SectionLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}" />

                            <Button Command="{Binding ClearExtraFiltersCommand}"
                                    Style="{DynamicResource QuietButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Visibility="{Binding HasExtraFilters, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterRemove" Width="14" Height="14"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="شيل الفلاتر" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- ═══════════ العمودين: القائمة + البروفايل ═══════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ═══ كارت أحسن عامل ═══
                     الكارت الوحيد اللي بياخد الدهبي كخلفية في الشاشة —
                     عشان كده بيبان من غير ما يبقى أكبر من غيره. -->
                <Button Grid.Row="0" Command="{Binding OpenBestWorkerCommand}"
                        HorizontalContentAlignment="Stretch" Margin="0,0,0,12"
                        Visibility="{Binding HasBestWorker, Converter={StaticResource BoolToVis}}"
                        ToolTip="اعرض بروفايله">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </Button.Style>

                    <Border CornerRadius="{DynamicResource RadiusCard}" Padding="16,13"
                            Background="{DynamicResource SidebarBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270"
                                              Opacity="0.16" Color="{DynamicResource ShadowColor}" />
                        </Border.Effect>

                        <DockPanel>
                            <views:WorkerAvatar DockPanel.Dock="Right" Diameter="46"
                                                PhotoData="{Binding BestWorker.PhotoData}"
                                                Initials="{Binding BestWorker.Initials}"
                                                VerticalAlignment="Center" Margin="0,0,0,0" />

                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="TrophyVariantOutline"
                                                     Width="26" Height="26" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />

                            <StackPanel VerticalAlignment="Center" Margin="14,0,14,0">
                                <TextBlock Text="أحسن عامل الأسبوع"
                                           FontSize="{DynamicResource FontTiny}" FontWeight="Bold"
                                           Foreground="{DynamicResource GoldBrush}" />
                                <TextBlock Text="{Binding BestWorkerName}"
                                           FontSize="{DynamicResource FontLarge}" FontWeight="Bold"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource SidebarInkBrush}" />
                                <TextBlock Text="{Binding BestWorker.TopSkillProduct}"
                                           FontSize="{DynamicResource FontTiny}" Margin="0,1,0,0"
                                           Visibility="{Binding BestWorker.HasTopSkill, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource SidebarInkSoftBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Button>

                <!-- ═══ قائمة العمال ═══ -->
                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="8">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoResults}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Kind="AccountSearchOutline" Width="44" Height="44"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource InkFaintBrush}" />
                            <TextBlock Text="مفيش عامل بالمواصفات دي" Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontBase}"
                                       Foreground="{DynamicResource InkSoftBrush}" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Workers}"
                                 SelectedItem="{Binding SelectedWorker}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- الكارت نفسه هنا مش في القالب: الاختيار
                                                     شريط دهبي على الحرف مش إطار حوالين
                                                     الكارت. الإطار بيزوّد خط رابع حوالين
                                                     كل كارت، والشريط بيقول نفس المعلومة
                                                     بعنصر واحد. -->
                                                <Border x:Name="Card"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1"
                                                        Padding="13,11">
                                                    <Grid>
                                                        <Border x:Name="Rail" Width="3" CornerRadius="2"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,-11,-13,-11"
                                                                Background="{DynamicResource GoldGradientBrush}"
                                                                Opacity="0" />
                                                        <ContentPresenter />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background"
                                                                Value="{DynamicResource HoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background"
                                                                Value="{DynamicResource SelectedBrush}" />
                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                Value="{DynamicResource GoldLineBrush}" />
                                                        <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <views:WorkerAvatar Grid.Column="0" Diameter="40"
                                                            PhotoData="{Binding PhotoData}"
                                                            Initials="{Binding Initials}"
                                                            VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Crown" Width="14" Height="14"
                                                                         VerticalAlignment="Center" Margin="0,0,5,0"
                                                                         Foreground="{DynamicResource GoldBrush}"
                                                                         Visibility="{Binding IsBestOfWeek, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="{Binding FullName}"
                                                           FontSize="{DynamicResource FontBase}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource InkBrush}" />

                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="{DynamicResource RadiusPill}"
                                                        Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}"
                                                               FontSize="{DynamicResource FontMicro}" FontWeight="Medium"
                                                               Foreground="{DynamicResource InkSoftBrush}" />
                                                </Border>

                                                <Border Background="{DynamicResource DangerTintBrush}"
                                                        CornerRadius="{DynamicResource RadiusPill}"
                                                        Padding="8,2" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="موقوف" FontSize="{DynamicResource FontMicro}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- سطر المهارات. سعر اليومية مقصود إنه مش هنا —
                                                 الأجر بيان حساس، يتشاف من البروفايل بس -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <materialDesign:PackIcon Kind="StarCircleOutline"
                                                                         Width="13" Height="13"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource InkFaintBrush}" />
                                                <TextBlock Text="{Binding SkillsText}"
                                                           FontSize="{DynamicResource FontTiny}" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource InkSoftBrush}" />

                                                <Border Background="{DynamicResource WarnTintBrush}"
                                                        CornerRadius="{DynamicResource RadiusPill}"
                                                        Padding="8,2" Margin="8,0,0,0"
                                                        Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AlertOutline"
                                                                                 Width="11" Height="11"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource WarnBrush}" />
                                                        <TextBlock Text="{Binding AttentionText}"
                                                                   FontSize="{DynamicResource FontMicro}"
                                                                   Margin="4,0,0,0" FontWeight="Medium"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource WarnBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- أرقام الأسبوع: الرقم كبير والكلمة صغيرة تحته -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <StackPanel Margin="0,0,16,0">
                                                <!-- الصفر بيبقى باهت: رقم مالوش قيمة بلون قوي
                                                     بيسحب النظر لحاجة مش موجودة أصلًا -->
                                                <TextBlock Text="{Binding PresentDays}"
                                                           Style="{DynamicResource StatNumber}"
                                                           ui:ThemeBrush.ForegroundKey="{Binding PresentColor}" />
                                                <TextBlock Text="حضور" Style="{DynamicResource StatCaption}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding AbsentWithoutPermissionDays}"
                                                           Style="{DynamicResource StatNumber}"
                                                           ui:ThemeBrush.ForegroundKey="{Binding AbsentColor}" />
                                                <TextBlock Text="غياب" Style="{DynamicResource StatCaption}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NetWorkdays}"
                                                           FontSize="{DynamicResource FontTitle}" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           ui:ThemeBrush.ForegroundKey="{Binding NetColor}" />
                                                <TextBlock Text="الصافي" FontSize="{DynamicResource FontMicro}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource InkFaintBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="12,0,0,0">
                <Grid>
                    <!-- حالة الفراغ: مساحة نص صغير في نص كارت فاضي بتبان
                         زي حاجة اتكسرت. العلامة الكبيرة الباهتة بتقول
                         "المكان ده بتاع حاجة لسه ماتفتحتش" وبتخلي البرنامج
                         يبان مصمّم حتى وهو مستني. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Viewbox Width="96" Height="96" Opacity="0.13" Margin="0,0,0,18">
                            <views:WmsLogo />
                        </Viewbox>

                        <TextBlock Text="اختار عامل من القايمة"
                                   Style="{DynamicResource Title}"
                                   HorizontalAlignment="Center" />

                        <Border Style="{DynamicResource GoldHairline}" Width="70"
                                Margin="0,10,0,10" />

                        <TextBlock Text="هتلاقي هنا مهاراته وتقييمه على كل منتج، حضوره وغيابه، وأجره في الأسبوع."
                                   Style="{DynamicResource Muted}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Detail}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- رأس البروفايل + أزرار الإدارة -->
                            <TextBlock Text="{Binding FullName}" Style="{DynamicResource Title}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource InkSoftBrush}" Margin="0,2,0,4">
                                <Run Text="تليفون: " /><Run Text="{Binding PhoneNumber, Mode=OneWay}" />
                                <Run Text="   التحق: " /><Run Text="{Binding HireDateText, Mode=OneWay}" />
                            </TextBlock>

                            <!-- سعر اليومية: أخضر لو متحدد، تحذير أصفر لو لأ -->
                            <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource GoodTintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoWage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding WageText}" FontSize="12.5" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoWage}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- شارة العامل بالساعة (بتظهر بس لو ليه دور بالساعة) -->
                            <Border Background="{DynamicResource WarnTintBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHourly}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" Margin="4,0,0,0">
                                        <Run Text="{Binding HourlyRoleText, Mode=OneWay}" /><Run Text=" — بيتحاسب بالساعة" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding DataContext.EditWorkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{DynamicResource QuietButton}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="تعديل" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <!--
                                      BasedOn لازم StaticResource: هي خاصية CLR عادية على
                                      Style مش DependencyProperty، وDynamicResource عليها
                                      بيرمي وقت التحميل مش وقت البناء. وده مش بيكسر تبديل
                                      الثيم — الألوان جوه النمط الأساسي نفسها DynamicResource.
                                    -->
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AccountOff" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="إيقاف العامل" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Text="إعادة تفعيل" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- الحذف غير الإيقاف: بيمر على كلمة سر العمليات وبيتسجّل -->
                                <Button Command="{Binding DataContext.DeleteWorkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{DynamicResource QuietButton}" Margin="6,0,0,0"
                                        Foreground="{DynamicResource DangerBrush}"
                                        ToolTip="شيل العامل من النظام نهائيًا — سجلاته التاريخية بتفضل محفوظة">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="حذف" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- ===== المهارات: كارت لكل منتج، بيتفتح على مراحل الخط ===== -->
                            <DockPanel Margin="0,4,0,6">
                                <!-- بيقلب بين "مهاراته" و"كل المنتجات" — مش بيفتح فورم تاني -->
                                <Button DockPanel.Dock="Left" Padding="10,5"
                                        Command="{Binding DataContext.ToggleAddSkillsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddingSkills}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="Plus" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddingSkills}" Value="True">
                                                            <Setter Property="Kind" Value="Check" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Margin="4,0,0,0" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="إضافة مهارات" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddingSkills}" Value="True">
                                                            <Setter Property="Text" Value="خلصت" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="المهارات (المراحل اللي بيعرف يعملها)" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DockPanel>

                            <!-- شريط أدوات: بحث في مهاراته + فتح/قفل الكل -->
                            <DockPanel Margin="0,0,0,7" Visibility="{Binding HasSkills, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Left" Style="{DynamicResource IconButton}" Padding="7,5"
                                        ToolTip="فتح أو قفل كل المنتجات"
                                        Command="{Binding DataContext.ToggleAllSkillGroupsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <materialDesign:PackIcon Width="17" Height="17">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="UnfoldMoreHorizontal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllExpanded}" Value="True">
                                                        <Setter Property="Kind" Value="UnfoldLessHorizontal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.2"
                                        CornerRadius="8" Padding="9,5" Margin="0,0,6,0">
                                    <Grid>
                                        <DockPanel>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                                    Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource InkSoftBrush}" />
                                            <TextBox Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="6,0,0,0" BorderThickness="0" FontSize="12"
                                                     VerticalAlignment="Center" Background="Transparent" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding SkillSearchHint}" Margin="24,0,0,0" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource InkSoftBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SkillSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- رسالة لما مفيش مهارات مربوطة خالص -->
                            <Border Background="{DynamicResource WarnTintBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnySkill}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="مفيش مهارات مربوطة — العامل ده مش هيظهر في أي رحلة إنتاج"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarnBrush}" />
                            </Border>

                            <!-- كان هنا كارت أزرق فيه سطر شرح + زرار "خلصت إضافة" +
                                 عدّاد باللي اتضاف. اتشال كله: الزرار كان مكرر (زرار
                                 "خلصت" فوق جنب العنوان بيعمل نفس الحاجة)، والشرح
                                 والعدّاد كانوا بياخدوا مساحة من الكروت نفسها من غير
                                 ما يضيفوا قرار. -->

                            <!-- البحث مالوش نتيجة (مختلف عن "مفيش مهارات خالص") -->
                            <TextBlock Text="مفيش منتج أو مرحلة بالاسم ده" FontSize="12" Margin="2,4,0,6"
                                       Foreground="{DynamicResource InkSoftBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSkills}" Value="True" />
                                                    <Condition Binding="{Binding HasVisibleSkills}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding SkillProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,7" BorderThickness="1.4"
                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                                    <Style.Triggers>
                                                        <!-- منتج مالوش فيه ولا مهارة (بيبان في وضع الإضافة بس) -->
                                                        <DataTrigger Binding="{Binding IsUntouched}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource GoldTintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- ===== رأس الكارت: دوسة عليه بتفتح الخط ===== -->
                                                <Button Command="{Binding DataContext.ToggleSkillGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        BorderThickness="0" Padding="11,9" Background="Transparent">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background"
                                                                                        Value="{DynamicResource SurfaceAltBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>

                                                    <!-- ترتيب رأس الكارت (Grid مش DockPanel عن قصد):
                                                         الأعمدة بتتقري من اليمين لأن اللوحة RTL، فالترتيب
                                                         اللي المستخدم بيشوفه = اسم المنتج ← عدد المراحل ←
                                                         تقييمه ← سهم الفتح. الـ DockPanel كان بيرتّبهم حسب
                                                         ترتيب الـ Dock بعد المرايا، وده صعب يتقري من الكود. -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 1. اسم المنتج -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <!-- المنتج نفسه موقوف -->
                                                                <Border Background="{DynamicResource DangerTintBrush}" CornerRadius="4"
                                                                        Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsProductInactive, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="منتج موقوف" FontSize="10"
                                                                               Foreground="{DynamicResource DangerBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <!-- مهارات على مراحل موقوفة -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                        Visibility="{Binding HasInactiveSkills, Converter={StaticResource BoolToVis}}">
                                                                <materialDesign:PackIcon Kind="AlertOutline" Width="11" Height="11"
                                                                                        VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource WarnBrush}" />
                                                                <TextBlock Text="{Binding InactiveSkillsText}" FontSize="10.5" Margin="3,0,0,0"
                                                                           Foreground="{DynamicResource WarnBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- 2. التغطية: كام مرحلة من كام.
                                                             بتخضرّ لما يغطي الخط كله — دي كانت رسالة النجمة
                                                             اللي اتشالت، فالمعلومة مضاعتش. -->
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="7,2"
                                                                VerticalAlignment="Center"
                                                                ToolTip="{Binding CoverageTooltip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CoversWholeLine}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource GoodTintBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding CoverageText}" FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CoversWholeLine}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- 3. تقييمه على المنتج ده — اللون بيتغيّر مع
                                                             المستوى عشان العين تقراه من غير ما تعدّ نجوم -->
                                                        <Border Grid.Column="2" CornerRadius="6" Padding="7,2" Margin="5,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="{Binding RatingTooltip}"
                                                                ui:ThemeBrush.BackgroundKey="{Binding RatingBackground}"
                                                                Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StarsText}" FontSize="10.5"
                                                                           VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                                                                <TextBlock Text="{Binding RatingLabel}" FontSize="11" FontWeight="Medium"
                                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           ui:ThemeBrush.ForegroundKey="{Binding RatingColor}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 4. سهم الفتح: بيلف لتحت وهو مفتوح -->
                                                        <materialDesign:PackIcon Grid.Column="3" Kind="ChevronLeft"
                                                                                Width="19" Height="19" VerticalAlignment="Center"
                                                                                Margin="7,0,0,0"
                                                                                RenderTransformOrigin="0.5,0.5"
                                                                                Foreground="{DynamicResource InkSoftBrush}">
                                                            <materialDesign:PackIcon.RenderTransform>
                                                                <RotateTransform x:Name="Chevron" Angle="0" />
                                                            </materialDesign:PackIcon.RenderTransform>
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Kind" Value="ChevronDown" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                    </Grid>
                                                </Button>

                                                <!-- ===== جسم الكارت: مراحل الخط بترتيبها ===== -->
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,9,9"
                                                        Padding="9,7" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                  <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Stages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="7" Padding="7,5" Margin="0,1.5"
                                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <!-- مش بيعرفها: باهتة وبإطار متقطّع الإحساس -->
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                    <Setter Property="Background" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <DockPanel>
                                                                        <!-- زرار واحد: يشيل المهارة أو يضيفها -->
                                                                        <Button DockPanel.Dock="Left"
                                                                                Command="{Binding DataContext.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                                                    <Setter Property="ToolTip" Value="ضيف المهارة دي للعامل" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                            <Setter Property="ToolTip" Value="شيل المهارة دي من العامل" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <materialDesign:PackIcon Width="13" Height="13">
                                                                                <materialDesign:PackIcon.Style>
                                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                                        <Setter Property="Kind" Value="Plus" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                                <Setter Property="Kind" Value="Close" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </materialDesign:PackIcon.Style>
                                                                            </materialDesign:PackIcon>
                                                                        </Button>

                                                                        <!-- رقم المرحلة في الخط -->
                                                                        <Border DockPanel.Dock="Right" Width="21" Height="21" CornerRadius="10.5"
                                                                                VerticalAlignment="Center" Margin="0,0,7,0">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                            <Setter Property="Background" Value="{DynamicResource InkBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding Position}" FontSize="10.5" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource SidebarInkBrush}" HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>

                                                                        <!-- ===== تقييم المدير بالنجوم ===== -->
                                                                        <!-- بيظهر للمهارات اللي بيعرفها (عشان يعدّل)، وكمان في
                                                                             وضع الإضافة للمراحل الجديدة: ساعتها الضغط على نجمة
                                                                             بيضيف المهارة بالمستوى ده على طول -->
                                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                                                    ToolTip="{Binding RatingTooltip}"
                                                                                    Visibility="{Binding ShowStars, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel.Resources>
                                                                                <!-- نجمة واحدة: مليانة لو ضمن التقييم، فاضية لو لأ -->
                                                                                <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                                    <Setter Property="Padding" Value="1,0" />
                                                                                    <Setter Property="Width" Value="18" />
                                                                                    <Setter Property="Height" Value="18" />
                                                                                </Style>
                                                                            </StackPanel.Resources>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star1Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource LineBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star1}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star2Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource LineBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star2}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star3Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource LineBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star3}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star4Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource LineBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star4}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star5Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource LineBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star5}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <!-- الأداء المقاس جنب النجوم — الدليل جنب الرأي -->
                                                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4"
                                                                                    Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding HasMeasurement, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="{Binding MeasuredText}" FontSize="10"
                                                                                           Foreground="{DynamicResource InkSoftBrush}" />
                                                                            </Border>

                                                                            <!-- تنبيه إن تقييمك بعيد عن أداؤه الفعلي -->
                                                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="13" Height="13"
                                                                                                     VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                                     Foreground="{DynamicResource WarnBrush}"
                                                                                                     ToolTip="تقييمك بعيد عن إنتاجه الفعلي — راجعه"
                                                                                                     Visibility="{Binding HasGapWithReality, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding StageName}" FontSize="12" TextWrapping="Wrap">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <!-- فجوة: باهت وعادي. مهارة: غامق ومتوسط -->
                                                                                        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                                                <Setter Property="FontWeight" Value="Medium" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Border Background="{DynamicResource WarnTintBrush}" CornerRadius="4"
                                                                                    Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                    ToolTip="المرحلة دي موقوفة — المهارة عليها مش هتنفع في أي رحلة إنتاج"
                                                                                    Visibility="{Binding IsStageInactive, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="موقوفة" FontSize="10"
                                                                                           Foreground="{DynamicResource WarnBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- إضافة جماعية: خط من 14 مرحلة كان محتاج 14 دوسة -->
                                                    <Button Style="{DynamicResource QuietButton}" Margin="0,7,0,0"
                                                            HorizontalAlignment="Stretch" Padding="8,6"
                                                            Command="{Binding DataContext.AddAllStagesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="PlaylistPlus" Width="15" Height="15"
                                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AddAllText}" Margin="6,0,0,0" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <!-- ===== الهستوري الأسبوعي: كارت لكل أسبوع، بيتفتح على تفاصيله ===== -->
                            <TextBlock Text="الهستوري الأسبوعي (آخر 8 أسابيع)" FontWeight="Bold" Margin="0,10,0,6" />
                            <ItemsControl ItemsSource="{Binding WeeklyHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,6" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.4">
                                            <StackPanel>
                                                <!-- ===== رأس الكارت ===== -->
                                                <Button Command="{Binding DataContext.ToggleWeekCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Stretch" Padding="11,9">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background"
                                                                                        Value="{DynamicResource SurfaceAltBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <!-- أسبوع فاضي: مفيش تفاصيل تتفتح -->
                                                                <DataTrigger Binding="{Binding IsEmptyWeek}" Value="True">
                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <DockPanel>
                                                        <materialDesign:PackIcon DockPanel.Dock="Left" Width="18" Height="18"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource InkSoftBrush}">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="ChevronLeft" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Kind" Value="ChevronDown" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsEmptyWeek}" Value="True">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <!-- الأجر: الرقم اللي بيتسأل عنه -->
                                                        <TextBlock DockPanel.Dock="Left" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource GoodBrush}"
                                                                   Text="{Binding WageText}"
                                                                   Visibility="{Binding HasWage, Converter={StaticResource BoolToVis}}" />

                                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Star" Width="14" Height="14"
                                                                                        VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                        ToolTip="أحسن عامل في الأسبوع ده"
                                                                                        Foreground="{DynamicResource GoldBrush}"
                                                                                        Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding WeekTitle}" FontSize="12.5" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4"
                                                                        Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasRelativeLabel, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding RelativeLabel}" FontSize="10"
                                                                               Foreground="{DynamicResource InkBrush}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- سطر الصافي: الرقم الحقيقي اللي بيتحاسب عليه -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="صافي" FontSize="11"
                                                                           Foreground="{DynamicResource InkSoftBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding NetText}" FontSize="12.5" FontWeight="Bold"
                                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock Text="يومية" FontSize="11" Margin="3,0,0,0"
                                                                           Foreground="{DynamicResource InkSoftBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="مفيش شغل الأسبوع ده" FontSize="11" Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource InkSoftBrush}"
                                                                           Visibility="{Binding IsEmptyWeek, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>

                                                <!-- ===== جسم الكارت ===== -->
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,9,9"
                                                        Padding="10,8"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <!-- الحسبة: أنتج − غياب − جزاءات = صافي -->
                                                        <UniformGrid Columns="4" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ProducedText}" FontSize="14" FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock Text="أنتج" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource InkSoftBrush}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="0" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasAbsence}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding AbsenceText}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="غياب" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource InkSoftBrush}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="0" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasPenaltyDeduction}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding PenaltyText}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="جزاءات" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource InkSoftBrush}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding NetText}" FontSize="14" FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock Text="الصافي" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource InkSoftBrush}" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <!-- اشتغل على: صف لكل مرحلة، الأعلى إنتاجًا فوق -->
                                                        <StackPanel Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="اشتغل على" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                                                                       Foreground="{DynamicResource InkSoftBrush}" />
                                                            <ItemsControl ItemsSource="{Binding Breakdown}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="7,4" Margin="0,1.5">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PiecesText}"
                                                                                           FontSize="11.5" FontWeight="Bold"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding StageName}" FontSize="11.5"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource InkBrush}" />
                                                                                    <TextBlock Text="{Binding ProductName}" FontSize="10.5"
                                                                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource InkSoftBrush}" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- الجزاءات بأسبابها -->
                                                        <StackPanel Margin="0,8,0,0"
                                                                    Visibility="{Binding HasPenalties, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="جزاءات الأسبوع" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                                                                       Foreground="{DynamicResource DangerBrush}" />
                                                            <ItemsControl ItemsSource="{Binding Penalties}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource DangerTintBrush}" CornerRadius="6"
                                                                                Padding="7,4" Margin="0,1.5">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding DeductionName}"
                                                                                           FontSize="11" FontWeight="Bold"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource DangerBrush}" />
                                                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding Reason}" FontSize="11.5"
                                                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource InkBrush}" />
                                                                                    <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                                                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource InkSoftBrush}" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
