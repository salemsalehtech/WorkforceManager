<UserControl x:Class="WorkforceManager.UI.Views.WorkersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة العمال: شريط أدوات فوق + جدول العمال في النص + لوحة تفاصيل (بروفايل) على الجنب -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== شريط الملخص: صورة القسم كلها بنظرة ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding AddWorkerCommand}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="17" Height="17" VerticalAlignment="Center" />
                        <TextBlock Text="إضافة عامل" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- تنبيه العمال المحتاجين انتباه — زرار بيفلتر عليهم -->
                <Button DockPanel.Dock="Right" Command="{Binding ShowNeedsAttentionCommand}"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        ToolTip="اعرض العمال دول بس">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsAttentionCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                            <Run Text="{Binding NeedsAttentionCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" محتاج انتباه" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <StackPanel Style="{StaticResource SummaryStat}">
                        <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource SummaryNumber}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="عامل نشط" Style="{StaticResource SummaryLabel}" />
                    </StackPanel>

                    <Border Style="{StaticResource SummaryDivider}" />

                    <StackPanel Style="{StaticResource SummaryStat}">
                        <TextBlock Text="{Binding HourlyCount}" Style="{StaticResource SummaryNumber}"
                                   Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Text="بالساعة" Style="{StaticResource SummaryLabel}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource SummaryStat}">
                        <TextBlock Text="{Binding InactiveCount}" Style="{StaticResource SummaryNumber}"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="موقوف" Style="{StaticResource SummaryLabel}" />
                    </StackPanel>

                    <Border Style="{StaticResource SummaryDivider}" />

                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Star" Width="15" Height="15" VerticalAlignment="Center"
                                                    Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding BestWorkerName}" FontSize="13.5" FontWeight="SemiBold"
                                       Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="أحسن عامل الأسبوع" Style="{StaticResource SummaryLabel}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== البحث + الفلاتر + الترتيب ===== -->
        <Grid Grid.Row="1" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- بحث لحظي: بيشتغل مع كل حرف، مفيش زرار ولا Enter -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.4"
                    CornerRadius="10" Padding="12,7">
                <Grid>
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="17" Height="17"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}" />
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ClearSearchCommand}" ToolTip="مسح البحث">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                        </Button>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0" BorderThickness="0" VerticalAlignment="Center"
                                 FontSize="13" Background="Transparent" />
                    </DockPanel>
                    <TextBlock Text="دوّر بالاسم أو بالمهارة…" Margin="30,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- أزرار الفلترة السريعة -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton Content="الكل" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
                <RadioButton Content="بالقطعة" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding IsFilterPiece, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="piece" />
                <RadioButton Content="بالساعة" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding IsFilterHourly, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="hourly" />
                <RadioButton Content="موقوفين" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding IsFilterInactive, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="inactive" />
            </StackPanel>

            <!-- عدد النتايج + عنوان الأسبوع -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="{Binding ResultsText}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding WeekTitle}" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- الترتيب -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ترتيب:" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                           Foreground="{StaticResource TextMutedBrush}" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Display" Width="165" FontSize="12.5" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- قائمة العمال: بطاقة لكل عامل -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <!-- مفيش نتايج -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoResults}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="46" Height="46"
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="مفيش عامل بالمواصفات دي" Margin="0,10,0,0" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Workers}"
                             SelectedItem="{Binding SelectedWorker}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- إطار بلون البراند حوالين البطاقة المختارة — عشان
                                             المستخدم يعرف بروفايل مين معروض على الجنب -->
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelectionRing" CornerRadius="13" Margin="-2"
                                                    BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter Margin="2" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionRing" Property="BorderBrush"
                                                            Value="{StaticResource BrandBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WorkerCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- دايرة الحروف الأولى -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                Background="{StaticResource SubtleBgBrush}"
                                                VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Initials}" FontSize="15.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrandBrush}" />
                                        </Border>

                                        <!-- الاسم + الشارات + التنبيه -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Star" Width="15" Height="15"
                                                                        VerticalAlignment="Center" Margin="0,0,5,0"
                                                                        Foreground="{StaticResource AccentBrush}"
                                                                        Visibility="{Binding IsBestOfWeek, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding FullName}" FontSize="14.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <!-- شارة النوع -->
                                                <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="7"
                                                        Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="Medium"
                                                               Foreground="{StaticResource BrandBrush}" />
                                                </Border>
                                                <!-- شارة موقوف (بتظهر بس لو العامل موقوف) -->
                                                <Border Background="{StaticResource DangerBgBrush}" CornerRadius="7"
                                                        Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="موقوف" FontSize="11" FontWeight="Medium"
                                                               Foreground="{StaticResource DangerBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- سطر التفاصيل: عدد المهارات. سعر اليومية مقصود إنه
                                                 مش هنا — الأجر بيان حساس، يتشاف من البروفايل بس -->
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <materialDesign:PackIcon Kind="StarCircleOutline" Width="13" Height="13"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding SkillsText}" FontSize="11.5" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>

                                            <!-- تنبيه: مفيش سعر يومية / مفيش مهارات -->
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                                        Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{StaticResource WarnBrush}" />
                                                <TextBlock Text="{Binding AttentionText}" FontSize="11.5" Margin="4,0,0,0"
                                                           VerticalAlignment="Center" FontWeight="Medium"
                                                           Foreground="{StaticResource WarnBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- أرقام الأسبوع -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="14,0,0,0">
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="{Binding PresentDays}" FontSize="16" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <TextBlock Text="حضور" FontSize="10.5" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="{Binding AbsentWithoutPermissionDays}" FontSize="16" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource DangerBrush}" />
                                                <TextBlock Text="غياب" FontSize="10.5" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NetWorkdays}" FontSize="17" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{Binding NetColor}" />
                                                <TextBlock Text="الصافي" FontSize="10.5" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- لوحة التفاصيل (بروفايل العامل المحدد) -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <Grid>
                    <!-- رسالة لما مفيش عامل محدد -->
                    <TextBlock Text="اختار عامل من الجدول لعرض ملفه الكامل"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Detail}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- رأس البروفايل + أزرار الإدارة -->
                            <TextBlock Text="{Binding FullName}" Style="{StaticResource HeadingText}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,4">
                                <Run Text="تليفون: " /><Run Text="{Binding PhoneNumber, Mode=OneWay}" />
                                <Run Text="   التحق: " /><Run Text="{Binding HireDateText, Mode=OneWay}" />
                            </TextBlock>

                            <!-- سعر اليومية: أخضر لو متحدد، تحذير أصفر لو لأ -->
                            <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoWage}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding WageText}" FontSize="12.5" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoWage}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- شارة العامل بالساعة (بتظهر بس لو ليه دور بالساعة) -->
                            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHourly}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Margin="4,0,0,0">
                                        <Run Text="{Binding HourlyRoleText, Mode=OneWay}" /><Run Text=" — بيتحاسب بالساعة" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding DataContext.EditWorkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="تعديل" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AccountOff" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="إيقاف العامل" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Text="إعادة تفعيل" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- الحذف غير الإيقاف: بيمر على كلمة سر العمليات وبيتسجّل -->
                                <Button Command="{Binding DataContext.DeleteWorkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                        Foreground="{StaticResource DangerBrush}"
                                        ToolTip="شيل العامل من النظام نهائيًا — سجلاته التاريخية بتفضل محفوظة">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="حذف" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- ===== المهارات: كارت لكل منتج، بيتفتح على مراحل الخط ===== -->
                            <DockPanel Margin="0,4,0,6">
                                <!-- بيقلب بين "مهاراته" و"كل المنتجات" — مش بيفتح فورم تاني -->
                                <Button DockPanel.Dock="Left" Padding="10,5"
                                        Command="{Binding DataContext.ToggleAddSkillsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddingSkills}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="Plus" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddingSkills}" Value="True">
                                                            <Setter Property="Kind" Value="Check" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Margin="4,0,0,0" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="إضافة مهارات" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddingSkills}" Value="True">
                                                            <Setter Property="Text" Value="خلصت" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="المهارات (المراحل اللي بيعرف يعملها)" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DockPanel>

                            <!-- شريط أدوات: بحث في مهاراته + فتح/قفل الكل -->
                            <DockPanel Margin="0,0,0,7" Visibility="{Binding HasSkills, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Padding="7,5"
                                        ToolTip="فتح أو قفل كل المنتجات"
                                        Command="{Binding DataContext.ToggleAllSkillGroupsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <materialDesign:PackIcon Width="17" Height="17">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="UnfoldMoreHorizontal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllExpanded}" Value="True">
                                                        <Setter Property="Kind" Value="UnfoldLessHorizontal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                <Border Background="{StaticResource CardBgBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.2"
                                        CornerRadius="8" Padding="9,5" Margin="0,0,6,0">
                                    <Grid>
                                        <DockPanel>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                                    Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBox Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="6,0,0,0" BorderThickness="0" FontSize="12"
                                                     VerticalAlignment="Center" Background="Transparent" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding SkillSearchHint}" Margin="24,0,0,0" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SkillSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- رسالة لما مفيش مهارات مربوطة خالص -->
                            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnySkill}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="مفيش مهارات مربوطة — العامل ده مش هيظهر في أي رحلة إنتاج"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarnBrush}" />
                            </Border>

                            <!-- وضع الإضافة شغال: المستخدم لازم يعرف ليه الكروت زادت فجأة -->
                            <Border Background="{StaticResource SoftPanelBgBrush}"
                                    BorderBrush="{StaticResource BrandBrush}" BorderThickness="1.4"
                                    CornerRadius="9" Padding="9,7" Margin="0,0,0,7"
                                    Visibility="{Binding IsAddingSkills, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="15" Height="15"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="بتشوف كل منتجات المصنع — افتح أي منتج وضيف منه المراحل"
                                               FontSize="11.5" Margin="6,0,0,0" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrandBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- البحث مالوش نتيجة (مختلف عن "مفيش مهارات خالص") -->
                            <TextBlock Text="مفيش منتج أو مرحلة بالاسم ده" FontSize="12" Margin="2,4,0,6"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSkills}" Value="True" />
                                                    <Condition Binding="{Binding HasVisibleSkills}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding SkillProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Margin="0,0,0,7" BorderThickness="1.4"
                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                                    <Style.Triggers>
                                                        <!-- منتج مالوش فيه ولا مهارة (بيبان في وضع الإضافة بس) -->
                                                        <DataTrigger Binding="{Binding IsUntouched}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SoftPanelBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- ===== رأس الكارت: دوسة عليه بتفتح الخط ===== -->
                                                <Button Command="{Binding DataContext.ToggleSkillGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        BorderThickness="0" Padding="11,9" Background="Transparent">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background"
                                                                                        Value="{StaticResource SubtleBgBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>

                                                    <DockPanel>
                                                        <!-- سهم الفتح: بيلف لتحت وهو مفتوح -->
                                                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ChevronLeft"
                                                                                Width="19" Height="19" VerticalAlignment="Center"
                                                                                RenderTransformOrigin="0.5,0.5"
                                                                                Foreground="{StaticResource TextMutedBrush}">
                                                            <materialDesign:PackIcon.RenderTransform>
                                                                <RotateTransform x:Name="Chevron" Angle="0" />
                                                            </materialDesign:PackIcon.RenderTransform>
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Kind" Value="ChevronDown" />
                                                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <!-- التغطية: كام مرحلة من كام -->
                                                        <Border DockPanel.Dock="Left" CornerRadius="6" Padding="7,2" Margin="7,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource SubtleBgBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CoversWholeLine}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding CoverageText}" FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CoversWholeLine}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <!-- بيغطي الخط كله -->
                                                                <materialDesign:PackIcon Kind="StarCircle" Width="14" Height="14"
                                                                                        Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                        ToolTip="بيعرف كل مراحل الخط — يقدر يمسك المنتج لوحده"
                                                                                        Foreground="{StaticResource SuccessBrush}"
                                                                                        Visibility="{Binding CoversWholeLine, Converter={StaticResource BoolToVis}}" />
                                                                <!-- المنتج نفسه موقوف -->
                                                                <Border Background="{StaticResource DangerBgBrush}" CornerRadius="4"
                                                                        Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsProductInactive, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="منتج موقوف" FontSize="10"
                                                                               Foreground="{StaticResource DangerBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <!-- مهارات على مراحل موقوفة -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                        Visibility="{Binding HasInactiveSkills, Converter={StaticResource BoolToVis}}">
                                                                <materialDesign:PackIcon Kind="AlertOutline" Width="11" Height="11"
                                                                                        VerticalAlignment="Center"
                                                                                        Foreground="{StaticResource WarnBrush}" />
                                                                <TextBlock Text="{Binding InactiveSkillsText}" FontSize="10.5" Margin="3,0,0,0"
                                                                           Foreground="{StaticResource WarnBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>

                                                <!-- ===== جسم الكارت: مراحل الخط بترتيبها ===== -->
                                                <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="0,0,9,9"
                                                        Padding="9,7" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                  <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Stages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="7" Padding="7,5" Margin="0,1.5"
                                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <!-- مش بيعرفها: باهتة وبإطار متقطّع الإحساس -->
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                    <Setter Property="Background" Value="White" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <DockPanel>
                                                                        <!-- زرار واحد: يشيل المهارة أو يضيفها -->
                                                                        <Button DockPanel.Dock="Left"
                                                                                Command="{Binding DataContext.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                    <Setter Property="ToolTip" Value="ضيف المهارة دي للعامل" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                            <Setter Property="ToolTip" Value="شيل المهارة دي من العامل" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <materialDesign:PackIcon Width="13" Height="13">
                                                                                <materialDesign:PackIcon.Style>
                                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                                        <Setter Property="Kind" Value="Plus" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                                <Setter Property="Kind" Value="Close" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </materialDesign:PackIcon.Style>
                                                                            </materialDesign:PackIcon>
                                                                        </Button>

                                                                        <!-- رقم المرحلة في الخط -->
                                                                        <Border DockPanel.Dock="Right" Width="21" Height="21" CornerRadius="10.5"
                                                                                VerticalAlignment="Center" Margin="0,0,7,0">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding Position}" FontSize="10.5" FontWeight="Bold"
                                                                                       Foreground="White" HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>

                                                                        <!-- ===== تقييم المدير بالنجوم ===== -->
                                                                        <!-- بيظهر للمهارات اللي العامل بيعرفها بس: تقييم مرحلة
                                                                             هو مش مربوط بيها مالوش معنى -->
                                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                                                    ToolTip="{Binding RatingTooltip}"
                                                                                    Visibility="{Binding IsKnown, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel.Resources>
                                                                                <!-- نجمة واحدة: مليانة لو ضمن التقييم، فاضية لو لأ -->
                                                                                <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                                    <Setter Property="Padding" Value="1,0" />
                                                                                    <Setter Property="Width" Value="18" />
                                                                                    <Setter Property="Height" Value="18" />
                                                                                </Style>
                                                                            </StackPanel.Resources>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star1Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource CardBorderBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star1}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="#F5A623" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star2Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource CardBorderBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star2}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="#F5A623" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star3Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource CardBorderBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star3}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="#F5A623" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star4Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource CardBorderBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star4}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="#F5A623" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <Button Style="{StaticResource StarButton}"
                                                                                    Command="{Binding DataContext.SetSkillStarsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding Star5Param}">
                                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                                    <materialDesign:PackIcon.Style>
                                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                                            <Setter Property="Kind" Value="StarOutline" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource CardBorderBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Star5}" Value="True">
                                                                                                    <Setter Property="Kind" Value="Star" />
                                                                                                    <Setter Property="Foreground" Value="#F5A623" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </materialDesign:PackIcon.Style>
                                                                                </materialDesign:PackIcon>
                                                                            </Button>

                                                                            <!-- الأداء المقاس جنب النجوم — الدليل جنب الرأي -->
                                                                            <Border Background="{StaticResource ChipBgBrush}" CornerRadius="4"
                                                                                    Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding HasMeasurement, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="{Binding MeasuredText}" FontSize="10"
                                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                                            </Border>

                                                                            <!-- تنبيه إن تقييمك بعيد عن أداؤه الفعلي -->
                                                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="13" Height="13"
                                                                                                     VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                                     Foreground="{StaticResource WarnBrush}"
                                                                                                     ToolTip="تقييمك بعيد عن إنتاجه الفعلي — راجعه"
                                                                                                     Visibility="{Binding HasGapWithReality, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding StageName}" FontSize="12" TextWrapping="Wrap">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <!-- فجوة: باهت وعادي. مهارة: غامق ومتوسط -->
                                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                                                <Setter Property="FontWeight" Value="Medium" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="4"
                                                                                    Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                    ToolTip="المرحلة دي موقوفة — المهارة عليها مش هتنفع في أي رحلة إنتاج"
                                                                                    Visibility="{Binding IsStageInactive, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="موقوفة" FontSize="10"
                                                                                           Foreground="{StaticResource WarnBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- إضافة جماعية: خط من 14 مرحلة كان محتاج 14 دوسة -->
                                                    <Button Style="{StaticResource GhostButton}" Margin="0,7,0,0"
                                                            HorizontalAlignment="Stretch" Padding="8,6"
                                                            Command="{Binding DataContext.AddAllStagesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="PlaylistPlus" Width="15" Height="15"
                                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AddAllText}" Margin="6,0,0,0" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ملاحظات المهارات النصية (المرجع القديم من ملف الإكسل) -->
                            <TextBlock Text="ملاحظات المهارات (المرجع النصي)" FontWeight="Bold" Margin="0,4,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SkillsNotes}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SkillsNotes}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SkillsNotes}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ===== الهستوري الأسبوعي: كارت لكل أسبوع، بيتفتح على تفاصيله ===== -->
                            <TextBlock Text="الهستوري الأسبوعي (آخر 8 أسابيع)" FontWeight="Bold" Margin="0,10,0,6" />
                            <ItemsControl ItemsSource="{Binding WeeklyHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Margin="0,0,0,6" Background="White"
                                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.4">
                                            <StackPanel>
                                                <!-- ===== رأس الكارت ===== -->
                                                <Button Command="{Binding DataContext.ToggleWeekCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Stretch" Padding="11,9">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background"
                                                                                        Value="{StaticResource SubtleBgBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <!-- أسبوع فاضي: مفيش تفاصيل تتفتح -->
                                                                <DataTrigger Binding="{Binding IsEmptyWeek}" Value="True">
                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <DockPanel>
                                                        <materialDesign:PackIcon DockPanel.Dock="Left" Width="18" Height="18"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{StaticResource TextMutedBrush}">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="ChevronLeft" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Kind" Value="ChevronDown" />
                                                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsEmptyWeek}" Value="True">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <!-- الأجر: الرقم اللي بيتسأل عنه -->
                                                        <TextBlock DockPanel.Dock="Left" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   Text="{Binding WageText}"
                                                                   Visibility="{Binding HasWage, Converter={StaticResource BoolToVis}}" />

                                                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Star" Width="14" Height="14"
                                                                                        VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                        ToolTip="أحسن عامل في الأسبوع ده"
                                                                                        Foreground="{StaticResource AccentBrush}"
                                                                                        Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding WeekTitle}" FontSize="12.5" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <Border Background="{StaticResource ChipBgBrush}" CornerRadius="4"
                                                                        Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasRelativeLabel, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding RelativeLabel}" FontSize="10"
                                                                               Foreground="{StaticResource BrandBrush}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- سطر الصافي: الرقم الحقيقي اللي بيتحاسب عليه -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="صافي" FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding NetText}" FontSize="12.5" FontWeight="Bold"
                                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource BrandBrush}" />
                                                                <TextBlock Text="يومية" FontSize="11" Margin="3,0,0,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="مفيش شغل الأسبوع ده" FontSize="11" Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Visibility="{Binding IsEmptyWeek, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>

                                                <!-- ===== جسم الكارت ===== -->
                                                <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="0,0,9,9"
                                                        Padding="10,8"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <!-- الحسبة: أنتج − غياب − جزاءات = صافي -->
                                                        <UniformGrid Columns="4" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ProducedText}" FontSize="14" FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="أنتج" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="0" />
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasAbsence}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding AbsenceText}" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="غياب" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="0" />
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasPenaltyDeduction}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding PenaltyText}" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="جزاءات" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding NetText}" FontSize="14" FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource BrandBrush}" />
                                                                <TextBlock Text="الصافي" FontSize="10.5" HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <!-- اشتغل على: صف لكل مرحلة، الأعلى إنتاجًا فوق -->
                                                        <StackPanel Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="اشتغل على" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <ItemsControl ItemsSource="{Binding Breakdown}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="White" CornerRadius="6" Padding="7,4" Margin="0,1.5">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PiecesText}"
                                                                                           FontSize="11.5" FontWeight="Bold"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding StageName}" FontSize="11.5"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                                    <TextBlock Text="{Binding ProductName}" FontSize="10.5"
                                                                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- الجزاءات بأسبابها -->
                                                        <StackPanel Margin="0,8,0,0"
                                                                    Visibility="{Binding HasPenalties, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="جزاءات الأسبوع" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                                                                       Foreground="{StaticResource DangerBrush}" />
                                                            <ItemsControl ItemsSource="{Binding Penalties}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{StaticResource DangerBgBrush}" CornerRadius="6"
                                                                                Padding="7,4" Margin="0,1.5">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding DeductionName}"
                                                                                           FontSize="11" FontWeight="Bold"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{StaticResource DangerBrush}" />
                                                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding Reason}" FontSize="11.5"
                                                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                                    <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                                                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
