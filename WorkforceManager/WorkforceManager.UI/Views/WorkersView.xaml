<UserControl x:Class="WorkforceManager.UI.Views.WorkersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة العمال: شريط أدوات فوق + جدول العمال في النص + لوحة تفاصيل (بروفايل) على الجنب -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط الأدوات: بحث موحّد + إظهار الموقوفين + زرار الإضافة -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding AddWorkerCommand}"
                        Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="إضافة عامل جديد" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <CheckBox DockPanel.Dock="Left" Content="إظهار الموقوفين"
                          IsChecked="{Binding ShowInactive}"
                          VerticalAlignment="Center" Margin="16,0" />

                <Button DockPanel.Dock="Right" Command="{Binding SearchCommand}"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="بحث" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- البحث الموحّد: بالاسم أو بالمهارة/المرحلة — Enter بينفذ البحث مباشرة -->
                <TextBox VerticalAlignment="Center" Padding="8,6" FontSize="14"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- عنوان الأسبوع الحالي -->
        <TextBlock Grid.Row="1" Text="{Binding WeekTitle}"
                   FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,4,6" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- جدول العمال بإحصائيات الأسبوع الحالي -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
            <DataGrid ItemsSource="{Binding Workers}"
                      SelectedItem="{Binding SelectedWorker}"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <!--
                  عرض الأعمدة: اسم العامل هو أهم عمود في الشاشة فمداه * بحد أدنى
                  يمنعه إنه يتقلّص لحرفين لما الأعمدة الرقمية تاخد المساحة.
                  أعمدة الأرقام اتضبطت على عرض محتواها الفعلي (أرقام صغيرة زي 0
                  و1.5) والعناوين اتقصّرت مع ToolTip بالنص الكامل — الفرق ده
                  بيرجّع للاسم مساحة كافية يظهر كامل.
                -->
                <DataGrid.Columns>
                    <!-- عمود نجمة أفضل عامل: العنوان أيقونة فيكتور مش إيموچي —
                         خط الواجهة مفيهوش رموز إيموچي فكان بيرسمها نجمة باهتة -->
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.Header>
                            <materialDesign:PackIcon Kind="Star" Width="15" Height="15"
                                                     Foreground="{StaticResource AccentBrush}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BestMark}" VerticalAlignment="Center" Margin="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="اسم العامل" Binding="{Binding FullName}" Width="*" MinWidth="150" />
                    <DataGridTextColumn Header="الكود" Binding="{Binding EmployeeCode}" Width="66" />
                    <DataGridTextColumn Header="حضور" Binding="{Binding PresentDays}" Width="66" />
                    <DataGridTextColumn Header="بإذن" Binding="{Binding AbsentWithPermissionDays}" Width="54">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridHeader}">
                                <Setter Property="ToolTip" Value="غياب بإذن" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="بدون إذن" Binding="{Binding AbsentWithoutPermissionDays}" Width="72">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridHeader}">
                                <Setter Property="ToolTip" Value="غياب بدون إذن" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="جزاءات" Binding="{Binding PenaltyDeduction}" Width="64">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridHeader}">
                                <Setter Property="ToolTip" Value="خصم جزاءات" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetWorkdays}" Width="64">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridHeader}">
                                <Setter Property="ToolTip" Value="صافي اليوميات" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="72" />
                </DataGrid.Columns>
                <!-- تمييز الصف حسب الحالة: الموقوف رمادي باهت (مبني على النمط الموحد) -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            </Border>

            <!-- لوحة التفاصيل (بروفايل العامل المحدد) -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <Grid>
                    <!-- رسالة لما مفيش عامل محدد -->
                    <TextBlock Text="اختار عامل من الجدول لعرض ملفه الكامل"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Detail}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- رأس البروفايل + أزرار الإدارة -->
                            <TextBlock Text="{Binding FullName}" Style="{StaticResource HeadingText}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,4">
                                <Run Text="الكود: " /><Run Text="{Binding EmployeeCode, Mode=OneWay}" />
                                <Run Text="   تليفون: " /><Run Text="{Binding PhoneNumber, Mode=OneWay}" />
                                <Run Text="   التحق: " /><Run Text="{Binding HireDateText, Mode=OneWay}" />
                            </TextBlock>

                            <!-- سعر اليومية بالجنيه -->
                            <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Right" Margin="0,0,0,4">
                                <TextBlock Text="{Binding WageText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </Border>

                            <!-- شارة العامل بالساعة (بتظهر بس لو ليه دور بالساعة) -->
                            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHourly}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Margin="4,0,0,0">
                                        <Run Text="{Binding HourlyRoleText, Mode=OneWay}" /><Run Text=" — بيتحاسب بالساعة" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding DataContext.EditWorkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="تعديل" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AccountOff" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="إيقاف العامل" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Text="إعادة تفعيل" Margin="5,0,0,0" />
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- المهارات -->
                            <TextBlock Text="المهارات (المراحل اللي بيعرف يعملها)" FontWeight="Bold" Margin="0,4,0,4" />
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ChipBgBrush}" CornerRadius="7" Padding="7,4" Margin="0,2">
                                            <DockPanel>
                                                <!-- زرار شيل المهارة -->
                                                <Button DockPanel.Dock="Left" Foreground="{StaticResource DangerBrush}"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Close" Width="11" Height="11" />
                                                </Button>
                                                <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- إضافة مهارة جديدة -->
                            <DockPanel Margin="0,6,0,10">
                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.AddSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="إضافة" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ComboBox ItemsSource="{Binding StageOptions}"
                                          SelectedItem="{Binding SelectedStageOption}"
                                          DisplayMemberPath="Display" Margin="0,0,6,0" FontSize="12" />
                            </DockPanel>

                            <!-- ملاحظات المهارات النصية (المرجع القديم من ملف الإكسل) -->
                            <TextBlock Text="ملاحظات المهارات (المرجع النصي)" FontWeight="Bold" Margin="0,4,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SkillsNotes}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SkillsNotes}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SkillsNotes}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- الهستوري الأسبوعي -->
                            <TextBlock Text="الهستوري الأسبوعي (آخر 8 أسابيع)" FontWeight="Bold" Margin="0,4,0,4" />
                            <ItemsControl ItemsSource="{Binding WeeklyHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                    <Run Text="{Binding BestMark, Mode=OneWay}" />
                                                    <Run Text="{Binding WeekTitle, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                    <Run Text="أنتج: " /><Run Text="{Binding Produced, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text="   خصم غياب: " /><Run Text="{Binding AbsenceDeduction, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" />
                                                    <Run Text="   خصم جزاءات: " /><Run Text="{Binding PenaltyDeduction, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" />
                                                    <Run Text="   الصافي: " /><Run Text="{Binding Net, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                                </TextBlock>
                                                <!-- أجر الأسبوع بالجنيه (لو ليه سعر يومية) -->
                                                <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="💵 الأجر: " /><Run Text="{Binding WageText, Mode=OneWay}" />
                                                </TextBlock>
                                                <!-- تفاصيل الإنتاج (لو فيه) -->
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                           Text="{Binding BreakdownText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBreakdown}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- الجزاءات بأسبابها (لو فيه) -->
                                                <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPenalties}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="جزاءات: " /><Run Text="{Binding PenaltiesText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
