<Window x:Class="WorkforceManager.UI.Views.InitialBalanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إضافة رصيد أولي"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="HeaderText" Text="إضافة رصيد أولي" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="اسم الرصيد (إجباري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" />

                <TextBlock Text="عدد القطع (إجباري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="QuantityBox" Margin="0,0,0,12" />

                <TextBlock Text="تاريخ الرصيد الأصلي" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="OriginalDatePicker" Margin="0,0,0,12" />

                <TextBlock Text="ملاحظات (اختياري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NotesBox" Margin="0,0,0,16" TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                         VerticalScrollBarVisibility="Auto" />

                <StackPanel x:Name="RangesSection" Margin="0,0,0,16">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="النطاقات والمراحل (اختياري)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" HorizontalAlignment="Right" Click="AddRange_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة نطاق" Margin="4,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <ItemsControl x:Name="RangesListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="من" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,4,0" />
                                            <ComboBox ItemsSource="{Binding Stages}" SelectedItem="{Binding FromStage}" DisplayMemberPath="Name" Width="120" FontSize="12" />
                                            <TextBlock Text="إلى" VerticalAlignment="Center" FontSize="12.5" Margin="8,0,4,0" />
                                            <ComboBox ItemsSource="{Binding Stages}" SelectedItem="{Binding ToStage}" DisplayMemberPath="Name" Width="120" FontSize="12" />
                                        </StackPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="عدد القطع:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerBrush}" Padding="6,4" Click="RemoveRange_Click">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                                            </Button>
                                            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Padding="4,2" FontSize="13" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
