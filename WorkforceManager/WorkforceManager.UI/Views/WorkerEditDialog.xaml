<Window x:Class="WorkforceManager.UI.Views.WorkerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إضافة عامل جديد"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة إضافة/تعديل عامل: نفس الفورم للحالتين، بيتملى مسبقًا في حالة التعديل —
         بطاقة عائمة بلا إطار نظام زي شاشة الدخول، بشريط علوي بلون البراند -->
    <Border CornerRadius="18" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource BrandBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="White"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="White" FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="اسم العامل (إجباري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" />

                <TextBlock Text="رقم التليفون" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PhoneBox" Margin="0,0,0,12" />

                <TextBlock Text="تاريخ الالتحاق" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="HireDatePicker" Margin="0,0,0,12" />

                <TextBlock Text="سعر اليومية بالجنيه" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="WageBox" Margin="0,0,0,4" />
                <TextBlock Text="الأجر = صافي اليوميات × السعر ده. سيبه 0 لحد ما تحدد سعر العامل."
                           Style="{StaticResource HintText}" Margin="0,0,0,12" />

                <TextBlock Text="نوع الحساب" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="HourlyRoleBox" Margin="0,0,0,4"
                          DisplayMemberPath="Display" SelectedValuePath="Role" />
                <TextBlock Text="عامل الإنتاج بيتحاسب بالقطعة (من مهاراته). العامل بالساعة (رص/جودة/تدريب) بيتحاسب بالساعات ويظهر في تبويب منفصل."
                           Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <!-- صورة العامل (اختيارية): معاينة دايرية + اختيار + إزالة.
                     خانة "ملاحظات المهارات" كانت هنا واتشالت — مهارات العامل
                     بقت تتقاس بالنجوم لكل مرحلة، وبتتعرض في بروفايله ككروت
                     محسوبة بدل نص حر محدش بيقراه. -->
                <TextBlock Text="صورة العامل (اختيارية)" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="72" Height="72" CornerRadius="36"
                            Background="{StaticResource SubtleBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.4"
                            Margin="0,0,12,0">
                        <Grid>
                            <materialDesign:PackIcon x:Name="NoPhotoIcon" Kind="AccountPlus" Width="26" Height="26"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{StaticResource TextMutedBrush}" />
                            <Image x:Name="PhotoPreview" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="36,36" RadiusX="35" RadiusY="35" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <Button Click="PickPhoto_Click" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderImage" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="اختار صورة" Margin="5,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemovePhotoButton" Click="RemovePhoto_Click"
                                Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="شيل الصورة" Margin="5,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- رسالة الخطأ (بتظهر لو الاسم فاضي مثلاً) -->
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
