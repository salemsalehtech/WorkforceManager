<Window x:Class="WorkforceManager.UI.Views.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إضافة منتج جديد"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة إضافة/تعديل منتج: نفس الفورم للحالتين، بيتملى مسبقًا في التعديل —
         بطاقة عائمة بلا إطار نظام زي شاشة الدخول، بشريط علوي بلون البراند -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="اسم المنتج (إجباري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" />

                <TextBlock Text="وصف (اختياري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DescriptionBox" Margin="0,0,0,14"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                         VerticalScrollBarVisibility="Auto" />

                <!-- صورة المنتج (اختيارية): معاينة + اختيار + إزالة -->
                <TextBlock Text="صورة المنتج (اختيارية)" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <!-- المعاينة: الصورة لو موجودة، وإلا مربع فاضي بأيقونة -->
                    <Border Width="72" Height="72" CornerRadius="12"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.4"
                            Margin="0,0,12,0">
                        <Grid>
                            <materialDesign:PackIcon x:Name="NoImageIcon" Kind="ImagePlus" Width="26" Height="26"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextMutedBrush}" />
                            <Image x:Name="ImagePreview" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,72,72" RadiusX="11" RadiusY="11" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <Button Click="PickImage_Click" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderImage" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="اختار صورة" Margin="5,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoveImageButton" Click="RemoveImage_Click"
                                Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="شيل الصورة" Margin="5,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
