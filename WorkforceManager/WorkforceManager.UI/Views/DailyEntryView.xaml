<UserControl x:Class="WorkforceManager.UI.Views.DailyEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة التسجيل اليومي: اختيار اليوم فوق + 3 تبويبات (رحلة الإنتاج / حضور / جزاءات) لنفس اليوم -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- اختيار اليوم (مشترك لكل التبويبات) + قفل إنتاج اليوم -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel>
                <!-- زرار القفل: بيقلب لـ "فتح اليوم" لما اليوم يبقى مقفول -->
                <Button DockPanel.Dock="Left" Padding="14,7"
                        Command="{Binding ToggleDayClosureCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDayClosed}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="LockOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDayClosed}" Value="True">
                                            <Setter Property="Kind" Value="LockOpenVariantOutline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Margin="6,0,0,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="قفل إنتاج اليوم" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDayClosed}" Value="True">
                                            <Setter Property="Text" Value="فتح اليوم تاني" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="17" Height="17"
                                             Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="اليوم:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding EntryDate}" Width="160" VerticalAlignment="Center" />

                    <!-- اليوم مقفول: التسجيل موقوف -->
                    <Border Background="{StaticResource DangerBgBrush}" CornerRadius="6" Padding="9,4"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsDayClosed, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOutline" Width="13" Height="13"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="اليوم مقفول — مفيش تسجيل إنتاج جديد" FontSize="11.5" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- فيه شغل واقف هيترحّل -->
                    <Border Background="{StaticResource WarnBgBrush}" CornerRadius="6" Padding="9,4"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasCarriedWork, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="13" Height="13"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource WarnBrush}" />
                            <TextBlock Text="{Binding CarriedSummary}" FontSize="11.5" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource WarnBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1">

            <!-- ============ تبويب رحلات الإنتاج (منتج أو أكتر في نفس اليوم) ============ -->
            <TabItem Header="  تسجيل الإنتاج  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ملخص اللي اتسجل النهارده + إضافة منتج تاني -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding AddFlowSessionCommand}"
                                    Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="إضافة منتج" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- رسالة لما لسه مفيش إنتاج مسجل في اليوم -->
                            <TextBlock DockPanel.Dock="Right" Text="لسه مفيش إنتاج مسجل النهارده"
                                       FontSize="12.5" VerticalAlignment="Center" Margin="18,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding DayHasNoProduction, Converter={StaticResource BoolToVis}}" />

                            <!-- أرقام اليوم (بتظهر بس لما يكون فيه إنتاج) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DayHasNoProduction}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayTotalPieces, StringFormat={}{0:N0}}"
                                               Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="قطعة النهارده" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <Border Style="{StaticResource SummaryDivider}" />

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayTotalWorkdays}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="يومية" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayWorkersCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="عامل" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayProductsCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="منتج" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- رحلة لكل منتج، تحت بعض -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FlowSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- بطاقة رحلة منتج واحد -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,4,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- رأس الرحلة: اختيار المنتج + إزالة الرحلة -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="المنتج:" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Products}"
                                                          SelectedItem="{Binding SelectedProduct}"
                                                          DisplayMemberPath="Name" Width="200" />
                                                <Button DockPanel.Dock="Right" Foreground="{StaticResource DangerBrush}"
                                                        Style="{StaticResource IconButton}" Padding="8,4"
                                                        ToolTip="إزالة رحلة المنتج ده من الشاشة (اللي اتحفظ قبل كده محفوظ عادي)"
                                                        Command="{Binding DataContext.RemoveFlowSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="إزالة المنتج" FontSize="12" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- تكرار توزيع آخر يوم شغل على المنتج ده -->
                                                <Button DockPanel.Dock="Left" Margin="10,0,0,0"
                                                        Style="{StaticResource GhostButton}" Padding="12,6"
                                                        ToolTip="يجيب نفس العمال على نفس المراحل من آخر يوم اشتغل فيه المنتج ده (من غير الأعداد)"
                                                        Command="{Binding RepeatLastDayCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="كرّر يوم فات" Margin="5,0,0,0" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- عدّاد الجاهزية: كام مرحلة تمام من اللي داخلة النهارده -->
                                                <Border DockPanel.Dock="Left" CornerRadius="8" Padding="10,5" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SubtleBgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllReady}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="ProgressClock" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AllReady}" Value="True">
                                                                            <Setter Property="Kind" Value="CheckCircle" />
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock Text="{Binding ReadinessText}" FontSize="12" FontWeight="Medium"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AllReady}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>

                                            <!-- الشغل المستني في الخط — أول حاجة المستخدم لازم يشوفها -->
                                            <Border DockPanel.Dock="Top" Background="{StaticResource WarnBgBrush}"
                                                    BorderBrush="{StaticResource WarnBrush}" BorderThickness="1.2"
                                                    CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                                                    Visibility="{Binding HasParkedPieces, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="16" Height="16"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{StaticResource WarnBrush}" />
                                                    <TextBlock Text="{Binding ParkedPiecesText}" FontSize="12" FontWeight="Medium"
                                                               Margin="6,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{StaticResource WarnBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="380" />
                                                </Grid.ColumnDefinitions>

                                                <!-- عمود المراحل -->
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- رسالة لما لسه مفيش منتج مختار للرحلة دي -->
                                                    <TextBlock Grid.Row="0" Text="اختار المنتج من فوق عشان مراحله تظهر هنا"
                                                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="4,10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- تحذيرات لحظية (تداخل نطاقات / توزيع مش مظبوط) قبل الحفظ -->
                                                    <TextBlock Grid.Row="0" Text="{Binding FlowWarning}"
                                                               Foreground="{StaticResource WarnBrush}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Margin="4,0,4,6">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FlowWarning}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- بطاقات المراحل -->
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding FlowStages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource SoftPanelBgBrush}" BorderBrush="{StaticResource SoftPanelBorderBrush}" BorderThickness="1"
                                                                        CornerRadius="8" Padding="0" Margin="0,0,4,6">
                                                                  <DockPanel>
                                                                    <!-- شريط حالة المرحلة: لون واحد بيقول جاهزة/ناقصة من بعيد -->
                                                                    <Border DockPanel.Dock="Left" Width="5" CornerRadius="3,0,0,3"
                                                                            Background="{Binding StateColor}" />

                                                                    <StackPanel Margin="10,8">
                                                                        <!-- رأس البطاقة: رقم الترتيب + الاسم + اليومية + إنتاج المرحلة المحسوب -->
                                                                        <DockPanel>
                                                                            <Border DockPanel.Dock="Left" Background="{StaticResource BrandBrush}" CornerRadius="12"
                                                                                    Width="24" Height="24" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DisplayOrder}" Foreground="White" FontSize="12"
                                                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <!-- بادج إنتاج المرحلة (بيظهر بس لما المرحلة تدخل في نطاق) -->
                                                                            <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBgBrush}" CornerRadius="4"
                                                                                    Padding="8,3" VerticalAlignment="Center">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ComputedPieces}" Value="0">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding ComputedPieces, StringFormat='الإنتاج: {0} قطعة'}"
                                                                                           Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="12.5" />
                                                                            </Border>

                                                                            <TextBlock Text="{Binding StageName}" FontWeight="Bold" FontSize="14"
                                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                            <TextBlock Text="{Binding QuotaText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0" />

                                                                            <!-- القطع المستنية المرحلة دي — بتقول للمستخدم يحط عماله فين -->
                                                                            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="5" Padding="6,2"
                                                                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                    Visibility="{Binding HasWaitingPieces, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="{Binding WaitingText}" Foreground="{StaticResource WarnBrush}"
                                                                                           FontSize="11.5" FontWeight="SemiBold" />
                                                                            </Border>

                                                                            <TextBlock Text="{Binding AlreadyText}" Foreground="{StaticResource WarnBrush}" FontSize="11.5"
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0" />

                                                                            <!-- حالة المرحلة بالنص (جاهزة / محتاجة عمال / التوزيع مش مظبوط) -->
                                                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                                                                       Foreground="{Binding StateColor}"
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                       Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}" />
                                                                        </DockPanel>

                                                                        <!-- العمال المتوزعين على المرحلة (Chips بنصيب كل واحد) -->
                                                                        <ItemsControl ItemsSource="{Binding AssignedWorkers}" Margin="0,6,0,0">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{StaticResource ChipBgBrush}" CornerRadius="4" Padding="6,3" Margin="0,2,4,2">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <!-- أمر الإزالة على الشريحة نفسها (callback للرحلة) -->
                                                                                            <Button Foreground="{StaticResource DangerBrush}"
                                                                                                    Style="{StaticResource IconButton}"
                                                                                                    ToolTip="إزالة العامل من المرحلة"
                                                                                                    Command="{Binding RemoveCommand}">
                                                                                                <materialDesign:PackIcon Kind="Close" Width="10" Height="10" />
                                                                                            </Button>
                                                                                            <TextBlock Text="{Binding WorkerName}" FontSize="12.5"
                                                                                                       VerticalAlignment="Center" Margin="4,0,6,0" />
                                                                                            <!-- نصيب العامل: بيتملى تلقائي بالتساوي وينفع يتعدل يدوي -->
                                                                                            <TextBox Text="{Binding SharePieces, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     Width="55" FontSize="12.5" Padding="4,1"
                                                                                                     VerticalContentAlignment="Center"
                                                                                                     ToolTip="عدد القطع لهذا العامل (اتوزع تلقائيًا — عدّله لو التوزيع مش بالتساوي)" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- إضافة عامل للمرحلة (المؤهلين بس): خانة بحث واحدة والاقتراحات
                                                                             بتنزل تحتيها مع أول حرف. الاختيار بالسهمين + Enter من غير ماوس. -->
                                                                        <StackPanel x:Name="WorkerPickerRoot" Margin="0,4,0,0">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasNoQualified}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>

                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Border Background="{StaticResource CardBgBrush}"
                                                                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.2"
                                                                                        CornerRadius="6" Padding="7,4" Width="240" Margin="0,0,6,0">
                                                                                    <Grid>
                                                                                        <DockPanel>
                                                                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                                                                                    Width="13" Height="13" VerticalAlignment="Center"
                                                                                                                    Foreground="{StaticResource TextMutedBrush}" />
                                                                                            <TextBox Text="{Binding WorkerSearch, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     Margin="5,0,0,0" BorderThickness="0" FontSize="12.5"
                                                                                                     VerticalAlignment="Center" Background="Transparent"
                                                                                                     ToolTip="اكتب أول حروف اسم العامل — الأسهم ▲▼ للاختيار وEnter للإضافة"
                                                                                                     PreviewKeyDown="WorkerSearch_PreviewKeyDown" />
                                                                                        </DockPanel>
                                                                                        <TextBlock Text="البحث" Margin="22,0,0,0" IsHitTestVisible="False"
                                                                                                   VerticalAlignment="Center" FontSize="12.5"
                                                                                                   Foreground="{StaticResource TextMutedBrush}">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding WorkerSearch}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- أمر الإضافة على البطاقة نفسها (callback للرحلة) -->
                                                                                <Button FontSize="12.5"
                                                                                        Style="{StaticResource GhostButton}" Padding="10,4"
                                                                                        Command="{Binding AddWorkerCommand}">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="عامل" Margin="4,0,0,0" />
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <!-- الاقتراحات: بتظهر بس والفوكس جوه الخانة، فالبطاقة مبتفضلش
                                                                                 مفرودة بقايمة ٢٠ عامل وانت مش بتدوّر أصلاً -->
                                                                            <Border Width="240" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                                                    Background="White" CornerRadius="6"
                                                                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.2">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=WorkerPickerRoot}" Value="True" />
                                                                                                    <Condition Binding="{Binding HasSuggestions}" Value="True" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <!-- القايمة مرتبة بالتقييم: الأحسن على المرحلة دي الأول -->
                                                                                <ListBox ItemsSource="{Binding VisibleWorkers}"
                                                                                         SelectedItem="{Binding SelectedWorkerToAdd}"
                                                                                         MaxHeight="150" FontSize="12.5"
                                                                                         BorderThickness="0" Background="Transparent"
                                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                                         SelectionChanged="Suggestions_SelectionChanged"
                                                                                         PreviewMouseLeftButtonUp="Suggestions_Click">
                                                                                    <ListBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <DockPanel LastChildFill="False" MinWidth="180"
                                                                                                       ToolTip="{Binding RatingTooltip}">
                                                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />

                                                                                                <!-- شارة التقييم: أخضر فوق الكوتة، أصفر تحتها -->
                                                                                                <Border DockPanel.Dock="Left" CornerRadius="4"
                                                                                                        Padding="5,1" Margin="8,0,0,0"
                                                                                                        VerticalAlignment="Center">
                                                                                                    <Border.Style>
                                                                                                        <Style TargetType="Border">
                                                                                                            <Setter Property="Background" Value="{StaticResource ChipBgBrush}" />
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding IsAboveQuota}" Value="True">
                                                                                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                                                                                </DataTrigger>
                                                                                                                <DataTrigger Binding="{Binding IsBelowQuota}" Value="True">
                                                                                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </Border.Style>
                                                                                                    <TextBlock Text="{Binding RatingText}" FontSize="10.5" FontWeight="SemiBold">
                                                                                                        <TextBlock.Style>
                                                                                                            <Style TargetType="TextBlock">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                                                                <Style.Triggers>
                                                                                                                    <DataTrigger Binding="{Binding IsAboveQuota}" Value="True">
                                                                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                                                    </DataTrigger>
                                                                                                                    <DataTrigger Binding="{Binding IsBelowQuota}" Value="True">
                                                                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                                                                    </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                            </Style>
                                                                                                        </TextBlock.Style>
                                                                                                    </TextBlock>
                                                                                                </Border>
                                                                                            </DockPanel>
                                                                                        </DataTemplate>
                                                                                    </ListBox.ItemTemplate>
                                                                                </ListBox>
                                                                            </Border>

                                                                            <!-- كتب اسم مش موجود: يعرف علطول بدل ما يستنى قايمة متظهرش -->
                                                                            <TextBlock Text="مفيش عامل مؤهل بالاسم ده"
                                                                                       FontSize="11.5" Margin="2,3,0,0"
                                                                                       Foreground="{StaticResource WarnBrush}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasNoMatch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <!-- مفيش مؤهلين: المرحلة محتاجة ربط مهارات الأول (قرار: المؤهلين بس إجباري) -->
                                                                        <TextBlock Text="لا يوجد عمال مؤهلون لهذه المرحلة — اربط المهارة من شاشة العمال الأول"
                                                                                   Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasNoQualified}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                  </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>

                                                <!-- عمود توزيع الإنتاج + المعاينة + الحفظ (خاص بالرحلة دي) -->
                                                <Border Grid.Column="1" Background="{StaticResource SoftPanelBgBrush}"
                                                        BorderBrush="{StaticResource SoftPanelBorderBrush}" BorderThickness="1"
                                                        CornerRadius="10" Margin="8,0,0,0" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock Text="توزيع الإنتاج على المراحل" FontWeight="Bold"
                                                                   FontSize="14" Foreground="{StaticResource BrandBrush}" />
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8"
                                                                   Text="اكتب: من أنهي مرحلة لأنهي مرحلة اتنتج كام قطعة. النطاق الجاهز بيغطي كل المراحل — عدّله أو ضيف نطاقات تانية لو الإنتاج وقف عند مرحلة معينة." />

                                                        <!-- نطاقات الإنتاج -->
                                                        <ItemsControl ItemsSource="{Binding FlowRanges}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                                            CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="من" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,4,0" />
                                                                                <ComboBox ItemsSource="{Binding StageOptions}" SelectedItem="{Binding FromStage}"
                                                                                          DisplayMemberPath="Display" Width="120" FontSize="12" />
                                                                                <TextBlock Text="إلى" VerticalAlignment="Center" FontSize="12.5" Margin="8,0,4,0" />
                                                                                <ComboBox ItemsSource="{Binding StageOptions}" SelectedItem="{Binding ToStage}"
                                                                                          DisplayMemberPath="Display" Width="120" FontSize="12" />
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                                <TextBlock Text="عدد القطع:" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,6,0" />
                                                                                <TextBox Text="{Binding PiecesText, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Width="90" Padding="6,3" FontSize="13" VerticalContentAlignment="Center" />
                                                                                <!-- أمر الحذف على السطر نفسه (callback للرحلة) -->
                                                                                <Button Margin="10,0,0,0"
                                                                                        Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}"
                                                                                        ToolTip="حذف النطاق"
                                                                                        Command="{Binding RemoveCommand}">
                                                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Command="{Binding AddRangeCommand}"
                                                                Style="{StaticResource GhostButton}" FontSize="12.5"
                                                                HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                                                <TextBlock Text="إضافة نطاق تاني" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- معاينة اليوميات قبل الحفظ -->
                                                        <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="8" Padding="10">
                                                            <StackPanel>
                                                                <TextBlock Text="معاينة اليوميات قبل الحفظ" FontWeight="Bold" FontSize="13"
                                                                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4" />
                                                                <TextBlock Text="لسه مفيش توزيع — اختار العمال واكتب أعداد النطاقات"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FlowPreview.Count}" Value="0">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl ItemsSource="{Binding FlowPreview}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock FontSize="12.5" Margin="0,2">
                                                                                <Run Text="• " />
                                                                                <Run Text="{Binding WorkerName, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                <Run Text="{Binding TotalPieces, Mode=OneWay, StringFormat=': {0} قطعة'}" />
                                                                                <Run Text="{Binding TotalWorkdays, Mode=OneWay, StringFormat='≈ {0} يومية'}"
                                                                                     Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- حفظ رحلة المنتج ده -->
                                                        <Button Command="{Binding SaveFlowCommand}"
                                                                Style="{StaticResource PrimaryButton}" FontSize="14"
                                                                Margin="0,10,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                                                <TextBlock Text="حفظ رحلة الإنتاج" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ تبويب سجلات اليوم (المراجعة والتصحيح) ============ -->
            <TabItem Header="  سجلات اليوم  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}" FontSize="12.5" Margin="4,0,4,8"
                               Text="كل سجلات الإنتاج المحفوظة في اليوم المختار — لو فيه رقم اتحفظ بالغلط صححه أو امسحه من هنا، واليوميات هتتظبط في كل الحسابات فورًا." />

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <!-- رسالة لما مفيش سجلات في اليوم -->
                            <TextBlock Text="مفيش سجلات إنتاج محفوظة في اليوم ده"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DayRecords.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DataGrid ItemsSource="{Binding DayRecords}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم العامل" Binding="{Binding WorkerName}" Width="*" />
                                    <DataGridTextColumn Header="المنتج / المرحلة" Binding="{Binding StageDisplay}" Width="*" />
                                    <DataGridTextColumn Header="القطع" Binding="{Binding PieceCount}" Width="90" />
                                    <DataGridTextColumn Header="يومية وقتها" Binding="{Binding QuotaAtEntry}" Width="90" />
                                    <DataGridTextColumn Header="اليوميات" Binding="{Binding Workdays}" Width="80" />
                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,4,0"
                                                            Style="{StaticResource IconButton}" Foreground="{StaticResource BrandBrush}"
                                                            ToolTip="تعديل عدد القطع"
                                                            Command="{Binding DataContext.EditDayRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="13" Height="13" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}"
                                                            ToolTip="حذف السجل نهائيًا"
                                                            Command="{Binding DataContext.DeleteDayRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب الحضور الموحّد (بالقطعة + بالساعة) ============ -->
            <TabItem Header="  الحضور والغياب  ">
                <Grid Margin="14,10,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== شريط الملخص: حالة اليوم كلها بنظرة واحدة ===== -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                        <!--
                          كل عدّاد زرار بيفتح قسمه في القائمة اللي تحت.
                          Tag = لون القسم (النمط بياخد منه التظليل والخط السفلي)،
                          وIsChecked مربوط بحالة الفلتر في الـ ViewModel فالمفتوح بيبان.
                        -->
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource SummaryChip}"
                                          Tag="{StaticResource BrandBrush}"
                                          IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                          Command="{Binding SetAttendanceFilterCommand}"
                                          CommandParameter="{x:Static vm:AttendanceFilter.All}"
                                          ToolTip="عرض كل العمال">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalWorkersCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="إجمالي العمال" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </ToggleButton>

                            <Border Style="{StaticResource SummaryDivider}" Margin="6,4,12,4" />

                            <ToggleButton Style="{StaticResource SummaryChip}"
                                          Tag="{StaticResource SuccessBrush}"
                                          IsChecked="{Binding IsFilterPresent, Mode=OneWay}"
                                          Command="{Binding SetAttendanceFilterCommand}"
                                          CommandParameter="{x:Static vm:AttendanceFilter.Present}"
                                          ToolTip="عرض الحاضرين بس">
                                <StackPanel>
                                    <TextBlock Text="{Binding PresentCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="حاضر" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource SummaryChip}"
                                          Tag="{StaticResource WarnBrush}"
                                          IsChecked="{Binding IsFilterExcused, Mode=OneWay}"
                                          Command="{Binding SetAttendanceFilterCommand}"
                                          CommandParameter="{x:Static vm:AttendanceFilter.Excused}"
                                          ToolTip="عرض الغايبين بإذن بس">
                                <StackPanel>
                                    <TextBlock Text="{Binding ExcusedCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource WarnBrush}" />
                                    <TextBlock Text="غياب بإذن" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource SummaryChip}"
                                          Tag="{StaticResource DangerBrush}"
                                          IsChecked="{Binding IsFilterUnexcused, Mode=OneWay}"
                                          Command="{Binding SetAttendanceFilterCommand}"
                                          CommandParameter="{x:Static vm:AttendanceFilter.Unexcused}"
                                          ToolTip="عرض الغايبين بدون إذن بس">
                                <StackPanel>
                                    <TextBlock Text="{Binding UnexcusedCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="بدون إذن" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource SummaryChip}"
                                          Tag="{StaticResource TextMutedBrush}"
                                          IsChecked="{Binding IsFilterUnset, Mode=OneWay}"
                                          Command="{Binding SetAttendanceFilterCommand}"
                                          CommandParameter="{x:Static vm:AttendanceFilter.Unset}"
                                          ToolTip="عرض اللي لسه محصلش تسجيل — اقفلهم واحد واحد">
                                <StackPanel>
                                    <TextBlock Text="{Binding UnsetCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="لسه مفيش" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- تحذير الجزاءات المتوقعة: بيظهر بس لما يكون فيه غياب بدون إذن -->
                            <Border Background="{StaticResource DangerBgBrush}" CornerRadius="10"
                                    Padding="14,8" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnexcusedCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="17" Height="17"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="{Binding PendingPenaltyText}" Margin="7,0,0,0"
                                               VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{StaticResource DangerBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== البحث + شرح مختصر ===== -->
                    <Grid Grid.Row="1" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.4"
                                CornerRadius="10" Padding="12,7">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="17" Height="17"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBox Text="{Binding AttendanceSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240" Margin="8,0,0,0" BorderThickness="0"
                                             VerticalAlignment="Center" FontSize="13" Background="Transparent" />
                                </StackPanel>
                                <!-- نص إرشادي بيختفي أول ما المستخدم يكتب -->
                                <TextBlock Text="دوّر باسم العامل…" Margin="30,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AttendanceSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1" Style="{StaticResource HintText}" FontSize="12"
                                   Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="اللي له شغل مسجّل بيتعلّم &quot;حاضر&quot; تلقائيًا · الغياب بدون إذن بيتسجّل له جزاء نص يومية لوحده (وبيتشال لو غيّرت الحالة)" />
                    </Grid>

                    <!-- ===== قائمة العمال: بطاقة لكل عامل ===== -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                        <Grid>
                            <!-- مفيش نتايج للبحث -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoAttendanceMatches}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="AccountSearchOutline" Width="46" Height="46"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding EmptyStateText}" Margin="0,10,0,0" FontSize="14"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding VisibleAttendanceRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- بطاقة العامل: شريط جانبي بلون الحالة + بياناته + أزرار الحالة -->
                                            <Border Style="{StaticResource WorkerCard}" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- شريط الحالة الجانبي: لون واحد بيقول حالة العامل من بعيد -->
                                                    <Border Grid.Column="0" Width="5" CornerRadius="3"
                                                            Background="{Binding StatusColor}" Margin="0,2,14,2" />

                                                    <!-- دايرة الحروف الأولى -->
                                                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                                                            Background="{StaticResource SubtleBgBrush}"
                                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource BrandBrush}" />
                                                    </Border>

                                                    <!-- الاسم + النوع + ملاحظة الشغل -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding FullName}" FontSize="14.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="7"
                                                                    Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RoleText}" FontSize="11"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource BrandBrush}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- سبب الحضور التلقائي -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasLoggedWork}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <materialDesign:PackIcon Kind="CheckDecagram" Width="14" Height="14"
                                                                                    VerticalAlignment="Center"
                                                                                    Foreground="{StaticResource SuccessBrush}" />
                                                            <TextBlock Text="{Binding WorkNote}" FontSize="11.5" Margin="5,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SuccessBrush}" />
                                                        </StackPanel>

                                                        <!-- اختصارات الشيفت (بتظهر للعامل بالساعة بس) -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHourly}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="الشيفت:" FontSize="12" VerticalAlignment="Center"
                                                                       Margin="0,0,9,0"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <ItemsControl ItemsSource="{Binding ShiftChoices}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <ToggleButton Style="{StaticResource ShiftChip}"
                                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Content="{Binding Display}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- أزرار الحالة: دوسة واحدة، والمختار بيتلون بلون حالته -->
                                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding StatusChoices}"
                                                                  VerticalAlignment="Center" Margin="14,0,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ToggleButton Style="{StaticResource StatusChip}"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Button Grid.Row="3" HorizontalAlignment="Left"
                            Command="{Binding SaveAttendanceCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Padding="22,11">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="17" Height="17" VerticalAlignment="Center" />
                            <TextBlock Text="حفظ الحضور" Margin="7,0,0,0" FontSize="13.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <!-- ============ تبويب الجزاءات ============ -->
            <TabItem Header="  الجزاءات  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فورم تسجيل جزاء جديد -->
                    <Border Grid.Row="0" Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="تسجيل جزاء جديد" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="العامل:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding AttendanceRows}" SelectedItem="{Binding PenaltyWorker}"
                                          DisplayMemberPath="FullName" Width="220" Margin="0,0,14,0" />
                                <TextBlock Text="الخصم:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding DeductionOptions}" SelectedItem="{Binding SelectedDeduction}"
                                          DisplayMemberPath="Display" Width="110" Margin="0,0,14,0" />
                            </StackPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Left" Command="{Binding AddPenaltyCommand}"
                                        Style="{StaticResource DangerButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="تسجيل الجزاء" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="السبب:" VerticalAlignment="Center" Margin="12,0,6,0" DockPanel.Dock="Left" />
                                <!-- سبب الجزاء نص حر: شرب سجاير، لبس هاندفري، ... -->
                                <TextBox Text="{Binding PenaltyReason, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- جزاءات اليوم المسجلة -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="جزاءات اليوم المسجلة" Style="{StaticResource SectionTitle}" Margin="4,0,4,6" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DayPenalties}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العامل" Binding="{Binding WorkerName}" Width="*" />
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*" />
                                <DataGridTextColumn Header="الخصم" Binding="{Binding DeductionName}" Width="90" />
                                <DataGridTemplateColumn Header="" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button FontSize="11" Foreground="{StaticResource DangerBrush}"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.RemovePenaltyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="حذف" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب السلف والحوافز ============ -->
            <TabItem Header="  السلف والحوافز  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فورم تسجيل سلفة/حافز جديد -->
                    <Border Grid.Row="0" Background="{StaticResource SubtleBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="تسجيل سلفة أو حافز (بالجنيه)" FontWeight="Bold"
                                       Foreground="{StaticResource BrandBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="العامل:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding AttendanceRows}" SelectedItem="{Binding AdjustmentWorker}"
                                          DisplayMemberPath="FullName" Width="200" Margin="0,0,14,0" />
                                <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding AdjustmentTypeOptions}" SelectedItem="{Binding SelectedAdjustmentType}"
                                          DisplayMemberPath="Display" Width="110" Margin="0,0,14,0" />
                                <TextBlock Text="المبلغ:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding AdjustmentAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="110" Padding="8,6" VerticalAlignment="Center" />
                                <TextBlock Text="ج" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Bold" />
                            </StackPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Left" Command="{Binding AddAdjustmentCommand}"
                                        Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="تسجيل" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="البيان:" VerticalAlignment="Center" Margin="12,0,6,0" DockPanel.Dock="Left" />
                                <!-- بيان الحركة اختياري: سلفة نص الشهر، مكافأة تارجت، ... -->
                                <TextBox Text="{Binding AdjustmentNote, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintText}" FontSize="11.5" Margin="0,8,0,0"
                                       Text="السلفة بتتخصم من أجر العامل في كشف الفترة، والحافز بيتزاد. النوع بيحدد الاتجاه — المبلغ دايمًا موجب." />
                        </StackPanel>
                    </Border>

                    <!-- حركات اليوم المسجلة -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="سلف وحوافز اليوم المسجلة" Style="{StaticResource SectionTitle}" Margin="4,0,4,6" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DayAdjustments}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العامل" Binding="{Binding WorkerName}" Width="*" />
                                <!-- النوع بلونه: سلفة حمرا، حافز أخضر -->
                                <DataGridTemplateColumn Header="النوع" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeName}" Foreground="{Binding TypeColor}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="110" />
                                <DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="2*" />
                                <DataGridTemplateColumn Header="" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button FontSize="11" Foreground="{StaticResource DangerBrush}"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.RemoveAdjustmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="حذف" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
