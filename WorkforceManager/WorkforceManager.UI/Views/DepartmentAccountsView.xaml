<UserControl x:Class="WorkforceManager.UI.Views.DepartmentAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <!-- الحسابات الإدارية (مدير/رئيس قسم): قايمة منفصلة تمامًا عن شاشة
         "العمال والمهارات" — دول مش عمال إنتاج، حضورهم بيتسجل تلقائيًا
         كل يوم من غير أي فعل، وتقريرهم منفصل عن تقارير العمال.

         فرز الوصول (CanManage): مدير القسم بس يشوف زرار "إضافة حساب"
         وأوامر التعديل/الإيقاف/الحذف على كل كارت. أي حساب تاني (رئيس
         قسم) بيشوف كارت واحد لحسابه هو بس، للقراءة (زرار "بروفايل" بس). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط العنوان -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding AddAccountCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="14,7"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="إضافة حساب" Margin="5,0,0,0" FontSize="12.5" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18"
                                              Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                <Setter Property="Text" Value="الحسابات الإدارية" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnlyProfile}" Value="True">
                                        <Setter Property="Text" Value="بروفايلي" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- القايمة -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="مفيش حسابات إدارية مضافة لسه" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVis}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Accounts}" Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8"
                                        Padding="14,11" Margin="0,0,0,6">
                                    <DockPanel>
                                        <views:WorkerAvatar DockPanel.Dock="Left" Diameter="44"
                                                            PhotoData="{Binding PhotoData}"
                                                            Initials="{Binding Initials}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <!-- الأوامر: تعديل متاح للمدير على أي حساب، ولأي حساب تاني
                                             على حسابه هو بس (بيانات شخصية، بدون مسمّى/راتب — شوف
                                             DepartmentAccountsViewModel.EditAccountAsync). إيقاف/حذف
                                             للمدير بس. -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Padding="7,4"
                                                    ToolTip="بروفايل"
                                                    Command="{Binding DataContext.OpenProfileCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="15" Height="15" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="7,4"
                                                    ToolTip="تعديل"
                                                    Command="{Binding DataContext.EditAccountCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="7,4"
                                                    ToolTip="{Binding ToggleTooltip}"
                                                    Visibility="{Binding DataContext.CanManage,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                 Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ToggleActiveCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Width="15" Height="15">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="PauseCircleOutline" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Kind" Value="PlayCircleOutline" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="7,4"
                                                    ToolTip="حذف" Foreground="{DynamicResource DangerBrush}"
                                                    Visibility="{Binding DataContext.CanManage,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                 Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DeleteAccountCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                                <!-- بادج التوثيق: دهبي مصمت للمدير، فضّي مفرّغ لرئيس القسم -->
                                                <materialDesign:PackIcon Width="15" Height="15" Margin="5,0,0,0"
                                                                          VerticalAlignment="Center"
                                                                          ToolTip="{Binding BadgeTooltip}"
                                                                          ui:ThemeBrush.ForegroundKey="{Binding BadgeColorKey}">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="{Binding BadgeIcon}" />
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>

                                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4"
                                                        Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding RoleName}" FontSize="10.5" FontWeight="Bold" />
                                                </Border>

                                                <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="4"
                                                        Padding="6,1" Margin="6,0,0,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="موقوف" FontSize="10.5" Foreground="{DynamicResource WarnBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding HasWage, Converter={StaticResource BoolToVis}}">
                                                <Run Text="{Binding WageText, Mode=OneWay}" />
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PhoneNumber}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="{Binding HasPhone, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Username, StringFormat='دخول: {0}'}" FontSize="11.5"
                                                           Margin="10,0,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
