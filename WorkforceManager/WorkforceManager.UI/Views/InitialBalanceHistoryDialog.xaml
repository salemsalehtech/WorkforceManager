<Window x:Class="WorkforceManager.UI.Views.InitialBalanceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="سجل الرصيد"
        Width="650" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="سجل الرصيد الأولي" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,18">
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="ToggleWorkersButton" DockPanel.Dock="Left"
                            Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12"
                            ToolTip="يعرض كل عامل اشتغل على أنهي مرحلة فعليًا من الرصيد ده"
                            Click="ToggleWorkersView_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ToggleWorkersButtonText" Text="عرض العمال" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TitleText" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="SummaryText" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                <TextBlock x:Name="NoHistoryText" Text="لا يوجد استخدامات مسجلة لهذا الرصيد بعد"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                           Visibility="Collapsed" Margin="0,0,0,8" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Headline}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Details}" FontSize="12.2" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding QuantityText}" FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Notes}" FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                            <Border Background="{DynamicResource SidebarBrush}" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource SidebarInkBrush}" FontSize="11.5" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                    <Button Content="إغلاق" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
