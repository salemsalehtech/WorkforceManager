<UserControl x:Class="WorkforceManager.UI.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- سجل العمليات: مين عمل إيه، إمتى، وليه -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط الفلترة -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="18" Height="18"
                                              Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="سجل العمليات" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <WrapPanel>
                    <TextBlock Text="من" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="130" FontSize="12.5" />
                    <TextBlock Text="إلى" VerticalAlignment="Center" FontSize="12.5" Margin="8,0,4,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="130" FontSize="12.5" />

                    <Button Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="12,6" Content="عرض" />
                    <Button Command="{Binding ShowTodayCommand}" Style="{StaticResource GhostButton}"
                            Margin="6,0,0,0" Padding="12,6" Content="النهارده" />
                    <Button Command="{Binding ShowLastMonthCommand}" Style="{StaticResource GhostButton}"
                            Margin="6,0,0,0" Padding="12,6" Content="آخر 30 يوم" />

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Margin="12,0,0,0" Padding="8,5" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="بحث بالاسم أو السبب" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- الجدول -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="مفيش عمليات مسجّلة في الفترة دي" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}" Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SubtleBgBrush}" CornerRadius="8"
                                        Padding="12,9" Margin="0,0,0,6">
                                    <DockPanel>
                                        <!-- شارة نوع العملية — الحذف أحمر -->
                                        <Border DockPanel.Dock="Left" CornerRadius="6" Padding="9,4"
                                                VerticalAlignment="Top" MinWidth="110">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ChipBgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeletion}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EventText}" FontSize="11.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeletion}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EntityName}" FontSize="13.5" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding When}" FontSize="11.5" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="السبب:" FontWeight="SemiBold" />
                                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Text="{Binding Details}" FontSize="11.5" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="اللي عملها:" />
                                                <Run Text="{Binding Actor, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
