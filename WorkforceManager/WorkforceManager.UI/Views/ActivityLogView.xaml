<UserControl x:Class="WorkforceManager.UI.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- سجل العمليات: مين عمل إيه، إمتى، وليه -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- شريط الفلترة -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="18" Height="18"
                                              Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="سجل العمليات" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <WrapPanel>
                    <TextBlock Text="من" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="130" FontSize="12.5" />
                    <TextBlock Text="إلى" VerticalAlignment="Center" FontSize="12.5" Margin="8,0,4,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="130" FontSize="12.5" />

                    <Button Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="12,6" Content="عرض" />
                    <Button Command="{Binding ShowTodayCommand}" Style="{StaticResource GhostButton}"
                            Margin="6,0,0,0" Padding="12,6" Content="النهارده" />
                    <Button Command="{Binding ShowLastMonthCommand}" Style="{StaticResource GhostButton}"
                            Margin="6,0,0,0" Padding="12,6" Content="آخر 30 يوم" />

                    <!-- السجل بقى بيسجّل كل عملية ليها قيمة مش الحذف بس،
                         فالفلتر ده بقى ضروري: من غيره اللي بيدوّر على
                         حركة فلوس بيعدّي على كل حفظ إنتاج في الشهر -->
                    <ComboBox ItemsSource="{Binding EventGroups}"
                              SelectedItem="{Binding SelectedEventGroup}"
                              DisplayMemberPath="Display"
                              Width="140" Margin="12,0,0,0" FontSize="12.5" />

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Margin="8,0,0,0" Padding="8,5" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="بحث بالاسم أو السبب" />
                </WrapPanel>

                <!-- السجل بيقصّر لوحده، فلازم الشاشة تقول ليه.
                     من غير السطر ده المستخدم بيدوّر على حدث قديم
                     ومبيلاقيهوش ويفتكر إن فيه عطل. -->
                <TextBlock Text="{Binding RetentionNote}" FontSize="11.5" Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- الجدول -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="مفيش عمليات مسجّلة في الفترة دي" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <!--
                    ListBox بدل ItemsControl+ScrollViewer يدوي — الفرق مش
                    شكلي: ListBox بيفرّج نفسه (VirtualizingStackPanel
                    ضمنيًا)، فبيبني العناصر الظاهرة بس. ItemsControl لفّه
                    ScrollViewer صريح مش بيفرّج حتى لو حطّيت VirtualizingStackPanel
                    كـ ItemsPanel — ScrollViewer الخارجي بيقطع معلومات
                    الـ viewport اللي التفريج محتاجها. الفرق كان بيبين على
                    سجل شهر كامل (كل كارت فيه ~15 عنصر مربوط بالثيم): كل
                    الكروت كانت بتتبني وقت الفتح حتى اللي برّه الشاشة.
                    ItemContainerStyle هنا بيشيل شكل التحديد/الفوكس بتاع
                    ListBox عشان يفضل شكله زي القايمة القديمة بالظبط —
                    قايمة عرض مش قايمة اختيار.
                -->
                <ListBox ItemsSource="{Binding Events}" Margin="12"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- الكارت اتقسّم لطبقات واضحة: أيقونة تدّي هوية الحدث
                                     فورًا، عنوان + وقت، جسم بس لو فيه سبب أو تفاصيل
                                     فعلًا (مش "السبب: —" في كل كارت)، والفاعل في
                                     سطر منفصل تحت خط رفيع — آخر حاجة العين توصلها. -->
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="10"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="11"
                                                       VerticalAlignment="Top" Margin="6,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <!-- شارة دائرية بأيقونة الحدث — اللون جاي كمفتاح
                                                 فرشاة من الـ ViewModel فبيتغيّر مع الثيم -->
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeletion}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMoney}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource GoldTintBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <materialDesign:PackIcon Kind="{Binding EventIcon}" Width="16" Height="16"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          ui:ThemeBrush.ForegroundKey="{Binding AccentColor}" />
                                            </Border>

                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EventText}" FontSize="11.5" FontWeight="Bold"
                                                           ui:ThemeBrush.ForegroundKey="{Binding AccentColor}" />
                                                <TextBlock Text="{Binding EntityName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- الجسم: بس لو فيه سبب أو تفاصيل فعلًا -->
                                        <StackPanel Margin="40,6,0,0"
                                                    Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}">
                                                <Run Text="السبب: " FontWeight="SemiBold" />
                                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Text="{Binding Details}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasReason}" Value="True">
                                                                <Setter Property="Margin" Value="0,2,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- خط رفيع فاصل قبل الفاعل — بيفصل "اللي حصل" عن "مين عمله" -->
                                        <Border Height="1" Background="{DynamicResource LineBrush}"
                                                Margin="40,8,0,6" />
                                        <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                                            <materialDesign:PackIcon Kind="AccountOutline" Width="12" Height="12"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Actor}" FontSize="11" FontWeight="SemiBold"
                                                       Margin="4,0,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
