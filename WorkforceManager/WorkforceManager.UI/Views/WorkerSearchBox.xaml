<UserControl x:Class="WorkforceManager.UI.Views.WorkerSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">

    <!-- بحث عن عامل بالاسم. عنصر واحد بيتشارك بين الجزاءات والسلف —
         الاتنين كانوا ComboBox على 46 عامل، والوصول لحد بالتمرير بطيء. -->
    <Grid>
        <Border BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1.4" CornerRadius="8"
                Background="{DynamicResource CardBgBrush}">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="AccountSearchOutline"
                                         Width="16" Height="16" Margin="9,0,0,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextMutedBrush}" />

                <!-- زرار مسح الاختيار -->
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Click="Clear_Click"
                        Margin="0,0,6,0" Padding="5,2" Visibility="Collapsed"
                        Style="{DynamicResource IconButton}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        ToolTip="امسح الاختيار">
                    <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                </Button>

                <Grid>
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                             Padding="8,7" FontSize="13" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             GotKeyboardFocus="SearchBox_GotFocus" />
                    <TextBlock x:Name="PlaceholderText" IsHitTestVisible="False"
                               Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- الاقتراحات: Popup عشان متزقّش اللي تحتها لما تفتح -->
        <Popup x:Name="SuggestionsPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBox}"
               HorizontalOffset="0" VerticalOffset="4">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" MinWidth="240">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MatchesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Row}" Click="PickWorker_Click"
                                        HorizontalContentAlignment="Stretch" Padding="9,6"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Row.TypeText}"
                                                   FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Row.FullName}" FontSize="12.5"
                                                   Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
