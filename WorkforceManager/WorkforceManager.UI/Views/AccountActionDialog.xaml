<Window x:Class="WorkforceManager.UI.Views.AccountActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة واحدة لعمليات الحساب التلاتة (تغيير الاسم / تغيير كلمة
         الدخول / إضافة حساب) — الخانات بتظهر وتختفي حسب العملية. تلات
         نوافذ متشابهة كانت هتخلي أي تعديل في الشكل يتعمل تلات مرات. -->
    <Border CornerRadius="18" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BrandBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="White"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="15.5" FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <!-- اسم المستخدم: تغيير الاسم + إضافة حساب -->
                <StackPanel x:Name="UsernameSection">
                    <TextBlock x:Name="UsernameLabel" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />
                </StackPanel>

                <!-- كلمة مرور جديدة: تغيير كلمة الدخول + إضافة حساب -->
                <StackPanel x:Name="NewPasswordSection">
                    <TextBlock x:Name="NewPasswordLabel" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,14" />
                </StackPanel>

                <!-- كلمة المرور الحالية: مطلوبة في التلاتة -->
                <StackPanel x:Name="CurrentPasswordSection">
                    <TextBlock x:Name="CurrentPasswordLabel" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,4" />
                    <TextBlock x:Name="CurrentPasswordHint" Style="{StaticResource HintText}" Margin="0,0,0,14"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border x:Name="ErrorBox" Background="{DynamicResource DangerBgBrush}" CornerRadius="7"
                        Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ConfirmButton" Click="Confirm_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
