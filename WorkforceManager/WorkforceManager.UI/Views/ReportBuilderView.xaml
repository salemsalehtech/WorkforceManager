<UserControl x:Class="WorkforceManager.UI.Views.ReportBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة التقارير: اختار عن إيه ولمدة إيه ومتفصّل إزاي، شوفه،
         وصدّره. بدّلت أربع تبويبات كان كل واحد فيهم تقرير ثابت. -->
    <UserControl.Resources>
        <!--
          الشاشة كانت صف واحد فيه تمن اختيارات بنفس الوزن البصري
          وتحته صف تاني من غير أي عنوان — فالمستخدم مش عارف يبدأ
          منين ولا إيه اللي بيأثر في إيه. الأقسام التلاتة بتقسّمها
          لتلات أسئلة: التقرير عن إيه؟ لمدة إيه؟ ونشوفه إزاي؟
        -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="CornerRadius" Value="10.5" />
            <Setter Property="Background" Value="{DynamicResource GoldBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource InkOnAccentBrush}" />
        </Style>

        <Style x:Key="StepCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <!-- القسم كله: عنوان فوق واختياراته تحته -->
        <Style x:Key="StepSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,30,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== الإعداد: القوالب فوق والخطوات تحتها في كارت واحد =====
             كانوا كارتين متجاورين، والفصل بينهم كان بياخد مساحة من
             الجدول من غير ما يوضّح حاجة — القالب هو اختصار الخطوات
             اللي تحته، فمكانه فوقها في نفس الكارت. -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="0" Margin="0,0,0,10">
            <StackPanel>
                <!-- ===== القوالب: أسرع طريق لتقرير بيتعمل كل شهر ===== -->
                <Border Padding="14,9" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource CardBorderBrush}">
                    <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="17" Height="17"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldDeepBrush}" />
                            <TextBlock Text="قالب جاهز:" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center" Margin="6,0,10,0" />
                            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="Name" Width="200" FontSize="12.5"
                                      ToolTip="بيملّي الاختيارات تحت — تقدر تعدّل عليها بعدها عادي" />
                            <Button Command="{Binding StartRenameTemplateCommand}"
                                    Style="{StaticResource IconButton}" Padding="7,5" Margin="4,0,0,0"
                                    Visibility="{Binding CanRenameSelectedTemplate, Converter={StaticResource BoolToVis}}"
                                    ToolTip="إعادة تسمية القالب">
                                <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" />
                            </Button>
                            <Button Command="{Binding DeleteTemplateCommand}"
                                    CommandParameter="{Binding SelectedTemplate}"
                                    Style="{StaticResource IconButton}" Padding="7,5" Margin="2,0,0,0"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Visibility="{Binding CanRenameSelectedTemplate, Converter={StaticResource BoolToVis}}"
                                    ToolTip="حذف القالب (القوالب الجاهزة مبتتحذفش)">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" />
                            </Button>
                        </StackPanel>

                        <!-- حفظ الإعداد الحالي كقالب جديد: مطويّة افتراضيًا
                             وراء زرار "+" — اختيار قالب جاهز هو المسار
                             الأكتر استخدامًا، وحفظ قالب جديد أندر بكتير -->
                        <Button DockPanel.Dock="Left" Command="{Binding ToggleAddNewTemplateCommand}"
                                Style="{StaticResource GhostButton}" Padding="11,6" Margin="20,0,0,0"
                                Visibility="{Binding IsAddingNewTemplate, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="احفظ الإعداد الحالي كقالب" Margin="5,0,0,0" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="{Binding IsAddingNewTemplate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="احفظ الحالي باسم:" FontSize="12.5" VerticalAlignment="Center"
                                       Margin="20,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBox Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160" Padding="7,5" FontSize="12.5" VerticalContentAlignment="Center" />
                            <Button Command="{Binding SaveTemplateCommand}" IsEnabled="{Binding CanSaveTemplate}"
                                    Style="{StaticResource GhostButton}" Padding="11,6" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="حفظ" Margin="5,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleAddNewTemplateCommand}"
                                    Style="{StaticResource IconButton}" Padding="6,4" Margin="4,0,0,0"
                                    ToolTip="إلغاء">
                                <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- فورم إعادة التسمية: مطويّة، بتظهر بس لما تدوس قلم التسمية -->
                    <DockPanel Margin="0,8,0,0"
                               Visibility="{Binding IsRenamingTemplate, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left" Text="الاسم الجديد:" FontSize="12.5" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button DockPanel.Dock="Right" Command="{Binding CancelRenameTemplateCommand}"
                                Style="{StaticResource IconButton}" Padding="6,4" Margin="4,0,0,0" ToolTip="إلغاء">
                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding ConfirmRenameTemplateCommand}"
                                Style="{StaticResource GhostButton}" Padding="11,6" Margin="6,0,0,0">
                            <TextBlock Text="حفظ الاسم" FontSize="12" />
                        </Button>
                        <TextBox Text="{Binding RenameTemplateText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Padding="7,5" FontSize="12.5" VerticalContentAlignment="Center"
                                 HorizontalAlignment="Left" />
                    </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== الخطوات التلاتة ===== -->
                <WrapPanel Margin="14,11,14,8">

                    <!-- ————— (١) التقرير عن إيه ————— -->
                    <StackPanel Style="{StaticResource StepSection}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Border Style="{StaticResource StepBadge}">
                                <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                         Style="{StaticResource StepIcon}" />
                            </Border>
                            <TextBlock Text="التقرير عن إيه؟" Style="{StaticResource StepCaption}" />
                        </StackPanel>

                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                                      DisplayMemberPath="Display" Width="150" FontSize="12.5"
                                      Margin="0,0,10,4" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                <TextBlock Text="متفصّل" Style="{StaticResource FieldLabel}" />
                                <!-- الاختيارات بتتغيّر مع الموضوع: التركيبة اللي
                                     مالهاش معنى مبتتعرضش أصلاً -->
                                <ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding SelectedGrouping}"
                                          DisplayMemberPath="Display" Width="130" FontSize="12.5" />
                            </StackPanel>

                            <!-- مستويات إضافية: "بالمنتج ثم العامل ثم المرحلة".
                                 مطويّة افتراضيًا وراء "تجميع متقدم" — معظم
                                 التقارير تجميع بمستوى واحد، والاتنين دول
                                 سؤال خاص ("مين اشتغل على إيه") مش الحالة
                                 العادية. -->
                            <CheckBox Content="تجميع متقدم (أكتر من مستوى)" FontSize="12" Margin="0,0,0,4"
                                      VerticalAlignment="Center" IsChecked="{Binding ShowThenBy}"
                                      Visibility="{Binding SupportsLevels, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SupportsLevels}" Value="True" />
                                                    <Condition Binding="{Binding ShowThenBy}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="ثم" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ThenByOptions}" SelectedItem="{Binding ThenBy1}"
                                          DisplayMemberPath="Display" Width="110" FontSize="12.5" />

                                <TextBlock Text="ثم" Style="{StaticResource FieldLabel}" Margin="8,0,7,0" />
                                <ComboBox ItemsSource="{Binding ThenByOptions}" SelectedItem="{Binding ThenBy2}"
                                          DisplayMemberPath="Display" Width="110" FontSize="12.5" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ————— (٢) لمدة إيه — بيختفي مع المهارات (حالة مش مدة) ————— -->
                    <StackPanel Style="{StaticResource StepSection}"
                                Visibility="{Binding UsesPeriod, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Border Style="{StaticResource StepBadge}">
                                <materialDesign:PackIcon Kind="CalendarRange"
                                                         Style="{StaticResource StepIcon}" />
                            </Border>
                            <TextBlock Text="لمدة إيه؟" Style="{StaticResource StepCaption}" />
                        </StackPanel>

                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                                      DisplayMemberPath="Display" Width="130" FontSize="12.5"
                                      Margin="0,0,10,4" />

                            <!-- الداتتين بيظهروا مع "مدة مخصوصة" بس -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="من" Style="{StaticResource FieldLabel}" Margin="0,0,5,0" />
                                <DatePicker SelectedDate="{Binding CustomFrom}" Width="125" FontSize="12.5" />
                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" Margin="8,0,5,0" />
                                <DatePicker SelectedDate="{Binding CustomTo}" Width="125" FontSize="12.5" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ————— (٣) نشوفه إزاي ————— -->
                    <StackPanel Style="{StaticResource StepSection}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Border Style="{StaticResource StepBadge}">
                                <materialDesign:PackIcon Kind="TuneVariant"
                                                         Style="{StaticResource StepIcon}" />
                            </Border>
                            <TextBlock Text="نشوفه إزاي؟" Style="{StaticResource StepCaption}" />
                        </StackPanel>

                        <WrapPanel>

                    <!-- الفلاتر جوّه زرار — نفس نمط شاشتي العمال والمنتجات -->
                    <Grid VerticalAlignment="Center" Margin="0,0,8,4">
                        <ToggleButton x:Name="FilterToggle" Style="{StaticResource ToolbarToggle}"
                                      IsChecked="{Binding IsFilterMenuOpen, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterVariant" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="فلاتر" Margin="5,0,0,0" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource SidebarBrush}" CornerRadius="8"
                                        Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ActiveFilterCount}" FontSize="10.5"
                                               FontWeight="Bold" Foreground="{DynamicResource SidebarInkBrush}" />
                                </Border>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <!--
                          الكارت كان بيطلع برّا النافذة: من غير MaxHeight
                          بيطول بطول قايمة العمال (17 عامل = كارت أطول من
                          الشاشة)، والـ Popup بيرسم في نافذة مستقلة فمش
                          بيتقص عند حدود البرنامج — بيفضل نازل على الشاشة.
                          الحل: سقف للارتفاع + تمرير جوّه.
                        -->
                        <Popup IsOpen="{Binding IsFilterMenuOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               HorizontalOffset="-6" VerticalOffset="2">
                            <Border Style="{StaticResource ToolbarPopupCard}"
                                    FlowDirection="RightToLeft" Width="310" MaxHeight="480">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- اختيار متعدد: المحرك بيقبل مجموعة من
                                         زمان، والشاشة كانت بتبعت واحد بس -->
                                    <TextBlock Text="عمال (علّم على اللي عايزه)" FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <Border Style="{StaticResource FilterListBox}">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Workers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  FontSize="12.5" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock Text="منتجات" FontSize="11" Margin="0,10,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <Border Style="{StaticResource FilterListBox}">
                                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Products}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  FontSize="12.5" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock Text="مرحلة" FontSize="11" Margin="0,10,0,3"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox ItemsSource="{Binding Stages}"
                                              SelectedItem="{Binding SelectedStage}"
                                              DisplayMemberPath="Display" FontSize="12.5" />

                                    <TextBlock Text="نوع العامل" FontSize="11" Margin="0,10,0,3"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox ItemsSource="{Binding WorkerKinds}"
                                              SelectedItem="{Binding SelectedWorkerKind}"
                                              DisplayMemberPath="Display" FontSize="12.5" />

                                    <Button Command="{Binding ClearFiltersCommand}"
                                            Style="{StaticResource GhostButton}" Padding="11,6"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilterRemove" Width="14" Height="14"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="شيل الفلاتر" Margin="5,0,0,0" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ===== محرّر الأعمدة ===== -->
                    <Grid VerticalAlignment="Center" Margin="0,0,8,4">
                        <ToggleButton x:Name="ColumnToggle" Style="{StaticResource ToolbarToggle}"
                                      IsChecked="{Binding IsColumnMenuOpen, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewColumnOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="الأعمدة" Margin="5,0,0,0" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource SidebarBrush}" CornerRadius="8"
                                        Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasColumnChanges, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✎" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource SidebarInkBrush}" />
                                </Border>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsColumnMenuOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ColumnToggle}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               HorizontalOffset="-6" VerticalOffset="2">
                            <Border Style="{StaticResource ToolbarPopupCard}"
                                    FlowDirection="RightToLeft" Width="420" MaxHeight="460">
                                <StackPanel>
                                    <!-- التلميح و"إجمالي" كانوا في نفس خانة الـ Grid
                                         (مفيش أعمدة أصلاً)، فالنصين كانوا بيتكتبوا
                                         فوق بعض. عمودين: التلميح بيقصّر نفسه
                                         و"إجمالي" بتفضل فوق خانة الجمع بالظبط. -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="علّم على اللي يظهر، وغيّر الاسم لو حابب"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="إجمالي" FontSize="11"
                                                   Margin="8,0,62,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>

                                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ColumnChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                                              VerticalAlignment="Center" Margin="0,0,7,0"
                                                              ToolTip="يظهر في الجدول" />

                                                    <!-- الاسم بيتغيّر هنا؛ المفتاح ورا الكواليس
                                                         مبيتغيّرش فالقوالب القديمة بتفضل شغالة -->
                                                    <TextBox Grid.Column="1" Text="{Binding Header, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="12.5" Padding="7,5" />

                                                    <!-- علامة الجمع بتختفي عند العمود اللي مالوش
                                                         إجمالي أصلاً (نصي زي المرحلة) بدل ما تبقى
                                                         موجودة ومالهاش أثر -->
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding Sums}"
                                                              VerticalAlignment="Center" Margin="10,0,4,0"
                                                              ToolTip="يدخل في سطر الإجمالي"
                                                              Visibility="{Binding CanSum, Converter={StaticResource BoolToVis}}" />

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}" Padding="5,3"
                                                                ToolTip="فوق"
                                                                Command="{Binding DataContext.MoveColumnUpCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="ChevronUp" Width="15" Height="15" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Padding="5,3"
                                                                ToolTip="تحت"
                                                                Command="{Binding DataContext.MoveColumnDownCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="ChevronDown" Width="15" Height="15" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>

                                    <Button Command="{Binding ResetColumnsCommand}"
                                            Style="{StaticResource GhostButton}" Padding="11,6"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Visibility="{Binding HasColumnChanges, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Restore" Width="14" Height="14"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="رجّع الأعمدة زي ما كانت" Margin="5,0,0,0" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ===== الترتيب والعرض =====
                         كانوا صف تاني كامل من غير عنوان: ترتيب وأعلى-N
                         وسطر إجمالي ومقارنة، أربع اختيارات ظاهرة على طول
                         بينافسوا اختيار الموضوع نفسه على انتباه المستخدم.
                         بقوا جوّه زرار بشارة: مبيزحموش الشاشة، والشارة
                         بتقول إن فيه حاجة منهم متغيّرة. -->
                    <Grid VerticalAlignment="Center" Margin="0,0,0,4">
                        <ToggleButton x:Name="DisplayToggle" Style="{StaticResource ToolbarToggle}"
                                      IsChecked="{Binding IsDisplayMenuOpen, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SortVariant" Width="15" Height="15"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="الترتيب والعرض" Margin="5,0,0,0" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource SidebarBrush}" CornerRadius="8"
                                        Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasDisplayChanges, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✎" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource SidebarInkBrush}" />
                                </Border>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsDisplayMenuOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=DisplayToggle}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               HorizontalOffset="-6" VerticalOffset="2">
                            <Border Style="{StaticResource ToolbarPopupCard}"
                                    FlowDirection="RightToLeft" Width="310">
                                <StackPanel>
                                    <TextBlock Text="ترتيب الصفوف" FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToolbarToggle}"
                                                      Margin="6,0,0,0"
                                                      IsChecked="{Binding SortDescending, Mode=TwoWay}"
                                                      ToolTip="من الأكبر للأصغر">
                                            <materialDesign:PackIcon Kind="SortDescending" Width="15" Height="15" />
                                        </ToggleButton>
                                        <ComboBox ItemsSource="{Binding SortOptions}"
                                                  SelectedItem="{Binding SelectedSort}"
                                                  DisplayMemberPath="Display" FontSize="12.5" />
                                    </DockPanel>

                                    <TextBlock Text="كام سطر" FontSize="11" Margin="0,12,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox ItemsSource="{Binding TopNOptions}"
                                              SelectedItem="{Binding SelectedTopN}"
                                              DisplayMemberPath="Display" FontSize="12.5" />

                                    <CheckBox Content="سطر الإجمالي تحت الجدول" FontSize="12.5"
                                              Margin="0,14,0,0" IsChecked="{Binding ShowTotals}"
                                              ToolTip="الأعمدة اللي بتدخل في الإجمالي بتتحدد من محرّر الأعمدة" />

                                    <CheckBox Content="قارن بالمدة اللي قبلها" FontSize="12.5"
                                              Margin="0,8,0,0" IsChecked="{Binding CompareWithPrevious}"
                                              ToolTip="بيزوّد لكل رقم: رقم المدة السابقة ونسبة التغير"
                                              Visibility="{Binding UsesPeriod, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                        </WrapPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== المعاينة + التصدير ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,11" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource CardBorderBrush}">
                    <!--
                      عمودين صريحين مش DockPanel: العنوان كان بيدخل تحت
                      زرار التصدير لما يطول، لأن DockPanel مبيقصّش الطفل
                      الأخير — النص بيفضل مرسوم والزرار بيتغطى عليه.
                      العمود النجمة + التقصير بالنقط بيخلّي العنوان يقصّر
                      نفسه بدل ما يتخبّى ورا الأزرار.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding ReportTitle}" FontWeight="Bold" FontSize="15"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource GoldDeepBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ReportPeriodText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ResultsText}" FontSize="12" Margin="12,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- خيارات الملف جنب زرار التصدير مش جوّه نافذة
                             تانية: المستخدم بيقرر شكل الملف وهو شايف
                             التقرير قدامه -->
                        <Grid VerticalAlignment="Center" Margin="8,0,0,0">
                            <ToggleButton x:Name="ExportToggle" Style="{StaticResource ToolbarToggle}"
                                          IsChecked="{Binding IsExportMenuOpen, Mode=TwoWay}"
                                          ToolTip="اللي هيتحط في ملف Excel">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15"
                                                             VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                             Margin="3,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsExportMenuOpen, Mode=TwoWay}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=ExportToggle}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource ToolbarPopupCard}"
                                        FlowDirection="RightToLeft" Width="290">
                                    <StackPanel>
                                        <TextBlock Text="اللي هيتحط في ملف Excel" FontSize="11"
                                                   Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextMutedBrush}" />

                                        <CheckBox Content="شيت تفاصيل: كل سجل على حدة"
                                                  IsChecked="{Binding ExportDetailSheet}"
                                                  FontSize="12.5" Margin="0,3"
                                                  ToolTip="سطر لكل سجل من غير تجميع — عشان تعمل Pivot بنفسك" />

                                        <CheckBox Content="شيت لكل مجموعة"
                                                  IsChecked="{Binding ExportSheetPerGroup}"
                                                  FontSize="12.5" Margin="0,3"
                                                  ToolTip="سجلات كل منتج/عامل في شيت لوحده — للطباعة والتوزيع" />

                                        <TextBlock Text="اسم المصنع والشعار بيتظبطوا من الإعدادات"
                                                   FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Command="{Binding ExportCommand}"
                                Style="{StaticResource SuccessButton}" Padding="15,8"
                                IsEnabled="{Binding HasReport}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="تصدير Excel" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- قسايم الأسبوع: ورقة تتقص بالطول، شريط لكل
                             عامل. منفصلة عن "قسيمة أجر" اللي بتطبع واحد
                             بس — دي للتوزيع على القسم كله دفعة واحدة.

                             **بتظهر مع تقرير الأجور بس.** كانت ظاهرة على
                             كل تقرير — يعني وإنت شايف جدول حضور أو هالك
                             قدامك يبقى جنبه زرار بيطلّع أجور، وهو شغال
                             فعلاً لأنه بيسأل PayrollService مباشرة. -->
                        <Button Command="{Binding ExportPayslipStripsCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="8,0,0,0"
                                Visibility="{Binding IsWagesReport, Converter={StaticResource BoolToVis}}"
                                ToolTip="ورقة A4 بالعرض فيها 4 قسايم — تتطبع وتتقص بالطول">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="قسايم الأجر" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- القسيمة ورقة عامل واحد — بتظهر في تقرير الأجور
                             لما تختار عامل واحد من الفلاتر، لأن قبل كده
                             السؤال "قسيمة مين؟" مالوش إجابة -->
                        <Button Command="{Binding PrintPayslipCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="8,0,0,0"
                                Visibility="{Binding CanPrintPayslip, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="قسيمة أجر" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- الجدول بيتبني في الكود لأن أعمدته بتتغيّر مع الموضوع -->
                <DataGrid x:Name="PreviewGrid" Grid.Row="1"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          ItemsSource="{Binding PreviewRows}" />

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="46" Height="46"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="مفيش بيانات في المدة دي" Margin="0,10,0,0" FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
