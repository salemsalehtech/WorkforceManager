<Window x:Class="WorkforceManager.UI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="رسالة" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة الرسائل الوحيدة في البرنامج — بديل MessageBox.Show بالكامل.
         نفس كروم SensitiveActionDialog بالظبط (نفس الحواف، نفس الظل، نفس
         الهيدر اللي بيتسحب) عشان الاتنين يبانوا نافذة واحدة للمستخدم مش
         نافذتين من تصميمين. اللي بيفرّق بينهم إن دي بتقول/بتسأل بس،
         ومفيهاش أي مدخلات. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <!-- لون الهيدر والأيقونة بيتحطوا من الكود حسب نوع الرسالة -->
            <Border x:Name="HeaderBar" DockPanel.Dock="Top" CornerRadius="18,18,0,0"
                    Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Left"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <materialDesign:PackIcon x:Name="KindIcon" DockPanel.Dock="Right"
                                             Width="21" Height="21" Margin="0,0,10,0"
                                             VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                               FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <StackPanel Margin="20,18,20,18">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13.5"
                           LineHeight="21" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                    <!-- بيختفي في رسايل الخبر/الخطأ (زرار واحد بس) -->
                    <Button x:Name="NoButton" Style="{StaticResource GhostButton}" Padding="16,8"
                            IsCancel="True" Content="لأ" />
                    <!-- النص والنمط بيتحطوا من الكود حسب النوع -->
                    <Button x:Name="YesButton" Padding="16,8" Margin="8,0,0,0" Click="Yes_Click" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
