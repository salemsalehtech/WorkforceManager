<Window x:Class="WorkforceManager.UI.Views.EditProductionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تصحيح سجل إنتاج"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- تصحيح عدد قطع سجل محفوظ بالغلط، واختياريًا تحويله لعامل تاني تمامًا
         (اتسجّل على عامل غلط بالغلط) — اليومية المحفوظة وقت التسجيل بتفضل زي ما هي —
         بطاقة عائمة بلا إطار نظام زي شاشة الدخول، بشريط علوي بلون البراند -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <!-- المرحلة/المنتج (للتأكد إنه السجل الصح قبل التعديل) -->
                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                    <TextBlock x:Name="StageText" FontWeight="Bold" FontSize="13.5" />
                </Border>

                <TextBlock Text="العامل" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="WorkerBox" DisplayMemberPath="Name" Margin="0,0,0,4" FontSize="14" />
                <TextBlock Text="غيّر العامل لو السجل اتسجّل على حد غلط بالغلط — يومية السجل ده هتتحول من العامل القديم للعامل الجديد"
                           Style="{StaticResource HintText}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock Text="عدد القطع الصحيح" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PiecesBox" Margin="0,0,0,6" FontSize="15" />
                <TextBlock Text="اليوميات هتتعاد حسابها تلقائيًا بنفس يومية وقت التسجيل"
                           Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ التصحيح" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
