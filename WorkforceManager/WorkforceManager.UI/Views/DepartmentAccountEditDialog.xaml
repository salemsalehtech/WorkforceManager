<Window x:Class="WorkforceManager.UI.Views.DepartmentAccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إضافة حساب إداري"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة إضافة/تعديل حساب إداري (مدير/رئيس قسم): الحساب ده بقى
         حساب دخول فعلي (يوزر + باسورد خاصين بيه)، مالوش مهارات ولا
         تاريخ التحاق، وحضوره بيتسجل تلقائيًا. مدير القسم مالوش سعر
         يومية خالص — خانتها بتتخفي لو الدور ده متحدد (RoleBox_Changed). -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22" MaxHeight="600">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580">
                <StackPanel>
                <TextBlock Text="اسم الحساب (إجباري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" />

                <TextBlock Text="المسمّى" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="RoleBox" Margin="0,0,0,4"
                          DisplayMemberPath="Display" SelectedValuePath="Role"
                          SelectionChanged="RoleBox_SelectionChanged" />
                <TextBlock Text="حساب إداري منفصل تمامًا عن العمال — بيتسجل حاضر تلقائيًا كل يوم من غير أي فعل."
                           Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <TextBlock Text="رقم التليفون" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PhoneBox" Margin="0,0,0,12" />

                <!-- سعر اليومية: مفيش خالص لمدير القسم — شوف RoleBox_SelectionChanged -->
                <StackPanel x:Name="WagePanel">
                    <TextBlock Text="سعر اليومية بالجنيه" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="WageBox" Margin="0,0,0,4" />
                    <TextBlock Text="الأجر = صافي اليوميات × السعر ده. سيبه 0 لحد ما تحدد سعره."
                               Style="{StaticResource HintText}" Margin="0,0,0,14" />
                </StackPanel>

                <!-- صورة الحساب (اختيارية): معاينة دايرية + اختيار + إزالة -->
                <TextBlock Text="صورة الحساب (اختيارية)" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.4"
                            Margin="0,0,12,0">
                        <Grid>
                            <materialDesign:PackIcon x:Name="NoPhotoIcon" Kind="AccountTie" Width="24" Height="24"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextMutedBrush}" />
                            <Image x:Name="PhotoPreview" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="32,32" RadiusX="31" RadiusY="31" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <Button Click="PickPhoto_Click" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderImage" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="اختار صورة" Margin="5,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemovePhotoButton" Click="RemovePhoto_Click"
                                Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="شيل الصورة" Margin="5,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- بيانات الدخول: يوزر + باسورد خاصين بالحساب ده -->
                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,14" />
                <TextBlock Text="بيانات الدخول" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,8" />

                <TextBlock Text="اسم الدخول" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,12" />

                <!-- تعديل ذاتي بس: تأكيد الهوية قبل أي تغيير في اسم
                     الدخول أو كلمة المرور -->
                <StackPanel x:Name="CurrentLoginPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="CurrentLoginPasswordBox" Margin="0,0,0,4" />
                    <TextBlock Text="مطلوبة لو هتغيّر اسم الدخول أو كلمة المرور" Style="{StaticResource HintText}" Margin="0,0,0,14" />
                </StackPanel>

                <TextBlock x:Name="PasswordLabel" Text="كلمة المرور" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,4" />
                <TextBlock x:Name="PasswordHint" Text="سيبها فاضية لو مش عايز تغيّرها" Visibility="Collapsed"
                           Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <!-- كلمة سر العمليات: منفصلة تمامًا عن كلمة الدخول —
                     بتتطلب قبل الحذف وتعديل الأجور والجزاءات بس -->
                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,14" />
                <TextBlock Text="كلمة سر العمليات" Style="{StaticResource FieldLabel}" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="منفصلة عن كلمة الدخول — بتتطلب قبل الحذف وتعديل الأجور والجزاءات بس."
                           Style="{StaticResource HintText}" Margin="0,0,0,8" TextWrapping="Wrap" />

                <StackPanel x:Name="CurrentOperationsPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="كلمة سر العمليات الحالية" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="CurrentOperationsPasswordBox" Margin="0,0,0,4" />
                    <TextBlock Text="مطلوبة عشان تغيّرها" Style="{StaticResource HintText}" Margin="0,0,0,14" />
                </StackPanel>

                <TextBlock x:Name="OperationsPasswordLabel" Text="كلمة سر العمليات (اختياري)" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="OperationsPasswordBox" Margin="0,0,0,4" />
                <TextBlock x:Name="OperationsPasswordHint" Text="سيبها فاضية لو مش عايز تغيّرها" Visibility="Collapsed"
                           Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <!-- رسالة الخطأ (بتظهر لو الاسم فاضي مثلاً) -->
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
