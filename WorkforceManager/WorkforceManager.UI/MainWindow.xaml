<Window x:Class="WorkforceManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="نظام إدارة إنتاجية وأجور العمال"
        Icon="Assets/app.ico"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <!--
      UseLayoutRounding + TextOptions هنا لأن النمط الضمني TargetType="Window"
      في App.xaml بيحطهم برضه — بس زي FlowDirection فوقه بالظبط، النمط
      الضمني ده مبيوصلش لـ MainWindow (كلاس مشتق، شوف تعليق FlowDirection).
      من غير UseLayoutRounding عناصر الشجرة كلها (كل شاشات الـ Sidebar) بترتّب
      على إحداثيات كسرية عند أي نسبة تكبير غير 100% — وده بيطلع حدود وزوايا
      مستديرة باهتة، وبيبان أوضح كل ما البطاقة فيها Border متداخلة أكتر
      (المنتجات، تسجيل الإنتاج) عن شاشة بسيطة زي سجل العمليات (DataGrid
      بارتفاع صف ثابت). الخاصية دي بتتوارث لكل الشجرة البصرية تحتها، فحطّها
      هنا بس بيغطي كل شاشة في الـ Sidebar دفعة واحدة. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════ القائمة الجانبية ══════════
             أسود دافي مصمت مش متدرّج: التدرّج بيخلي البنود اللي فوق والبنود
             اللي تحت على خلفيتين مختلفتين، فالشريط الدهبي بتاع البند
             النشط بيبان بقوّتين حسب مكانه. اللون الواحد بيخلي كل بند
             يتعامل مع نفس الأرضية. -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <!-- الهوية -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal">
                        <views:WmsLogo x:Name="SidebarLogo" Width="46" Height="46" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- كان مكتوب "إدارة الإنتاج والأجور" — جملة
                                 بتوصف البرنامج، والبرنامج مفتوح قدام
                                 المستخدم أصلاً. اسم المصنع والقسم بيقولوا
                                 النسخة دي بتاعة مين، وبيتظبطوا من
                                 الإعدادات. لو مفيش اسم بيرجع للاسم
                                 العام بدل سطر فاضي. -->
                            <TextBlock x:Name="FactoryText" Text="WMS" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource GoldBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            <TextBlock x:Name="DepartmentText" FontSize="11"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                       Foreground="{DynamicResource SidebarInkSoftBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- خط دهبي رفيع بيفصل الهوية عن التنقل -->
                    <Border Height="1" Margin="0,18,0,0" Opacity="0.35"
                            Background="{DynamicResource GoldGradientBrush}" />
                </StackPanel>

                <!-- الحساب الداخل بيه + زرار الخروج: آخر حاجة في القايمة
                     الجانبية (تحت بطاقة اليوم) — ظاهرة في كل الشاشات،
                     عشان أي حد يقدر يبدّل حساب من غير ما يقفل البرنامج
                     كله (مهم دلوقتي إن الحسابات الإدارية بقى لكل واحدة
                     يوزر وباسورد لوحدها). -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,10" Padding="12,9"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource SidebarAltBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Click="Logout_Click"
                                Style="{StaticResource IconButton}" Padding="6,4"
                                Foreground="{DynamicResource SidebarInkBrush}" ToolTip="تسجيل الخروج"
                                AutomationProperties.Name="تسجيل الخروج">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="16" Height="16" />
                        </Button>
                        <TextBlock x:Name="SignedInAsText" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SidebarInkSoftBrush}" />
                    </DockPanel>
                </Border>

                <!-- بطاقة اليوم في آخر القائمة -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="13,11"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource SidebarAltBrush}">
                    <StackPanel>
                        <!-- التاريخ بالعربي بيتكتب من الكود عند فتح النافذة -->
                        <TextBlock x:Name="TodayText" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SidebarInkBrush}" />
                        <TextBlock Text="أسبوع العمل: الخميس ← الأربعاء" FontSize="10.5"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SidebarInkSoftBrush}" />
                    </StackPanel>
                </Border>

                <!-- عناصر التنقل -->
                <StackPanel Margin="12,4,12,0">
                    <!-- التنقل بـ Checked + Click مع بعض عن قصد:
                         Checked للتنقل الفعلي والكيبورد، وClick لإعادة تحميل الشاشة
                         المفتوحة أصلًا (Checked مبيتنفذش لو الزرار متعلم بالفعل) -->
                    <RadioButton x:Name="NavWorkersItem" Style="{StaticResource NavItem}" IsChecked="True"
                                 Checked="NavWorkers_Checked" Click="NavWorkers_Checked"
                                 AutomationProperties.Name="العمال">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="العمال" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavProducts_Checked" Click="NavProducts_Checked"
                                 AutomationProperties.Name="المنتجات والمراحل">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="المنتجات والمراحل" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavDailyEntry_Checked" Click="NavDailyEntry_Checked"
                                 AutomationProperties.Name="تسجيل الإنتاج اليومي">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardEditOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="تسجيل الإنتاج اليومي" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- شاشتين مختلفتين عن قصد: التقييم بتتشاف وبيتصرّف
                         منها، والتقارير بتطلّع ورق. خلطهم في شاشة واحدة
                         كان بيخلي المدير يدوّر على اللي بيهمه وسط تبويبات
                         بتعمل حاجة تانية خالص. -->
                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavEvaluation_Checked" Click="NavEvaluation_Checked"
                                 AutomationProperties.Name="التقييم والمتابعة">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="التقييم والمتابعة" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavReports_Checked" Click="NavReports_Checked"
                                 AutomationProperties.Name="التقارير">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="التقارير" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavActivityLog_Checked" Click="NavActivityLog_Checked"
                                 AutomationProperties.Name="سجل العمليات">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="سجل العمليات" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <!-- عدد العمليات اللي اتسجّلت من آخر مرة الحساب ده فتح
                                 السجل — بتتصفّر أول ما الشاشة تتفتح (ActivityLogViewModel.LoadAsync) -->
                            <!-- DangerBgBrush/DangerBrush زوج ألوان متباين بالتصميم في الثيمين
                                 (نفس زوج شارة الحذف في سجل العمليات) — لون Danger الصريح بيعكس
                                 نفسه بين الثيمين فمش آمن لوحده كخلفية مصمتة -->
                            <Border x:Name="ActivityBadge" Background="{DynamicResource DangerBgBrush}"
                                    CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="ActivityBadgeText" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavSettings_Checked" Click="NavSettings_Checked"
                                 AutomationProperties.Name="الإعدادات والنسخ">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="الإعدادات والنسخ" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- قايمة منفصلة تمامًا عن "العمال والمهارات" —
                         الحسابات دي مش عمال إنتاج -->
                    <RadioButton Style="{StaticResource NavItem}"
                                 Checked="NavDepartmentAccounts_Checked" Click="NavDepartmentAccounts_Checked"
                                 AutomationProperties.Name="الحسابات الإدارية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="الحسابات الإدارية" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════ منطقة المحتوى ══════════ -->
        <Grid Grid.Column="1">
            <Border Background="{DynamicResource GroundBrush}">
                <ContentControl x:Name="MainContent" Margin="20,18" />
            </Border>

            <!-- الإشعارات فوق المحتوى: بتظهر في الركن وبتروح لوحدها،
                 والشغل تحتها مبيتوقفش -->
            <views:ToastHost x:Name="Toasts" />
        </Grid>
    </Grid>
</Window>
