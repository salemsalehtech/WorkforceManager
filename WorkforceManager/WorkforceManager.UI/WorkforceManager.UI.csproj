<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- الإعدادات المشتركة (ImplicitUsings / Nullable / اللغات / رقم الإصدار) في Directory.Build.props -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WorkforceManager.UI</RootNamespace>
    <!-- أيقونة البرنامج (تظهر على الـ exe والاختصارات) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WorkforceManager</AssemblyName>
    <!--
      البرنامج WPF يعني ويندوز 64-بت وبس. من غير تحديد المنصة دي، حزمة SQLite
      بتنسخ مكتباتها الأصلية لـ 20 منصة (لينكس، ماك، wasm، mips، ppc64...) —
      24 ميجا في كل بناء، منها 22.5 ملهاش أي لازمة على ويندوز.
      SelfContained=false عشان البناء العادي يفضل خفيف؛ النشر المستقل بيتحدد
      من publish.ps1 وقت الحاجة.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- إعدادات نسخة التوزيع (DebugType وخلافه) في Directory.Build.props -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!--
      مطلوبة لأداة dotnet-ef عشان تقدر تولّد Migrations من مشروع UI كمشروع بداية التشغيل.
      محصورة في وضع Debug عن قصد: الحزمة دي بتجرّ معاها مترجم Roslyn
      (Microsoft.CodeAnalysis.* بـ 12 ميجا) وده كان بيتشحن مع نسخة المصنع من غير
      أي داعي — أدوات تطوير مالهاش لازمة عند المستخدم النهائي.
      أوامر dotnet ef بتبني Debug افتراضيًا فبتفضل شغالة عادي.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8"
                     Condition="'$(Configuration)' == 'Debug'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkforceManager.Business\WorkforceManager.Business.csproj" />
    <ProjectReference Include="..\WorkforceManager.Data\WorkforceManager.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- الأيقونة كـ Resource عشان تتستخدم كأيقونة النافذة (شريط المهام) كمان -->
    <Resource Include="Assets\app.ico" />
    <!--
      خط الواجهة (Tajawal) مدموج جوه الـ exe كـ Resource مش متثبت على الجهاز —
      البرنامج محمول ولازم يطلع بنفس الشكل على أي ويندوز من غير تثبيت خطوط.
      خمس أوزان ثابتة (مش variable font) عن قصد: WPF بيدعم الأوزان الثابتة صح،
      أما المتغيرة فبيرسم منها الوزن الافتراضي بس ويزوّر الباقي (synthetic bold)
      وشكله وحش. الأوزان دي بتغطي كل ما تستخدمه الشاشات:
      Light=300 / Regular=400 / Medium=500 / Bold=700 / ExtraBold=800.
      الإجمالي ~300 كيلو، والترخيص OFL (نسخته في Fonts\OFL.txt).
    -->
    <Resource Include="Fonts\*.ttf" />
    <!-- نص الترخيص بيتشحن جنب البرنامج (شرط الـ OFL) مش جوه الـ exe -->
    <Content Include="Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
