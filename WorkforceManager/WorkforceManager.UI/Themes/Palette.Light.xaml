<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============ الثيم الفاتح ============

      الهوية: **أسود ودهبي بس — مفيش كحلي خالص.** كانت الهوية الأولى
      كحلي + دهبي، وطلع الكحلي بيزاحم الدهبي: لون تاني قوي في شاشة
      المفروض لونها الأساسي واحد. الحبر والشريط الجانبي دلوقتي درجات
      محايدة دافية (رمادي-بني، صفر أزرق) بدل الكحلي — نفس الغمقان،
      نفس نسب التباين بالظبط، بس من غير ميل لأي لون تاني غير الدهبي.

      كل درجة هنا محسوبة بحيث تحافظ على **نفس نسبة التباين** اللي
      كانت للكحلي القديم (نفس الإضاءة النسبية WCAG) — مفيش تنازل في
      وضوح القراية عشان نشيل اللون.

      **الأرضية دافية مش رمادي مزرق.** ده تاني أهم قرار في الملف.
      الرمادي المزرق (#F7F8FA) لون محايد بارد — الدهبي فوقه بيبان لون
      غريب داخل على الشاشة. الأرضية الدافية (#F6F2E9) بتخلي الدهبي
      *ينتمي* للشاشة، والكروت البيضا بتطلع منها أوضح.

      ليه الدهبي مش نص: الدهبي الفاتح على الأبيض نسبة وضوحه 2.2:1 —
      والحد الأدنى لنص يتقرا هو 4.5:1. يعني نص دهبي على أبيض شكله لامع
      في الصورة ومتعب جدًا لواحد قاعد عليه 8 ساعات. الحبر الغامق على
      الأبيض 13.4:1. فالدهبي بيروح على اللي المفروض يلفت النظر: الرقم
      المهم، الزرار الرئيسي، العنصر النشط، شريط الاختيار — وبيبان
      **أكتر** لأنه نادر ولأنه اللون الوحيد في الشاشة. ولما يلزم نص
      دهبي بنستخدم GoldDeepBrush (5.9:1).

      الملف ده بيتبدّل كله في اللحظة عند تغيير الثيم، فكل الأنماط
      بتشاور على الفُرَش دي بـ DynamicResource مش StaticResource.
    -->

    <!-- ════ الأسطح ════
         سُلّم دافي: الأرضية أغمق، الكارت أبيض ناصع فوقها. -->
    <Color x:Key="GroundColor">#F6F2E9</Color>
    <SolidColorBrush x:Key="GroundBrush" Color="{DynamicResource GroundColor}" />
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <Color x:Key="SurfaceAltColor">#F1ECDF</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
    <Color x:Key="SurfaceSunkenColor">#EBE4D3</Color>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource SurfaceSunkenColor}" />

    <!-- الشريط الجانبي: أسود دافي (محايد) في الثيمين — هو هوية البرنامج،
         مش الكحلي. نفس درجة إضاءة الكحلي القديم بالظبط، غير لونه بس. -->
    <Color x:Key="SidebarColor">#342E28</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
    <Color x:Key="SidebarAltColor">#453F39</Color>
    <SolidColorBrush x:Key="SidebarAltBrush" Color="{DynamicResource SidebarAltColor}" />
    <Color x:Key="SidebarInkColor">#DED4CA</Color>
    <SolidColorBrush x:Key="SidebarInkBrush" Color="{DynamicResource SidebarInkColor}" />
    <Color x:Key="SidebarInkSoftColor">#98928C</Color>
    <SolidColorBrush x:Key="SidebarInkSoftBrush" Color="{DynamicResource SidebarInkSoftColor}" />

    <!-- ════ الحبر ════
         رمادي-بني دافي محايد — 12:1 على الأرضية و13.4:1 على الأبيض،
         نفس درجة الكحلي القديم بالظبط من غير أي ميل للأزرق. -->
    <Color x:Key="InkColor">#342E28</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource InkColor}" />
    <Color x:Key="InkSoftColor">#625C56</Color>
    <SolidColorBrush x:Key="InkSoftBrush" Color="{DynamicResource InkSoftColor}" />
    <!-- 4.6:1 على الأرضية الدافية -->
    <Color x:Key="InkFaintColor">#756D65</Color>
    <SolidColorBrush x:Key="InkFaintBrush" Color="{DynamicResource InkFaintColor}" />
    <Color x:Key="InkOnAccentColor">#2B251F</Color>
    <SolidColorBrush x:Key="InkOnAccentBrush" Color="{DynamicResource InkOnAccentColor}" />

    <!-- ════ الدهبي ════ -->
    <Color x:Key="GoldColor">#C2A14D</Color>
    <SolidColorBrush x:Key="GoldBrush" Color="{DynamicResource GoldColor}" />
    <!-- أغمق: النص الدهبي على الفاتح لما يلزم (5.9:1) -->
    <Color x:Key="GoldDeepColor">#8A6D1F</Color>
    <SolidColorBrush x:Key="GoldDeepBrush" Color="{DynamicResource GoldDeepColor}" />
    <Color x:Key="GoldTintColor">#FBF5E4</Color>
    <SolidColorBrush x:Key="GoldTintBrush" Color="{DynamicResource GoldTintColor}" />
    <Color x:Key="GoldLineColor">#E0CFA2</Color>
    <SolidColorBrush x:Key="GoldLineBrush" Color="{DynamicResource GoldLineColor}" />

    <!-- مسار شريط القياس: بيج فاتح دافي مختلف عن التعبئة البني الغامق (شوف شرايط الرصيد الأولي) -->
    <Color x:Key="MeterTrackColor">#E7DCC1</Color>
    <SolidColorBrush x:Key="MeterTrackBrush" Color="{DynamicResource MeterTrackColor}" />

    <!-- المعدن: الدهبي المصمت بيبان دهان، والتدرج بيبان معدن -->
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0C378" Offset="0" />
        <GradientStop Color="#C2A14D" Offset="0.5" />
        <GradientStop Color="#A9852F" Offset="1" />
    </LinearGradientBrush>

    <!-- خط شعري بيبدأ ويخلص شفاف — تحت العناوين -->
    <LinearGradientBrush x:Key="GoldHairlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C2A14D" Offset="0" />
        <GradientStop Color="#C2A14D" Offset="0.15" />
        <GradientStop Color="#00C2A14D" Offset="1" />
    </LinearGradientBrush>

    <!-- الأسود الدافي العميق للكروت البطلة (بدل الكحلي القديم) -->
    <LinearGradientBrush x:Key="InkGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#453F39" Offset="0" />
        <GradientStop Color="#2B251F" Offset="1" />
    </LinearGradientBrush>

    <!-- ════ الخطوط الفاصلة ════ (دافية زي الأرضية) -->
    <Color x:Key="LineColor">#E7E0CE</Color>
    <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}" />
    <Color x:Key="LineStrongColor">#D5CAB0</Color>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{DynamicResource LineStrongColor}" />

    <!-- ════ التفاعل ════ -->
    <Color x:Key="HoverColor">#FAF5E9</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <Color x:Key="PressedColor">#F2E9D4</Color>
    <SolidColorBrush x:Key="PressedBrush" Color="{DynamicResource PressedColor}" />
    <Color x:Key="SelectedColor">#FCF4DE</Color>
    <SolidColorBrush x:Key="SelectedBrush" Color="{DynamicResource SelectedColor}" />
    <Color x:Key="FocusRingColor">#C2A14D</Color>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />

    <!-- ════ ألوان الحالة ════

         **مفيش أخضر ولا أزرق ولا أحمر أساسي.** كلهم اتشالوا: كانوا
         أعلى لون مشبع في الشاشة، يعني أكتر حاجة بتخطف العين كانت أقل
         حاجة مهمة — والهوية بتتكسر.

         اللي فضل كله جوه عيلة الدهبي والرمادي-البني المحايد:
           • الكويس  = دهبي غامق (الدهبي هو "أيوه" في الهوية دي)
           • تحذير   = برونزي أغمق وأقل صفار — نفس العيلة، عمق مختلف
           • خطر     = طوبي دافي، جار الدهبي مش لون غريب
           • معلومة  = رمادي-بني دافي محايد

         **الخطر هو الاستثناء الوحيد وبقصد.** زرار "احذف" لو شكله زي
         زرار "احفظ" دي مشكلة أمان مش اختيار جمالي. الطوبي هنا دافي
         عشان يفضل من نفس العالم، مش أحمر إشارة مرور. -->
    <Color x:Key="GoodColor">#8A6D1F</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="{DynamicResource GoodColor}" />
    <Color x:Key="GoodTintColor">#FBF5E4</Color>
    <SolidColorBrush x:Key="GoodTintBrush" Color="{DynamicResource GoodTintColor}" />

    <Color x:Key="WarnColor">#8F5B14</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
    <Color x:Key="WarnTintColor">#F9EEDA</Color>
    <SolidColorBrush x:Key="WarnTintBrush" Color="{DynamicResource WarnTintColor}" />

    <Color x:Key="DangerColor">#A0342A</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <Color x:Key="DangerTintColor">#F8E9E5</Color>
    <SolidColorBrush x:Key="DangerTintBrush" Color="{DynamicResource DangerTintColor}" />

    <Color x:Key="InfoColor">#4F4941</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <Color x:Key="InfoTintColor">#EFEEE6</Color>
    <SolidColorBrush x:Key="InfoTintBrush" Color="{DynamicResource InfoTintColor}" />

    <!-- ════ ألوان الرسوم البيانية ════

         ثمن لون للمنتجات في الرسم المكدّس. اللوحة القديمة كانت أزرق
         وبرتقالي وأحمر وبنفسجي وأخضر — سبع هويات مختلفة في رسم واحد.

         دي **بتتبادل** دهبي/رمادي-بني دافي بقصد (بدل دهبي/كحلي):
         لونين متجاورين في العمود لازم يبقوا مميزين عن بعض. التبادل
         بيدّي أقصى فرق بين كل شريحة واللي جنبها وإحنا لسه في عيلتين
         بس. الدرجتين 2 و8 كانوا متطابقين تقريبًا في اللوحة الكحلية
         القديمة (فرق 5 في قناة واحدة) — اتصلّحوا هنا كمان. -->
    <SolidColorBrush x:Key="Series1Brush" Color="#C2A14D" />
    <SolidColorBrush x:Key="Series2Brush" Color="#3A342D" />
    <SolidColorBrush x:Key="Series3Brush" Color="#DCC077" />
    <SolidColorBrush x:Key="Series4Brush" Color="#6E675E" />
    <SolidColorBrush x:Key="Series5Brush" Color="#8A6D1F" />
    <SolidColorBrush x:Key="Series6Brush" Color="#A79F92" />
    <SolidColorBrush x:Key="Series7Brush" Color="#5B4816" />
    <SolidColorBrush x:Key="Series8Brush" Color="#524C43" />
    <!-- التاسع فما فوق: رمادي محايد. توليد لون جديد أو لفّ اللوحة من
         أولها بيدي لونين متطابقين لمنتجين مختلفين من غير ما حد يعرف. -->
    <SolidColorBrush x:Key="SeriesOtherBrush" Color="#9A9384" />

    <!-- ════ الظلال ════ -->
    <Color x:Key="ShadowColor">#3A2E14</Color>

    <!-- ════ الأسماء القديمة ════

         الشاشات اللي لسه ماتعادش تصميمها بتشاور على أسماء فُرَش قديمة.
         الأسماء دي كانت في ملف Compat.xaml لوحده، **وده كان غلط**:
         الـ SolidColorBrush اللي بيتعرّف في ResourceDictionary بيتجمّد
         (Freeze)، فالـ DynamicResource اللي جواه بيتحل **مرة واحدة** وقت
         التحميل وبعدها عمره ما بيتحدّث. يعني الأسماء دي كانت بتتجمّد على
         ألوان الثيم الفاتح وتفضل كده — وتبديل الثيم عمره ما كان بيوصلها.
         ده كان السبب الحقيقي إن الوضع الليلي بيطلع نصه فاتح.

         مكانها هنا بيحل المشكلة من جذرها: ملف اللوحة بيتبدّل **بالكامل**
         عند تغيير الثيم، فالأسماء دي بتتولد من جديد بألوان الثيم الجديد.
         مفيش تجميد يقدر يمسكها.

         بتتشال مع آخر شاشة تتحوّل للأسماء الجديدة. -->
    <SolidColorBrush x:Key="BrandBrush" Color="{DynamicResource InkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource GoldColor}" />
    <SolidColorBrush x:Key="PageBgBrush" Color="{DynamicResource GroundColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource LineColor}" />
    <SolidColorBrush x:Key="SubtleBgBrush" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SoftPanelBgBrush" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SoftPanelBorderBrush" Color="{DynamicResource LineColor}" />
    <SolidColorBrush x:Key="ChipBgBrush" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{DynamicResource LineColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource InkColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource InkSoftColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="{DynamicResource SelectedColor}" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="{DynamicResource GoldColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource GoodColor}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{DynamicResource GoodTintColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{DynamicResource DangerTintColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{DynamicResource WarnTintColor}" />

</ResourceDictionary>
