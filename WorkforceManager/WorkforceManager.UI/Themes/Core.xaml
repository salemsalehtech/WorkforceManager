<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      ============ نظام التصميم: المقاسات والأنماط الأساسية ============

      كل الألوان هنا بـ DynamicResource مش StaticResource. الفرق مش
      شكلي: StaticResource بتتحل مرة واحدة وقت تحميل الشاشة، فتبديل
      الثيم كان بيحتاج إعادة تشغيل. DynamicResource بتفضل مربوطة،
      فتبديل ملف الألوان بيتنقل للشاشة في اللحظة.

      **استثناء واحد: BasedOn لازم StaticResource.** هي خاصية CLR عادية
      على Style مش DependencyProperty، وDynamicResource عليها بترمي وقت
      التحميل. وده مش بيكسر حاجة — الألوان جوه النمط الأساسي نفسها
      DynamicResource وفاضلة حيّة.
    -->

    <!-- ============ سُلّم الخط ============
         سبع مقاسات وبس. أي مقاس بره السلم بيخلي الشاشات تختلف عن بعض
         من غير سبب. -->
    <sys:Double x:Key="FontMicro">10.5</sys:Double>
    <sys:Double x:Key="FontTiny">11.5</sys:Double>
    <sys:Double x:Key="FontSmall">12.5</sys:Double>
    <sys:Double x:Key="FontBase">13.5</sys:Double>
    <sys:Double x:Key="FontLarge">15.5</sys:Double>
    <sys:Double x:Key="FontTitle">19</sys:Double>
    <sys:Double x:Key="FontDisplay">26</sys:Double>

    <!--
      Tajawal — خط هندسي حديث مصمم للعربي والإنجليزي مع بعض، فالأرقام
      والكلمات الإنجليزية بتتناسق مع العربي في نفس السطر بدل ما ويندوز
      يستبدل خط تاني للعربي. مدموج في الـ exe (شوف Fonts في ملف المشروع)
      فمش محتاج تثبيت. الاحتياطي بعد الفاصلة مهم: لو المورد فشل لأي سبب
      الواجهة بترجع لخط النظام بدل خط افتراضي وحش.
    -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Tajawal, Segoe UI, Tahoma</FontFamily>

    <!-- ============ الزوايا ============ -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ============ الظل ============
         ظل واحد خفيف. الظلال المتعددة بتخلي الشاشة تبان مليانة طبقات.
         في الثيم الغامق الظل مبيعملش حاجة تقريبًا وده مقصود: الغامق
         بيفصل بالإضاءة (سُلّم الأسطح) مش بالظل. -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Direction="270"
                      Opacity="0.10" Color="{DynamicResource ShadowColor}" />

    <DropShadowEffect x:Key="LiftShadow" BlurRadius="30" ShadowDepth="8" Direction="270"
                      Opacity="0.18" Color="{DynamicResource ShadowColor}" />

    <!-- ============ حركة موحّدة ============ -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <Duration x:Key="Quick">0:0:0.15</Duration>

    <!-- ============ النصوص ============

         **النمط الضمني ده هو اللي بيخلي الوضع الليلي شغّال.** أي
         TextBlock من غير Foreground صريح بياخد الأسود الافتراضي بتاع
         WPF — يعني أسود على أسود، مختفي تمامًا. وده كان في عشرات
         الأماكن في البرنامج، ومحدش كان بيلاحظه في الثيم الفاتح لأن
         الأسود على أبيض شكله سليم.

         الأنماط المسمّاة تحت (Body / Title / …) بتغلبه لما تتحط
         بالاسم، والنص اللي المفروض يبقى فاتح (على رأس كحلي مثلاً)
         عنده Foreground صريح فبرضه بيغلبه. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
    </Style>

    <!-- الرقم البطل في الكروت — الدهبي بيروح هنا -->
    <Style x:Key="Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
    </Style>

    <!-- ============ الكارت ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- كارت بحد دهبي — للحاجة اللي المفروض تشدّ العين -->
    <Style x:Key="CardAccent" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource GoldLineBrush}" />
    </Style>

    <!-- الكارت البطل: كحلي عميق في الثيمين — عليه الدهبي بيلمع -->
    <Style x:Key="CardHero" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InkGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GoldLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- ============ الخط الشعري الدهبي ============
         تحت عنوان الصفحة. بيبدأ مصمت من ناحية العنوان وبيسيح لشفاف —
         خط مصمت من الحرف للحرف بيبان قاطع، والمتلاشي بيبان مقصود. -->
    <Style x:Key="GoldHairline" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource GoldHairlineBrush}" />
        <Setter Property="CornerRadius" Value="1" />
    </Style>

    <!-- ============ مربّع رقم ============
         الرقم أولًا وكبير، والكلمة تحته صغيرة. العكس بيخلي العين تقرا
         الكلمة الأول وتدوّر على الرقم. -->
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontMicro}" />
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============ وسم صغير ============
         "بالإنتاج" / "عامل تحت التدريب" — معلومة مساعدة، فمحدّد بخط
         شعري مش معبّي بلون. المعبّي بلون بيسحب نظر أكتر من الاسم نفسه. -->
    <Style x:Key="PillTag" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillTagGold" TargetType="Border" BasedOn="{StaticResource PillTag}">
        <Setter Property="Background" Value="{DynamicResource GoldTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GoldLineBrush}" />
    </Style>

    <!-- ============ الأزرار ============ -->

    <!-- الأساسي: دهبي. واحد بس في الشاشة — هو الفعل الرئيسي -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkOnAccentBrush}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSmall}"
                                Background="{DynamicResource GoldGradientBrush}" />
                        <!-- لمعة علوية خفيفة: بتدّي إحساس المعدن -->
                        <Border CornerRadius="{DynamicResource RadiusSmall}" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Ring" CornerRadius="11" Margin="-3"
                                BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                                Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource LiftShadow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- الثانوي: محدّد بس -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- زرار أيقونة شفاف -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ شريحة الفلتر ============
         **المختار دهبي مصمت والنص كحلي.** كان كحلي مصمت ونص دهبي —
         وده كان بيختفي تمامًا في الثيم الغامق: شريحة كحلي فوق كارت
         كحلي فوق أرضية كحلي. الدهبي هو اللون الوحيد اللي بيبان بنفس
         القوة على الأبيض وعلى الغامق، فهو اللي المفروض يقول "دي
         المختارة". -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusPill}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                            Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldGradientBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource InkOnAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ بند القايمة الجانبية ============ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarInkBrush}" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSmall}"
                                Background="Transparent" Padding="14,11" />

                        <!-- توهّج دهبي خفيف جوه البند النشط -->
                        <Border x:Name="Glow" CornerRadius="{DynamicResource RadiusSmall}" Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop Color="#26C2A14D" Offset="0" />
                                    <GradientStop Color="#00C2A14D" Offset="0.85" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- الشريط الدهبي على حرف البند النشط -->
                        <Border x:Name="Mark" Width="3" HorizontalAlignment="Right"
                                Margin="0,9" CornerRadius="2"
                                Background="{DynamicResource GoldGradientBrush}" Opacity="0" />

                        <ContentPresenter Margin="14,11" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarAltBrush}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ خانة الإدخال ============ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GoldBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GoldBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineStrongBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InkFaintBrush}" />
                        </Trigger>
                        <!-- التركيز دهبي: المستخدم عارف هو بيكتب فين -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GoldBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GoldBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- ============ القايمة المنسدلة ============

         **بترث قالب MaterialDesign بدل قالب من عندنا.** كتبت قالب
         كامل الأول وطلع فيه عيب خطير: الـ ContentPresenter بتاع
         الاختيار مبيحترمش DisplayMemberPath، وكل القوايم في البرنامج
         بتستخدمه — فبدل ما يظهر اسم المرحلة كان بيظهر ToString بتاع
         الكائن نفسه:
             StageFilterOption { StageId = 1, Display = GRS }
         منطق اختيار قالب العنصر في WPF أعقد من ContentPresenter واحد،
         وقالب المكتبة متعامل معاه صح من زمان. مفيش داعي نعيد كتابته
         عشان شكل الحدود.

         Outlined عن قصد مش الافتراضي (اللي بخط تحتاني): ده اللي بيدي
         حقل بحدود وزوايا مدوّرة زي باقي حقول البرنامج.

         الألوان بترجع للوحتنا بعد الوراثة، وثيم المكتبة بقى بيمشي مع
         ثيمنا (شوف ApplyTheme)، فالنتيجة قالبهم بهويتنا. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>


    <!--
      حقل التاريخ بيرث قالب MaterialDesign بدل ما نكتب واحد من الصفر.
      الـ DatePicker جواه تقويم منبثق كامل وزرار تقويم — إعادة بنائهم
      شغل كتير لعنصر بيظهر في 10 أماكن، وقالب المكتبة متعامل معاهم
      كويس **وبقى بيسمع لثيمنا** بعد ما ApplyTheme بقت تبدّل
      BaseTheme بتاعها كمان. اللي كان هنا قبل كده نمط بيظبط المسافة
      والخط بس، فالعنصر كان بيفضل على قالب ويندوز الافتراضي: زرار
      تقويم أبيض ناصع وسط شاشة سودا.

      الألوان بعدها بتترجع للوحتنا، فالنتيجة قالب المكتبة بهويتنا.
    -->
    <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignDatePicker}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============ شريط التمرير ============

         شريط ويندوز الافتراضي (مربع رمادي + زرارين سهم) هو أوضح إشارة
         إن البرنامج قديم — وبيظهر في كل شاشة فيها قايمة. البديل: خيط
         رفيع من غير زراير، بيدهّب لما الماوس يقرب.

         RepeatButton بتوع الصفحة لازم يفضلوا موجودين (الدوس على فاضي
         التراك بيصفّح) بس بقالب شفاف بدل السهم. -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusPill}" Margin="3"
                            Background="{DynamicResource LineStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource ScrollPageButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource ScrollPageButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ التلميحة ============
         الافتراضي أصفر بحد أسود — من ويندوز 95 حرفيًا. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontTiny}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource GoldLineBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}" Padding="10,7"
                            MaxWidth="320" Effect="{DynamicResource CardShadow}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
