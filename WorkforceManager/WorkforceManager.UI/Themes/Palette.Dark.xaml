<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============ الثيم الغامق ============

      **مش عكس الفاتح.** قلب الألوان حرفيًا بيطلع رمادي ميت وحواف
      قاسية. الغامق هنا اتبنى لوحده: الأسطح كحلي مزرق (مش أسود) عشان
      الدهبي يدفا عليه، والحبر مش أبيض ناصع (بيبهر في الضلمة) — لبني
      فاتح.

      **أهم إصلاح هنا: سُلّم الارتفاع.** النسخة اللي فاتت كانت أرضية
      #0A101A وكارت #121C2A — فرق 8 درجات بس. على شاشة حقيقية ده
      مبيتشافش، فالكروت كانت بتدوب في الخلفية والصفحة كلها تبان لطعة
      واحدة. دلوقتي الفرق بقى تقريبًا التلت، والخط الفاصل بقى يتشاف
      فعلًا فوق سطح الكارت. الكارت لازم يبان إنه *حاجة* مرفوعة، مش
      مساحة لونها قريب.

      والدهبي هنا **أفتح** من الفاتح: #E3C271 بدل #C2A14D. الدهبي
      الغامق على سطح غامق بيبقى بني باهت. الفكرة إن اللون يفضل *يقرا*
      دهبي، مش إن الرقم يفضل واحد.

      نفس المفاتيح بالظبط زي الفاتح — الملف بيتبدّل مكانه في اللحظة.
    -->

    <!-- ════ الأسطح ════
         سُلّم واضح: أرضية ← كارت ← مرفوع. كل درجة تتشاف بالعين. -->
    <Color x:Key="GroundColor">#070B12</Color>
    <SolidColorBrush x:Key="GroundBrush" Color="{DynamicResource GroundColor}" />
    <Color x:Key="SurfaceColor">#131F31</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <Color x:Key="SurfaceAltColor">#1D2C42</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
    <Color x:Key="SurfaceSunkenColor">#0C1420</Color>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource SurfaceSunkenColor}" />

    <Color x:Key="SidebarColor">#050810</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
    <Color x:Key="SidebarAltColor">#141F33</Color>
    <SolidColorBrush x:Key="SidebarAltBrush" Color="{DynamicResource SidebarAltColor}" />
    <Color x:Key="SidebarInkColor">#CBD5E3</Color>
    <SolidColorBrush x:Key="SidebarInkBrush" Color="{DynamicResource SidebarInkColor}" />
    <Color x:Key="SidebarInkSoftColor">#7C8CA3</Color>
    <SolidColorBrush x:Key="SidebarInkSoftBrush" Color="{DynamicResource SidebarInkSoftColor}" />

    <!-- ════ الحبر ════ -->
    <!-- مش أبيض ناصع: #FFFFFF على غامق بيبهر العين في الضلمة -->
    <Color x:Key="InkColor">#E9EFF7</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource InkColor}" />
    <Color x:Key="InkSoftColor">#A3B2C6</Color>
    <SolidColorBrush x:Key="InkSoftBrush" Color="{DynamicResource InkSoftColor}" />
    <Color x:Key="InkFaintColor">#75879F</Color>
    <SolidColorBrush x:Key="InkFaintBrush" Color="{DynamicResource InkFaintColor}" />
    <Color x:Key="InkOnAccentColor">#0B1220</Color>
    <SolidColorBrush x:Key="InkOnAccentBrush" Color="{DynamicResource InkOnAccentColor}" />

    <!-- ════ الدهبي ════ -->
    <Color x:Key="GoldColor">#E3C271</Color>
    <SolidColorBrush x:Key="GoldBrush" Color="{DynamicResource GoldColor}" />
    <!-- على الغامق الدهبي واضح أصلاً، فنسخة "الغامق" بتبقى أفتح شوية -->
    <Color x:Key="GoldDeepColor">#F0D89A</Color>
    <SolidColorBrush x:Key="GoldDeepBrush" Color="{DynamicResource GoldDeepColor}" />
    <Color x:Key="GoldTintColor">#251D0E</Color>
    <SolidColorBrush x:Key="GoldTintBrush" Color="{DynamicResource GoldTintColor}" />
    <Color x:Key="GoldLineColor">#57451F</Color>
    <SolidColorBrush x:Key="GoldLineBrush" Color="{DynamicResource GoldLineColor}" />

    <!-- المعدن: الدهبي المصمت بيبان دهان، والتدرج بيبان معدن -->
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2DCA4" Offset="0" />
        <GradientStop Color="#E3C271" Offset="0.5" />
        <GradientStop Color="#C29B45" Offset="1" />
    </LinearGradientBrush>

    <!-- خط شعري بيبدأ ويخلص شفاف — تحت العناوين -->
    <LinearGradientBrush x:Key="GoldHairlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E3C271" Offset="0" />
        <GradientStop Color="#E3C271" Offset="0.15" />
        <GradientStop Color="#00E3C271" Offset="1" />
    </LinearGradientBrush>

    <!-- الكحلي العميق للكروت البطلة -->
    <LinearGradientBrush x:Key="InkGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D2C42" Offset="0" />
        <GradientStop Color="#0C1420" Offset="1" />
    </LinearGradientBrush>

    <!-- ════ الخطوط الفاصلة ════
         لازم تتشاف فوق SurfaceColor — القديم كان قريب منه أوي -->
    <Color x:Key="LineColor">#27384F</Color>
    <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}" />
    <Color x:Key="LineStrongColor">#3B5170</Color>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{DynamicResource LineStrongColor}" />

    <!-- ════ التفاعل ════ -->
    <Color x:Key="HoverColor">#1D2C42</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <Color x:Key="PressedColor">#26374F</Color>
    <SolidColorBrush x:Key="PressedBrush" Color="{DynamicResource PressedColor}" />
    <Color x:Key="SelectedColor">#2E2413</Color>
    <SolidColorBrush x:Key="SelectedBrush" Color="{DynamicResource SelectedColor}" />
    <Color x:Key="FocusRingColor">#E3C271</Color>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />

    <!-- ════ ألوان الحالة ════
         نفس منطق الفاتح: مفيش أخضر ولا أزرق. دهبي = كويس، برونزي =
         تحذير، طوبي دافي = خطر، كحلي فاتح = معلومة. التفاصيل الكاملة
         في Palette.Light.xaml. -->
    <Color x:Key="GoodColor">#E3C271</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="{DynamicResource GoodColor}" />
    <Color x:Key="GoodTintColor">#251D0E</Color>
    <SolidColorBrush x:Key="GoodTintBrush" Color="{DynamicResource GoodTintColor}" />

    <Color x:Key="WarnColor">#E09A3F</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
    <Color x:Key="WarnTintColor">#2C1F0C</Color>
    <SolidColorBrush x:Key="WarnTintBrush" Color="{DynamicResource WarnTintColor}" />

    <Color x:Key="DangerColor">#E08072</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <Color x:Key="DangerTintColor">#2F1815</Color>
    <SolidColorBrush x:Key="DangerTintBrush" Color="{DynamicResource DangerTintColor}" />

    <Color x:Key="InfoColor">#9BB0CC</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <Color x:Key="InfoTintColor">#16212F</Color>
    <SolidColorBrush x:Key="InfoTintBrush" Color="{DynamicResource InfoTintColor}" />

    <!-- ════ ألوان الرسوم البيانية ════
         نفس منطق الفاتح (تبادل دهبي/كحلي) بس كل الدرجات مرفوعة عشان
         تتقرا على سطح غامق — الكحلي الغامق على كارت كحلي مبيبانش. -->
    <SolidColorBrush x:Key="Series1Brush" Color="#E3C271" />
    <SolidColorBrush x:Key="Series2Brush" Color="#8FA5C4" />
    <SolidColorBrush x:Key="Series3Brush" Color="#F2DCA4" />
    <SolidColorBrush x:Key="Series4Brush" Color="#5C7EA3" />
    <SolidColorBrush x:Key="Series5Brush" Color="#C29B45" />
    <SolidColorBrush x:Key="Series6Brush" Color="#B9C9DC" />
    <SolidColorBrush x:Key="Series7Brush" Color="#9A7C2E" />
    <SolidColorBrush x:Key="Series8Brush" Color="#43617F" />
    <SolidColorBrush x:Key="SeriesOtherBrush" Color="#6E7686" />

    <!-- ════ الظلال ════ -->
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>
