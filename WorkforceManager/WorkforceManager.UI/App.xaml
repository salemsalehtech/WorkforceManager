<Application x:Class="WorkforceManager.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Amber" />
                <!-- في MaterialDesignThemes 5.x اتغير اسم ملف الأنماط الافتراضية
                     القديمة (Material Design 2) لـ MaterialDesign2.Defaults.xaml —
                     المسار القديم "MaterialDesignTheme.Defaults.xaml" مبقاش موجود
                     في المكتبة وبيطلع IOException -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

                <!-- ============ الهوية الجديدة ============
                     ترتيب الدمج مقصود:
                       1. Palette  = ألوان الهوية (بيتبدّل بالكامل مع الثيم،
                                     وجواه كمان أسماء الفُرَش القديمة)
                       2. Core     = المقاسات والأنماط الجديدة
                     اللي بيتدمج بعدين بيكسب، فـ Core بتغلب الأنماط القديمة
                     اللي تحت بنفس الاسم.

                     **Compat.xaml اتشال.** كان ملف تالت بيربط الأسماء
                     القديمة بالجديدة، والفكرة كانت سليمة بس التنفيذ لأ:
                     الـ SolidColorBrush اللي بيتعرّف في ResourceDictionary
                     بيتجمّد، فالـ DynamicResource اللي جواه بيتحل مرة
                     واحدة وقت التحميل وخلاص. يعني الأسماء دي كانت بتتجمّد
                     على الثيم الفاتح ومكانش فيه تبديل بيوصلها. مكانها
                     دلوقتي جوه ملف اللوحة نفسه، واللوحة بتتبدّل بالكامل.

                     الفهرس صفر متحجوز لـ Palette — ApplyTheme بتبدّله. -->
                <ResourceDictionary Source="Themes/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/Core.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- محوّل بولياني → ظهور/إخفاء (لعناصر بتظهر بس لما يبقى فيه بيانات) -->
            <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

            <!-- ======================================================
                 نظام التصميم الموحد (Design System)
                 كل ألوان وأنماط الواجهة في مكان واحد — أي شاشة بتستخدم
                 نفس المراجع دي، فالشكل متناسق والتعديل من نقطة واحدة
                 ====================================================== -->

            <!-- ــــــــــ ألوان MaterialDesign ــــــــــ

                 **لوحة الألوان القديمة كانت هنا واتشالت.** كانت 24 فرشاة
                 معرّفة *مباشرة* في Application.Resources — والمباشر في WPF
                 بيغلب أي حاجة جاية من MergedDictionaries، فالجسر اللي
                 المفروض بيربط الأسماء القديمة بالهوية الجديدة كان **ميت
                 من يوم ما اتكتب**: كل شاشة غير اللي اتعمل لها إعادة تصميم
                 كانت لسه بتترسم بالأزرق والبرتقالي القدام. الأسماء دي
                 كلها بقت جوه ملف اللوحة نفسه (Palette.Light/Dark)، عشان
                 تتبدّل مع الثيم زي باقي الألوان.

                 اللي فضل هنا هو ألوان MaterialDesign بس، ولازم تفضل
                 مباشرة لنفس السبب بالظبط — دي الطريقة الوحيدة إنها تغلب
                 القاموس بتاع المكتبة. بس بقت بتاخد لونها من اللوحة
                 (DynamicResource) بدل ما تكون أرقام مكتوبة بالإيد، فبتتغير
                 مع الثيم زي أي حاجة تانية.

                 BundledTheme.PrimaryColor بياخد أسماء ألوان Material بس
                 (مش Hex حر)، فالتحكم الحقيقي بيحصل من هنا. -->
            <!-- الـ Primary بتاع MaterialDesign هو لون التمييز في كل
                 عناصرها: علامة الـ CheckBox، نقطة الـ RadioButton،
                 اليوم المختار في التقويم، مؤشر الـ TabControl. كان
                 مربوط بالحبر — يعني في الثيم الأسود بقى **أبيض تقريبًا**
                 (الحبر هناك #EDEDED)، فمربع الاختيار كان بيطلع مربع
                 أبيض ناصع وسط شاشة سودا. الدهبي هو لون التمييز عندنا،
                 فهو اللي المفروض يكون هنا. -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{DynamicResource GoldLineColor}" />
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="{DynamicResource InkOnAccentColor}" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{DynamicResource GoldColor}" />
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="{DynamicResource InkOnAccentColor}" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{DynamicResource GoldDeepColor}" />
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="{DynamicResource InkOnAccentColor}" />
            <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="{DynamicResource GoldLineColor}" />
            <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="{DynamicResource InkOnAccentColor}" />
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{DynamicResource GoldColor}" />
            <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="{DynamicResource InkOnAccentColor}" />
            <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="{DynamicResource GoldDeepColor}" />
            <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="{DynamicResource SurfaceColor}" />

            <!-- ══════════════════════════════════════════════════
                 الخطوط (Typography)
                 ══════════════════════════════════════════════════ -->
            <!-- AppFont اتنقل لـ Themes/Core.xaml مع باقي نظام التصميم —
                 كان معرّف هنا وفي Core بقيمتين مختلفتين، والمباشر بيغلب،
                 فسلّم الخطوط الجديد كان شغال بخط غير اللي مكتوب فيه. -->

            <!-- سلّم أحجام موحّد — بدل أرقام متناثرة في كل شاشة.
                 كل درجة ليها وزن ولون وتباعد أسطر مناسب لدورها -->

            <!-- عنوان الشاشة الكبير (شاشة الدخول، رأس القسيمة) -->
            <Style x:Key="DisplayText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="LineHeight" Value="36" />
            </Style>

            <!-- عنوان رئيسي داخل الشاشة (اسم العامل/المنتج في لوحة التفاصيل) -->
            <Style x:Key="HeadingText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                <Setter Property="LineHeight" Value="26" />
            </Style>

            <!-- عنوان قسم داخل بطاقة -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            </Style>

            <!-- تسمية حقل إدخال -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <!-- نص شرح/تلميح تحت الحقول — أخف وزن وأهدى لون عشان ميزاحمش المحتوى -->
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="18" />
            </Style>

            <!-- رقم بارز (إحصائية/مبلغ) — الأرقام في Tajawal بعرض ثابت فبتتصف تحت بعض -->
            <!-- ــــــــــ الإطار العام للنوافذ ــــــــــ -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <!--
              النوافذ في المشروع بتحدد FontFamily على نفسها (لأن نمط Window
              الضمني مبيوصلش للأنواع المشتقة زي MainWindow)، والـ UserControl
              مش بيرث من نمط الـ Window أصلاً — فبنحط نمط ضمني للنوعين دول
              كمان عشان الخط يوصل لكل شاشة من غير تكرار في كل ملف
            -->
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <!-- النصوص العادية اللي مش ماخدة نمط من فوق -->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>

            <!-- ــــــــــ البطاقات ــــــــــ -->
            <!-- ظل ناعم موحّد — إحساس بارتفاع البطاقة عن خلفية الصفحة من غير ما يزعج العين -->
            <DropShadowEffect x:Key="CardShadow" Color="{DynamicResource ShadowColor}" Direction="270" ShadowDepth="1.5"
                              BlurRadius="16" Opacity="0.08" />

            <!-- بطاقة محتوى بيضاء بحواف ناعمة — الوحدة الأساسية لأي لوحة في الشاشات -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            </Style>

            <!-- شريط أدوات أعلى الشاشة (بحث/أزرار) -->
            <Style x:Key="ToolbarCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- ══════════════════════════════════════════════════
                 الأزرار
                 ══════════════════════════════════════════════════ -->
            <!--
              منحنى تسارع موحّد لكل الحركات — البداية سريعة والنهاية بتهدى،
              وده اللي بيدي الإحساس "الطبيعي" بدل الحركة الخطية الميكانيكية
            -->
            <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

            <!--
              الزر الأساسي: 5 طبقات فوق بعض جوه Grid واحد —
                1) Shade  : خلفية اللون الأساسي + الظل اللي بيكبر عند المرور
                2) Sheen  : تدرّج شفاف (فاتح من فوق/غامق من تحت) بيدي إحساس بالحجم
                3) Glow   : طبقة بيضا بتزيد شفافيتها عند المرور = تفتيح ناعم
                4) Pulse  : دايرة بتتمدد وتتلاشى عند الضغط (إحساس اللمسة/الـ ripple)
                5) المحتوى

              كل الحركات على ScaleTransform وOpacity — دول أرخص حاجة في WPF
              (بيتنفذوا على مستوى الـ composition من غير إعادة رسم للـ layout)
            -->
            <Style x:Key="BaseActionButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <!-- الإطار المنقّط الافتراضي وحش؛ بنعمل حلقة تركيز خاصة بينا تحت -->
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <!-- TransformGroup عشان نقدر نكبّر ونرفع في نفس الوقت -->
                                    <TransformGroup>
                                        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="RootLift" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- 1) اللون الأساسي + الظل -->
                                <Border x:Name="Shade" CornerRadius="10"
                                        Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="Shadow" Color="{DynamicResource ShadowColor}" Direction="270"
                                                          ShadowDepth="2" BlurRadius="9" Opacity="0.28" />
                                    </Border.Effect>
                                </Border>

                                <!-- 2) تدرّج الحجم -->
                                <Border CornerRadius="10" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2BFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#18000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- 3) تفتيح المرور -->
                                <Border x:Name="Glow" CornerRadius="10" Background="White"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- 4) نبضة الضغط -->
                                <Border x:Name="Pulse" CornerRadius="10" Background="White"
                                        Opacity="0" IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale" ScaleX="0.75" ScaleY="0.75" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- حلقة التركيز بالكيبورد (Tab) — مهمة للوصولية -->
                                <Border x:Name="FocusRing" CornerRadius="13" Margin="-3"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- 5) المحتوى -->
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- المرور: يفتح لون + يكبر شوية + يرتفع + ظله يوسع -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                                 To="0.16" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.025" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.025" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootLift" Storyboard.TargetProperty="Y"
                                                                 To="-1.5" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius"
                                                                 To="18" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="ShadowDepth"
                                                                 To="5" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                                 To="0.36" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootLift" Storyboard.TargetProperty="Y"
                                                                 To="0" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius"
                                                                 To="9" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="ShadowDepth"
                                                                 To="2" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                                 To="0.28" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- الضغط: الزر بينضغط جوه + نبضة بتتمدد وتختفي -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.97" Duration="0:0:0.09"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.97" Duration="0:0:0.09"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootLift" Storyboard.TargetProperty="Y"
                                                                 To="0" Duration="0:0:0.09" />
                                                <!-- النبضة: تظهر فجأة وتتلاشى وهي بتكبر -->
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                                 From="0.75" To="1" Duration="0:0:0.38"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                                 From="0.75" To="1" Duration="0:0:0.38"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                                 From="0.30" To="0" Duration="0:0:0.38"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- تركيز الكيبورد: حلقة كهرمانية حوالين الزر -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                                </Trigger>

                                <!-- معطّل: باهت + بلا ظل + المؤشر عادي -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                    <Setter TargetName="Shade" Property="Effect" Value="{x:Null}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- الزر الرئيسي (كحلي) — الفعل الأساسي في أي شاشة -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
                <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
            </Style>

            <!-- زر النجاح (أخضر) — إضافة/تصدير -->
            <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            </Style>

            <!-- زر الخطر (أحمر) — جزاءات وما شابه -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            </Style>

            <!--
              زر هادي بإطار — أفعال ثانوية (تعديل، تنقل بين أسابيع...)
              نفس لغة التفاعل بتاعة الزر الأساسي بس أخف: الإطار بيتلون بلون
              البراند عند المرور والخلفية بتتظلل، من غير ظل قوي عشان يفضل ثانوي
            -->
            <!--
                شريحة حالة الحضور: زرار تعليم سريع بدل القائمة المنسدلة.
                المتعلّم بياخد **لون حالته** (أخضر/أصفر/أحمر) من AccentColor
                اللي على الخيار نفسه، فالمستخدم يقرا حالة العامل من اللون
                من غير ما يقرا النص أصلاً.

                ملاحظة مهمة: النص جوّه TextBlock صريح مش ContentPresenter —
                لأن MaterialDesign بتحقن ستايل ضمني على ToggleButton بيخليه
                مفتاح تبديل (switch) والنص بيختفي. الأيقونة + النص هنا
                مضمونين إنهم يترسموا.
            -->
            <Style x:Key="StatusChip" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <!--
                                طبقتين فوق بعض بدل ما نغيّر اللون في التريجر:
                                WPF مبيسمحش بـ Binding جوه Setter.Value، فاللون
                                اللي جاي من البيانات (AccentColor) بيتحط على
                                طبقة ثابتة، والتريجر بيظهّرها بالشفافية بس.
                            -->
                            <Grid MinWidth="104">
                                <Border x:Name="Outline" CornerRadius="16" BorderThickness="1.6"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" />

                                <Border x:Name="Fill" CornerRadius="16" Opacity="0"
                                        ui:ThemeBrush.BackgroundKey="{Binding AccentColor}" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Margin="14,8">
                                    <materialDesign:PackIcon x:Name="Ico" Kind="{Binding Icon}"
                                                            Width="16" Height="16" VerticalAlignment="Center"
                                                            ui:ThemeBrush.ForegroundKey="{Binding AccentColor}" />
                                    <TextBlock x:Name="Txt" Text="{Binding Display}" Margin="6,0,0,0"
                                               FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Outline" Property="Background" Value="{DynamicResource SubtleBgBrush}" />
                                    <Setter TargetName="Fill" Property="Opacity" Value="0.12" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Fill" Property="Opacity" Value="1" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="White" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="Ico" Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- شريحة شيفت العامل بالساعة: أصغر وبلون النجاح، عشان تتفرق عن أزرار الحالة -->
            <Style x:Key="ShiftChip" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.4"
                                    CornerRadius="13" Padding="11,5">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                           FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SuccessBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="White" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                زرار فلترة سريع (الكل / بالإنتاج / بالساعة / موقوفين).
                RadioButton عشان الاختيار يبقى واحد بس، بس شكله شريحة —
                المفعّل بلون البراند والباقي باهت.
            -->
            <Style x:Key="FilterChip" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.4"
                                    CornerRadius="15" Padding="14,7">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                           FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="White" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- بطاقة عامل واحد في قائمة الحضور (بتعلى شوية مع الماوس) -->
            <Style x:Key="WorkerCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,11" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SoftPanelBgBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- عدّاد واحد في شريط ملخص الحضور -->
            <Style x:Key="SummaryStat" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,26,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
              عدّاد الملخص كزرار فلتر: بيفتح قسمه في القائمة اللي تحته.
              اللون بيتحدد من برّه (Tag = لون القسم) عشان النمط الواحد يخدم
              الأخضر والأحمر والأصفر من غير تكرار.

              ثلاث حالات بصرية:
                - عادي  : شفاف
                - مرور  : خلفية رمادية خفيفة + يطلع لفوق شوية
                - مفتوح : خلفية بلون القسم + خط سفلي بلون القسم (IsChecked)

              ToggleButton مش Button عشان حالة "مفتوح" تتربط بـ IsChecked
              مباشرة من الـ ViewModel من غير تحويلات.
            -->
            <Style x:Key="SummaryChip" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="Lift" Y="0" />
                                </Grid.RenderTransform>

                                <Border x:Name="Bd" CornerRadius="10" Background="Transparent" />

                                <!-- تظليل بلون القسم — بيبان عند المرور وبيقوى لما يتفتح -->
                                <Border x:Name="Tint" CornerRadius="10" Opacity="0"
                                        Background="{TemplateBinding Tag}" IsHitTestVisible="False" />

                                <!-- خط سفلي بلون القسم = علامة إن القسم ده مفتوح -->
                                <Border x:Name="Bar" Height="3" CornerRadius="2" VerticalAlignment="Bottom"
                                        Margin="14,0" Background="{TemplateBinding Tag}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                                 To="-2" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity"
                                                                 To="0.10" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                                 To="0" Duration="0:0:0.18"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- القسم المفتوح: بيغلب حالة المرور -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                                    <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SummaryNumber" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SummaryLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Style>

            <Style x:Key="SummaryDivider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="0,4,26,4" />
                <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="RootLift" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <Border x:Name="Bd" Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1.4"
                                        CornerRadius="10" />

                                <!-- نبضة الضغط (نفس فكرة الزر الأساسي بس بلون البراند) -->
                                <Border x:Name="Pulse" CornerRadius="10" Opacity="0"
                                        Background="{DynamicResource BrandBrush}" IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale" ScaleX="0.75" ScaleY="0.75" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border x:Name="FocusRing" CornerRadius="13" Margin="-3"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                        Opacity="0" IsHitTestVisible="False" />

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.03" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.03" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootLift" Storyboard.TargetProperty="Y"
                                                                 To="-1" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootLift" Storyboard.TargetProperty="Y"
                                                                 To="0" Duration="0:0:0.20"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.97" Duration="0:0:0.09"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.97" Duration="0:0:0.09"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                                 From="0.75" To="1" Duration="0:0:0.38"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                                 From="0.75" To="1" Duration="0:0:0.38"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                                 From="0.14" To="0" Duration="0:0:0.38"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.16"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              زرار بيفتح لوحة صغيرة تحته (المدة، الفلاتر). بيفضل مضلّل وهو
              مفتوح عشان يبان إن اللوحة اللي ظهرت بتخصّه.

              وجوده بيخلي صفوف الأدوات المتكررة تتلمّ في زرار واحد: بدل ما
              تلات قوايم تقعد على الشاشة طول الوقت، بتقعد جوّه وتظهر لما
              تتطلب.
            -->
            <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="11,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1.4" CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- لوحة بتنزل من زرار ToolbarToggle -->
            <Style x:Key="ToolbarPopupCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,6,0,10" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                          Opacity="0.18" Color="{DynamicResource ShadowColor}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              زر أيقونة شفاف — الحذف والإغلاق داخل الشرائح والجداول.
              فكرة اللون: خلفية المرور بتاخد نفس لون الأيقونة نفسها بشفافية خفيفة
              (Background مربوط بـ Foreground + Opacity متحركة) — يعني زرار الحذف
              الأحمر بيتظلل أحمر وزرار التعديل الكحلي بيتظلل كحلي تلقائيًا،
              من غير ما نعمل نمط منفصل لكل حالة في كل شاشة.
            -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- التظليل بلون الأيقونة نفسها -->
                                <Border x:Name="Tint" CornerRadius="8" Opacity="0"
                                        Background="{TemplateBinding Foreground}" />

                                <Border x:Name="FocusRing" CornerRadius="10" Margin="-2"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.6"
                                        Opacity="0" IsHitTestVisible="False" />

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity"
                                                                 To="0.14" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.15" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.15" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.18"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.18"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.26" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.92" Duration="0:0:0.08"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.92" Duration="0:0:0.08"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.15" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.15" Duration="0:0:0.14"
                                                                 EasingFunction="{StaticResource EaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- (أنماط النصوص كلها فوق مع سلّم الخطوط) -->

            <!-- ــــــــــ الجداول الحديثة ــــــــــ -->
            <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style x:Key="ModernGridCell" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <!-- التحديد بيتلون على مستوى الصف — الخلية نفسها بتفضل شفافة عشان مفيش أزرق افتراضي -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ModernGridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- الجدول الموحد: مفيش إطار (البطاقة الأم هي الإطار)، خطوط أفقية خفيفة، صفوف مريحة -->
            <Style x:Key="ModernDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="RowHeight" Value="38" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernGridHeader}" />
                <Setter Property="CellStyle" Value="{StaticResource ModernGridCell}" />
                <Setter Property="RowStyle" Value="{StaticResource ModernGridRow}" />
            </Style>

            <!-- ــــــــــ عناصر القائمة الجانبية ــــــــــ -->
            <!-- عنصر تنقل: حبة دائرية بتتظلل عند المرور، وبتتميز بمؤشر كهرماني عند الاختيار -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SidebarInkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Pill" CornerRadius="10" Background="Transparent">
                                <Grid>
                                    <!-- المؤشر الكهرماني الجانبي — علامة الشاشة المفتوحة حاليًا -->
                                    <Border x:Name="Indicator" Width="4" CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Left" Margin="0,9"
                                            Visibility="Collapsed" />
                                    <ContentPresenter VerticalAlignment="Center" Margin="16,11" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="#24FFFFFF" />
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ــــــــــ التبويبات الحديثة ــــــــــ -->
            <!-- تبويب بشكل حبة: بيتحدد بخط كهرماني تحته، بدل الإطار الرمادي الافتراضي —
                 نمط افتراضي (من غير x:Key) فبيطبّق نفسه تلقائيًا على أي TabControl في التطبيق -->
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10,10,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <!-- خط التحديد الكهرماني — بيظهر بس على التبويب المفتوح -->
                                <Border x:Name="Indicator" Height="3" VerticalAlignment="Bottom" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}" Margin="16,0"
                                        Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- الحاوية: شريط تبويبات بخط سفلي هادي + مساحة محتوى بلا إطار صندوقي -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,0,0,0">
                                    <TabPanel IsItemsHost="True" Margin="2,0" />
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" Margin="0,10,0,0" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ــــــــــ عناصر الإدخال ــــــــــ -->
            <!-- حقل نصي حديث: حواف دائرية + حدود هادية، وتتحول للون البراند عند التركيز
                 بدل لون MaterialDesign الافتراضي — نمط افتراضي بيغطي كل TextBox في التطبيق -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
                <Setter Property="SelectionOpacity" Value="0.45" />
                <Setter Property="SelectionTextBrush" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- حقل التاريخ الداخلي: نوع مشتق من TextBox، والأنماط الضمنية
                 في WPF مبتوصلش للأنواع المشتقة، فلازم يتظبط لوحده. بنظبط
                 ألوان التحديد بس من غير Template عشان منكسرش الـ watermark
                 بتاع MaterialDesign. -->
            <!--
              **لازم قالب كامل، مش Setters وبس.** النمط الضمني ده
              بيحل *بدل* نمط MaterialDesign مش فوقه، فأول ما اتكتب
              هنا الحقل فقد كل تنسيق المكتبة ورجع للقالب الافتراضي
              بتاع WPF — خلفية بيضا مصمتة. في الثيم الفاتح محدش لاحظ،
              وفي الأسود بقى مستطيل أبيض ناصع وسط الشاشة.

              (النمط الضمني بتاع TextBox مبيوصلش هنا: DatePickerTextBox
              نوع مشتق، وWPF مبيورّثش الأنماط الضمنية للأنواع المشتقة.)
            -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource GoldBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource GoldBrush}" />
                <Setter Property="SelectionOpacity" Value="0.35" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSmall}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineStrongBrush}"
                                    BorderThickness="1">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InkFaintBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- نفس شكل الحقل النصي لخانة كلمة المرور -->
            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
                <Setter Property="SelectionOpacity" Value="0.45" />
                <Setter Property="SelectionTextBrush" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- أنماط ComboBox وDatePicker اتنقلوا لـ Themes/Core.xaml
                 بقالب كامل. اللي كان هنا بيظبط المسافة والخط بس و"مش
                 بيعيد بناء القالب الداخلي تفاديًا لمخاطرة" — والنتيجة
                 إن الـ 22 قايمة منسدلة فضلوا شايلين قالب ويندوز
                 الافتراضي (Aero) بخلفيته البيضا المتدرجة، اللي مش
                 بيسمع لأي لوحة ألوان. في الثيم الفاتح عدّت، وفي
                 الأسود بقوا مستطيلات بيضا. -->
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
