<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- الإعدادات المشتركة (ImplicitUsings / Nullable / اللغات / رقم الإصدار) في Directory.Build.props -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WorkforceManager.UI</RootNamespace>
    <!-- أيقونة البرنامج (تظهر على الـ exe والاختصارات) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WorkforceManager</AssemblyName>
    <!--
      DPI-awareness (app.manifest) — من غيره ويندوز بيعمل Bitmap Stretch
      للنافذة على أي شاشة مكبّرة (125%+، الوضع الافتراضي على أغلب الأجهزة)،
      وده اللي بيظهر كضبابية عامة وألوان باهتة. التفاصيل في app.manifest.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      البرنامج WPF يعني ويندوز 64-بت وبس. من غير تحديد المنصة دي، حزمة SQLite
      بتنسخ مكتباتها الأصلية لـ 20 منصة (لينكس، ماك، wasm، mips، ppc64...) —
      24 ميجا في كل بناء، منها 22.5 ملهاش أي لازمة على ويندوز.
      SelfContained=false عشان البناء العادي يفضل خفيف؛ النشر المستقل بيتحدد
      من publish.ps1 وقت الحاجة.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- إعدادات نسخة التوزيع (DebugType وخلافه) في Directory.Build.props -->

  <ItemGroup>
    <!--
      8.0.1 مش 8.0.0: الإصدار الأقدم بيجرّ Microsoft.Extensions.Caching.Memory 8.0.0
      اللي فيها ثغرة عالية الخطورة (GHSA-qj66-m88j-hmgj).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      مطلوبة لأداة dotnet-ef عشان تقدر تولّد Migrations من مشروع UI كمشروع بداية التشغيل.
      محصورة في وضع Debug عن قصد: الحزمة دي بتجرّ معاها مترجم Roslyn
      (Microsoft.CodeAnalysis.* بـ 12 ميجا) وده كان بيتشحن مع نسخة المصنع من غير
      أي داعي — أدوات تطوير مالهاش لازمة عند المستخدم النهائي.
      أوامر dotnet ef بتبني Debug افتراضيًا فبتفضل شغالة عادي.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29"
                     Condition="'$(Configuration)' == 'Debug'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkforceManager.Business\WorkforceManager.Business.csproj" />
    <ProjectReference Include="..\WorkforceManager.Data\WorkforceManager.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- الأيقونة كـ Resource عشان تتستخدم كأيقونة النافذة (شريط المهام) كمان -->
    <Resource Include="Assets\app.ico" />
    <!--
      خطوط الواجهة مدموجة جوه الـ exe كـ Resource مش متثبتة على الجهاز —
      البرنامج محمول ولازم يطلع بنفس الشكل على أي ويندوز من غير تثبيت خطوط.
      أوزان ثابتة (مش variable font) عن قصد لكل الخطوط هنا: WPF بيدعم الأوزان
      الثابتة صح، أما المتغيرة فبيرسم منها الوزن الافتراضي بس ويزوّر الباقي
      (synthetic bold) وشكله وحش — نفس السبب اللي خلّى IBM Plex Sans Arabic
      (خط القايمة الجانبية، شوف SidebarFont في Core.xaml) يتقدّم على Cairo:
      Cairo بقى متاح كـ variable font بس دلوقتي (حتى من مستودع المصمّم نفسه)،
      وPlex لسه عنده أوزان ثابتة حقيقية.
      Tajawal (خط التطبيق العام): Light=300 / Regular=400 / Medium=500 /
      Bold=700 / ExtraBold=800، الترخيص OFL في Fonts\OFL.txt.
      IBM Plex Sans Arabic (خط القايمة الجانبية بس): Regular=400 / SemiBold=600 /
      Bold=700 — الأوزان التلاتة اللي القايمة الجانبية فعليًا بتستخدمها (النص
      العادي، العنصر المختار، اسم/شعار المصنع)، مش كل أوزان الخط. **كل وزن ملف
      عائلة خط منفصلة باسمها الخاص** (IBM Plex Sans Arabic / ...Medium إلخ لو
      اتضافوا لاحقًا)، مش عائلة واحدة بأوزان فرعية زي Tajawal — WPF ميقدرش يختار
      الملف الصح لوحده من FontWeight بس هنا، فكل استخدام بوزن مختلف عن العادي
      (شوف SidebarFontSemiBold/SidebarFontBold في Core.xaml) بيحدد اسم العائلة
      المطلوبة صراحة، مش يعتمد على تخمين WPF. ترخيصه OFL منفصل في
      Fonts\OFL-IBMPlexSansArabic.txt (خط مختلف، ترخيص منفصل عن بتاع Tajawal
      حتى لو نفس نوع الرخصة).
    -->
    <Resource Include="Fonts\*.ttf" />
    <!-- نص كل ترخيص بيتشحن جنب البرنامج (شرط الـ OFL) مش جوه الـ exe -->
    <Content Include="Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\OFL-IBMPlexSansArabic.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
