<Window x:Class="WorkforceManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="إدارة قسم الصنفرة"
        Height="720" Width="1200"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--
      UseLayoutRounding + TextOptions هنا لأن النمط الضمني TargetType="Window"
      في App.xaml بيحطهم برضه — بس زي FlowDirection فوقه بالظبط، النمط
      الضمني ده مبيوصلش لـ MainWindow (كلاس مشتق، شوف تعليق FlowDirection).
      من غير UseLayoutRounding عناصر الشجرة كلها (كل شاشات الـ Sidebar) بترتّب
      على إحداثيات كسرية عند أي نسبة تكبير غير 100% — وده بيطلع حدود وزوايا
      مستديرة باهتة، وبيبان أوضح كل ما البطاقة فيها Border متداخلة أكتر
      (المنتجات، تسجيل الإنتاج) عن شاشة بسيطة زي سجل العمليات (DataGrid
      بارتفاع صف ثابت). الخاصية دي بتتوارث لكل الشجرة البصرية تحتها، فحطّها
      هنا بس بيغطي كل شاشة في الـ Sidebar دفعة واحدة. -->

    <!--
      التخطيط كله مبني على مساحة تصميم ثابتة (DesignWidth/DesignHeight في
      الكود): الشريط الجانبي 248، وأعرض شاشة (المنتجات) محتاجة ~914 جوّه،
      يعني ~1162 على الأقل. على لابتوب 1366×768 بتكبير 125% المتاح 1093
      DIP بس — أقل من كده، فالمحتوى كان **بيتقص** من غير أي علامة.

      ScaleTransform على LayoutTransform مش Viewbox عن قصد: الـ Viewbox
      بيقيس الابن على مقاسه المرغوب ويكبّر/يصغّر الناتج، أما LayoutTransform
      بيدّي الابن المساحة **مقسومة على المقياس** فالتخطيط بيتنفّذ فعليًا على
      مساحة التصميم ويترسم بالحجم المطلوب — الأعمدة النسبية (*) بتشتغل صح،
      والنص بيترسم شعاعيًا فبيفضل حاد بدل ما يتغبّش.

      المقياس بيتحسب في MainWindow.xaml.cs وبيصغّر **وبيكبّر**: كده كل
      شاشة 16:9 بتوصل لنفس التخطيط بالظبط مهما كانت دقتها. شوف ApplyUiScale
      لسبب التكبير وللتنازل اللي وراه.
    -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════ الشريط العلوي (كان القايمة الجانبية) ══════════
             شريط واحد فوق كل الشاشات: اللوجو والاسم (= الرئيسية)، بنود التنقل الأربعة،
             وعلى الطرف التاني التاريخ والبحث السريع والجرس وحفظ نهائي والحساب.
             أسود دافي مصمت زي القايمة القديمة بالظبط (SidebarBrush) عشان البنود الذهبية
             والبند المختار يفضلوا على نفس الأرضية. TextElement.FontFamily هنا بس فبتتوارث لكل
             اللي تحته (Border مالوش FontFamily بتاعه — شوف تعليق NavItem في Core.xaml). -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource SidebarBrush}" Padding="18,6" BorderBrush="#33C2A14D" BorderThickness="0,0,0,1" Panel.ZIndex="10"
                TextElement.FontFamily="{DynamicResource SidebarFont}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />      <!-- 0 اللوجو (بداية) -->
                    <ColumnDefinition Width="Auto" />   <!-- 1 التنقل (في النص) -->
                    <ColumnDefinition Width="*" />      <!-- 2 بحث + جرس + المزيد (نهاية) -->
                </Grid.ColumnDefinitions>

                <!-- اللوجو والاسم = "الرئيسية": دوسة عليهم بترجع للرئيسية من أي شاشة (HomeLogo_Click).
                     اسم المصنع والقسم بيتظبطوا من الإعدادات؛ لو مفيش اسم بيرجع لـ WMS. -->
                    <Button x:Name="HomeLogoButton" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource CardButton}" Click="HomeLogo_Click"
                            ToolTip="الرئيسية" AutomationProperties.Name="الرئيسية" Padding="0">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <views:WmsLogo x:Name="SidebarLogo" Width="34" Height="34" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- كان مكتوب "إدارة الإنتاج والأجور" — جملة
                                 بتوصف البرنامج، والبرنامج مفتوح قدام
                                 المستخدم أصلاً. اسم المصنع والقسم بيقولوا
                                 النسخة دي بتاعة مين، وبيتظبطوا من
                                 الإعدادات. لو مفيش اسم بيرجع للاسم
                                 العام بدل سطر فاضي. -->
                            <TextBlock x:Name="FactoryText" Text="إدارة قسم الصنفرة" FontSize="15" FontWeight="Bold"
                                       FontFamily="{DynamicResource SidebarFontBold}"
                                       Foreground="{DynamicResource GoldBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            <TextBlock x:Name="DepartmentText" FontSize="11"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                       Foreground="{DynamicResource SidebarInkSoftBrush}" />
                        </StackPanel>
                    </StackPanel>
                    </Button>

                <!-- التنقل: RadioButton لكل شاشة، والمختار عليه الخلفية والخط الدهبي. التنقل بـ Checked + Click
                     مع بعض عن قصد: Checked للتنقل الفعلي، وClick لإعادة تحميل الشاشة المفتوحة أصلًا
                     (Checked مبيتنفذش لو الزرار متعلم بالفعل). الاتنين على NavigateToView_Checked، اللي
                     بيعرف الشاشة من Tag الزرار نفسه. البنود المخفية في الآخر مسارات برمجية بس. -->
                <!-- حاوية كبسولة للبنود: خلفية أفتح شوية من الشريط عشان البنود تبان كمجموعة واحدة -->
                <Border Grid.Column="1" Margin="0" Padding="3" CornerRadius="13" VerticalAlignment="Center"
                        Background="{DynamicResource SidebarAltBrush}">
                <StackPanel x:Name="NavHost" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="NavHomeItem" Style="{StaticResource TopNavItem}" IsChecked="True"
                                 Tag="{x:Type views:HomeView}"
                                 Checked="NavigateToView_Checked" Click="NavigateToView_Checked"
                                 AutomationProperties.Name="الرئيسية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="الرئيسية" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavWorkersItem" Style="{StaticResource TopNavItem}"
                                 Tag="{x:Type views:WorkersHubView}"
                                 Checked="NavigateToView_Checked" Click="NavigateToView_Checked"
                                 AutomationProperties.Name="إدارة العمال">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="إدارة العمال" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- إدارة الإنتاج: المنتجات والمراحل + الخطة الشهرية + تسجيل الإنتاج اليومي (كروت، ProductionHubView) -->
                    <RadioButton x:Name="NavProductionItem" Style="{StaticResource TopNavItem}"
                                 Tag="{x:Type views:ProductionHubView}"
                                 Checked="NavigateToView_Checked" Click="NavigateToView_Checked"
                                 AutomationProperties.Name="إدارة الإنتاج">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Factory" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="إدارة الإنتاج" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <!-- عدد خطط الذاكرة المستحقة النهارده أو المتأخرة — الذاكرة جوّه التسجيل اليومي جوّه إدارة الإنتاج -->
                            <Border x:Name="MemoryBadge" Background="{DynamicResource DangerBgBrush}"
                                    CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="MemoryBadgeText" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <!-- مسارات برمجية مخفية (HiddenRoutes) لنفس سبب باقي المسارات تحت — شوف EmbeddedRoutes -->
                    <RadioButton x:Name="NavProductsItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:ProductsView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="المنتجات والمراحل" />
                    <RadioButton x:Name="NavMonthlyPlanItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:MonthlyPlanView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الإنتاج الشهري للمنتجات" />
                    <RadioButton x:Name="NavDailyEntryItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:DailyEntryView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="تسجيل يوميات العمال" />

                    <!-- الإعدادات اتنقلت لقايمة "المزيد" (SettingsMenuButton) — البند هنا مسار برمجي مخفي بس:
                         البحث والجولة والرئيسية لسه بيعملوا NavSettingsItem.IsChecked = true، وشاشة الإعدادات
                         بتتفتح بنفس طريقة سجل العمليات (من غير بند ظاهر معلّم، شوف OpenStandaloneRoute). -->
                    <RadioButton x:Name="NavSettingsItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:SettingsView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الإعدادات" />

                    <!-- مسارات برمجية بس (مخفية، مجموعة منفصلة فمش بتفكّ تحديد أي بند ظاهر).
                         الشاشات دي اتنقلت جوّه شاشات تانية، لكن البحث السريع والجولة
                         والرئيسية وغيرهم لسه بيقولوا "افتح الذاكرة" بـ NavMemoryItem.IsChecked
                         — NavigateToView_Checked بيحوّل كل واحد لأبوه ويختار التبويب/القسم
                         المناسب (EmbeddedRoutes في MainWindow.xaml.cs). -->
                    <RadioButton x:Name="NavAttendanceItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:AttendanceView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الحضور والغياب" />
                    <RadioButton x:Name="NavPenaltiesItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:PenaltiesView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الجزاءات" />
                    <RadioButton x:Name="NavAdjustmentsItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:AdjustmentsView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="السلف والحوافز" />
                    <RadioButton x:Name="NavMemoryItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:MemoryView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الذاكرة" />
                    <RadioButton x:Name="NavEvaluationItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:ReportsView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="تقييم ومتابعة العمال" />
                    <RadioButton x:Name="NavReportsItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:ReportBuilderView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="تقارير العمال" />
                    <RadioButton x:Name="NavActivityLogItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:ActivityLogView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="سجل العمليات" />
                    <RadioButton x:Name="NavDepartmentAccountsItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:DepartmentAccountsView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الحسابات الإدارية" />
                    <RadioButton x:Name="NavHelpItem" GroupName="HiddenRoutes" Visibility="Collapsed"
                                 Tag="{x:Type views:HelpView}" Checked="NavigateToView_Checked"
                                 AutomationProperties.Name="الدليل" />
                </StackPanel>
                </Border>


                <!-- مجموعة اليمين-فعليًا-الشمال: بحث + جرس + المزيد. HorizontalAlignment=Right = الطرف النهائي في واجهة عربية -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- بحث سريع -->
                        <Button x:Name="GlobalSearchButton" Margin="0" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Stretch"
                                Style="{StaticResource TopBarButton}"
                                Click="GlobalSearch_Click" ToolTip="بحث سريع عن عامل أو منتج (Ctrl+K)"
                                AutomationProperties.Name="بحث سريع">
                            <DockPanel LastChildFill="True">
                                <!-- اختصار الكيبورد على الطرف التاني، شكل "حقل بحث" مش زرار عادي -->
                                <Border DockPanel.Dock="Left" CornerRadius="6" Padding="7,2" Margin="14,0,0,0" VerticalAlignment="Center"
                                        Background="#1FFFFFFF">
                                    <TextBlock Text="Ctrl K" FontSize="10.5" FontWeight="SemiBold" Opacity="0.65" />
                                </Border>
                                <materialDesign:PackIcon DockPanel.Dock="Right" Kind="Magnify" Width="17" Height="17" VerticalAlignment="Center" />
                                <TextBlock Text="بحث سريع" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5" Opacity="0.85" />
                            </DockPanel>
                        </Button>

                <!-- جرس الإشعارات: تجميع تنبيهات (سجل العمليات، عمال محتاجين انتباه، موجز الخطة) -->
                        <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="NotificationBellToggle" Style="{StaticResource TopBarToggle}"
                                          Padding="10" ToolTip="الإشعارات"
                                          AutomationProperties.Name="الإشعارات">
                                <materialDesign:PackIcon Kind="BellOutline" Width="17" Height="17" />
                            </ToggleButton>

                            <!-- بادچ العدد — نفس شكل ActivityBadge/MemoryBadge بالظبط -->
                            <Border x:Name="NotificationBellBadge" Background="{DynamicResource DangerBrush}"
                                    CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock x:Name="NotificationBellBadgeText" FontSize="9.5" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <Popup IsOpen="{Binding IsChecked, ElementName=NotificationBellToggle, Mode=TwoWay}"
                                   StaysOpen="False" PlacementTarget="{Binding ElementName=NotificationBellToggle}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource ToolbarPopupCard}" FlowDirection="RightToLeft" Width="270">
                                    <StackPanel>
                                        <TextBlock Text="الإشعارات" FontWeight="Bold" FontSize="13"
                                                   Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />

                                        <TextBlock x:Name="NotificationEmptyText" Text="كله تمام، مفيش حاجة محتاجة انتباهك دلوقتي"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />

                                        <!-- موجز الصبح: منتجات الخطة المتأخرة وكام قطعة مطلوبة منها النهارده.
                                             بيتحسب مرة واحدة عند فتح البرنامج (LoadPlanBriefing)، مش مع كل تنقّل -->
                                        <Button x:Name="NotificationPlanItem" Click="NotificationPlanItem_Click"
                                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                Padding="8,7" Margin="0,0,0,4" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalendarAlert" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                                                <TextBlock x:Name="NotificationPlanText" Margin="8,0,0,0" FontSize="12.5" MaxWidth="210"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="NotificationActivityItem" Click="NotificationActivityItem_Click"
                                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                Padding="8,7" Margin="0,0,0,4" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="History" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}" />
                                                <TextBlock x:Name="NotificationActivityText" Margin="8,0,0,0" FontSize="12.5"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="NotificationAttentionItem" Click="NotificationAttentionItem_Click"
                                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                Padding="8,7" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountAlertOutline" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}" />
                                                <TextBlock x:Name="NotificationAttentionText" Margin="8,0,0,0" FontSize="12.5"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- سجل العمليات اتنقل هنا من القايمة الجانبية: دايمًا ظاهر (مش بس لما فيه عمليات جديدة)
                                             وشارة عدد العمليات الجديدة جنبه — بتتصفّر أول ما الشاشة تتفتح (ActivityLogViewModel.LoadAsync) -->
                                        <Separator Margin="0,6,0,6" />
                                        <Button x:Name="NotificationOpenLogButton" Click="NotificationActivityItem_Click"
                                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                Padding="8,7" AutomationProperties.Name="سجل العمليات">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                                                <TextBlock Text="سجل العمليات" Margin="8,0,0,0" FontSize="12.5"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <!-- DangerBgBrush/DangerBrush زوج ألوان متباين بالتصميم في الثيمين -->
                                                <Border x:Name="ActivityBadge" Background="{DynamicResource DangerBgBrush}"
                                                        CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock x:Name="ActivityBadgeText" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                <!-- المزيد: الحساب (الاسم + تسجيل الخروج) وحفظ نهائي اتجمّعوا هنا بدل ما يزحموا الشريط.
                     حفظ نهائي هو البوابة الوحيدة للأفعال اليومية المتكررة — نفس الزرار هو اللي بيفتح لما
                     البرنامج يرفض يقفل قبل التوقيع. الحساب ظاهر فيه كل مرة عشان أي حد يبدّل حساب من غير ما
                     يقفل البرنامج. الاتنين (FinalSaveButton وAccountCard) لسه بنفس الأسماء. -->
                <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="MoreToggle" Style="{StaticResource TopBarToggle}" Padding="12,8"
                                  ToolTip="الحساب وحفظ نهائي" AutomationProperties.Name="المزيد">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="المزيد" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=MoreToggle, Mode=TwoWay}"
                           StaysOpen="False" PlacementTarget="{Binding ElementName=MoreToggle}"
                           Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource ToolbarPopupCard}" FlowDirection="RightToLeft" Width="280">
                            <StackPanel>
                                <Border x:Name="AccountCard" Padding="10,8" CornerRadius="12"
                                        Background="{DynamicResource SubtleBgBrush}">
                                    <DockPanel>
                                        <Button x:Name="LogoutButton" DockPanel.Dock="Left" Click="Logout_Click"
                                                Style="{StaticResource IconButton}" Padding="6,4"
                                                ToolTip="تسجيل الخروج" AutomationProperties.Name="تسجيل الخروج">
                                            <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" />
                                        </Button>
                                        <views:WorkerAvatar x:Name="AccountAvatar" DockPanel.Dock="Left" Diameter="34"
                                                             Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SignedInAsText" FontSize="13" Margin="10,0,0,0"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </Border>

                                <!-- الإعدادات (كانت بند في الشريط): فيها الحماية والحسابات الإدارية والنسخ الاحتياطي والدليل -->
                                <Button x:Name="SettingsMenuButton" Margin="0,8,0,0" Click="OpenSettings_Click"
                                        Style="{StaticResource GhostButton}" Padding="12,9" HorizontalContentAlignment="Left"
                                        AutomationProperties.Name="الإعدادات">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="الإعدادات" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="FinalSaveButton" Margin="0,10,0,0" Click="FinalSave_Click"
                                        Style="{StaticResource PrimaryButton}" Padding="0,10"
                                        HorizontalContentAlignment="Center"
                                        ToolTip="مراجعة وتوقيع كل حاجة حصلت النهارده"
                                        AutomationProperties.Name="حفظ نهائي">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                        <TextBlock Text="حفظ نهائي" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ منطقة المحتوى ══════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- بانر وضع التجربة (Sandbox): صف مقفول بيدّي ارتفاع صفر لما
                 مش في تجربة، فمفيش فراغ زيادة في الاستخدام العادي -->
            <Border x:Name="SandboxBanner" Grid.Row="0" Visibility="Collapsed"
                    Background="{DynamicResource GoldTintBrush}" Padding="14,9">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="12,5"
                            Content="إنهاء التجربة" Click="SandboxExit_Click" />
                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FlaskOutline" Width="17" Height="17"
                                             Margin="0,0,8,0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource GoldBrush}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="وضع تجربة تفاعلي — البيانات هنا وهمية للتدريب بس، مش بيانات مصنعك الحقيقية" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border Background="{DynamicResource GroundBrush}">
                    <ContentControl x:Name="MainContent" Margin="20,18" />
                </Border>

                <!-- الإشعارات فوق المحتوى: بتظهر في الركن وبتروح لوحدها،
                     والشغل تحتها مبيتوقفش -->
                <views:ToastHost x:Name="Toasts" />
            </Grid>
        </Grid>

        <!-- ══════════ جولة "إيه الجديد" (Spotlight) ══════════
             FlowDirection="LeftToRight" مقصود: المواقع بتتحسب في الكود
             بإحداثيات فعلية (TransformToVisual)، ولو سبنا RTL الموروثة
             كانت هتنعكس Margin.Left/HorizontalAlignment="Left" على الجنب
             التاني. النص العربي جوه الفقاعة بيرجّع RTL بنفسه. -->
        <Grid x:Name="TourOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="1000"
              FlowDirection="LeftToRight">
            <!-- دوسة على المنطقة المعتمة (برّه الفقاعة والهالة) = زي "تخطي الكل" —
                 نفس تعامل أي Overlay/Dialog تاني بيتقفل بدوسة برّه -->
            <Path x:Name="TourDimPath" Fill="#AA000000" MouseLeftButtonDown="TourDim_MouseLeftButtonDown" />
            <Border x:Name="TourHighlight" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="3"
                    CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
            <Border x:Name="TourCallout" Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
                    Padding="18,16" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    FlowDirection="RightToLeft">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TourStepCounter" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="TourTitle" FontSize="15.5" FontWeight="Bold" Margin="0,4,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TourDescription" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <!-- بتظهر بس أثناء خطوة تدريب تفاعلي حقيقية (RunGuidedStepAsync) —
                         بتوضّح إن العنصر المضوّي قابل للدوس فعليًا دلوقتي -->
                    <StackPanel x:Name="TourGuidedHint" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="CursorDefaultClick" Width="14" Height="14"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                        <TextBlock Text="دوس على العنصر المضوّي — هيكمّل لوحده" FontSize="11.5" Margin="6,0,0,0"
                                   FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="16,7" Content="التالي"
                                Click="TourNext_Click" />
                        <Button x:Name="TourBackButton" Style="{StaticResource GhostButton}" Padding="16,7" Margin="8,0,0,0"
                                Content="السابق" Click="TourBack_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="16,7" Margin="8,0,0,0"
                                Content="تخطي الكل" Click="TourSkip_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
