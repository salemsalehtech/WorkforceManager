<Window x:Class="WorkforceManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="نظام إدارة إنتاجية وأجور العمال"
        Height="720" Width="1200"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--
      UseLayoutRounding + TextOptions هنا لأن النمط الضمني TargetType="Window"
      في App.xaml بيحطهم برضه — بس زي FlowDirection فوقه بالظبط، النمط
      الضمني ده مبيوصلش لـ MainWindow (كلاس مشتق، شوف تعليق FlowDirection).
      من غير UseLayoutRounding عناصر الشجرة كلها (كل شاشات الـ Sidebar) بترتّب
      على إحداثيات كسرية عند أي نسبة تكبير غير 100% — وده بيطلع حدود وزوايا
      مستديرة باهتة، وبيبان أوضح كل ما البطاقة فيها Border متداخلة أكتر
      (المنتجات، تسجيل الإنتاج) عن شاشة بسيطة زي سجل العمليات (DataGrid
      بارتفاع صف ثابت). الخاصية دي بتتوارث لكل الشجرة البصرية تحتها، فحطّها
      هنا بس بيغطي كل شاشة في الـ Sidebar دفعة واحدة. -->

    <!--
      التخطيط كله مبني على مساحة تصميم ثابتة (DesignWidth/DesignHeight في
      الكود): الشريط الجانبي 248، وأعرض شاشة (المنتجات) محتاجة ~914 جوّه،
      يعني ~1162 على الأقل. على لابتوب 1366×768 بتكبير 125% المتاح 1093
      DIP بس — أقل من كده، فالمحتوى كان **بيتقص** من غير أي علامة.

      ScaleTransform على LayoutTransform مش Viewbox عن قصد: الـ Viewbox
      بيقيس الابن على مقاسه المرغوب ويكبّر/يصغّر الناتج، أما LayoutTransform
      بيدّي الابن المساحة **مقسومة على المقياس** فالتخطيط بيتنفّذ فعليًا على
      مساحة التصميم ويترسم بالحجم المطلوب — الأعمدة النسبية (*) بتشتغل صح،
      والنص بيترسم شعاعيًا فبيفضل حاد بدل ما يتغبّش.

      المقياس بيتحسب في MainWindow.xaml.cs وبيصغّر **وبيكبّر**: كده كل
      شاشة 16:9 بتوصل لنفس التخطيط بالظبط مهما كانت دقتها. شوف ApplyUiScale
      لسبب التكبير وللتنازل اللي وراه.
    -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <!-- عرض الشريط بيتحسب في الكود (SidebarRatio) — كان 248 ثابتة،
             فكان بياخد 18% من شاشة 1362 و13% من شاشة 1917، يعني بيبان
             عريض على دي ورفيع على دي. النسبة بتخليه متسق، والمساحة
             الزيادة على الشاشة الكبيرة بتروح للمحتوى مش للشريط. -->
        <Grid.ColumnDefinitions>
            <!-- Auto: العرض الفعلي بقى خاصية Width على SidebarBorder نفسه
                 (double عادي، قابل للتحريك)، مش هنا — شوف تعليق SidebarBorder -->
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════ القائمة الجانبية ══════════
             أسود دافي مصمت مش متدرّج: التدرّج بيخلي البنود اللي فوق والبنود
             اللي تحت على خلفيتين مختلفتين، فالشريط الدهبي بتاع البند
             النشط بيبان بقوّتين حسب مكانه. اللون الواحد بيخلي كل بند
             يتعامل مع نفس الأرضية. -->
        <!-- TextElement.FontFamily هنا بس، مش على كل عنصر لوحده — بتتوارث لكل
             حاجة تحتها (ماعدا NavItem style اللي عنده Setter صريح بيكسر
             الوراثة، شوف Core.xaml). Border مش Control/TextElement فمالوش
             خاصية FontFamily بتاعته — لازم الصيغة المرفقة (Attached Property)
             عشان الوراثة تشتغل من عنصر مش قابل للكتابة عادي. -->
        <!-- Width صريح هنا (مش عرض عمود Grid) عشان يبقى قابل للتحريك
             بـDoubleAnimation عادي — GridLength (لو العمود هو اللي بيحمل
             العرض) مالهوش حركة مباشرة في WPF. SidebarColumn بقى Auto
             وبيتبع عرض الـBorder ده تلقائيًا. القيمة هنا (248) ابتدائية
             بس — ApplySidebarWidth بيظبطها فورًا عند فتح النافذة. -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="248" Background="{DynamicResource SidebarBrush}"
                TextElement.FontFamily="{DynamicResource SidebarFont}">
            <Grid>
            <!-- كل محتوى الشريط القديم — عنصر واحد قابل للإخفاء ككل عند
                 الطي (Opacity)، بدل أجزاء منفصلة. زرار الطي نفسه تحت،
                 برّه العنصر ده عمدًا، عشان يفضل ظاهر في الحالتين -->
            <DockPanel x:Name="SidebarContent">
                <!-- الهوية -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,20">
                    <!-- اللوجو والاسم = "الرئيسية": دوسة عليهم بترجع للرئيسية من أي شاشة
                         (HomeLogo_Click). وهو مطوي فيه نسخة صغيرة من اللوجو تحت زرار
                         الطي بتعمل نفس الحاجة (CollapsedHomeButton) -->
                    <Button x:Name="HomeLogoButton" Style="{StaticResource CardButton}" Click="HomeLogo_Click"
                            ToolTip="الرئيسية" AutomationProperties.Name="الرئيسية" Padding="0">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <views:WmsLogo x:Name="SidebarLogo" Width="46" Height="46" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- كان مكتوب "إدارة الإنتاج والأجور" — جملة
                                 بتوصف البرنامج، والبرنامج مفتوح قدام
                                 المستخدم أصلاً. اسم المصنع والقسم بيقولوا
                                 النسخة دي بتاعة مين، وبيتظبطوا من
                                 الإعدادات. لو مفيش اسم بيرجع للاسم
                                 العام بدل سطر فاضي. -->
                            <TextBlock x:Name="FactoryText" Text="WMS" FontSize="17" FontWeight="Bold"
                                       FontFamily="{DynamicResource SidebarFontBold}"
                                       Foreground="{DynamicResource GoldBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            <TextBlock x:Name="DepartmentText" FontSize="11"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                       Foreground="{DynamicResource SidebarInkSoftBrush}" />
                        </StackPanel>
                    </StackPanel>
                    </Button>

                    <!-- خط دهبي رفيع بيفصل الهوية عن التنقل -->
                    <Border Height="1" Margin="0,18,0,0" Opacity="0.35"
                            Background="{DynamicResource GoldGradientBrush}" />

                    <!-- بطاقة اليوم — أول عنصر محتوى بعد الهوية مباشرة
                         (كانت آخر عنصر تحت القايمة، اتنقلت هنا) -->
                    <Border x:Name="DateCard" Margin="0,14,0,0" Padding="13,11"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SidebarAltBrush}"
                            Style="{StaticResource HoverGrowCard}">
                        <StackPanel>
                            <!-- التاريخ بالعربي بيتكتب من الكود عند فتح النافذة -->
                            <TextBlock x:Name="TodayText" FontSize="12.5" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource SidebarFontSemiBold}"
                                       Foreground="{DynamicResource SidebarInkBrush}" />
                            <TextBlock Text="أسبوع العمل: الخميس ← الأربعاء" FontSize="10.5"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource SidebarInkSoftBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- بحث سريع: عامل أو منتج، من أي شاشة، من غير ما تفتح شاشته الأول -->
                    <Button x:Name="GlobalSearchButton" Margin="0,14,0,0" Padding="10,7" HorizontalContentAlignment="Left"
                            Style="{StaticResource GhostButton}"
                            Click="GlobalSearch_Click" ToolTip="بحث سريع عن عامل أو منتج"
                            AutomationProperties.Name="بحث سريع">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="بحث سريع" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- توقيع نهاية اليوم — آخر عنصر في القائمة الجانبية
                     بالكامل (أول عنصر Dock="Bottom" في الترتيب = أبعد
                     حاجة لتحت في DockPanel)، تحت بطاقة اليوم وكارت
                     الحساب. البوابة الوحيدة الباقية للأفعال اليومية
                     المتكررة (Tier B) بعد ما اتشالت منها الباسوردات
                     الفورية — نفس الزرار ده هو اللي بيفتح لما البرنامج
                     يرفض يقفل قبل التوقيع. -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,10">
                    <Button x:Name="FinalSaveButton" Click="FinalSave_Click"
                            Style="{StaticResource PrimaryButton}" Padding="0,10"
                            HorizontalContentAlignment="Center"
                            ToolTip="مراجعة وتوقيع كل حاجة حصلت النهارده"
                            AutomationProperties.Name="حفظ نهائي">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="17" Height="17" VerticalAlignment="Center" />
                            <TextBlock Text="حفظ نهائي" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- الحساب الداخل بيه + زرار الخروج: آخر حاجة في القايمة
                     الجانبية (تحت بطاقة اليوم) — ظاهرة في كل الشاشات،
                     عشان أي حد يقدر يبدّل حساب من غير ما يقفل البرنامج
                     كله (مهم دلوقتي إن الحسابات الإدارية بقى لكل واحدة
                     يوزر وباسورد لوحدها). -->
                <Border x:Name="AccountCard" DockPanel.Dock="Bottom" Margin="16,0,16,10" Padding="12,9"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource SidebarAltBrush}"
                        Style="{StaticResource HoverGrowCard}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Click="Logout_Click"
                                Style="{StaticResource IconButton}" Padding="6,4"
                                Foreground="{DynamicResource GoldBrush}" ToolTip="تسجيل الخروج"
                                AutomationProperties.Name="تسجيل الخروج">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" />
                        </Button>
                        <views:WorkerAvatar x:Name="AccountAvatar" DockPanel.Dock="Left" Diameter="34"
                                             Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SignedInAsText" FontSize="13" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource SidebarFontSemiBold}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SidebarInkBrush}" />
                    </DockPanel>
                </Border>

                <!-- عناصر التنقل -->
                <!--
                  ScrollViewer حوالين قايمة التنقل: القايمة آخر عنصر في
                  الـ DockPanel، يعني بتاخد اللي فاضل بعد البطاقات المرصوصة
                  تحت — ولما المساحة تقل كانت **بتتقص في صمت**. ده اللي خلا
                  "الحسابات الإدارية" تختفي أول ما التكبير قلّل الارتفاع
                  المنطقي. دلوقتي بتزحلق بدل ما تخفي، فمفيش بند يبقى غير
                  قابل للوصول مهما كان مقاس الشاشة أو عدد البنود.
                  مش بديل عن ظبط مساحة التصميم (شوف DesignHeight) — ده
                  الحزام اللي بيمنع الاختفاء الصامت لو الاتنين اختلفوا.
                -->
                <!-- Grid ملفوف حوالين الـScrollViewer عشان NavIndicator (الشريط
                     الدهبي المشترك اللي بينزلق بين البنود، شوف MainWindow.xaml.cs's
                     PositionNavIndicator) يقدر يتراكب فوق القايمة من غير ما
                     يبقى جزء من محتواها القابل للتمرير -->
                <Grid x:Name="NavIndicatorHost">
                <ScrollViewer x:Name="NavScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,4,12,0">
                    <!-- التنقل بـ Checked + Click مع بعض عن قصد:
                         Checked للتنقل الفعلي والكيبورد، وClick لإعادة تحميل الشاشة
                         المفتوحة أصلًا (Checked مبيتنفذش لو الزرار متعلم بالفعل) -->
                    <RadioButton x:Name="NavHomeItem" Style="{StaticResource NavItem}" IsChecked="True"
                                 Checked="NavHome_Checked" Click="NavHome_Checked"
                                 AutomationProperties.Name="الرئيسية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="الرئيسية" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavWorkersItem" Style="{StaticResource NavItem}"
                                 Checked="NavWorkers_Checked" Click="NavWorkers_Checked"
                                 AutomationProperties.Name="العمال">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="العمال" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavProductsItem" Style="{StaticResource NavItem}"
                                 Checked="NavProducts_Checked" Click="NavProducts_Checked"
                                 AutomationProperties.Name="المنتجات والمراحل">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="المنتجات والمراحل" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMonthlyPlanItem" Style="{StaticResource NavItem}"
                                 Checked="NavMonthlyPlan_Checked" Click="NavMonthlyPlan_Checked"
                                 AutomationProperties.Name="الخطة الشهرية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="الخطة الشهرية" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDailyEntryItem" Style="{StaticResource NavItem}"
                                 Checked="NavDailyEntry_Checked" Click="NavDailyEntry_Checked"
                                 AutomationProperties.Name="تسجيل الإنتاج اليومي">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardEditOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="تسجيل الإنتاج اليومي" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- جنب التسجيل اليومي عن قصد: الذاكرة هي اللي بتوصّل
                         للتسجيل ("ابدأ الآن")، فمكانها الطبيعي جنبه -->
                    <RadioButton x:Name="NavMemoryItem" Style="{StaticResource NavItem}"
                                 Checked="NavMemory_Checked" Click="NavMemory_Checked"
                                 AutomationProperties.Name="الذاكرة">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="الذاكرة" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <!-- عدد خطط الذاكرة المستحقة النهارده أو المتأخرة (نفس نمط شارة سجل العمليات تحت) -->
                            <Border x:Name="MemoryBadge" Background="{DynamicResource DangerBgBrush}"
                                    CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="MemoryBadgeText" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <!-- شاشتين مختلفتين عن قصد: التقييم بتتشاف وبيتصرّف
                         منها، والتقارير بتطلّع ورق. خلطهم في شاشة واحدة
                         كان بيخلي المدير يدوّر على اللي بيهمه وسط تبويبات
                         بتعمل حاجة تانية خالص. -->
                    <RadioButton x:Name="NavEvaluationItem" Style="{StaticResource NavItem}"
                                 Checked="NavEvaluation_Checked" Click="NavEvaluation_Checked"
                                 AutomationProperties.Name="التقييم والمتابعة">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="التقييم والمتابعة" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavReportsItem" Style="{StaticResource NavItem}"
                                 Checked="NavReports_Checked" Click="NavReports_Checked"
                                 AutomationProperties.Name="التقارير">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="التقارير" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavActivityLogItem" Style="{StaticResource NavItem}"
                                 Checked="NavActivityLog_Checked" Click="NavActivityLog_Checked"
                                 AutomationProperties.Name="سجل العمليات">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="سجل العمليات" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <!-- عدد العمليات اللي اتسجّلت من آخر مرة الحساب ده فتح
                                 السجل — بتتصفّر أول ما الشاشة تتفتح (ActivityLogViewModel.LoadAsync) -->
                            <!-- DangerBgBrush/DangerBrush زوج ألوان متباين بالتصميم في الثيمين
                                 (نفس زوج شارة الحذف في سجل العمليات) — لون Danger الصريح بيعكس
                                 نفسه بين الثيمين فمش آمن لوحده كخلفية مصمتة -->
                            <Border x:Name="ActivityBadge" Background="{DynamicResource DangerBgBrush}"
                                    CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="ActivityBadgeText" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettingsItem" Style="{StaticResource NavItem}"
                                 Checked="NavSettings_Checked" Click="NavSettings_Checked"
                                 AutomationProperties.Name="الإعدادات والنسخ">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="الإعدادات والنسخ" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- قايمة منفصلة تمامًا عن "العمال والمهارات" —
                         الحسابات دي مش عمال إنتاج -->
                    <RadioButton x:Name="NavDepartmentAccountsItem" Style="{StaticResource NavItem}"
                                 Checked="NavDepartmentAccounts_Checked" Click="NavDepartmentAccounts_Checked"
                                 AutomationProperties.Name="الحسابات الإدارية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="الحسابات الإدارية" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- مرجع دائم بشرح كل شاشة + جولة سبوت لايت قصيرة لكل ميزة —
                         آخر عنصر عن قصد، زي أي "مساعدة" في أي برنامج -->
                    <RadioButton x:Name="NavHelpItem" Style="{StaticResource NavItem}"
                                 Checked="NavHelp_Checked" Click="NavHelp_Checked"
                                 AutomationProperties.Name="الدليل">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="الدليل" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>

                <!-- المؤشر الدهبي المشترك للبند المختار — عنصر واحد بينزلق
                     بدل ما كل بند يفعّل شريطه الخاص لوحده (كان كده قبل كده،
                     Opacity 0↔1 بلا حركة). موضعه بيتظبط برمجيًا
                     (PositionNavIndicator) بـTranslateTransform، مش Margin —
                     أرخص للحركة ومايأثرش على تخطيط باقي البنود. IsHitTestVisible
                     False عشان ميحجبش دوسة على أي بند. -->
                <Border x:Name="NavIndicator" Width="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                        CornerRadius="2" Background="{DynamicResource GoldGradientBrush}"
                        IsHitTestVisible="False" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorTransform" />
                    </Border.RenderTransform>
                </Border>
                </Grid>
            </DockPanel>

            <!-- زرار طي/فتح الشريط — ثابت في نفس المكان دايمًا (الحافة
                 الداخلية، جنب حد المحتوى)، برّه SidebarContent فمايختفيش
                 معاه. **HorizontalAlignment="Right" مقصودة** — الـGrid
                 الأب موروث FlowDirection=RightToLeft من النافذة، فـWPF
                 بيعكس معنى Left/Right وقت حل التخطيط: "Right" هنا فعليًا
                 بتترسم عند الحافة اليسرى الحقيقية (بعيد عن اللوجو اللي في
                 أول الصف الأفقي، يعني الحافة اليمنى). "Left" كانت بتتحط
                 فوق اللوجو بالظبط لنفس السبب بالعكس — شوف تعليق CLAUDE.md.
                 الأيقونة بتتقلب في الكود (SidebarToggle_Click) —
                 ChevronDoubleLeft وهو مطوي (دوس تفتح لجوّه)، ChevronDoubleRight
                 وهو مفتوح (دوس تقفل لبرّه) -->
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="{DynamicResource SidebarAltBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,10,0">
                <Grid>
                    <Button x:Name="SidebarToggleButton" Click="SidebarToggle_Click" Style="{StaticResource IconButton}" Padding="0"
                            Width="36" Height="36" ToolTip="طي القائمة الجانبية"
                            AutomationProperties.Name="طي أو فتح القائمة الجانبية">
                        <materialDesign:PackIcon x:Name="SidebarToggleIcon" Kind="ChevronDoubleRight"
                                                  Width="18" Height="18" Foreground="{DynamicResource GoldBrush}" />
                    </Button>
                    <!-- نقطة تنبيه صغيرة — بتبان لو فيه بادچ معلّق (سجل عمليات/
                         ذاكرة مستحقة) وقت ما الشريط يكون مطوي، عشان تنبيه
                         مهم ميضيعش لمجرد إن المستخدم طاوي الشريط -->
                    <Border x:Name="SidebarToggleBadgeDot" Width="9" Height="9" CornerRadius="4.5"
                            Background="{DynamicResource DangerBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                            IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>
            <!-- لوجو صغير = "الرئيسية" وهو مطوي — اللوجو الكبير جوّه SidebarContent
                 بيختفي مع الطي، والنسخة دي بتفضل ظاهرة في الشريط الضيق تحت زرار
                 الطي، فالرجوع للرئيسية متاح من أي شاشة في الحالتين -->
            <Button x:Name="CollapsedHomeButton" Style="{StaticResource CardButton}" Click="HomeLogo_Click"
                    Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,74,0,0"
                    ToolTip="الرئيسية" AutomationProperties.Name="الرئيسية"
                    Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <views:WmsLogo Width="30" Height="30" />
            </Button>
            </Grid>
        </Border>

        <!-- ══════════ منطقة المحتوى ══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- بانر وضع التجربة (Sandbox): صف مقفول بيدّي ارتفاع صفر لما
                 مش في تجربة، فمفيش فراغ زيادة في الاستخدام العادي -->
            <Border x:Name="SandboxBanner" Grid.Row="0" Visibility="Collapsed"
                    Background="{DynamicResource GoldTintBrush}" Padding="14,9">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="12,5"
                            Content="إنهاء التجربة" Click="SandboxExit_Click" />
                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FlaskOutline" Width="17" Height="17"
                                             Margin="0,0,8,0" VerticalAlignment="Center"
                                             Foreground="{DynamicResource GoldBrush}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="وضع تجربة تفاعلي — البيانات هنا وهمية للتدريب بس، مش بيانات مصنعك الحقيقية" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border Background="{DynamicResource GroundBrush}">
                    <ContentControl x:Name="MainContent" Margin="20,18" />
                </Border>

                <!-- الإشعارات فوق المحتوى: بتظهر في الركن وبتروح لوحدها،
                     والشغل تحتها مبيتوقفش -->
                <views:ToastHost x:Name="Toasts" />
            </Grid>
        </Grid>

        <!-- ══════════ جولة "إيه الجديد" (Spotlight) ══════════
             FlowDirection="LeftToRight" مقصود: المواقع بتتحسب في الكود
             بإحداثيات فعلية (TransformToVisual)، ولو سبنا RTL الموروثة
             كانت هتنعكس Margin.Left/HorizontalAlignment="Left" على الجنب
             التاني. النص العربي جوه الفقاعة بيرجّع RTL بنفسه. -->
        <Grid x:Name="TourOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="1000"
              FlowDirection="LeftToRight">
            <!-- دوسة على المنطقة المعتمة (برّه الفقاعة والهالة) = زي "تخطي الكل" —
                 نفس تعامل أي Overlay/Dialog تاني بيتقفل بدوسة برّه -->
            <Path x:Name="TourDimPath" Fill="#AA000000" MouseLeftButtonDown="TourDim_MouseLeftButtonDown" />
            <Border x:Name="TourHighlight" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="3"
                    CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
            <Border x:Name="TourCallout" Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
                    Padding="18,16" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    FlowDirection="RightToLeft">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TourStepCounter" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="TourTitle" FontSize="15.5" FontWeight="Bold" Margin="0,4,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TourDescription" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <!-- بتظهر بس أثناء خطوة تدريب تفاعلي حقيقية (RunGuidedStepAsync) —
                         بتوضّح إن العنصر المضوّي قابل للدوس فعليًا دلوقتي -->
                    <StackPanel x:Name="TourGuidedHint" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="CursorDefaultClick" Width="14" Height="14"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                        <TextBlock Text="دوس على العنصر المضوّي — هيكمّل لوحده" FontSize="11.5" Margin="6,0,0,0"
                                   FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="16,7" Content="التالي"
                                Click="TourNext_Click" />
                        <Button x:Name="TourBackButton" Style="{StaticResource GhostButton}" Padding="16,7" Margin="8,0,0,0"
                                Content="السابق" Click="TourBack_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="16,7" Margin="8,0,0,0"
                                Content="تخطي الكل" Click="TourSkip_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
