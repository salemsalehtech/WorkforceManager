<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WorkforceManager.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- ويندوز 8.1 و10/11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!--
    من غير المانيفست ده مفيش أي إعلان عن دعم الشاشات عالية الدقة، فويندوز
    بيعتبر البرنامج "DPI-unaware" ويعمل له Bitmap Stretch للنافذة كلها على
    أي شاشة مكبّرة (125%/150%/175% — الوضع الافتراضي على أغلب أجهزة
    ويندوز الحديثة). الـ Stretch ده هو سبب الشكل الضبابي والألوان الباهتة:
    ويندوز بياخد صورة النافذة اللي البرنامج رسمها بدقة عادية ويكبّرها زي
    الصورة، فكل حاجة (خط، أيقونة، حدود، تدرّج لوني) بتترسم من جديد بكسلات
    ممزوجة بدل حوافها الأصلية الحادة.
    PerMonitorV2 بيخلي ويندوز يقول للبرنامج مقاس الشاشة الحقيقي، والبرنامج
    (WPF بيدعمها أصلاً) يرسم على المقاس ده مباشرة من غير تكبير لاحق.
  -->
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
