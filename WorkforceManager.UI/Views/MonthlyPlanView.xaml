<UserControl x:Class="WorkforceManager.UI.Views.MonthlyPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <!-- الخطة الشهرية: كمية مخططة لكل منتج لشهر واحد — تخطيط بس، مفيش
         تحقيق/مقارنة بإنتاج فعلي هنا (شوف MonthlyPlanViewModel). خطة
         العيلة دايمًا SUM محسوب، مفيش TextBox عليها خالص. -->
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- التنقل بين الشهور -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource IconButton}" Padding="8">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                </Button>
                <TextBlock Text="{Binding MonthLabel}" FontSize="16" FontWeight="Bold" Margin="10,0"
                           VerticalAlignment="Center" MinWidth="130" TextAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Command="{Binding NextMonthCommand}" Style="{StaticResource IconButton}" Padding="8">
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <Button Command="{Binding CopyFromPreviousMonthCommand}" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Padding="14,9" Margin="0,0,16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center"/>
                    <TextBlock Text="انسخ خطة الشهر اللي فات" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- الإجمالي العام -->
            <StackPanel Style="{StaticResource SummaryStat}" Margin="0,0,16,8">
                <TextBlock Text="{Binding GrandTotal, StringFormat=N0}" Style="{StaticResource SummaryNumber}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="إجمالي الخطة" Style="{StaticResource SummaryLabel}"/>
            </StackPanel>
        </WrapPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Card}" Padding="14">
                <ItemsControl ItemsSource="{Binding FamilyGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <DockPanel Margin="2,0,0,8">
                                    <TextBlock Text="{Binding Subtotal, StringFormat=' — إجمالي القسم: {0:N0}'}"
                                               DockPanel.Dock="Left" FontSize="12.5" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GoldDeepBrush}"/>
                                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Products}" Tag="{Binding}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="12,9">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <!-- التحذير: منتج ناقصه وزن أو مادة — العيلة نفسها مش شرط -->
                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="AlertOutline"
                                                                             Width="15" Height="15" Margin="0,0,10,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource WarnBrush}"
                                                                             ToolTip="ناقصه وزن القطعة أو المادة — كمّل بياناته من فورم المنتج"
                                                                             Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVis}}"/>

                                                    <TextBox DockPanel.Dock="Left" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="90" TextAlignment="Center" Margin="0,0,14,0"
                                                             Tag="{Binding}" LostFocus="QuantityBox_LostFocus"/>

                                                    <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
