<UserControl x:Class="WorkforceManager.UI.Views.MonthlyPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             xmlns:tour="clr-namespace:WorkforceManager.UI.Tour"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">

    <!--
      الخطة الشهرية: دخول الخطة + تتبّع حي للمحقق. تخطيط من فوق لتحت:
        1. شريط علوي: تنقل شهور + لقطة يوم معيّن + انسخ الشهر اللي فات + الإجمالي
        2. شريط ملخص: عدد ماشي صح/متأخر/سابق
        3. تنبيه لطيف لعيلة واطية (مايمنعش الاستخدام، بس Banner)
        4. أولوياتي النهاردة: أكتر 3-5 منتجات محتاجة دفعة
        5. الجدول الرئيسي مجمّع بالعيلة — المتأخر فوق كل قسم تلقائيًا
      خطة/محقق العيلة دايمًا SUM محسوب، مفيش حقل كتابة عليهم.
    -->
    <UserControl.Resources>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ 1. الشريط العلوي ═══════════ -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource IconButton}" Padding="8">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                </Button>
                <TextBlock Text="{Binding MonthLabel}" FontSize="16" FontWeight="Bold" Margin="10,0"
                           VerticalAlignment="Center" MinWidth="130" TextAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Command="{Binding NextMonthCommand}" Style="{StaticResource IconButton}" Padding="8">
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <!-- لقطة يوم معيّن (البند 9) — التتبّع كله بيتحسب لحد التاريخ ده -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                <TextBlock Text="لحد يوم:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" />
                <DatePicker x:Name="AsOfDatePicker" SelectedDate="{Binding AsOfDate, Mode=OneWay}"
                            SelectedDateChanged="AsOfDatePicker_SelectedDateChanged" Width="130" />
            </StackPanel>

            <Button Command="{Binding CopyFromPreviousMonthCommand}" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Padding="14,9" Margin="0,0,16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="انسخ خطة الشهر اللي فات" Margin="6,0,0,0" />
                </StackPanel>
            </Button>

            <StackPanel Style="{StaticResource SummaryStat}" Margin="0,0,16,8">
                <TextBlock Text="{Binding GrandTotalAchieved, StringFormat=N0}" Style="{StaticResource SummaryNumber}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding GrandTotalPlan, StringFormat='محقق من {0:N0} مخطط'}" Style="{StaticResource SummaryLabel}" />
            </StackPanel>

            <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Padding="14,9" Margin="0,0,16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="تصدير إكسل" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- ═══════════ 2. شريط الملخص ═══════════ -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource GoodTintBrush}" Margin="0,0,8,0">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource GoodBrush}">
                    <Run Text="{Binding OnTrackCount, Mode=OneWay}" /><Run Text=" ماشي صح" />
                </TextBlock>
            </Border>
            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource DangerTintBrush}" Margin="0,0,8,0">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource DangerBrush}">
                    <Run Text="{Binding BehindCount, Mode=OneWay}" /><Run Text=" متأخر" />
                </TextBlock>
            </Border>
            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource GoldTintBrush}">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource GoldDeepBrush}">
                    <Run Text="{Binding AheadCount, Mode=OneWay}" /><Run Text=" سابق" />
                </TextBlock>
            </Border>
            <!-- أيقونة واحدة بتشرح الحدود التلاتة مع بعض، بدل ما تتكرر على كل بادچ لوحده -->
            <views:HelpIcon Text="{x:Static tour:FieldHelpText.PaceStatus}" Margin="0,0,14,0" />

            <!-- نسبة المحقق والمطلوب النهارده بيتكرروا لكل منتج تحت — الشرح
                 مرة واحدة هنا بدل أيقونة على كل كارت منتج -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="نسبة المحقق" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <views:HelpIcon Text="{x:Static tour:FieldHelpText.AchievedPercent}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="المطلوب النهارده" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <views:HelpIcon Text="{x:Static tour:FieldHelpText.RequiredDailyOutput}" />
            </StackPanel>
        </WrapPanel>

        <!-- ═══════════ 3. تنبيه لطيف — عيلة واطية عن الإيقاع (البند 6) ═══════════ -->
        <Border Grid.Row="2" Background="{DynamicResource DangerTintBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding HasBelowThresholdFamilies, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AlertCircleOutline" Width="18" Height="18"
                                         VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Margin="0,0,10,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding BelowThresholdFamiliesText}" />
            </DockPanel>
        </Border>

        <!-- ═══════════ 4. أولوياتي النهاردة (البند 10) ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10"
                    Visibility="{Binding HasPriorities, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="أولوياتي النهاردة" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
            <ItemsControl ItemsSource="{Binding TodaysPriorities}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonthlyPlanProductRow}">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="12,9" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}">
                                    <Run Text="محتاج" /><Run Text="{Binding RequiredDailyOutput, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="النهارده، اتعمل" /><Run Text="{Binding TodayCompleted, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ═══════════ 5. الجدول الرئيسي — مادة فوق عيلة، زي شيت المصنع الأصلي ═══════════ -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MaterialGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonthlyPlanMaterialGroupRow}">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- رأس المادة: قسم كامل مستقل (نحاس/زاما/غير محدد) بإجمالياته -->
                                <DockPanel Margin="2,0,0,10">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <TextBlock FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GoldDeepBrush}">
                                            <Run Text="محقق" /><Run Text="{Binding AchievedSubtotal, Mode=OneWay, StringFormat=N0}" />
                                            <Run Text="من خطة" /><Run Text="{Binding Subtotal, Mode=OneWay, StringFormat=N0}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding HasWeight, Converter={StaticResource BoolToVis}}">
                                            <Run Text="إجمالي الوزن" /><Run Text="{Binding TotalWeightKg, Mode=OneWay, StringFormat='{}{0:N1} كجم'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HeaderText}" FontSize="{DynamicResource FontLarge}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding FamilyGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MonthlyPlanFamilyGroupRow}">
                                            <StackPanel Margin="0,0,0,18">
                                                <DockPanel Margin="2,0,0,8">
                                                    <WrapPanel DockPanel.Dock="Left">
                                                        <TextBlock FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMutedBrush}">
                                                            <Run Text="— محقق" /><Run Text="{Binding AchievedSubtotal, Mode=OneWay, StringFormat=N0}" />
                                                            <Run Text="من خطة" /><Run Text="{Binding Subtotal, Mode=OneWay, StringFormat=N0}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding HasWeight, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="وزن" /><Run Text="{Binding TotalWeightKg, Mode=OneWay, StringFormat='{}{0:N1} كجم'}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasCorrections, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="تصليحات" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <Run Text="{Binding CorrectionsSubtotal, Mode=OneWay, StringFormat=N0}" FontWeight="Bold"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </TextBlock>
                                                        <!-- فرق الإنتاج اليومي على مستوى المجموعة — سالب (أحمر) لسه ناقص عن المطلوب، موجب (أخضر) فوق المطلوب -->
                                                        <TextBlock FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="Bold"
                                                                   Visibility="{Binding HasDailyGap, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDailyGapNegative}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="فرق اليوم" />
                                                            <Run Text="{Binding DailyGap, Mode=OneWay, StringFormat=N0}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionTitle}" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MonthlyPlanProductRow}">
                                            <Border Margin="0,0,0,8" Padding="14,11">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <!-- الصف الأول: اسم + خطة + بار تقدم ملوّن + نسبة + مقارنة الشهر اللي فات -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="140" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AlertOutline" Width="14" Height="14"
                                                                                     Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource WarnBrush}"
                                                                                     ToolTip="ناقصه وزن القطعة أو المادة"
                                                                                     Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVis}}" />
                                                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </DockPanel>

                                                        <TextBox Name="QuantityBox" Grid.Column="1" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="80" TextAlignment="Center" Tag="{Binding}"
                                                                 LostFocus="QuantityBox_LostFocus" ToolTip="الكمية المخططة" />

                                                        <!-- بار التقدم الملوّن (البند 1) — Behind/OnTrack/Ahead، بدل رقم عاري.
                                                             Maximum ثابت 150 (نفس تقصير ProgressBarPercent) — أعلى من 150%
                                                             بيتقص بصريًا، العارضة مش أرقام دقيقة -->
                                                        <ProgressBar Grid.Column="2" Height="8" Margin="10,0" VerticalAlignment="Center"
                                                                     Minimum="0" Maximum="150" Value="{Binding ProgressBarPercent, Mode=OneWay}"
                                                                     Background="{DynamicResource MeterTrackBrush}" BorderThickness="0"
                                                                     ui:ThemeBrush.ForegroundKey="{Binding StatusInkKey}" />

                                                        <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontWeight="Bold"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   ui:ThemeBrush.ForegroundKey="{Binding StatusInkKey}" />

                                                        <TextBlock Grid.Column="4" Text="{Binding ComparisonText}" FontSize="11" FlowDirection="LeftToRight"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="مقارنة بنفس اليوم من الشهر اللي فات"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>

                                                    <!-- الصف الثاني: انتاج اليوم | المطلوب النهارده بالظبط | توقّع نهاية الشهر | تصليحات -->
                                                    <WrapPanel Margin="0,9,0,0">
                                                        <TextBlock FontSize="11.5" Margin="0,0,18,4" Foreground="{DynamicResource TextMutedBrush}">
                                                            <Run Text="إنتاج النهارده:" /><Run Text="{Binding TodayCompleted, Mode=OneWay}" FontWeight="Bold"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="11.5" Margin="0,0,18,4" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding HasRequiredDailyOutput, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="المطلوب النهارده:" /><Run Text="{Binding RequiredDailyOutput, Mode=OneWay}" FontWeight="Bold"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="11.5" Margin="0,0,18,4" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding HasForecast, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="توقّع نهاية الشهر:" /><Run Text="{Binding ForecastEndOfMonth, Mode=OneWay}" FontWeight="Bold"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                            <TextBlock Text="تصليحات:" FontSize="11.5" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                                            <TextBox Text="{Binding CorrectionText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="60" TextAlignment="Center" FontSize="11.5" Tag="{Binding}"
                                                                     LostFocus="CorrectionBox_LostFocus"
                                                                     ToolTip="تعديل يدوي على المحقق ليوم اللقطة المعروض — مش مشتق من أي رحلة إنتاج" />
                                                        </StackPanel>

                                                        <!-- الخطة اليومية: هدف يومي يدوي بيحدده المستخدم بنفسه، مختلف عن
                                                             "المطلوب النهارده" المحسوب فوق (اللي بيتغيّر كل ما الأيام تنقص) -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="الخطة اليومية:" FontSize="11.5" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                                            <TextBox Text="{Binding DailyTargetText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="60" TextAlignment="Center" FontSize="11.5" Tag="{Binding}"
                                                                     LostFocus="DailyTargetBox_LostFocus"
                                                                     ToolTip="هدف يومي يدوي — سايبه فاضي يعني مفيش هدف محدد لهذا المنتج" />
                                                        </StackPanel>
                                                        <views:FieldError Message="{Binding DailyTargetError}" Margin="0,0,0,4" />
                                                        <Border Background="{DynamicResource GoldTintBrush}" CornerRadius="8" Padding="7,1" Margin="0,0,0,4"
                                                                Visibility="{Binding IsOutsidePlan, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="إنتاج خارج الخطة" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource GoldDeepBrush}" />
                                                        </Border>
                                                        <TextBlock FontSize="11.5" Margin="0,0,18,4" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding HasWeight, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="الوزن:" /><Run Text="{Binding TotalWeightKg, Mode=OneWay, StringFormat='{}{0:N2} كجم'}" FontWeight="Bold"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
