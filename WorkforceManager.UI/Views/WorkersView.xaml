<UserControl x:Class="WorkforceManager.UI.Views.WorkersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <!--
      ═══════════ شاشة العمال والمهارات ═══════════

      التخطيط: ترويسة الصفحة، بعدين صف تحكّم واحد، بعدين عمودين —
      قائمة العمال على اليمين وبروفايل المحدد على الشمال.

      قواعد التصميم اللي الشاشة دي ماشية عليها (وباقي الشاشات هتمشي
      عليها بعد كده):
        • الدهبي أكسنت مش لون نص: بيروح على الرقم البطل، والعنصر
          النشط، والشريط اللي على حرف الكارت المختار.
        • أرقام كبيرة وعناوين صغيرة: العين بتمسك الرقم الأول، والكلمة
          اللي تحته بتفسّره.
        • كل الأيقونات 15 في القوائم و17 في الترويسات — المقاسات
          المختلطة هي أكتر حاجة بتخلي الشاشة تبان عشوائية.
        • كل الألوان DynamicResource عشان الوضع الليلي يتبدّل لحظيًا.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ الصف الموحّد ═══════════
             كانت 3 صفوف منفصلة (عنوان+إحصائيات، بحث+شرايط+فلاتر، فترة
             العرض) بتاخد مساحة رأسية كتير من غير داعي — اتدمجوا في صف
             واحد. الفترة والفلاتر بقوا زرارين Popup (نفس نمط "فلاتر
             وترتيب" الأصلي) بدل ما ياخدوا مكان دايم على الشاشة. -->
        <!-- WrapPanel مش Grid بأعمدة Auto ثابتة: أول تصميم كان Grid وعناصره
             (زرار "عامل جديد" وأيقونة الترتيب) اختفوا برّه حافة الشاشة على
             شاشة أضيق — عمود Auto في Grid مابيصغرش ومابيلفش، فأي عجز في
             العرض الكلي بيدفع آخر الأعمدة برّه المرئي بصمت، من غير أي
             تنبيه أو خطأ بناء (نفس مشكلة WrapPanel-vs-StackPanel الموثّقة
             في CLAUDE.md، بس هنا على مستوى Grid كامل مش صف Pills). الحل:
             WrapPanel حقيقي — أي عنصر مايلاقيش مكان بيلف لسطر تاني، مايختفيش
             خالص. كل عنصر هنا بهامش يمين+تحت ثابت (نفس تعليق العمال
             الأصلي) عشان التباعد يفضل متساوي في أي سطر. -->
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">

            <!-- العنوان + الإحصائيات مدمجين في سطر واحد بدل عنوان كبير
                 وسطر إحصائيات تحته -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                <TextBlock Text="العمال" FontSize="{DynamicResource FontLarge}" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="·" Margin="10,0" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                    <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold"  Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" نشط" />
                </TextBlock>

                <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                    <Run Text="{Binding HourlyCount, Mode=OneWay}" FontWeight="Bold"  Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" بالساعة" />
                </TextBlock>

                <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                    <Run Text="{Binding InactiveCount, Mode=OneWay}" FontWeight="Bold"  Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" موقوف" />
                </TextBlock>

                <!-- المحتاجين انتباه: زرار مش نص، لأنه بيعمل حاجة -->
                <Button x:Name="ShowNeedsAttentionButton" Command="{Binding ShowNeedsAttentionCommand}"
                        Margin="10,0,0,0" Padding="10,3"
                        ToolTip="اعرض العمال دول بس">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsAttentionCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="14" Height="14"
                                                 VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,0,0" FontSize="{DynamicResource FontTiny}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding NeedsAttentionCount, Mode=OneWay}" FontWeight="Bold"  Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" محتاج انتباه" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- البحث: بيشتغل مع كل حرف، مفيش زرار ولا Enter -->
            <Border Width="230" Margin="0,0,20,8" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,0" Height="36">
                <Grid>
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                 Width="16" Height="16" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource InkFaintBrush}" />
                        <Button DockPanel.Dock="Right" Command="{Binding ClearSearchCommand}"
                                Padding="5" ToolTip="مسح البحث">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
                        </Button>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent" Padding="0">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </DockPanel>

                    <TextBlock Text="دوّر بالاسم أو بالمهارة…" Margin="30,0,0,0"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource InkFaintBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel x:Name="QuickFilterChipsPanel" Orientation="Horizontal" Margin="0,0,14,8"
                        VerticalAlignment="Center">
                <RadioButton Content="الكل" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
                <RadioButton Content="بالإنتاج" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterPiece, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="piece" />
                <RadioButton Content="بالساعة" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterHourly, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="hourly" />
                <RadioButton Content="موقوفين" Style="{DynamicResource Chip}"
                             IsChecked="{Binding IsFilterInactive, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="inactive" />
            </StackPanel>

            <TextBlock Text="{Binding ResultsText}" VerticalAlignment="Center"
                       Margin="0,0,20,8" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkSoftBrush}" />

            <!-- الفترة: كانت بطاقة كاملة فوق الشبكة (PeriodControlCard) —
                 بقت زرار Popup بنفس نمط "فلاتر وترتيب" بالظبط -->
            <Grid Margin="0,0,8,8" VerticalAlignment="Center">
                <ToggleButton x:Name="PeriodToggle" Style="{DynamicResource ToolbarToggle}"
                              IsChecked="{Binding IsPeriodMenuOpen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarRange" Width="15" Height="15"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PeriodLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                 Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsPeriodMenuOpen, Mode=TwoWay}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=PeriodToggle}" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{DynamicResource ToolbarPopupCard}"
                            FlowDirection="RightToLeft" Width="300">
                        <StackPanel>
                            <RadioButton Style="{StaticResource Chip}" Content="أسبوع" GroupName="WorkersPeriod"
                                         IsChecked="{Binding IsPeriodWeek, Mode=OneWay}"
                                         Command="{Binding SetPeriodGrainCommand}" CommandParameter="week" />
                            <RadioButton Style="{StaticResource Chip}" Content="شهر" GroupName="WorkersPeriod"
                                         IsChecked="{Binding IsPeriodMonth, Mode=OneWay}"
                                         Command="{Binding SetPeriodGrainCommand}" CommandParameter="month" />
                            <RadioButton Style="{StaticResource Chip}" Content="مدة مخصوصة" GroupName="WorkersPeriod"
                                         IsChecked="{Binding IsPeriodCustom, Mode=OneWay}"
                                         Command="{Binding SetPeriodGrainCommand}" CommandParameter="custom" />

                            <!-- أسبوع/شهر: سهمين رجوع وقدّام -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding IsPeriodCustom, Converter={StaticResource InverseBoolToVis}}">
                                <Button Command="{Binding PrevPeriodCommand}"
                                        Style="{StaticResource IconButton}" Padding="5,3"
                                        ToolTip="الفترة اللي فاتت">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="15" Height="15" />
                                </Button>
                                <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center"
                                           FontSize="12.5" Margin="4,0,4,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <Button Command="{Binding NextPeriodCommand}"
                                        Style="{StaticResource IconButton}" Padding="5,3"
                                        ToolTip="الفترة اللي بعدها">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="15" Height="15" />
                                </Button>
                            </StackPanel>

                            <!-- مدة مخصوصة: تاريخين بدل السهمين -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding IsPeriodCustom, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <DatePicker SelectedDate="{Binding CustomFrom}" Width="120" VerticalAlignment="Center" />
                                <TextBlock Text="لحد" VerticalAlignment="Center" Margin="8,0,6,0" />
                                <DatePicker SelectedDate="{Binding CustomTo}" Width="120" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- الفلاتر والترتيب جوّه زرار واحد -->
            <Grid VerticalAlignment="Center" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <!-- تكبير/تصغير كروت الشبكة يدويًا — كروت أصغر يبقى عدد أكتر
                         في الصف، أكبر يبقى أوضح. شوف WorkersViewModel.IsCompactGrid -->
                    <Button Command="{Binding ToggleGridDensityCommand}"
                            Style="{DynamicResource IconButton}" Padding="7,5" Margin="0,0,6,0"
                            ToolTip="كروت أصغر/أكبر">
                        <materialDesign:PackIcon Width="17" Height="17">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ViewGridOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactGrid}" Value="True">
                                            <Setter Property="Kind" Value="ViewComfyOutline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>

                    <ToggleButton x:Name="FilterToggle" Style="{DynamicResource ToolbarToggle}"
                                  IsChecked="{Binding IsFilterMenuOpen, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="فلاتر وترتيب" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource GoldBrush}" CornerRadius="8"
                                    Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasExtraFilters, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveFilterCount}"
                                           FontSize="{DynamicResource FontMicro}" FontWeight="Bold"
                                           Foreground="{DynamicResource InkOnAccentBrush}" />
                            </Border>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                     Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <Popup IsOpen="{Binding IsFilterMenuOpen, Mode=TwoWay}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=FilterToggle}" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{DynamicResource ToolbarPopupCard}"
                            FlowDirection="RightToLeft" Width="300">
                        <StackPanel>
                            <TextBlock Text="المرحلة" Style="{DynamicResource SectionLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding StageFilterOptions}"
                                      SelectedItem="{Binding SelectedStageFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="العمال المؤهلين لمرحلة معينة" />

                            <TextBlock Text="المنتج" Style="{DynamicResource SectionLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding ProductFilterOptions}"
                                      SelectedItem="{Binding SelectedProductFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="العمال اللي عندهم مهارة في المنتج ده" />

                            <TextBlock Text="التقييم" Style="{DynamicResource SectionLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding StarsFilterOptions}"
                                      SelectedItem="{Binding SelectedStarsFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="متوسط تقييم العامل على كل مهاراته" />

                            <TextBlock Text="الحضور النهارده" Style="{DynamicResource SectionLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding AttendanceFilterOptions}"
                                      SelectedItem="{Binding SelectedAttendanceFilter}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}"
                                      ToolTip="حالة الحضور المسجّلة النهارده" />

                            <Border Height="1" Margin="0,14,0,12"
                                    Background="{DynamicResource LineBrush}" />

                            <TextBlock Text="الترتيب" Style="{DynamicResource SectionLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                      DisplayMemberPath="Display" FontSize="{DynamicResource FontSmall}" />

                            <Button Command="{Binding ClearExtraFiltersCommand}"
                                    Style="{DynamicResource QuietButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Visibility="{Binding HasExtraFilters, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterRemove" Width="14" Height="14"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="شيل الفلاتر" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ترتيب العمال: أيقونة بس دلوقتي (كان نص+أيقونة) — توفير مساحة
                 أفقية في الصف المزدحم ده، الوظيفة نفسها زي ما هي -->
            <Button x:Name="OpenWorkerOrderButton" Command="{Binding OpenWorkerOrderCommand}"
                    Style="{DynamicResource IconButton}" Padding="8,6" VerticalAlignment="Center"
                    Margin="0,0,8,8" ToolTip="رتّب العمال بالترتيب اللي عايزه — نفس الترتيب هيظهر في كل مكان">
                <materialDesign:PackIcon Kind="SwapVertical" Width="17" Height="17" />
            </Button>

            <Button x:Name="AddWorkerButton" Command="{Binding AddWorkerCommand}"
                    Style="{DynamicResource GoldButton}" VerticalAlignment="Center" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="17" Height="17"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="عامل جديد" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- ═══════════ تذكير مراجعة التقييمات ═══════════
             بيظهر مرة كل شهر ولو فيه اقتراحات فعلاً بس. التذكير من غير
             حاجة تستاهل بيتحوّل لضوضاء المستخدم بيتعلّم يتجاهلها. -->
        <Border x:Name="SkillReviewCard" Grid.Row="1" Margin="0,0,0,14" Padding="16,13"
                CornerRadius="{DynamicResource RadiusCard}"
                Background="{DynamicResource GoldTintBrush}"
                BorderBrush="{DynamicResource GoldLineBrush}" BorderThickness="1"
                Visibility="{Binding NeedsSkillReview, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding OpenSkillReviewCommand}"
                        Style="{DynamicResource GoldButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StarCog" Width="15" Height="15"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="راجع دلوقتي" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource SurfaceBrush}">
                        <materialDesign:PackIcon Kind="StarCheckOutline" Width="18" Height="18"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource GoldDeepBrush}" />
                    </Border>
                    <TextBlock Text="{Binding SkillReviewText}" FontSize="{DynamicResource FontBase}"
                               FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GoldDeepBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- ═══════════ القائمة (شبكة الكروت) ═══════════
             كانت عمودين (قائمة + لوحة تفاصيل جانبية 380px محجوزة دايمًا
             حتى لو مفيش عامل متحدد). اللوحة بقت WorkerDetailDialog Modal
             (نفس نقلة ProductDetailDialog) — العمود اتشال خالص، فالشبكة
             بقت تاخد العرض المتاح كله وعدد الكروت في الصف زاد. -->
        <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- بطاقة الفترة (أسبوع/شهر/مدة مخصوصة) كانت هنا كصف كامل —
                     اتنقلت لزرار Popup في الصف الموحّد فوق (شوف
                     WorkersViewModel.IsPeriodMenuOpen)، فالمحتوى نفسه
                     (RadioButtons + الأسهم/التواريخ) عايش هناك دلوقتي، مش
                     اتكرر أو اتشال. -->

                <!-- ═══ كارت أحسن 3 عمال ═══
                     الكارت الوحيد اللي بياخد الدهبي كخلفية في الشاشة —
                     عشان كده بيبان من غير ما يبقى أكبر من غيره. كارت #1
                     أكبر من #2/#3. الدوسة على فايز بتفتح "ليه فاز؟" في
                     وضع الأسبوع، وبروفايله مباشرة في وضع الشهر/المدة
                     المخصوصة (الشرح الأسبوعي مش متاح غير لأسبوع حقيقي). -->
                <Border Grid.Row="0" CornerRadius="{DynamicResource RadiusCard}" Padding="16,13"
                        Margin="0,0,0,12" Background="{DynamicResource SidebarBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270"
                                          Opacity="0.16" Color="{DynamicResource ShadowColor}" />
                    </Border.Effect>

                    <StackPanel>
                        <!-- الهيدر نفسه بقى زرار — طي/فتح بدل ما الكارت ياخد
                             مساحة رأسية ثابتة طول الوقت حتى لو المستخدم مش
                             محتاجه دلوقتي (شوف WorkersViewModel.IsBestWorkersExpanded).
                             نفس نمط رأس كارت المهارة القابل للطي في
                             WorkerDetailDialog. -->
                        <Button Command="{Binding ToggleBestWorkersCommand}"
                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                BorderThickness="0" Padding="0" Background="Transparent"
                                Margin="0,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <DockPanel>
                                <materialDesign:PackIcon DockPanel.Dock="Left" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource GoldBrush}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBestWorkersExpanded}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <Grid DockPanel.Dock="Left" Margin="8,0,0,0">
                                    <materialDesign:PackIcon Kind="TrophyVariantOutline"
                                                             Width="22" Height="22" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource GoldBrush}" />
                                    <!-- نقطة صغيرة تقول "فيه فايزين تستاهل تشوفهم" وانت لسه مطوي —
                                         بتختفي أول ما تفتح، مفيش داعي تتكرر مع البودیوم الظاهر -->
                                    <Border Width="7" Height="7" CornerRadius="3.5"
                                            Background="{DynamicResource DangerBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-2,-2,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsBestWorkersExpanded}" Value="False" />
                                                            <Condition Binding="{Binding HasBestWorkerCards}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                                <TextBlock Text="أحسن 3 عمال" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSmall}" FontWeight="Bold"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource GoldBrush}" />
                            </DockPanel>
                        </Button>

                        <!-- حالة مفيش فايزين (فترة قبل الميزة، أو مفيش إنتاج قطع أصلًا) -->
                        <TextBlock Text="لا يوجد عمال مؤهلين للتقييم في الفترة دي"
                                   FontSize="{DynamicResource FontSmall}" HorizontalAlignment="Center"
                                   Margin="0,10,0,4"
                                   Foreground="{DynamicResource SidebarInkSoftBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBestWorkersExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasBestWorkerCards}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- صف الفايزين: بوديوم — #1 في النص وأكبر، #2/#3 على الجنبين وأصغر
                             ومرفوعين لأسفل شوية (VerticalAlignment=Bottom + Margin علوي) عشان
                             يبانوا "واقفين على درجة أوطى" فعليًا. StackPanel مش Grid بأعمدة —
                             عنصر Collapsed (أقل من 3 فايزين) مبياخدش مكان، فالباقي بيترصّ في
                             النص لوحده من غير فراغات. -->
                        <StackPanel x:Name="BestWorkerCardsRow" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBestWorkersExpanded}" Value="True" />
                                                <Condition Binding="{Binding HasBestWorkerCards}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- #2 (يسار بصريًا تحت RTL) -->
                            <Button Style="{StaticResource CardButton}" Width="96" Margin="0,18,10,0"
                                    Command="{Binding OpenRecognitionDetailCommand}"
                                    CommandParameter="{Binding BestWorkerCard2}"
                                    Visibility="{Binding HasBestWorkerCard2, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding RecognitionCardTooltip}">
                                <Border CornerRadius="{DynamicResource RadiusCard}" Padding="8,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid HorizontalAlignment="Center">
                                            <views:WorkerAvatar Diameter="32"
                                                                PhotoData="{Binding BestWorkerCard2.PhotoData}"
                                                                Initials="{Binding BestWorkerCard2.Initials}" />
                                            <Border Width="18" Height="18" CornerRadius="9"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-4,0" Background="{DynamicResource GoldBrush}"
                                                    Opacity="0.75">
                                                <TextBlock Text="{Binding BestWorkerCard2.Rank}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource InkOnAccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding BestWorkerCard2.FullName}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource FontSmall}" FontWeight="Bold"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SidebarInkBrush}" />
                                        <TextBlock Text="{Binding BestWorkerCard2.ScoreText}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource FontMicro}" TextAlignment="Center"
                                                   Margin="0,2,0,0" Foreground="{DynamicResource SidebarInkSoftBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- #1 (النص، أكبر) -->
                            <Button Style="{StaticResource CardButton}" Width="140"
                                    Command="{Binding OpenRecognitionDetailCommand}"
                                    CommandParameter="{Binding BestWorkerCard1}"
                                    ToolTip="{Binding RecognitionCardTooltip}">
                                <Border CornerRadius="{DynamicResource RadiusCard}" Padding="12,14">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid HorizontalAlignment="Center">
                                            <views:WorkerAvatar Diameter="56"
                                                                PhotoData="{Binding BestWorkerCard1.PhotoData}"
                                                                Initials="{Binding BestWorkerCard1.Initials}" />
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0" Background="{DynamicResource GoldGradientBrush}">
                                                <TextBlock Text="{Binding BestWorkerCard1.Rank}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource InkOnAccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding BestWorkerCard1.FullName}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource FontTitle}" FontWeight="Bold"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SidebarInkBrush}" />
                                        <TextBlock Text="{Binding BestWorkerCard1.ScoreText}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource FontSmall}" TextAlignment="Center"
                                                   Margin="0,3,0,0" Foreground="{DynamicResource SidebarInkSoftBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- #3 (يمين بصريًا تحت RTL) -->
                            <Button Style="{StaticResource CardButton}" Width="96" Margin="10,18,0,0"
                                    Command="{Binding OpenRecognitionDetailCommand}"
                                    CommandParameter="{Binding BestWorkerCard3}"
                                    Visibility="{Binding HasBestWorkerCard3, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding RecognitionCardTooltip}">
                                <Border CornerRadius="{DynamicResource RadiusCard}" Padding="8,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid HorizontalAlignment="Center">
                                            <views:WorkerAvatar Diameter="32"
                                                                PhotoData="{Binding BestWorkerCard3.PhotoData}"
                                                                Initials="{Binding BestWorkerCard3.Initials}" />
                                            <Border Width="18" Height="18" CornerRadius="9"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-4,0" Background="{DynamicResource GoldBrush}"
                                                    Opacity="0.55">
                                                <TextBlock Text="{Binding BestWorkerCard3.Rank}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource InkOnAccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding BestWorkerCard3.FullName}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource FontSmall}" FontWeight="Bold"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SidebarInkBrush}" />
                                        <TextBlock Text="{Binding BestWorkerCard3.ScoreText}" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource FontMicro}" TextAlignment="Center"
                                                   Margin="0,2,0,0" Foreground="{DynamicResource SidebarInkSoftBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ شبكة كروت العمال ═══
                     ItemsControl+WrapPanel بدل ListBox — نفس بنية ProductsGrid
                     بالظبط (شوف CLAUDE.md قسم "شاشة العمال"). التحديد بقى يدوي
                     (WorkerRow.IsSelected + SelectWorkerCommand) بدل
                     ListBox.SelectedItem — شوف WorkersViewModel.OnSelectedWorkerChanged. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{DynamicResource Card}" Padding="14">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoResults}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="AccountSearchOutline" Width="44" Height="44"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource InkFaintBrush}" />
                                <TextBlock Text="مفيش عامل بالمواصفات دي" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{DynamicResource FontBase}"
                                           Foreground="{DynamicResource InkSoftBrush}" />
                            </StackPanel>

                            <ItemsControl x:Name="WorkersGrid" ItemsSource="{Binding Workers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- عرض الكارت محسوب من عرض الشبكة الفعلي (GridColumnWidthConverter)
                                             عشان يضمن 5 أعمدة بالظبط مهما كان حجم النافذة — رقم عرض ثابت
                                             (260 مثلًا) بيصح على شاشة ويغلط على تانية، والمستخدم لقى إنه
                                             بيدّي 4 بس مش 5 على شاشته. IsCompactGrid بقى بيأثّر على حجم
                                             العناصر جوّه الكارت بس (أفاتار/خط)، مش على عرض الكارت نفسه
                                             (اللي بقى مضمون بالحساب مش بالتبديل اليدوي). -->
                                        <Button Style="{StaticResource CardButton}" Opacity="0" Click="WorkerTile_Click"
                                                Margin="0,0,10,10"
                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource GridColumnWidth}, ConverterParameter=5}">
                                            <Button.ContextMenu>
                                                <!-- تعديل/إيقاف/حذف سريع من غير فتح الديالوج بالكامل.
                                                     ContextMenu مش وارث DataContext من مالكه تلقائيًا في
                                                     WPF (بايظة معروفة — مش جزء من الشجرة المرئية وقت حل
                                                     الوراثة)، فبنربطه صراحة بـPlacementTarget.DataContext
                                                     (اللي WPF بيظبطه تلقائيًا على الزرار المالك) عشان كل
                                                     MenuItem يوصل لصف WorkerRow صح؛ الأوامر نفسها بتتنفذ من
                                                     كود-behind (نفس أسلوب WorkerTile_Click بالظبط) لأن
                                                     الأوامر عايشة في WorkersViewModel مش في WorkerRow. -->
                                                <ContextMenu FlowDirection="RightToLeft"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="تعديل" Click="EditWorkerMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="إيقاف/تفعيل العامل" Click="ToggleActiveMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="AccountOff" Width="15" Height="15" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="حذف" Click="DeleteWorkerMenuItem_Click"
                                                              Foreground="{DynamicResource DangerBrush}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="14" />
                                            </Button.RenderTransform>
                                            <Border Padding="12,10" MinHeight="185">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                        <!-- الظل بيكسر ClearType على شبكة كروت — نفس سبب كارت المنتج -->
                                                        <Setter Property="Effect" Value="{x:Null}" />
                                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                                        <Style.Triggers>
                                                            <!-- ترتيب الأولوية: أحسن العامل (حالة احتفالية) الأول،
                                                                 الانتباه (مشكلة فعلية) بعده بيكسبه لو الاتنين صح،
                                                                 والتحديد (فعل لحظي من المستخدم) آخر واحد فيكسب
                                                                 على الكل (آخر Trigger متطابق هو اللي بيربح في WPF) -->
                                                            <DataTrigger Binding="{Binding IsBestOfWeek}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <!-- أفاتار جنب الاسم أفقيًا بدل فوق بعض — كان بياخد صف
                                                         رأسي كامل لوحده (~56px مع الهامش)، وده أكبر توفير
                                                         مساحة رأسية ممكن من غير ما نشيل أي معلومة، عشان
                                                         صفّين كروت (10 عمال) يبانوا من غير Scroll -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <views:WorkerAvatar PhotoData="{Binding PhotoData}"
                                                                            Initials="{Binding Initials}"
                                                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <views:WorkerAvatar.Style>
                                                                <Style TargetType="views:WorkerAvatar">
                                                                    <Setter Property="Diameter" Value="42" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsCompactGrid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                            <Setter Property="Diameter" Value="34" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </views:WorkerAvatar.Style>
                                                        </views:WorkerAvatar>
                                                        <materialDesign:PackIcon Kind="Crown" Width="14" Height="14"
                                                                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                                                                 Foreground="{DynamicResource GoldBrush}"
                                                                                 Visibility="{Binding IsBestOfWeek, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center"
                                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="15" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsCompactGrid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                            <Setter Property="FontSize" Value="13" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- النوع + "موقوف" — WrapPanel مش StackPanel أفقي
                                                         (خطر قص صامت عند 900px، شوف CLAUDE.md) -->
                                                    <WrapPanel Margin="0,6,0,-6">
                                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                                CornerRadius="{DynamicResource RadiusPill}"
                                                                Padding="8,2" Margin="0,0,6,6">
                                                            <TextBlock Text="{Binding TypeText}"
                                                                       FontSize="{DynamicResource FontMicro}" FontWeight="Medium"
                                                                       Foreground="{DynamicResource InkSoftBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource DangerTintBrush}"
                                                                CornerRadius="{DynamicResource RadiusPill}"
                                                                Padding="8,2" Margin="0,0,6,6">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="موقوف" FontSize="{DynamicResource FontMicro}"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource DangerBrush}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- المهارات + نجوم% + تنبيهات — لغاية 4 Pills هنا لوحدها،
                                                         WrapPanel إجباري -->
                                                    <WrapPanel Margin="0,2,0,-6">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                                                            <materialDesign:PackIcon Kind="StarCircleOutline"
                                                                                     Width="13" Height="13"
                                                                                     VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource InkFaintBrush}" />
                                                            <TextBlock Text="{Binding SkillsText}"
                                                                       FontSize="{DynamicResource FontTiny}" Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource InkSoftBrush}" />
                                                        </StackPanel>

                                                        <!-- نسبة % تلخّص تقييمه بالنجوم = (متوسط النجوم ÷ 5) × 100 -->
                                                        <Border Background="{DynamicResource GoldTintBrush}"
                                                                CornerRadius="{DynamicResource RadiusPill}"
                                                                Padding="8,2" Margin="0,0,6,6"
                                                                Visibility="{Binding HasStarsPercent, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding StarsPercentText}"
                                                                       FontSize="{DynamicResource FontMicro}" FontWeight="Bold"
                                                                       ui:ThemeBrush.ForegroundKey="GoldDeepBrush" />
                                                        </Border>

                                                        <Border Background="{DynamicResource WarnTintBrush}"
                                                                CornerRadius="{DynamicResource RadiusPill}"
                                                                Padding="8,2" Margin="0,0,6,6"
                                                                Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="AlertOutline"
                                                                                         Width="11" Height="11"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource WarnBrush}" />
                                                                <TextBlock Text="{Binding AttentionText}"
                                                                           FontSize="{DynamicResource FontMicro}"
                                                                           Margin="4,0,0,0" FontWeight="Medium"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource WarnBrush}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- إنتاج النهارده أقل بشكل ملحوظ من متوسط أيام شغله (ProductionTrendService) -->
                                                        <Border Background="{DynamicResource WarnTintBrush}"
                                                                CornerRadius="{DynamicResource RadiusPill}"
                                                                Padding="8,2" Margin="0,0,6,6"
                                                                Visibility="{Binding NeedsProductionReview, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="TrendingDown"
                                                                                         Width="11" Height="11"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource WarnBrush}" />
                                                                <TextBlock Text="{Binding ProductionReviewText}"
                                                                           FontSize="{DynamicResource FontMicro}"
                                                                           Margin="4,0,0,0" FontWeight="Medium"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource WarnBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- الألقاب الرسمية الثابتة (أسبوعي/شهري) — بتفضل معلّقة على
                                                         اسمه لحد ما حد تاني ياخدها منه، مختلفة عن تاج IsBestOfWeek فوق -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasCurrentWeeklyTitle}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasCurrentMonthlyTitle}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <TextBlock Text="{Binding CurrentWeeklyTitleText}" FontSize="{DynamicResource FontMicro}"
                                                                   FontWeight="Medium" Foreground="{DynamicResource GoldDeepBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasCurrentWeeklyTitle, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding CurrentMonthlyTitleText}" FontSize="{DynamicResource FontMicro}"
                                                                   FontWeight="Medium" Foreground="{DynamicResource GoldDeepBrush}"
                                                                   Margin="10,0,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasCurrentMonthlyTitle, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>

                                                    <!-- أرقام الفترة المختارة: 3 أعمدة متساوية، عددهم ثابت
                                                         دايمًا فـGrid مش WrapPanel -->
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <!-- الصفر بيبقى باهت: رقم مالوش قيمة بلون قوي
                                                                 بيسحب النظر لحاجة مش موجودة أصلًا. Style مبني
                                                                 على StatNumber المشتركة (BasedOn لازم
                                                                 StaticResource، شوف WorkerDetailDialog لنفس
                                                                 السبب) بدل تعديلها هي نفسها — مستخدمة في
                                                                 شاشات تانية (شرائح الرئيسية مثلًا) -->
                                                            <TextBlock Text="{Binding PresentDays}"
                                                                       ui:ThemeBrush.ForegroundKey="{Binding PresentColor}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatNumber}">
                                                                        <Setter Property="FontSize" Value="18" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsCompactGrid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="FontSize" Value="15" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="حضور" Style="{DynamicResource StatCaption}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding AbsentWithoutPermissionDays}"
                                                                       ui:ThemeBrush.ForegroundKey="{Binding AbsentColor}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatNumber}">
                                                                        <Setter Property="FontSize" Value="18" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsCompactGrid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="FontSize" Value="15" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="غياب" Style="{DynamicResource StatCaption}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding NetWorkdays}"
                                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                                       ui:ThemeBrush.ForegroundKey="{Binding NetColor}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontSize" Value="21" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsCompactGrid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="FontSize" Value="18" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="الصافي" FontSize="{DynamicResource FontMicro}"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource InkFaintBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>
    </Grid>
</UserControl>
