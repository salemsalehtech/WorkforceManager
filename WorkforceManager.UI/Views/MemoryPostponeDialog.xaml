<views:ChromelessDialogWindow x:Class="WorkforceManager.UI.Views.MemoryPostponeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="تأجيل التذكير" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <views:ChromelessDialogWindow.HeaderContent>
        <TextBlock Text="أجّل التذكير لإمتى؟" Foreground="{DynamicResource SidebarInkBrush}"
                   FontSize="15.5" FontWeight="Bold" />
    </views:ChromelessDialogWindow.HeaderContent>

    <!-- الفوتر ثابت أسفل النافذة بذاته (DockPanel داخلي) عشان يفضل ملزوق تحت -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                CornerRadius="0,0,18,18" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource GhostButton}" Padding="16,8"
                        IsCancel="True" Content="إلغاء" />
                <Button Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="8,0,0,0"
                        IsDefault="True" Content="أجّل" Click="Confirm_Click" />
            </StackPanel>
        </Border>

        <StackPanel Margin="18,16,18,16">
            <!-- اختيارات سريعة: أغلب التأجيلات بتبقى واحدة منهم -->
            <WrapPanel>
                <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,7,7"
                        Tag="1" Click="Quick_Click" Content="بكرة" />
                <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,7,7"
                        Tag="3" Click="Quick_Click" Content="بعد 3 أيام" />
                <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,7,7"
                        Tag="7" Click="Quick_Click" Content="بعد أسبوع" />
            </WrapPanel>

            <TextBlock Text="أو اختار يوم" FontWeight="Bold" FontSize="12.5" Margin="0,8,0,4"  Foreground="{DynamicResource TextPrimaryBrush}"/>
            <DatePicker x:Name="DatePick" FontSize="13.5" />

            <Border x:Name="ErrorBox" Background="{DynamicResource DangerBgBrush}" CornerRadius="7"
                    Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
            </Border>
        </StackPanel>
    </DockPanel>
</views:ChromelessDialogWindow>
