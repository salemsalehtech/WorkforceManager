<UserControl x:Class="WorkforceManager.UI.Views.DailyEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- شاشة التسجيل اليومي: اختيار اليوم فوق + 3 تبويبات (رحلة الإنتاج / حضور / جزاءات) لنفس اليوم -->
    <UserControl.Resources>
        <!-- بطاقة المرحلة: مستخرجة هنا عشان شاشة "العمال على المراحل" (WorkersOverlay) تستخدم نفس البطاقة بالظبط -->
                                                            <DataTemplate x:Key="StageCardTemplate">
                                                                <Border Background="{DynamicResource SoftPanelBgBrush}" BorderBrush="{DynamicResource SoftPanelBorderBrush}" BorderThickness="1"
                                                                        CornerRadius="8" Padding="0" Margin="0,0,4,6">
                                                                  <DockPanel>
                                                                    <!-- شريط حالة المرحلة: لون واحد بيقول جاهزة/ناقصة من بعيد -->
                                                                    <Border DockPanel.Dock="Left" Width="5" CornerRadius="3,0,0,3"
                                                                            ui:ThemeBrush.BackgroundKey="{Binding StateColor}" />

                                                                    <StackPanel Margin="10,8">
                                                                        <!-- رأس البطاقة: رقم الترتيب + الاسم + اليومية + إنتاج المرحلة المحسوب -->
                                                                        <DockPanel>
                                                                            <Border DockPanel.Dock="Left" Background="{DynamicResource SidebarBrush}" CornerRadius="12"
                                                                                    Width="24" Height="24" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DisplayOrder}" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12"
                                                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <!-- بادج إنتاج المرحلة (بيظهر بس لما المرحلة تدخل في نطاق) -->
                                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource SuccessBgBrush}" CornerRadius="4"
                                                                                    Padding="8,3" VerticalAlignment="Center">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ComputedPieces}" Value="0">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding ComputedPieces, StringFormat='الإنتاج: {0} قطعة'}"
                                                                                           Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="12.5" />
                                                                            </Border>

                                                                            <TextBlock Text="{Binding StageName}" FontWeight="Bold" FontSize="14"
                                                                                       VerticalAlignment="Center" Margin="8,0,0,0"  Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                                            <!-- مرحلة رص إدارية: بلا نطاق/قطع، عاملها بيتحط تاج بيومية مباشرة -->
                                                                            <Border Background="{DynamicResource InfoTintBrush}" CornerRadius="4"
                                                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsRackingStage, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="رص" FontSize="10.5" ui:ThemeBrush.ForegroundKey="InfoBrush" />
                                                                            </Border>

                                                                            <TextBlock Text="{Binding QuotaText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                       Visibility="{Binding HasQuota, Converter={StaticResource BoolToVis}}" />

                                                                            <TextBlock Text="{Binding AlreadyText}" Foreground="{DynamicResource WarnBrush}" FontSize="11.5"
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0" />

                                                                            <!-- حالة المرحلة بالنص (جاهزة / محتاجة عمال / التوزيع مش مظبوط) -->
                                                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                                                                       ui:ThemeBrush.ForegroundKey="{Binding StateColor}"
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                       Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}" />
                                                                        </DockPanel>

                                                                        <!-- العمال المتوزعين على المرحلة (Chips بنصيب كل واحد،
                                                                             أو بادج "تحت التدريب"/بلا بادج لعامل الرص بدل خانة
                                                                             العدد للتاجات — شوف FlowShareEntry.IsTagOnly) -->
                                                                        <ItemsControl ItemsSource="{Binding AssignedWorkers}" Margin="0,6,0,0">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border CornerRadius="4" Padding="6,3" Margin="0,2,4,2">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsTagOnly}" Value="True">
                                                                                                        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}" />
                                                                                                    </DataTrigger>
                                                                                                    <!-- إعادة عمل: لون مختلف عشان تتميّز فورًا عن الإنتاج العادي -->
                                                                                                    <DataTrigger Binding="{Binding IsRework}" Value="True">
                                                                                                        <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <!-- أمر الإزالة على الشريحة نفسها (callback للرحلة) -->
                                                                                            <Button Foreground="{DynamicResource DangerBrush}"
                                                                                                    Style="{StaticResource IconButton}"
                                                                                                    ToolTip="إزالة العامل من المرحلة"
                                                                                                    Command="{Binding RemoveCommand}">
                                                                                                <materialDesign:PackIcon Kind="Close" Width="10" Height="10" />
                                                                                            </Button>
                                                                                            <TextBlock Text="{Binding WorkerName}" FontSize="12.5"
                                                                                                       VerticalAlignment="Center" Margin="4,0,6,0" />

                                                                                            <!-- بادج التاج (تحت التدريب) — بدل خانة العدد -->
                                                                                            <TextBlock Text="{Binding TagLabel}" FontSize="10.5"
                                                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                                       Visibility="{Binding HasTagLabel, Converter={StaticResource BoolToVis}}" />

                                                                                            <!-- بادج "إعادة عمل" -->
                                                                                            <TextBlock Text="إعادة عمل" FontSize="10.5" FontWeight="Bold"
                                                                                                       Foreground="{DynamicResource WarnBrush}"
                                                                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                                       Visibility="{Binding IsRework, Converter={StaticResource BoolToVis}}" />

                                                                                            <!-- نصيب العامل: بيتملى تلقائي بالتساوي وينفع يتعدل يدوي
                                                                                                 (مش موجودة خالص للتاجات — مفيش قطع ليهم) -->
                                                                                            <TextBox Text="{Binding SharePieces, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     Width="55" FontSize="12.5" Padding="4,1"
                                                                                                     VerticalContentAlignment="Center"
                                                                                                     ToolTip="عدد القطع لهذا العامل (اتوزع تلقائيًا — عدّله لو التوزيع مش بالتساوي)"
                                                                                                     Visibility="{Binding IsTagOnly, Converter={StaticResource InverseBoolToVis}}" />

                                                                                            <!-- تعليم الشريحة كإعادة عمل: القطع بتتحسب في يومية
                                                                                                 العامل وأجره، ومش بتزوّد إنتاج الخط -->
                                                                                            <Button Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                                                                                    Foreground="{DynamicResource WarnBrush}"
                                                                                                    ToolTip="إعادة عمل — العامل بيصلّح شغل خلص. بياخد يوميته عادي والقطع مش بتزوّد إنتاج الخط"
                                                                                                    Command="{Binding ToggleReworkCommand}"
                                                                                                    Visibility="{Binding IsTagOnly, Converter={StaticResource InverseBoolToVis}}">
                                                                                                <materialDesign:PackIcon Kind="Restore" Width="12" Height="12" />
                                                                                            </Button>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- إضافة عامل للمرحلة (المؤهلين بس): خانة بحث واحدة والاقتراحات
                                                                             بتنزل تحتيها مع أول حرف. الاختيار بالسهمين + Enter من غير ماوس. -->
                                                                        <StackPanel x:Name="WorkerPickerRoot" Margin="0,4,0,0">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasNoQualified}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>

                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Border Background="{DynamicResource CardBgBrush}"
                                                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.2"
                                                                                        CornerRadius="6" Padding="7,4" Width="240" Margin="0,0,6,0">
                                                                                    <Grid>
                                                                                        <DockPanel>
                                                                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                                                                                    Width="13" Height="13" VerticalAlignment="Center"
                                                                                                                    Foreground="{DynamicResource TextMutedBrush}" />
                                                                                            <!-- الدوسة بتفتح القايمة: بعد كل إضافة بتتقفل،
                                                                                                 والمستخدم هو اللي بيفتحها لما يحتاج -->
                                                                                            <TextBox x:Name="WorkerSearchBox"
                                                                                                     Text="{Binding WorkerSearch, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     Margin="5,0,0,0" BorderThickness="0" FontSize="12.5"
                                                                                                     VerticalAlignment="Center" Background="Transparent"
                                                                                                     ToolTip="اكتب أول حروف اسم العامل — الأسهم ▲▼ للاختيار وEnter للإضافة"
                                                                                                     PreviewKeyDown="WorkerSearch_PreviewKeyDown"
                                                                                                     PreviewMouseLeftButtonDown="WorkerSearch_Clicked" />
                                                                                        </DockPanel>
                                                                                        <TextBlock Text="البحث" Margin="22,0,0,0" IsHitTestVisible="False"
                                                                                                   VerticalAlignment="Center" FontSize="12.5"
                                                                                                   Foreground="{DynamicResource TextMutedBrush}">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding WorkerSearch}" Value="">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- أمر الإضافة على البطاقة نفسها (callback للرحلة) -->
                                                                                <Button FontSize="12.5"
                                                                                        Style="{StaticResource GhostButton}" Padding="10,4"
                                                                                        Command="{Binding AddWorkerCommand}">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="عامل" Margin="4,0,0,0" />
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <!-- الاقتراحات: بتظهر بس والفوكس جوه الخانة والقايمة
                                                                                 مفتوحة، فالبطاقة مبتفضلش مفرودة بقايمة ٢٠ عامل
                                                                                 وانت مش بتدوّر أصلاً.
                                                                                 IsPickerOpen بتتصفّر مع كل إضافة عامل — الفوكس
                                                                                 لوحده مكانش بيقفلها لأنه بيفضل مكانه. -->
                                                                            <Border Width="240" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                                                    Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.2">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=WorkerPickerRoot}" Value="True" />
                                                                                                    <Condition Binding="{Binding HasSuggestions}" Value="True" />
                                                                                                    <Condition Binding="{Binding IsPickerOpen}" Value="True" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <!-- القايمة مرتبة بالتقييم: الأحسن على المرحلة دي الأول -->
                                                                                <ListBox ItemsSource="{Binding VisibleWorkers}"
                                                                                         SelectedItem="{Binding SelectedWorkerToAdd}"
                                                                                         MaxHeight="150" FontSize="12.5"
                                                                                         BorderThickness="0" Background="Transparent"
                                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                                         SelectionChanged="Suggestions_SelectionChanged"
                                                                                         PreviewMouseLeftButtonUp="Suggestions_Click">
                                                                                    <ListBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <!-- الاسم فوق والنجوم تحته: الأسماء العربية طويلة
                                                                                                 والقايمة ضيقة، فالنجوم جنبه كانت بتزقّه أو تتقص -->
                                                                                            <StackPanel MinWidth="180" Margin="0,1"
                                                                                                        ToolTip="{Binding RatingTooltip}">
                                                                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />

                                                                                                <!-- تاج (متدرّب/عامل رص): بادج بدل النجوم — التقييم
                                                                                                     مالوش معنى لعامل بيتحاسب بالساعة -->
                                                                                                <Border Background="{DynamicResource InfoTintBrush}" CornerRadius="4"
                                                                                                        Padding="5,1" Margin="0,1,0,0" HorizontalAlignment="Left"
                                                                                                        Visibility="{Binding HasTagLabel, Converter={StaticResource BoolToVis}}">
                                                                                                    <TextBlock Text="{Binding TagLabel}" FontSize="10"
                                                                                                               ui:ThemeBrush.ForegroundKey="InfoBrush" />
                                                                                                </Border>

                                                                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                                                                                            Visibility="{Binding IsTagOnly, Converter={StaticResource InverseBoolToVis}}">
                                                                                                    <!-- النجوم دهبية دايمًا — ده لون النجوم المتعارف عليه -->
                                                                                                    <TextBlock Text="{Binding StarsText}" FontSize="11"
                                                                                                               FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" />

                                                                                                    <!-- نسبة تقييمه بالنجوم جنبها، رمادي عشان ميزاحمش النجوم -->
                                                                                                    <TextBlock Text="{Binding StarsPercentText}" FontSize="10"
                                                                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                                                                </StackPanel>

                                                                                                <!-- مكلّف في مكان تاني النهارده: العناصر دي نازلة
                                                                                                     آخر القايمة، والعلامة بتقول ليه — اختياره
                                                                                                     هيطلّع رسالة تأكيد -->
                                                                                                <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="4"
                                                                                                        Padding="5,1" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                                                                        Visibility="{Binding IsAssignedElsewhere, Converter={StaticResource BoolToVis}}">
                                                                                                    <TextBlock Text="{Binding AssignedElsewhereText}" FontSize="10"
                                                                                                               TextWrapping="Wrap"
                                                                                                               Foreground="{DynamicResource WarnBrush}" />
                                                                                                </Border>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ListBox.ItemTemplate>
                                                                                </ListBox>
                                                                            </Border>

                                                                            <!-- كتب اسم مش موجود: يعرف علطول بدل ما يستنى قايمة متظهرش -->
                                                                            <TextBlock Text="مفيش عامل مؤهل بالاسم ده"
                                                                                       FontSize="11.5" Margin="2,3,0,0"
                                                                                       Foreground="{DynamicResource WarnBrush}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasNoMatch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <!-- مفيش مؤهلين: المرحلة محتاجة ربط مهارات الأول (قرار: المؤهلين بس إجباري) -->
                                                                        <TextBlock Text="لا يوجد عمال مؤهلون لهذه المرحلة — اربط المهارة من شاشة العمال الأول"
                                                                                   Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,4,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasNoQualified}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                    </StackPanel>
                                                                  </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- صفحة الكروت الأول (تسجيل الإنتاج، الرصيد الأولي، سجلات اليوم، الذاكرة، الهالك)، والدوسة على كارت
             بتفتح التبويب بتاعه تحت شريط رجوع. شريط التبويبات نفسه مخفي — الكروت هي التنقّل. -->
        <views:HubLandingView x:Name="Landing" />

        <Grid x:Name="PagesLayer" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- مخفي: التسجيل اليومي بيتعرض دايمًا جوّه إدارة الإنتاج وشريطها هو اللي بيعرض المسار كله في سطر واحد (INestedLandingHost) -->
        <views:HubPageBar x:Name="PageBar" Grid.Row="0" Visibility="Collapsed" />

        <!-- اختيار اليوم (مشترك لكل التبويبات) -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <DockPanel>
                <!-- حذف إنتاج اليوم كله: كلمة سر + سبب مكتوب + حذف ناعم + إشعار،
                     كلهم في معاملة واحدة من الأنظمة المشتركة -->
                <Button x:Name="DeleteDayButton" DockPanel.Dock="Left" Padding="12,7" Margin="8,0,0,0"
                        Command="{Binding DeleteDayCommand}"
                        ToolTip="يشيل كل سجلات إنتاج اليوم (بكلمة سر وسبب)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarRemoveOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="حذف إنتاج اليوم" Margin="6,0,0,0" FontSize="13" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="DateNavPanel" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="17" Height="17"
                                             Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="اليوم:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Style="{StaticResource IconButton}" Padding="5" ToolTip="يوم فات"
                            Command="{Binding PreviousDayCommand}">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" />
                    </Button>
                    <DatePicker SelectedDate="{Binding EntryDate}" Width="150" VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource IconButton}" Padding="5" ToolTip="يوم جاي"
                            Command="{Binding NextDayCommand}">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0" FontSize="12"
                            ToolTip="ارجع لتاريخ النهارده" Command="{Binding GoToTodayCommand}">
                        <TextBlock Text="النهارده" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- شريط الرؤوس مخفي: التنقّل بين الصفحات بالكروت (HubLandingView) والرجوع من HubPageBar -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ============ تبويب رحلات الإنتاج (منتج أو أكتر في نفس اليوم) ============ -->
            <TabItem Header="  تسجيل الإنتاج  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ملخص اللي اتسجل النهارده + إضافة منتج تاني -->
                    <Border x:Name="ProductionSummaryBar" Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="AddFlowSessionButton" DockPanel.Dock="Left" Command="{Binding AddFlowSessionCommand}"
                                    Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="إضافة منتج" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- رسالة لما لسه مفيش إنتاج مسجل في اليوم -->
                            <TextBlock DockPanel.Dock="Right" Text="لسه مفيش إنتاج مسجل النهارده"
                                       FontSize="12.5" VerticalAlignment="Center" Margin="18,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding DayHasNoProduction, Converter={StaticResource BoolToVis}}" />

                            <!-- أرقام اليوم (بتظهر بس لما يكون فيه إنتاج) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DayHasNoProduction}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- الرقم ده **مش** مجموع القطع على كل المراحل:
                                     القطعة بتعدّي المراحل بالترتيب، فـ 5,000 قطعة
                                     على منتج من 11 مرحلة كانت بتطلع 55,000.
                                     بيعرض التام، ولو مفيش تام بيعرض اللي دخل الخط
                                     بدل ما يقول صفر ويوحي إن اليوم فاضي. -->
                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayHeadlinePieces, StringFormat={}{0:N0}}"
                                               Style="{StaticResource SummaryNumber}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DayPiecesLabel}" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <Border Style="{StaticResource SummaryDivider}" />

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayTotalWorkdays}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="يومية" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayWorkersCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{DynamicResource BrandBrush}" />
                                    <TextBlock Text="عامل" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource SummaryStat}">
                                    <TextBlock Text="{Binding DayProductsCount}" Style="{StaticResource SummaryNumber}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="منتج" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>

                                <!-- الهالك بيظهر بس لما يكون موجود: "صفر
                                     هالك" مش معلومة، وبياخد مساحة من
                                     الأرقام اللي بتتقري كل يوم -->
                                <Border Style="{StaticResource SummaryDivider}"
                                        Visibility="{Binding DayHasScrap, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Style="{StaticResource SummaryStat}"
                                            Visibility="{Binding DayHasScrap, Converter={StaticResource BoolToVis}}"
                                            ToolTip="قطع اتشالت من الخط ومش هتتكمّل">
                                    <TextBlock Text="{Binding DayScrapPieces, StringFormat={}{0:N0}}"
                                               Style="{StaticResource SummaryNumber}"
                                               Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="هالك" Style="{StaticResource SummaryLabel}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- رحلة لكل منتج، تحت بعض -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FlowSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- بطاقة رحلة منتج واحد — أكورديون: واحدة مفتوحة بتفاصيلها والباقي مطوي على عنوانه -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,4,12">
                                        <StackPanel>
                                            <!-- ═════ رأس الرحلة: طي/فتح + المنتج + الملخص + الجاهزية + إزالة ═════ -->
                                            <DockPanel>
                                                <views:FieldError DockPanel.Dock="Bottom" Message="{Binding ProductError}" />
                                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Padding="6"
                                                        Command="{Binding ToggleExpandedCommand}" Margin="0,0,6,0"
                                                        ToolTip="طي أو فتح تفاصيل الرحلة دي">
                                                    <materialDesign:PackIcon Width="18" Height="18">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="ChevronUp" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                        <Setter Property="Kind" Value="ChevronDown" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>
                                                <TextBlock DockPanel.Dock="Left" Text="المنتج:" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Products}"
                                                          SelectedItem="{Binding SelectedProduct}"
                                                          DisplayMemberPath="Name" Width="200" />
                                                <!-- ملخص الرحلة (بيبان وهي مطوية كمان) -->
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PreviewSummary}" Margin="12,0,0,0"
                                                           FontSize="12.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <Border DockPanel.Dock="Left" CornerRadius="8" Padding="10,5" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleBgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllReady}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="ProgressClock" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AllReady}" Value="True">
                                                                            <Setter Property="Kind" Value="CheckCircle" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock Text="{Binding ReadinessText}" FontSize="12" FontWeight="Medium"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AllReady}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <Button DockPanel.Dock="Left" Margin="10,0,0,0"
                                                        Style="{StaticResource GhostButton}" Padding="12,6"
                                                        ToolTip="يجيب نفس العمال على نفس المراحل من آخر يوم اشتغل فيه المنتج ده (من غير الأعداد)"
                                                        Command="{Binding RepeatLastDayCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Text="كرّر يوم فات" Margin="5,0,0,0" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="تصليحات:" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                                    <TextBox Text="{Binding CorrectionText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="60" TextAlignment="Center" FontSize="12" Tag="{Binding}"
                                                             LostFocus="CorrectionBox_LostFocus"
                                                             ToolTip="تعديل يدوي على محقق الخطة الشهرية لهذا المنتج في هذا اليوم — مستقل عن الرحلة والأجور" />
                                                </StackPanel>
                                                <Button DockPanel.Dock="Right" Foreground="{DynamicResource DangerBrush}"
                                                        Style="{StaticResource IconButton}" Padding="8,4"
                                                        ToolTip="إزالة رحلة المنتج ده من الشاشة (اللي اتحفظ قبل كده محفوظ عادي)"
                                                        Command="{Binding DataContext.RemoveFlowSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="إزالة" FontSize="12" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DockPanel>

                                            <!-- ═════ تفاصيل الرحلة (بتتخبّى لما تتطوي) ═════ -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <Border Background="{DynamicResource InfoTintBrush}"
                                                        CornerRadius="7" Padding="9,5" Margin="0,0,0,8"
                                                        Visibility="{Binding IsFromMemoryPlan, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="14" Height="14"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource InfoBrush}" />
                                                        <TextBlock Text="الرحلة دي من خطة محفوظة في الذاكرة" FontSize="12" FontWeight="Bold"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource InfoBrush}" />
                                                    </StackPanel>
                                                </Border>


                                            <Border Margin="0,0,0,8" Padding="10,8"
                                                    Background="{DynamicResource SubtleBgBrush}" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasInitialBalances}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <!-- العنوان + الشريط: زرار كامل بيفتح تبويب "الرصيد الأولي" -->
                                                    <Button Command="{Binding DataContext.OpenInitialBalanceTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding SelectedProduct}"
                                                            Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            Foreground="{DynamicResource InkBrush}"
                                                            ToolTip="افتح تفاصيل الرصيد الأولي">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,5">
                                                                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ChevronLeft"
                                                                                        Width="14" Height="14" VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Text="الرصيد الأولي" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextMutedBrush}">
                                                                    <Run Text="{Binding InitialBalanceSummary.RemainingQuantity, Mode=OneWay, StringFormat='متبقي {0:N0}'}" />
                                                                    <Run Text=" / " />
                                                                    <Run Text="{Binding InitialBalanceSummary.TotalQuantity, Mode=OneWay, StringFormat='{}{0:N0} إجمالي'}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <ProgressBar Height="8" Minimum="0"
                                                                         Maximum="{Binding InitialBalanceSummary.TotalQuantity, Mode=OneWay}"
                                                                         Value="{Binding InitialBalanceSummary.RemainingQuantity, Mode=OneWay}"
                                                                         Background="{DynamicResource MeterTrackBrush}"
                                                                         Foreground="{DynamicResource InkBrush}" BorderThickness="0" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- تنبيه: سحب جاري على الشاشة دلوقتي، وزّع العمال وادوس حفظ -->
                                                    <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6"
                                                            Background="{DynamicResource WarnBgBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPendingWithdrawal}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="إلغاء السحب" Style="{StaticResource GhostButton}"
                                                                    Padding="8,4" FontSize="11" Command="{Binding CancelPendingWithdrawalCommand}" />
                                                            <TextBlock Text="سحب رصيد جاري — وزّع العمال على المراحل تحت وادوس حفظ"
                                                                       FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                                <!-- ═════ الخطوة 1: توزيع الإنتاج على المراحل (النطاقات) — سطر عنوان + أزرار، وتحته كل نطاق في سطر واحد ═════ -->
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Left" Command="{Binding TakeFromInitialBalanceCommand}"
                                                            Style="{StaticResource GhostButton}" FontSize="12" Padding="10,5" Margin="8,0,0,0"
                                                            Visibility="{Binding HasInitialBalances, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="14" Height="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="أخذ من الرصيد الأولي" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button DockPanel.Dock="Left" Command="{Binding AddRangeCommand}"
                                                            Style="{StaticResource GhostButton}" FontSize="12" Padding="10,5" Margin="8,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="نطاق تاني" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="توزيع الإنتاج على المراحل" FontWeight="Bold" FontSize="14"
                                                               Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="15" Height="15" VerticalAlignment="Center"
                                                                             Margin="6,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                                                                             ToolTip="اكتب: من أنهي مرحلة لأنهي مرحلة اتنتج كام قطعة. النطاق الجاهز بيغطي كل المراحل — عدّله أو ضيف نطاقات تانية لو الإنتاج وقف عند مرحلة معينة." />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding FlowRanges}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="8" Padding="8,5" Margin="0,0,8,6">
                                                                <StackPanel>
                                                                    <!-- النطاق كله في سطر واحد: من ← إلى — عدد القطع — حذف -->
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="من" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,4,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <ComboBox ItemsSource="{Binding StageOptions}" SelectedItem="{Binding FromStage}"
                                                                                  DisplayMemberPath="Display" Width="125" FontSize="12" />
                                                                        <TextBlock Text="إلى" VerticalAlignment="Center" FontSize="12.5" Margin="8,0,4,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <ComboBox ItemsSource="{Binding StageOptions}" SelectedItem="{Binding ToStage}"
                                                                                  DisplayMemberPath="Display" Width="125" FontSize="12" />
                                                                        <TextBlock Text="القطع:" VerticalAlignment="Center" FontSize="12.5" Margin="12,0,4,0"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBox Text="{Binding PiecesText, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Width="80" Padding="6,3" FontSize="13" VerticalContentAlignment="Center" />
                                                                        <!-- أمر الحذف على السطر نفسه (callback للرحلة) -->
                                                                        <Button Margin="6,0,0,0" Style="{StaticResource IconButton}"
                                                                                Foreground="{DynamicResource DangerBrush}" ToolTip="حذف النطاق"
                                                                                Command="{Binding RemoveCommand}">
                                                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <!-- خطأ النطاق ده تحته مباشرة: المستخدم بيشوف المشكلة في مكانها -->
                                                                    <views:FieldError Message="{Binding Error}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- ═════ الخطوة 2: العمال على المراحل — زرار بيفتح شاشة كاملة بكل المراحل قدامك (WorkersOverlay) ═════ -->
                                                <Button Command="{Binding DataContext.OpenWorkersModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource PrimaryButton}" Padding="18,14" Margin="0,6,0,0"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip="كل المراحل قدامك مرة واحدة — ضيف العمال على أي مرحلة من غير ما تنزل وتطلع">
                                                    <DockPanel>
                                                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ChevronLeft" Width="20" Height="20"
                                                                                 VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding ReadinessText}" FontSize="12.5" Margin="0,0,14,0"
                                                                   VerticalAlignment="Center" Opacity="0.85" />
                                                        <materialDesign:PackIcon Kind="AccountMultiplePlusOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                                        <TextBlock Text="العمال على المراحل" FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>

                                                <!-- معاينة اليوميات قبل الحفظ -->
                                                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="معاينة اليوميات قبل الحفظ" FontWeight="Bold" FontSize="13"
                                                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4" />
                                                                <TextBlock Text="لسه مفيش توزيع — اختار العمال واكتب أعداد النطاقات"
                                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FlowPreview.Count}" Value="0">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl ItemsSource="{Binding FlowPreview}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock FontSize="12.5" Margin="0,2">
                                                                                <Run Text="• " />
                                                                                <Run Text="{Binding WorkerName, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                <Run Text="{Binding TotalPieces, Mode=OneWay, StringFormat=': {0} قطعة'}" />
                                                                                <Run Text="{Binding TotalWorkdays, Mode=OneWay, StringFormat='≈ {0} يومية'}"
                                                                                     Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ═════ شريط الحفظ الثابت: ملخص الرحلة المفتوحة + حفظها — ظاهر دايمًا تحت من غير ما تنزل ═════ -->
                    <Border Grid.Row="2" Padding="14,10" Margin="0,8,0,0" DataContext="{Binding ActiveFlow}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding SaveFlowCommand}"
                                    Style="{StaticResource PrimaryButton}" FontSize="14" Padding="22,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Text="حفظ رحلة الإنتاج" Margin="8,0,0,0" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ReadinessText}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="{Binding SelectedProduct.Name, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="  —  " Foreground="{DynamicResource TextMutedBrush}" />
                                <Run Text="{Binding PreviewSummary, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب الرصيد الأولي (تفاصيل وإدارة الأرصدة) ============ -->
            <TabItem Header="  الرصيد الأولي  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="AddInitialBalanceButton" Command="{Binding AddInitialBalanceCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="14,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PackageVariantClosedPlus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="رصيد أولي جديد" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton x:Name="InitialBalanceHistoryToggle" Style="{StaticResource ToolbarToggle}" Margin="10,0,0,0"
                                              IsChecked="{Binding IsShowingInitialBalanceHistory}"
                                              ToolTip="الأرصدة اللي كملت باستخدامها بالكامل">
                                    <!-- ToolbarToggle مش StatusChip: قالب StatusChip بيقرا Icon/Display/AccentColor
                                         من الـ DataContext بس (لعناصر ItemsControl زي StatusChoices تحت)،
                                         وبيتجاهل أي Content حرفي زي ده خالص. ClipboardTextClockOutline بدل
                                         ArchiveOutline: نفس أيقونة "السجل" في باقي البرنامج (سجل العمليات) —
                                         "أرشيف" مالوش علاقة بصرية بمعنى سجل تاريخي زي الساعة/اللوح دي -->
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                                        <TextBlock Text="السجل" Margin="5,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <!-- الملخّص المُجمّع لأرصدة المنتج (نفس شريط كارت الرحلة) -->
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Width="220"
                                        Visibility="{Binding InitialBalanceTabIsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{Binding InitialBalanceTabSummary.RemainingQuantity, Mode=OneWay, StringFormat='متبقي {0:N0}'}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding InitialBalanceTabSummary.TotalQuantity, Mode=OneWay, StringFormat='{}{0:N0} إجمالي'}" />
                                </TextBlock>
                                <ProgressBar Height="8" Margin="0,5,0,0" Minimum="0"
                                             Maximum="{Binding InitialBalanceTabSummary.TotalQuantity, Mode=OneWay}"
                                             Value="{Binding InitialBalanceTabSummary.RemainingQuantity, Mode=OneWay}"
                                             Background="{DynamicResource MeterTrackBrush}"
                                             Foreground="{DynamicResource InkBrush}" BorderThickness="0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="المنتج:" FontWeight="Bold" VerticalAlignment="Top" Margin="0,6,8,0"  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding Products}"
                                              SelectedItem="{Binding SelectedInitialBalanceProduct}"
                                              DisplayMemberPath="Name" Width="200" VerticalAlignment="Center" />
                                    <views:FieldError MaxWidth="200" Message="{Binding InitialBalanceProductError}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <!-- الأرصدة النشطة -->
                            <Grid Visibility="{Binding IsShowingInitialBalanceHistory, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                                       Text="مفيش رصيد أولي للمنتج ده — اضغط &quot;رصيد أولي جديد&quot; عشان تضيف واحد، أو أي نطاق ماوصلش لآخر الخط بيتحول لرصيد أولي تلقائيًا بعد حفظ الرحلة."
                                       Visibility="{Binding InitialBalanceTabIsEmpty, Converter={StaticResource BoolToVis}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding InitialBalanceTabIsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl ItemsSource="{Binding InitialBalanceCards}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource SoftPanelBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Padding="5"
                                                                    ToolTip="سجل الاستخدام"
                                                                    Command="{Binding DataContext.ShowInitialBalanceHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="History" Width="16" Height="16" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Padding="5"
                                                                    ToolTip="تعديل الرصيد"
                                                                    Command="{Binding DataContext.EditInitialBalanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Padding="5"
                                                                    Foreground="{DynamicResource DangerBrush}"
                                                                    ToolTip="حذف الرصيد"
                                                                    Command="{Binding DataContext.DeleteInitialBalanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                                   Foreground="{DynamicResource InkBrush}"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </DockPanel>

                                                    <TextBlock FontSize="12" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="{Binding Quantity, Mode=OneWay, StringFormat='إجمالي {0:N0}'}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding UsedQuantity, Mode=OneWay, StringFormat='مستهلك {0:N0}'}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding RemainingQuantity, Mode=OneWay, StringFormat='متبقي {0:N0}'}" />
                                                    </TextBlock>

                                                    <ProgressBar Height="8" Margin="0,6,0,9" Minimum="0"
                                                                 Maximum="{Binding Quantity, Mode=OneWay}"
                                                                 Value="{Binding RemainingQuantity, Mode=OneWay}"
                                                                 Background="{DynamicResource MeterTrackBrush}"
                                                                 Foreground="{DynamicResource InkBrush}" BorderThickness="0" />

                                                    <ItemsControl ItemsSource="{Binding Ranges}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="6"
                                                                        Padding="8,5" Margin="0,0,0,4">
                                                                    <DockPanel>
                                                                        <Button DockPanel.Dock="Left" Content="سحب"
                                                                                Style="{StaticResource GhostButton}" Padding="12,3" FontSize="11.5"
                                                                                ToolTip="يجهّز النطاق ده في رحلة المنتج وينقلك لتبويب تسجيل الإنتاج"
                                                                                Command="{Binding DataContext.WithdrawBalanceRangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" />
                                                                        <Button DockPanel.Dock="Left" Content="تحويل لهالك" Margin="6,0,0,0"
                                                                                Style="{StaticResource GhostButton}" Padding="12,3" FontSize="11.5"
                                                                                Foreground="{DynamicResource DangerBrush}"
                                                                                ToolTip="يحوّل جزء أو كل المتبقي من النطاق ده لهالك"
                                                                                Command="{Binding DataContext.ScrapBalanceRangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" />
                                                                        <TextBlock VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                                            <Run Text="{Binding FromStageName, Mode=OneWay}" />
                                                                            <Run Text=" ← " />
                                                                            <Run Text="{Binding ToStageName, Mode=OneWay}" />
                                                                            <Run Text="{Binding PieceCount, Mode=OneWay, StringFormat=' ({0:N0} قطعة)'}" />
                                                                        </TextBlock>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12"
                                                            ToolTip="يجهّز كل نطاقات الرصيد ده في رحلة المنتج وينقلك لتبويب تسجيل الإنتاج"
                                                            Command="{Binding DataContext.WithdrawWholeBalanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="سحب الكل" Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>

                            <!-- السجل: الأرصدة اللي كملت باستخدامها بالكامل — للاطّلاع بس، بدون تعديل/حذف/سحب -->
                            <Grid Visibility="{Binding IsShowingInitialBalanceHistory, Converter={StaticResource BoolToVis}}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                           TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                                           Text="مفيش أرصدة مكتملة لسه للمنتج ده."
                                           Visibility="{Binding InitialBalanceHistoryIsEmpty, Converter={StaticResource BoolToVis}}" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding InitialBalanceHistoryIsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding InitialBalanceHistoryCards}" Margin="4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                                                        BorderBrush="{DynamicResource SoftPanelBorderBrush}" BorderThickness="1" Opacity="0.85">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="5"
                                                                    ToolTip="سجل الاستخدام"
                                                                    Command="{Binding DataContext.ShowInitialBalanceHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="History" Width="16" Height="16" />
                                                            </Button>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                                       Foreground="{DynamicResource InkBrush}"
                                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </DockPanel>

                                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}">
                                                            <Run Text="{Binding Quantity, Mode=OneWay, StringFormat='إجمالي {0:N0}'}" />
                                                            <Run Text="  ·  " />
                                                            <Run Text="اكتمل بالكامل"
                                                                 Foreground="{DynamicResource TextMutedBrush}" />
                                                        </TextBlock>
                                                        <Border Background="{DynamicResource DangerTintBrush}" CornerRadius="6"
                                                                Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                Visibility="{Binding HasScrapUsage, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="اتقفل بهالك" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب سجلات اليوم (المراجعة والتصحيح) ============ -->
            <TabItem Header="  سجلات اليوم  ">
                <Grid x:Name="RecordsTabRoot" Margin="10">
                    <Grid.InputBindings>
                        <!-- Ctrl+Z يتراجع عن آخر تعديل/حذف طالما مركّز على تبويب سجلات
                             اليوم — نفس زرار "تراجع" في الشريط تحت -->
                        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoLastActionCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}" FontSize="12.5" Margin="4,0,4,8"
                               Text="كل سجلات الإنتاج المحفوظة في الفترة المختارة — لو فيه رقم اتحفظ بالغلط صححه أو امسحه من هنا، واليوميات هتتظبط في كل الحسابات فورًا. الفترة هنا مستقلة عن يوم التسجيل فوق الشاشة." />

                    <!-- الفترة (يوم/أسبوع/شهر) وفلتر المنتج — مستقلين عن تاريخ التسجيل فوق -->
                    <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel x:Name="RecordsGrainRow" DockPanel.Dock="Right" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Chip}" Content="بيوم" GroupName="RecordsGrain"
                                             IsChecked="{Binding IsRecordsGrainDay, Mode=OneWay}"
                                             Command="{Binding SetRecordsGrainCommand}" CommandParameter="day" />
                                <RadioButton Style="{StaticResource Chip}" Content="بأسبوع" GroupName="RecordsGrain"
                                             IsChecked="{Binding IsRecordsGrainWeek, Mode=OneWay}"
                                             Command="{Binding SetRecordsGrainCommand}" CommandParameter="week" />
                                <RadioButton Style="{StaticResource Chip}" Content="بشهر" GroupName="RecordsGrain"
                                             IsChecked="{Binding IsRecordsGrainMonth, Mode=OneWay}"
                                             Command="{Binding SetRecordsGrainCommand}" CommandParameter="month" />
                            </StackPanel>

                            <!-- تراجع عن آخر تصحيح/نقل/حذف — بيظهر شغال بس لما يكون فيه
                                 حاجة نتراجع عنها فعلاً. نفس تأثير Ctrl+Z. -->
                            <Button x:Name="UndoButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                                    Command="{Binding UndoLastActionCommand}"
                                    ToolTip="{Binding UndoDescription}"
                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                    Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="UndoVariant" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="تراجع" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <DatePicker DockPanel.Dock="Right" SelectedDate="{Binding RecordsDate}" Width="150"
                                        VerticalAlignment="Center" Margin="10,0,0,0" />

                            <TextBlock DockPanel.Dock="Right" Text="{Binding RecordsPeriodLabel}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <TextBlock Text="المنتج:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"  Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding RecordsProductOptions}"
                                      SelectedItem="{Binding SelectedRecordsProduct}"
                                      DisplayMemberPath="Display" Width="200" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <!-- رسالة لما مفيش سجلات في الفترة/الفلتر المختارين -->
                            <TextBlock Text="مفيش سجلات إنتاج محفوظة في الفترة دي"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                       Visibility="{Binding RecordsTabIsEmpty, Converter={StaticResource BoolToVis}}" />

                            <DataGrid ItemsSource="{Binding DayRecords}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <!-- التاريخ بس لما الفترة أكتر من يوم واحد — في وضع اليوم كل الصفوف نفس التاريخ فمفيش داعي -->
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="70"
                                                        Visibility="{Binding DataContext.IsRecordsGrainDay, ElementName=RecordsTabRoot, Converter={StaticResource InverseBoolToVis}}" />
                                    <DataGridTextColumn Header="اسم العامل" Binding="{Binding WorkerName}" Width="Auto" MinWidth="150" />
                                    <DataGridTextColumn Header="المنتج / المرحلة" Binding="{Binding StageDisplay}" Width="Auto" MinWidth="170" />
                                    <DataGridTextColumn Header="القطع" Binding="{Binding PieceCount}" Width="90" />
                                    <DataGridTextColumn Header="اليومية" Binding="{Binding QuotaAtEntry}" Width="90" />
                                    <DataGridTextColumn Header="اليوميات" Binding="{Binding Workdays}" Width="80" />
                                    <!-- إعادة عمل: بتتحسب في يومية العامل بس مش في إنتاج الخط -->
                                    <DataGridTemplateColumn Header="" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="إعادة عمل" FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WarnBrush}"
                                                           ToolTip="إعادة عمل — محسوبة في يومية العامل، مش في إنتاج الخط"
                                                           Visibility="{Binding IsRework, Converter={StaticResource BoolToVis}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,4,0"
                                                            Style="{StaticResource IconButton}" Foreground="{DynamicResource BrandBrush}"
                                                            ToolTip="تعديل عدد القطع"
                                                            Command="{Binding DataContext.EditDayRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="13" Height="13" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerBrush}"
                                                            ToolTip="حذف السجل نهائيًا"
                                                            Command="{Binding DataContext.DeleteDayRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب الذاكرة (كان بند مستقل في القايمة الجانبية) ============
                 خطط الإنتاج المحفوظة اللي بتوصّل للتسجيل ("ابدأ الآن") — مكانها الطبيعي
                 جنب سجلات اليوم. بتتبني أول ما التبويب يتفتح (LazyScreenHost). -->
            <TabItem x:Name="MemoryTabItem" Header="  الذاكرة  ">
                <views:LazyScreenHost x:Name="MemoryHost" ScreenType="{x:Type views:MemoryView}" />
            </TabItem>

            <!--
              الهالك: قطع اتشالت من الخط ومش هتتكمّل.

              البرنامج بيسأل لوحده لما يلاقي فرق بين مرحلتين بعد حفظ
              الرحلة. التبويب ده للحالة اللي مفيش فيها فرق يظهر —
              **قطعة خلصت آخر مرحلة والجودة رفضتها**. مفيش مرحلة بعد
              الأخيرة نقارنها بيها، فلازم المستخدم يقولها بنفسه.
            -->
            <TabItem Header="  الهالك  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="AddScrapButton" DockPanel.Dock="Left" Command="{Binding AddScrapCommand}"
                                    Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="15" Height="15"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="تسجيل هالك" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>

                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="الهالك" FontWeight="Bold"
                                           Foreground="{DynamicResource BrandBrush}" />
                                <TextBlock Style="{StaticResource HintText}" FontSize="11.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="القطع اللي اتشالت ومش هتتكمّل. الهالك على آخر مرحلة بيتخصم من الإنتاج التام، واللي في نص الخط بيتشال من الشغل الواقف. مالوش أي تأثير على الأجور." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="4,0,4,6">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ScrapTotalText}"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="هالك اليوم" Style="{StaticResource SectionTitle}" />
                            </DockPanel>

                            <DataGrid x:Name="ScrapGrid" Grid.Row="1" ItemsSource="{Binding DayScrap}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="المنتج / المرحلة" Binding="{Binding StageDisplay}"
                                                        Width="Auto" MinWidth="190" />
                                    <DataGridTextColumn Header="القطع" Binding="{Binding PieceCount, StringFormat=N0}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="السبب" Binding="{Binding ReasonDisplay}"
                                                        Width="Auto" MinWidth="120" />
                                    <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note}" Width="2*" />
                                    <!-- أيقونة بس من غير نص — زي عمود "سجلات اليوم"، شوف تعليقه في تبويب الجزاءات -->
                                    <DataGridTemplateColumn Header="" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerBrush}"
                                                        ToolTip="حذف الهالك"
                                                        Command="{Binding DataContext.RemoveScrapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═════ شاشة "العمال على المراحل": بتغطي الصفحة كلها وفيها كل مراحل الرحلة المفتوحة قدامك مرة واحدة
             (ColumnFlowPanel AutoFit بيختار أقل عدد أعمدة يكفي الارتفاع) — ضيف العمال وإنت بتشوف كل المراحل
             من غير ما تنزل وتطلع. الرحلة هي ActiveFlow (نفس الـ ViewModel، فالتغييرات والحفظ هي هي). ═════ -->
        <Border x:Name="WorkersOverlay" Grid.Row="1" Grid.RowSpan="2" Padding="10"
                Background="{DynamicResource GroundBrush}" DataContext="{Binding ActiveFlow}"
                Visibility="{Binding DataContext.IsWorkersMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Command="{Binding SaveFlowCommand}"
                                Style="{StaticResource PrimaryButton}" FontSize="14" Padding="20,9" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                <TextBlock Text="حفظ رحلة الإنتاج" Margin="8,0,0,0" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,12,0"
                                Command="{Binding DataContext.CloseWorkersModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="رجوع للرحلة" Margin="6,0,0,0" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ReadinessText}" Margin="0,0,14,0"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="14">
                            <Run Text="{Binding SelectedProduct.Name, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  —  العمال على المراحل  —  " Foreground="{DynamicResource TextMutedBrush}" />
                            <Run Text="{Binding PreviewSummary, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="OverlayBody" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FlowStages}" ItemTemplate="{StaticResource StageCardTemplate}"
                                  Loaded="FlowStages_Loaded" Unloaded="FlowStages_Unloaded"
                                  DataContextChanged="FlowStages_DataContextChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:ColumnFlowPanel AutoFit="True" MaxColumns="5" Columns="3"
                                                       FitHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
