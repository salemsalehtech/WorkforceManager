<UserControl x:Class="WorkforceManager.UI.Views.FieldError"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root" Visibility="Collapsed">

    <!-- خطأ خانة واحدة تحتها مباشرة — نفس شكل خطأ النطاق في التسجيل اليومي
         (خلفية DangerBgBrush + أيقونة + نص DangerBrush): زوج Tint/Ink من
         اللوحة بيتقلب مع الثيم، مش لون أحمر ثابت -->
    <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="5"
            Padding="7,4" Margin="0,6,0,0" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="13" Height="13"
                                     VerticalAlignment="Top" Margin="0,1,0,0"
                                     Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{Binding Message, ElementName=Root}" FontSize="11.5" Margin="5,0,0,0"
                       TextWrapping="Wrap" MaxWidth="300"
                       Foreground="{DynamicResource DangerBrush}" />
        </StackPanel>
    </Border>
</UserControl>
