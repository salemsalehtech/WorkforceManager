<UserControl x:Class="WorkforceManager.UI.Views.HubPageBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- شريط رفيع فوق أي صفحة جوه نظام الكروت: زرار رجوع للكروت + مسار "الشاشة ← الصفحة" -->
    <Border Style="{StaticResource ToolbarCard}" Padding="10,6">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Padding="10,5" Click="Back_Click"
                    ToolTip="رجوع للكروت" AutomationProperties.Name="رجوع للكروت">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="رجوع" Margin="6,0,0,0" FontSize="13" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="HubText" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"
                                     Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <materialDesign:PackIcon x:Name="SubChevron" Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"
                                     Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="SubText" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
