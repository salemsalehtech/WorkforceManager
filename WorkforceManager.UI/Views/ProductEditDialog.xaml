<Window x:Class="WorkforceManager.UI.Views.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إضافة منتج جديد"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نافذة إضافة/تعديل منتج: نفس الفورم للحالتين، بيتملى مسبقًا في التعديل —
         بطاقة عائمة بلا إطار نظام زي شاشة الدخول، بشريط علوي بلون البراند -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="اسم المنتج (إجباري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" />

                <TextBlock Text="وصف (اختياري)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DescriptionBox" Margin="0,0,0,14"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                         VerticalScrollBarVisibility="Auto" />

                <!-- عامل الرص الافتراضي (اختياري): لو محدَّد بيتحط تاجه
                     تلقائيًا على مرحلة الرص كل يوم في شاشة الإنتاج
                     اليومي — تقدر تشيله أو تستبدله لليوم بس -->
                <TextBlock Text="عامل الرص الافتراضي (اختياري)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="RackingWorkerBox" DisplayMemberPath="Name" Margin="0,0,0,14" />

                <!-- عيلة المنتج (اختيارية) — "+ عيلة جديدة" آخر عنصر في القايمة
                     بيفتح TextPromptDialog صغير، شوف FamilyBox_SelectionChanged -->
                <TextBlock Text="العيلة (اختيارية)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FamilyBox" DisplayMemberPath="Name" Margin="0,0,0,14"
                          SelectionChanged="FamilyBox_SelectionChanged" />

                <!-- وزن القطعة والمادة: بيُستخدموا بس في حساب خطة الإنتاج
                     الشهرية (شاشة "الخطة الشهرية")، مش فلتر ولا تاج هنا -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="وزن القطعة بالجرام (اختياري)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WeightBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="المادة (اختياري)" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="MaterialBox" DisplayMemberPath="Display" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
