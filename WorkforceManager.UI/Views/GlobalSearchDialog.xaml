<Window x:Class="WorkforceManager.UI.Views.GlobalSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="بحث سريع" Width="420" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center"
                                             Foreground="{DynamicResource SidebarInkBrush}" />
                    <TextBlock Text="بحث سريع — عمال ومنتجات" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource GhostButton}" Padding="16,8"
                            IsCancel="True" Content="إلغاء" />
                </StackPanel>
            </Border>

            <StackPanel Margin="18,16,18,10">
                <TextBox x:Name="SearchBox" Padding="10,8" FontSize="13.5"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         materialDesign:HintAssist.Hint="اكتب اسم عامل أو منتج..." />

                <TextBlock x:Name="EmptyText" Text="مفيش نتائج" Margin="4,16,0,0" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />

                <ListBox x:Name="ResultsList" Margin="0,10,0,0" MaxHeight="270"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         KeyDown="ResultsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8"
                                    Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource GoldDeepBrush}">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="PackageVariantClosed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorker}" Value="True">
                                                        <Setter Property="Kind" Value="AccountGroup" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="منتج" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorker}" Value="True">
                                                        <Setter Property="Text" Value="عامل" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
