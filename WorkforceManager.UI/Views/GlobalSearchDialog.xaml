<Window x:Class="WorkforceManager.UI.Views.GlobalSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dtos="clr-namespace:WorkforceManager.Business.DTOs;assembly=WorkforceManager.Business"
        Title="بحث سريع" Width="460" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center"
                                             Foreground="{DynamicResource SidebarInkBrush}" />
                    <TextBlock Text="بحث سريع" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource GhostButton}" Padding="16,8"
                            IsCancel="True" Content="إلغاء" />
                </StackPanel>
            </Border>

            <StackPanel Margin="18,16,18,10">
                <TextBox x:Name="SearchBox" Padding="10,8" FontSize="13.5"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         materialDesign:HintAssist.Hint="اكتب أي حاجة — عامل، منتج، رصيد، إعداد..." />

                <TextBlock x:Name="EmptyText" Text="مفيش نتائج" Margin="4,16,0,0" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />

                <ListBox x:Name="ResultsList" Margin="0,10,0,0" MaxHeight="380"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         KeyDown="ResultsList_KeyDown">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="2,12,0,4" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{DynamicResource GoldDeepBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Worker}">
                                                        <Setter Property="Text" Value="العمال" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Product}">
                                                        <Setter Property="Text" Value="المنتجات" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.ProductionStage}">
                                                        <Setter Property="Text" Value="مراحل الإنتاج" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.InitialBalance}">
                                                        <Setter Property="Text" Value="الرصيد الأولي" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.MemoryPlan}">
                                                        <Setter Property="Text" Value="خطط الذاكرة" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.ActivityLogEntry}">
                                                        <Setter Property="Text" Value="سجل العمليات" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.ReportTemplate}">
                                                        <Setter Property="Text" Value="قوالب التقارير" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.DepartmentAccount}">
                                                        <Setter Property="Text" Value="الحسابات الإدارية" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Setting}">
                                                        <Setter Property="Text" Value="الإعدادات" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.HelpTopic}">
                                                        <Setter Property="Text" Value="الدليل" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8"
                                    Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                                             Foreground="{DynamicResource GoldDeepBrush}">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Magnify" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Worker}">
                                                        <Setter Property="Kind" Value="AccountGroup" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Product}">
                                                        <Setter Property="Kind" Value="PackageVariantClosed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.ProductionStage}">
                                                        <Setter Property="Kind" Value="FormatListNumbered" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.InitialBalance}">
                                                        <Setter Property="Kind" Value="ArchiveOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.MemoryPlan}">
                                                        <Setter Property="Kind" Value="CalendarClockOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.ActivityLogEntry}">
                                                        <Setter Property="Kind" Value="History" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.ReportTemplate}">
                                                        <Setter Property="Kind" Value="FileChartOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.DepartmentAccount}">
                                                        <Setter Property="Kind" Value="AccountTieOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Setting}">
                                                        <Setter Property="Kind" Value="CogOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.HelpTopic}">
                                                        <Setter Property="Kind" Value="HelpCircleOutline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PrimaryText}" FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondaryText}" FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecondaryText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
