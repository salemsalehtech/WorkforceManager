<Window x:Class="WorkforceManager.UI.Views.GlobalSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:dtos="clr-namespace:WorkforceManager.Business.DTOs;assembly=WorkforceManager.Business"
        Title="بحث سريع" Width="900" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center"
                                             Foreground="{DynamicResource SidebarInkBrush}" />
                    <TextBlock Text="بحث سريع" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource GhostButton}" Padding="16,8"
                            IsCancel="True" Content="إلغاء" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="18,16,14,10">
                <TextBox x:Name="SearchBox" Padding="10,8" FontSize="13.5"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         materialDesign:HintAssist.Hint="اكتب أي حاجة: عامل، منتج، سؤال (غياب النهارده، المتأخر في الخطة)، أو أمر (سجّل غياب أحمد)" />

                <TextBlock x:Name="EmptyText" Text="مفيش نتائج" Margin="4,16,0,0" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />

                <!-- بتظهر بس لما صندوق البحث فاضي — آخر بحث (لو موجود) + أمثلة
                     ثابتة تعرّف بالنيات، عشان محدش يعرف "غياب فلان" أو "أعلى
                     إنتاج الأسبوع ده" شغالة إلا لو شافها مكتوبة -->
                <StackPanel x:Name="EmptyStatePanel" Margin="2,16,0,0" Visibility="Collapsed">
                    <!-- تنبيهات النهارده (من MainWindow.BuildSearchAlertsAsync) — دوسة بتكتب السؤال اللي بيجاوبه -->
                    <StackPanel x:Name="AlertsSection" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="محتاج انتباهك النهارده" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                        <ItemsControl x:Name="AlertsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AlertChip_Click" Tag="{Binding Query}"
                                            Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,6" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource WarnBrush}" />
                                            <TextBlock Text="{Binding Text}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="أوامر سريعة" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                    <ItemsControl x:Name="QuickActionsList" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Click="HintChip_Click"
                                        Style="{StaticResource GhostButton}"
                                        Padding="10,5" Margin="0,0,6,6" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="RecentSearchesSection" Visibility="Collapsed">
                        <TextBlock Text="آخر بحث" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                        <ItemsControl x:Name="RecentSearchesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="HintChip_Click"
                                            Style="{StaticResource GhostButton}"
                                            Padding="10,5" Margin="0,0,6,6" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="جرّب" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,6" />
                    <ItemsControl x:Name="HintChipsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Click="HintChip_Click"
                                        Style="{StaticResource GhostButton}"
                                        Padding="10,5" Margin="0,0,6,6" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ListBox x:Name="ResultsList" Margin="0,10,0,0" MaxHeight="440" SelectionChanged="ResultsList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         KeyDown="ResultsList_KeyDown">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="2,12,0,4" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{DynamicResource GoldDeepBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Worker}">
                                                        <Setter Property="Text" Value="العمال" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Product}">
                                                        <Setter Property="Text" Value="المنتجات" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.ProductionStage}">
                                                        <Setter Property="Text" Value="مراحل الإنتاج" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.InitialBalance}">
                                                        <Setter Property="Text" Value="الرصيد الأولي" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.MemoryPlan}">
                                                        <Setter Property="Text" Value="خطط الذاكرة" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.ActivityLogEntry}">
                                                        <Setter Property="Text" Value="سجل العمليات" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.ReportTemplate}">
                                                        <Setter Property="Text" Value="قوالب التقارير" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.DepartmentAccount}">
                                                        <Setter Property="Text" Value="الحسابات الإدارية" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Setting}">
                                                        <Setter Property="Text" Value="الإعدادات" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.HelpTopic}">
                                                        <Setter Property="Text" Value="الدليل" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.IntentAnswer}">
                                                        <Setter Property="Text" Value="الإجابة السريعة" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Action}">
                                                        <Setter Property="Text" Value="أوامر" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="{x:Static dtos:SearchCategory.Screen}">
                                                        <Setter Property="Text" Value="الشاشات" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                            <!-- بطاقة إجابة النية — شكل مختلف تمامًا عن صف نتيجة عادي،
                                 شوف SearchIntentService. بديلة (مش إضافة) للصف العادي
                                 تحتها؛ الاتنين في نفس مكان الـ Grid، وحدة بس بتبان
                                 حسب Category (شوف Visibility triggers الاتنين تحت) -->
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1.4"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.IntentAnswer}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="16" Height="16"
                                                                 VerticalAlignment="Top" Margin="0,2,0,0"
                                                                 Foreground="{DynamicResource GoldDeepBrush}" />
                                        <TextBlock Text="{Binding IntentAnswer.Title}" FontSize="13.5" FontWeight="Bold"
                                                   Margin="6,0,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding IntentAnswer.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                               FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="Wrap"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- بتبان بس لو فيه فعلًا حاجة تتقال (مفيش بيانات للفترة، أو تحذير) —
                                         شوف SearchIntentAnswer.EmptyNote's توثيق: مفيش سكوت، دايمًا وضوح -->
                                    <TextBlock Text="{Binding IntentAnswer.EmptyNote}" FontSize="12" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IntentAnswer.EmptyNote}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8"
                                    Padding="10,8" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.IntentAnswer}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                                             Foreground="{DynamicResource GoldDeepBrush}">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Magnify" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Worker}">
                                                        <Setter Property="Kind" Value="AccountGroup" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Product}">
                                                        <Setter Property="Kind" Value="PackageVariantClosed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.ProductionStage}">
                                                        <Setter Property="Kind" Value="FormatListNumbered" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.InitialBalance}">
                                                        <Setter Property="Kind" Value="ArchiveOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.MemoryPlan}">
                                                        <Setter Property="Kind" Value="CalendarClockOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.ActivityLogEntry}">
                                                        <Setter Property="Kind" Value="History" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.ReportTemplate}">
                                                        <Setter Property="Kind" Value="FileChartOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.DepartmentAccount}">
                                                        <Setter Property="Kind" Value="AccountTieOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Setting}">
                                                        <Setter Property="Kind" Value="CogOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.HelpTopic}">
                                                        <Setter Property="Kind" Value="HelpCircleOutline" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Action}">
                                                        <Setter Property="Kind" Value="LightningBolt" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Static dtos:SearchCategory.Screen}">
                                                        <Setter Property="Kind" Value="ViewGridOutline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PrimaryText}" FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondaryText}" FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecondaryText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- كارت المعاينة: ملخص العامل/المنتج المحدد في القايمة (ResultsList_SelectionChanged) — من غير ما تفتح شاشته -->
            <Border Grid.Column="1" Margin="0,16,18,10" Padding="14,12" CornerRadius="12"
                    Background="{DynamicResource SubtleBgBrush}">
                <Grid>
                    <TextBlock x:Name="PreviewPlaceholder" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                               Text="اختار عامل أو منتج من النتايج (بالأسهم أو بالماوس) وهتلاقي ملخصه هنا" />
                    <StackPanel x:Name="PreviewCard" Visibility="Collapsed">
                        <TextBlock x:Name="PreviewTitle" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <ItemsControl x:Name="PreviewLines">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="170"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Enter أو دبل كليك يفتح التفاصيل" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
