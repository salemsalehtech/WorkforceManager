<UserControl x:Class="WorkforceManager.UI.Views.PenaltiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- الجزاءات — كانت تبويب في التسجيل اليومي، بقت تبويب في إدارة العمال. نفس DailyEntryViewModel بالظبط. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:EntryDateBar Grid.Row="0" />
                <Grid Grid.Row="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فورم تسجيل جزاء جديد -->
                    <Border Grid.Row="0" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="تسجيل جزاء جديد" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8" />
                            <!-- صف الخانات في صف 0، وخطأ كل خانة تحت عمودها بالظبط في صف 1
                                 (FieldError) — عشان التسمية تفضل في نص الخانة لما خطأ يظهر -->
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="العامل:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <views:WorkerSearchBox Grid.Column="1" Workers="{Binding AttendanceRows}"
                                                       SelectedWorker="{Binding PenaltyWorker, Mode=TwoWay}"
                                                       Placeholder="دوّر على العامل بالاسم…"
                                                       Width="220" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="الخصم:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding DeductionOptions}" SelectedItem="{Binding SelectedDeduction}"
                                          DisplayMemberPath="Display" Width="110" Margin="0,0,14,0" />
                                <views:FieldError Grid.Row="1" Grid.Column="1" MaxWidth="220" Message="{Binding PenaltyWorkerError}" />
                                <views:FieldError Grid.Row="1" Grid.Column="3" MaxWidth="160" Message="{Binding PenaltyDeductionError}" />
                            </Grid>
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="AddPenaltyButton" DockPanel.Dock="Left" Command="{Binding AddPenaltyCommand}"
                                        Style="{StaticResource DangerButton}" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="تسجيل الجزاء" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="السبب:" VerticalAlignment="Top" Margin="12,8,6,0" DockPanel.Dock="Left" />
                                <!-- سبب الجزاء نص حر: شرب سجاير، لبس هاندفري، ... -->
                                <StackPanel>
                                    <TextBox Text="{Binding PenaltyReason, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                    <views:FieldError Message="{Binding PenaltyReasonError}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- جزاءات اليوم المسجلة -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="جزاءات اليوم المسجلة" Style="{StaticResource SectionTitle}" Margin="4,0,4,6" />
                        <DataGrid x:Name="PenaltiesGrid" Grid.Row="1" ItemsSource="{Binding DayPenalties}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العامل" Binding="{Binding WorkerName}" Width="Auto" MinWidth="150" />
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*" />
                                <DataGridTextColumn Header="الخصم" Binding="{Binding DeductionName}" Width="90" />
                                <!--
                                    أيقونة بس من غير نص — زي عمود "سجلات اليوم" بالظبط. عمود
                                    نص+أيقونة في عرض ضيق (60-70) كان بيقصّ النص ("حذف" بتبقى
                                    "حذ")، وده اللي كان بيبين كإطار/عمود "مش متناسق". الأيقونة
                                    وحدها مالهاش نص يتقصّ، والـ ToolTip بيقول نفس المعنى.
                                    نفس عرض عمود "سجلات اليوم" (120) لأنه نفس المحتوى بالظبط:
                                    زرارين أيقونة جنب بعض.
                                -->
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource IconButton}" Foreground="{DynamicResource BrandBrush}"
                                                        ToolTip="تعديل الجزاء"
                                                        Command="{Binding DataContext.EditPenaltyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="13" Height="13" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerBrush}"
                                                        ToolTip="حذف الجزاء"
                                                        Command="{Binding DataContext.RemovePenaltyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>
