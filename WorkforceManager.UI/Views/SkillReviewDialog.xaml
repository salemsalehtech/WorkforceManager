<Window x:Class="WorkforceManager.UI.Views.SkillReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="مراجعة تقييمات العمال" Width="820" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <!-- الرأس -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="مراجعة تقييمات العمال" Foreground="{DynamicResource SidebarInkBrush}"
                                   FontSize="15.5" FontWeight="Bold" />
                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- شريط الأوامر تحت -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="16,8"
                            IsCancel="True" Content="خلّص دلوقتي" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="AppliedText" VerticalAlignment="Center" FontSize="12"
                                   Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button x:Name="ApplyAllButton" Style="{StaticResource PrimaryButton}"
                                Padding="16,8" Click="ApplyAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckAll" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="وافق على الكل" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- القايمة -->
            <Grid Margin="18,14,18,10">
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="كل التقييمات متطابقة مع الأداء الفعلي — مفيش حاجة محتاجة تعديل"
                           Visibility="Collapsed" />

                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SuggestionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="9"
                                        Padding="14,11" Margin="0,0,0,8">
                                    <DockPanel>
                                        <!-- أزرار القرار -->
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Button Padding="7,5"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    Tag="{Binding}" Click="ApplyOne_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="ToolTip" Value="وافق على التعديل ده" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                                                                <Setter Property="ToolTip" Value="أكّد التقييم ده" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="Check" Width="17" Height="17" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="7,5"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    ToolTip="سيبه زي ما هو"
                                                    Tag="{Binding}" Click="Ignore_Click">
                                                <materialDesign:PackIcon Kind="Close" Width="17" Height="17" />
                                            </Button>
                                        </StackPanel>

                                        <!-- التغيير المقترح: ارفع / نزّل / أكّد -->
                                        <Border DockPanel.Dock="Right" CornerRadius="7" Padding="11,7"
                                                VerticalAlignment="Center" MinWidth="150">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpgrade}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- تعديل: من كذا لكذا -->
                                                <TextBlock HorizontalAlignment="Center" FontSize="13"
                                                           Visibility="{Binding IsConfirmation, Converter={StaticResource InverseBoolToVis}}">
                                                    <Run Text="{Binding CurrentStarsText, Mode=OneWay}" Foreground="{DynamicResource InkSoftBrush}" />
                                                    <Run Text="  ←  " Foreground="{DynamicResource InkFaintBrush}" />
                                                    <Run Text="{Binding SuggestedStarsText, Mode=OneWay}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" />
                                                </TextBlock>

                                                <!-- تأكيد: النجوم زي ما هي، فالسهم بيلغبط -->
                                                <TextBlock HorizontalAlignment="Center" FontSize="13"
                                                           Text="{Binding SuggestedStarsText}"
                                                           Foreground="{DynamicResource GoldBrush}" FontWeight="Bold"
                                                           Visibility="{Binding IsConfirmation, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock HorizontalAlignment="Center" FontSize="10.5" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="نزّل التقييم" />
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpgrade}" Value="True">
                                                                    <Setter Property="Text" Value="ارفع التقييم" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                                                                    <Setter Property="Text" Value="أكّد التقييم" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- العامل والمرحلة والسبب -->
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding WorkerName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource BrandBrush}">
                                                <Run Text="{Binding ProductName, Mode=OneWay}" />
                                                <Run Text="←" Foreground="{DynamicResource TextMutedBrush}" />
                                                <Run Text="{Binding StageName, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" FontSize="11.5" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
