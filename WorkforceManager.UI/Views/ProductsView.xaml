<UserControl x:Class="WorkforceManager.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650"
        d:DesignWidth="1100">

    <!-- شاشة المنتجات: ملخص + بحث وفلاتر + بطاقات المنتجات + خط إنتاج المنتج المحدد -->
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== الصف الموحّد: ملخص + بحث + فلاتر + مدة ===== =====
             كانا صفّين منفصلين (بطاقة ملخص، وصف تحكّم تحتها) — اتدمجوا في
             WrapPanel واحد. WrapPanel مش Grid بأعمدة Auto ثابتة: Grid كان
             ممكن يدفع آخر عنصر برّه حافة الشاشة بصمت لو العرض الكلي زاد عن
             المتاح (نفس المشكلة اللي اتصلحت في شاشة العمال) — أي عنصر هنا
             مايلاقيش مكان بيلف لسطر تاني بدل ما يختفي. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddProductButton"
                    Command="{Binding AddProductCommand}"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    Padding="18,10" Margin="0,0,16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PackageVariantClosedPlus"
                            Width="17"
                            Height="17"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="إضافة منتج"
                            Margin="7,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- تنبيه المنتجات اللي فيها مشكلة -->
            <Button Command="{Binding ShowNeedsAttentionCommand}"
                    VerticalAlignment="Center"
                    Margin="0,0,16,8"
                    ToolTip="اعرض المنتجات دي بس">
                <Button.Style>
                    <Style TargetType="Button"
                            BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Foreground"
                                Value="{DynamicResource WarnBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttentionCount}"
                                    Value="0">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOutline"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <Run Text="{Binding NeedsAttentionCount, Mode=OneWay}"
                                FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" منتج فيه مشكلة"/>
                    </TextBlock>
                </StackPanel>
            </Button>

            <!-- ===== إحصائيات النشاط =====
                 "الإجمالي" و"إجمالي المراحل" اتشالوا: رقمين ثابتين تقريبًا
                 ومحدش بياخد قرار بناءً عليهم. مكانهم بقى أكتر وأقل منتج
                 إنتاجًا فعليًا — دول اللي بيقولوا فين الشغل وفين الوقفة.
                 كل إحصائية مكتوب تحتها الفترة اللي بتقيسها. -->
            <StackPanel Style="{StaticResource SummaryStat}" Margin="0,0,16,8">
                <TextBlock Text="{Binding WorkedProductsCount}"
                        Style="{StaticResource SummaryNumber}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="منتج شغّال"
                        Style="{StaticResource SummaryLabel}"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center"
                    Margin="0,0,16,8"
                    MaxWidth="170">
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                    <materialDesign:PackIcon Kind="TrendingUp"
                            Width="14"
                            Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{Binding MostActiveName}"
                            FontSize="13"
                            FontWeight="Bold"
                               Margin="5,0,0,0"
                            VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding MostActivePieces}"
                        FontSize="10.5"
                        HorizontalAlignment="Right"
                           Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock Text="أكتر منتج إنتاجًا"
                        Style="{StaticResource SummaryLabel}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center"
                    Margin="0,0,20,8"
                    MaxWidth="170">
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                    <materialDesign:PackIcon Kind="TrendingDown"
                            Width="14"
                            Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource WarnBrush}"/>
                    <TextBlock Text="{Binding LeastActiveName}"
                            FontSize="13"
                            FontWeight="Bold"
                               Margin="5,0,0,0"
                            VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding LeastActivePieces}"
                        FontSize="10.5"
                        HorizontalAlignment="Right"
                           Foreground="{DynamicResource WarnBrush}"/>
                <TextBlock Text="أقل منتج إنتاجًا"
                        Style="{StaticResource SummaryLabel}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1.4"
                    CornerRadius="10"
                    Width="230"
                    Margin="0,0,16,8"
                    Padding="12,7">
                <Grid>
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                Kind="Magnify"
                                Width="17"
                                Height="17"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="مسح البحث">
                            <Button.Style>
                                <Style TargetType="Button"
                                        BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}"
                                                Value="">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="Close"
                                    Width="13"
                                    Height="13"/>
                        </Button>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                 FontSize="13"
                                Background="Transparent"/>
                    </DockPanel>
                    <TextBlock Text="دوّر بالمنتج أو بالمرحلة…"
                            Margin="30,0,0,0"
                            IsHitTestVisible="False"
                               VerticalAlignment="Center"
                            FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}"
                                            Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- كانت "شغّالين الأسبوع ده على" — والمدة مكتوبة على زرارها
                 جنبه على طول، فمكانش ليها لزوم تتكرر جوّه الشريط كمان -->
            <StackPanel Orientation="Horizontal"
                    Margin="0,0,14,8"
                    VerticalAlignment="Center">
                <RadioButton Content="شغّالين"
                        Style="{StaticResource Chip}"
                             ToolTip="المنتجات اللي اتسجل عليها شغل فعلي في المدة المختارة"
                             IsChecked="{Binding IsFilterWorked, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                        CommandParameter="worked"/>
                <RadioButton Content="الكل"
                        Style="{StaticResource Chip}"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                        CommandParameter="all"/>
                <RadioButton Content="موقوف"
                        Style="{StaticResource Chip}"
                             IsChecked="{Binding IsFilterInactive, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                        CommandParameter="inactive"/>
            </StackPanel>

            <TextBlock Text="{Binding ResultsText}"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                       VerticalAlignment="Center"
                    Margin="0,0,20,8"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- ===== زرار الفلاتر =====
                 المرحلة والعامل والترتيب كانوا تلات قوايم قاعدين على
                 الشاشة طول الوقت في صف لوحدهم. بقوا جوّه، والرقم على
                 الزرار بيقول كام واحد شغّال دلوقتي — عشان المستخدم
                 ميبصّش على قايمة ناقصة ومايعرفش ليه. -->
            <Grid VerticalAlignment="Center" Margin="0,0,8,8">
                <ToggleButton x:Name="FilterToggle"
                        Style="{StaticResource ToolbarToggle}"
                              IsChecked="{Binding IsFilterMenuOpen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterVariant"
                                Width="15"
                                Height="15"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="فلاتر"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SidebarBrush}"
                                CornerRadius="8"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasExtraFilters, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveFilterCount}"
                                    FontSize="10.5"
                                       FontWeight="Bold"
                                    Foreground="{DynamicResource SidebarInkBrush}"/>
                        </Border>
                        <materialDesign:PackIcon Kind="ChevronDown"
                                Width="14"
                                Height="14"
                                                 Margin="4,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsFilterMenuOpen, Mode=TwoWay}"
                        StaysOpen="False"
                       PlacementTarget="{Binding ElementName=FilterToggle}"
                        Placement="Bottom"
                       AllowsTransparency="True"
                        PopupAnimation="Fade">
                    <Border Style="{StaticResource ToolbarPopupCard}"
                            FlowDirection="RightToLeft"
                            Width="290">
                        <StackPanel>
                            <TextBlock Text="المرحلة"
                                    FontSize="11"
                                    Margin="0,0,0,3"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <ComboBox ItemsSource="{Binding StageFilterOptions}"
                                      SelectedItem="{Binding SelectedStageFilter}"
                                      DisplayMemberPath="Display"
                                    FontSize="12.5"
                                      ToolTip="المنتجات اللي فيها المرحلة دي"/>

                            <TextBlock Text="العامل"
                                    FontSize="11"
                                    Margin="0,10,0,3"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <ComboBox ItemsSource="{Binding WorkerFilterOptions}"
                                      SelectedItem="{Binding SelectedWorkerFilter}"
                                      DisplayMemberPath="Display"
                                    FontSize="12.5"
                                      ToolTip="المنتجات اللي العامل ده اشتغل عليها في المدة"/>

                            <!-- ده ترتيب مش فلتر، بس بيغيّر اللي المستخدم
                                 شايفه فمكانه معاهم -->
                            <TextBlock Text="الترتيب"
                                    FontSize="11"
                                    Margin="0,10,0,3"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <ComboBox ItemsSource="{Binding VolumeFilterOptions}"
                                      SelectedItem="{Binding SelectedVolumeFilter}"
                                      DisplayMemberPath="Display"
                                    FontSize="12.5"
                                      ToolTip="ترتيب المنتجات بحجم إنتاجها في المدة"/>

                            <Button Command="{Binding ClearExtraFiltersCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="11,6"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding HasExtraFilters, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterRemove"
                                            Width="14"
                                            Height="14"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="شيل الفلاتر"
                                            Margin="5,0,0,0"
                                            FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ===== زرار المدة =====
                 المدة كانت مكتوبة أربع مرات: داتتين + زرارين + سطر وصفي
                 + اسم الشريط. بقت مكتوبة مرة على الزرار، والتفاصيل
                 (والمدة المخصصة) جوّه. المدة بتحكم "شغّال ولا لأ"
                 والإحصائيات فوق مع بعض. -->
            <Grid VerticalAlignment="Center"
                    Margin="0,0,0,8">
                <ToggleButton x:Name="PeriodToggle"
                        Style="{StaticResource ToolbarToggle}"
                              IsChecked="{Binding IsPeriodMenuOpen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarRange"
                                Width="15"
                                Height="15"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PeriodLabel}"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="ChevronDown"
                                Width="14"
                                Height="14"
                                                 Margin="4,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsPeriodMenuOpen, Mode=TwoWay}"
                        StaysOpen="False"
                       PlacementTarget="{Binding ElementName=PeriodToggle}"
                        Placement="Bottom"
                       AllowsTransparency="True"
                        PopupAnimation="Fade">
                    <Border Style="{StaticResource ToolbarPopupCard}"
                            FlowDirection="RightToLeft"
                            Width="290">
                        <StackPanel>
                            <Button Command="{Binding UseCurrentWeekCommand}"
                                    Content="الأسبوع ده"
                                    Style="{StaticResource GhostButton}"
                                    Padding="11,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Right"
                                    FontSize="12.5"/>
                            <Button Command="{Binding UseThisMonthCommand}"
                                    Content="الشهر ده"
                                    Style="{StaticResource GhostButton}"
                                    Padding="11,7"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Right"
                                    FontSize="12.5"/>
                            <Button Command="{Binding UseLastMonthCommand}"
                                    Content="آخر 30 يوم"
                                    Style="{StaticResource GhostButton}"
                                    Padding="11,7"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Right"
                                    FontSize="12.5"/>

                            <Border Height="1"
                                    Background="{DynamicResource CardBorderBrush}"
                                    Margin="0,12,0,10"/>

                            <TextBlock Text="مدة مخصوصة"
                                    FontSize="11"
                                    Margin="0,0,0,5"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                        Text="من"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                           Margin="0,0,5,0"
                                        Foreground="{DynamicResource TextMutedBrush}"/>
                                <DatePicker Grid.Column="1"
                                        SelectedDate="{Binding PeriodFrom}"
                                        FontSize="12.5"/>
                                <TextBlock Grid.Column="2"
                                        Text="إلى"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                           Margin="8,0,5,0"
                                        Foreground="{DynamicResource TextMutedBrush}"/>
                                <DatePicker Grid.Column="3"
                                        SelectedDate="{Binding PeriodTo}"
                                        FontSize="12.5"/>
                            </Grid>

                            <TextBlock Text="{Binding PeriodText}"
                                    FontSize="11"
                                    Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </WrapPanel>

        <!-- شبكة كروت المنتجات — نفس هيكل شبكة صفحة "الدليل". التفاصيل بقت
             بتفتح Modal (ProductDetailDialog) عند الدوسة على كارت، مش لوحة
             تحت الشبكة زي قبل كده — شوف ProductTile_Click في
             ProductsView.xaml.cs -->
        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

            <Border Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoResults}"
                                            Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                Width="46"
                                Height="46"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="مفيش منتج بالمواصفات دي"
                                Margin="0,10,0,0"
                                FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- شبكة الكروت — نفس بنية TopicsGrid بتاعة "الدليل" بالظبط
                         (ItemsControl عادي + WrapPanel، مش ListBox) -->
                    <ItemsControl x:Name="ProductsGrid" ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- عرض الكارت محسوب من عرض الشبكة الفعلي + حالة الشريط الجانبي
                                     (GridColumnWidthConverter.MultiConvert، نفس شاشة العمال بالحرف) —
                                     الشريط ظاهر = 5 أعمدة، مطوي = 6. كان عرض ثابت 250px، فعدد الأعمدة
                                     كان بيطلع عشوائي حسب حجم النافذة من غير أي ضمان. -->
                                <Button Style="{StaticResource CardButton}" Margin="0,0,10,10"
                                        Opacity="0"
                                        Click="ProductTile_Click">
                                    <ui:AnimatedWidth.Value>
                                        <MultiBinding Converter="{StaticResource GridColumnWidth}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            <Binding Path="IsSidebarCollapsed" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </ui:AnimatedWidth.Value>
                                    <Button.RenderTransform>
                                        <TranslateTransform Y="14"/>
                                    </Button.RenderTransform>
                                    <Border Padding="14,12">
                                        <Border.Style>
                                            <!-- Effect={x:Null} بيلغي ظل Card الموروث: DropShadowEffect على عنصر
                                                 بيجبر WPF يرسمه في طبقة Bitmap منفصلة، وده بيلغي ClearType
                                                 ويخلي النص جوّاه Grayscale AA (أعمى/مغبّش) — مبيبان بالكاد على
                                                 كارت واحد، لكن على شبكة فيها 15-20 كارت بنفس الستايل كل النصوص
                                                 في الشاشة بتبقى أقل وضوحًا دفعة واحدة. الحلقة الدهبية عند
                                                 الهوفر (CardButton.Ring) كفاية كإحساس "ارتفاع" للكارت، فمفيش
                                                 داعي للظل أصلًا هنا -->
                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- الأفاتار مكان أيقونة الموضوع في كارت الدليل —
                                                 المنتج مالوش أيقونة، والأفاتار أصلًا هويته
                                                 البصرية في كل الشاشة -->
                                            <Border Width="44" Height="44" CornerRadius="12"
                                                    Background="{DynamicResource SubtleBgBrush}"
                                                    HorizontalAlignment="Left">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}" FontSize="15.5" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrandBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,44,44" RadiusX="11" RadiusY="11"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Margin="0,8,0,0"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <!-- مخفي تمامًا لو مفيش وصف، بدل سطر فاضي — ولها ToolTip
                                                 بالنص الكامل عشان القطع بالنقط ميضيّعش المعلومة -->
                                            <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Description}"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                                       Foreground="{DynamicResource CardBadgeTextBrush}"/>

                                            <!-- تنبيه المنتج — نفس معلومة الكارت القديم، مضغوطة -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                                                         VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}"/>
                                                <TextBlock Text="{Binding AttentionText}" FontSize="10.5" Margin="4,0,0,0"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" FontWeight="Medium"
                                                           Foreground="{DynamicResource WarnBrush}"/>
                                            </StackPanel>

                                            <!-- بادج عدد المراحل + بادج النشاط في الفترة (نشط) — نفس
                                                 مكان بادج "N ميزة" في الدليل، مع بادج إضافي مقترح:
                                                 ProductRow.ActivityText موجودة أصلًا (بتغذّي فلتر
                                                 "شغّالين" في الشاشة) بس مكانتش ظاهرة على الكارت خالص -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                        Padding="7,1">
                                                    <TextBlock Text="{Binding StagesCountText}" FontSize="10"
                                                               Foreground="{DynamicResource CardBadgeTextBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                        Padding="7,1" Margin="5,0,0,0">
                                                    <TextBlock Text="{Binding ActivityText}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="130"
                                                               Foreground="{DynamicResource CardBadgeTextBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- بادج "موقوف" بدل عدد المراحل لمنتج متوقف — نفس
                                                 المعلومة اللي كانت في الكارت القديم -->
                                            <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="8"
                                                    Padding="7,1" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="موقوف" FontSize="10" FontWeight="Medium"
                                                           Foreground="{DynamicResource DangerBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

        </ScrollViewer>
    </Grid>
</UserControl>
