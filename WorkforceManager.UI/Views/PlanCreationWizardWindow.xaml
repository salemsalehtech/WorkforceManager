<Window x:Class="WorkforceManager.UI.Views.PlanCreationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="خطة جديدة للشهر" Width="760" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!--
      wizard إنشاء خطة جديدة للشهر — 3 خطوات: مدة (شهر كامل/فترات فرعية
      مرقّمة) → إدخال هدف كل منتج (عيلات ككروت، صح أخضر لكل منتج/عيلة خلصت) →
      حفظ (شاشة تحميل). شوف PlanCreationWizardViewModel/CLAUDE.md.
    -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" Click="Close_Click"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="خطة جديدة للشهر" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <Grid Margin="24,20,24,20">

                <!-- ═══════════ خطوة 1: المدة ═══════════ -->
                <StackPanel Visibility="{Binding IsDurationStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="اختار مدة الخطة" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="الافتراضي الشهر كامل — أو خصّص فترة أو أكتر جوه الشهر لو محتاج تقسيمه"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,0,18" TextWrapping="Wrap" />

                    <Button Content="إنشاء خطة للشهر كامل" Command="{Binding UseWholeMonthCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="26,11" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <Button Content="تخصيص فترة (اختياري)" Command="{Binding ToggleCustomizingCommand}"
                            Style="{StaticResource GhostButton}" Padding="18,9" HorizontalAlignment="Left" />

                    <StackPanel Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="من" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding CustomStart}" Width="160" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding CustomEnd}" Width="160" />
                            </StackPanel>
                            <Button Content="أضف فترة" Command="{Binding AddCustomPeriodCommand}"
                                    Style="{StaticResource GhostButton}" Padding="16,9" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        </WrapPanel>

                        <TextBlock Text="{Binding DurationError}" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Visibility="{Binding HasDurationError, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding Periods}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WizardPeriodRow}">
                                    <Border Background="{DynamicResource GoldTintBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource GoldDeepBrush}" FontWeight="Bold" FontSize="12.5" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="ابدأ إدخال الأهداف" Command="{Binding StartEntryCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="22,10" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════ خطوة 2: إدخال الأهداف ═══════════ -->
                <DockPanel Visibility="{Binding IsEntryStep, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{Binding CurrentPeriod.Label}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Visibility="{Binding HasMultiplePeriods, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                            <Run Text="سجّلت" /><Run Text="{Binding CurrentPeriod.EnteredCount, Mode=OneWay}" />
                            <Run Text="من" /><Run Text="{Binding CurrentPeriod.TotalCount, Mode=OneWay}" />
                            <Run Text="منتج" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                        <Button Content="رجوع" Command="{Binding BackToDurationCommand}"
                                Style="{StaticResource GhostButton}" Padding="20,9" Margin="0,0,8,0" />
                        <Button Content="التالي" Command="{Binding NextPeriodCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="26,9"
                                Visibility="{Binding IsLastPeriod, Converter={StaticResource InverseBoolToVis}}" />
                        <Button Content="حفظ الخطة" Click="Save_Click"
                                Style="{StaticResource PrimaryButton}" Padding="26,9"
                                Visibility="{Binding IsLastPeriod, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CurrentPeriod.FamilyGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WizardFamilyGroupRow}">
                                    <!-- Effect={x:Null}: كارت متكرر جوه ItemsControl — الظل بيلغي ClearType، شوف CLAUDE.md -->
                                    <Border Style="{StaticResource Card}" Effect="{x:Null}" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel Margin="2,0,0,10">
                                                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="CheckCircle" Width="17" Height="17"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                                         Foreground="{DynamicResource SuccessBrush}"
                                                                         Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionTitle}" />
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Products}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:WizardProductRow}">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBox DockPanel.Dock="Left"
                                                                     Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="90" TextAlignment="Center" />
                                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Check" Width="15" Height="15"
                                                                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource SuccessBrush}"
                                                                                     Visibility="{Binding IsEntered, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═══════════ خطوة 3: حفظ ═══════════ -->
                <StackPanel Visibility="{Binding IsSavingStep, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,0,0,14" />
                    <TextBlock Text="جاري إنشاء الخطة..." FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

            </Grid>
        </DockPanel>
    </Border>
</Window>
