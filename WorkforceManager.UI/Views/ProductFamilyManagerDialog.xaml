<Window x:Class="WorkforceManager.UI.Views.ProductFamilyManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إدارة العائلات" Width="420" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- ديالوج بسيط عن قصد (مش شاشة إدارة كاملة) — قايمة + تعديل اسم +
         حذف لو فاضية. إضافة عيلة جديدة بتحصل من فورم المنتج نفسه
         ("+ عيلة جديدة")، مش من هنا. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="إدارة العائلات" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}"
                        Content="قفل" IsCancel="True" Padding="22,8" />
            </Border>

            <Grid Margin="18,16,18,10">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="TagOffOutline" Width="40" Height="40"
                                             HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="لسه مفيش عائلات — أضف واحدة من فورم المنتج" Margin="0,10,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <ListBox x:Name="FamiliesList" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Click="Rename_Click" Tag="{Binding}" Style="{StaticResource IconButton}"
                                                Padding="6" ToolTip="تعديل الاسم">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" />
                                        </Button>
                                        <Button Click="Delete_Click" Tag="{Binding}" Style="{StaticResource IconButton}"
                                                Padding="6" Margin="4,0,0,0"
                                                IsEnabled="{Binding CanDelete}"
                                                ToolTip="{Binding DeleteTooltip}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15"
                                                                     Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ProductCount, StringFormat=' — {0} منتج'}"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
