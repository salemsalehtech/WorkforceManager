<views:ChromelessDialogWindow x:Class="WorkforceManager.UI.Views.WithdrawInitialBalancePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="أخذ من الرصيد الأولي"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <views:ChromelessDialogWindow.HeaderContent>
        <TextBlock Text="أخذ من الرصيد الأولي" Foreground="{DynamicResource SidebarInkBrush}"
                   FontSize="15.5" FontWeight="Bold" />
    </views:ChromelessDialogWindow.HeaderContent>

    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="الرصيد" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="BalanceBox" Margin="0,0,0,12" DisplayMemberPath="Display"
                  SelectionChanged="BalanceBox_SelectionChanged" />

        <TextBlock Text="النطاق" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="RangeBox" Margin="0,0,0,12" DisplayMemberPath="Display"
                  SelectionChanged="RangeBox_SelectionChanged" />

        <TextBlock Text="عدد القطع المسحوبة" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="QuantityBox" Margin="0,0,0,4" />
        <TextBlock x:Name="RemainingText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,16" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                   Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="متابعة" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
        </StackPanel>
    </StackPanel>
</views:ChromelessDialogWindow>
