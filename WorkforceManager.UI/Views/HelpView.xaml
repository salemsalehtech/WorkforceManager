<UserControl x:Class="WorkforceManager.UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}"
             d:DesignWidth="1100" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- شبكة مدمجة ثابتة فوق (تايل لكل شاشة، بترتيب القايمة الجانبية) +
         لوحة تفاصيل بعرض كامل تحت — بدل الأكورديون الطويل القديم. دوسة
         على تايل تختاره (SelectTopicCommand) من غير ما يتمدد مكانه، فارتفاع
         صفوف الشبكة يفضل ثابت مهما كان المختار كبير أو صغير. "تسجيل
         الإنتاج اليومي" بس عنده SubTopics (7 تبويبات)، فبيتعرض كأكورديون
         متداخل جوّه لوحة التفاصيل بدل قايمة ميزات مباشرة.

         كل أوامر الأزرار هنا بتتربط بـ AncestorType=UserControl (مش عدّ
         مستويات ItemsControl زي الجولة اللي فاتت) — الـDataContext بيوصل
         لـHelpViewModel مباشرة أيًا كان عدد الـItemsControl المتداخلة
         بينهم، فمفيش هشاشة لو أضفنا مستوى تعشيش زيادة بعدين. -->
    <UserControl.Resources>
        <!-- تايل الشبكة المدمجة — يستخدم CardButton (كارت كله زرار، بدون
             تكبير عند المرور، حلقة دهبية بس) الموجود أصلًا في Core.xaml -->
        <DataTemplate x:Key="TopicTile">
            <!-- Opacity/RenderTransform بيبدأوا في حالة "لسه ما دخلش" —
                 HelpView.xaml.cs بيحرّكهم لحالتهم الطبيعية بحركة متدرّجة
                 (Storyboard حقيقي، مش تايمر بيغيّر خصائص يدوي) أول ما
                 الشاشة تفتح، بفارق وقت بسيط بين تايل والتاني -->
            <Button Style="{StaticResource CardButton}" Width="220" Margin="0,0,10,10"
                    Opacity="0"
                    Command="{Binding DataContext.SelectTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.RenderTransform>
                    <TranslateTransform Y="14" />
                </Button.RenderTransform>
                <Border Padding="14,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22"
                                                 HorizontalAlignment="Left" Foreground="{DynamicResource GoldBrush}" />
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                Padding="7,1" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="{Binding FeatureCount, Mode=OneWay}" />
                                <Run Text=" ميزة" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- صف ميزة واحدة (AppTourStep) بزرار "جرّبها" — نفس شكل الجولة
             اللي فاتت، بيتكرر هنا ومرة جوّه أكورديون التبويبات الفرعية -->
        <DataTemplate x:Key="FeatureRow">
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                    Padding="10,8" Margin="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="10,4"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.TryTourCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TelevisionPlay" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="جرّبها" Margin="4,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                   Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- كارت تبويب فرعي (لـ"تسجيل الإنتاج اليومي" بس دلوقتي) —
             أكورديون داخلي مستقل عن اختيار التايل الرئيسي فوق -->
        <DataTemplate x:Key="SubTopicCard">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,8">
                <StackPanel>
                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="12,10"
                            Command="{Binding DataContext.ToggleSubTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="ChevronLeft" Width="16" Height="16"
                                                     Margin="8,2,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronDown" />
                                                <Setter Property="Foreground" Value="{DynamicResource GoldBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding TourSteps}" ItemTemplate="{StaticResource FeatureRow}"
                                  Margin="12,0,12,10"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="22" Height="22"
                                         VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                <TextBlock Text="الدليل" FontSize="18" FontWeight="Bold" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="دوس على أي شاشة تحت عشان تشوف كل ميزاتها بالتفصيل، واختار اللي عايز تتعلمه ودوس &quot;جرّبها&quot; وهنوريك مكانه بالظبط." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="TopicsGrid" ItemsSource="{Binding Topics}" ItemTemplate="{StaticResource TopicTile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- حالة فاضية: مفيش شاشة متحددة لسه -->
                <Border Style="{StaticResource Card}" Margin="0,4,0,14" Padding="24"
                        Visibility="{Binding HasSelectedTopic, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="دوس على أي شاشة فوق عشان تشوف تفاصيلها" HorizontalAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                </Border>

                <!-- لوحة التفاصيل بعرض كامل -->
                <Border Style="{StaticResource Card}" Margin="0,4,0,14" Padding="18"
                        Visibility="{Binding HasSelectedTopic, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding SelectedTopic.Icon}" Width="22" Height="22"
                                                     VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock Text="{Binding SelectedTopic.Title}" FontSize="17" FontWeight="Bold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedTopic.Description}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" />

                        <!-- ميزات مباشرة — لأي شاشة مالهاش SubTopics -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding SelectedTopic.HasSubTopics, Converter={StaticResource InverseBoolToVis}}">
                            <Button HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Style="{StaticResource GhostButton}" Padding="10,5"
                                    Command="{Binding TryFullTourCommand}"
                                    CommandParameter="{Binding SelectedTopic}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlaylistPlay" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="شغّل كل الميزات بالترتيب" Margin="5,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SelectedTopic.TourSteps}" ItemTemplate="{StaticResource FeatureRow}" />
                        </StackPanel>

                        <!-- تبويبات فرعية — "تسجيل الإنتاج اليومي" بس دلوقتي -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding SelectedTopic.HasSubTopics, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding SelectedTopic.SubTopics}" ItemTemplate="{StaticResource SubTopicCard}" />
                        </StackPanel>

                        <!-- تمارين عملية: وضع تجربة تفاعلي حقيقي، مش مجرد سبوت لايت
                             شرح — بيظهر بس للمواضيع اللي عندها فلو تدريب فعلًا -->
                        <StackPanel Visibility="{Binding SelectedTopic.HasGuidedFlows, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="HandBackRightOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                                <TextBlock Text="تمارين عملية" FontWeight="Bold" FontSize="12.5"
                                           Margin="6,0,0,0" Foreground="{DynamicResource GoldBrush}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedTopic.GuidedFlows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GoldTintBrush}"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Button Style="{StaticResource GoldButton}" Padding="10,5"
                                                            Command="{Binding DataContext.TryGuidedPracticeCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="HandBackRightOutline" Width="13" Height="13"
                                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="جرّبها بنفسك" Margin="4,0,0,0" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="تمرين عملي على بيانات وهمية" FontSize="10"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                                               Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
