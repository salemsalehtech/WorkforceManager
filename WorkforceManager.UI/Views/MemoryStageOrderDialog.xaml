<Window x:Class="WorkforceManager.UI.Views.MemoryStageOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ترتيب مراحل الخطة" Width="480" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- نفس تفاعل WorkerOrderDialog بالظبط (سحب + ▲▼) بفرق واحد جوهري:
         هناك كل حركة بتتحفظ فورًا في قاعدة البيانات، وهنا الترتيب بيتبنى
         في الذاكرة وبيترجّع للمنادي عند "تمام" — لأن الخطة نفسها ممكن
         تكون لسه ما اتحفظتش أصلاً.

         وزيادة: شيلة/إضافة مرحلة. الخطة ممكن تتخطى مراحل عن قصد (قرار
         مؤكد مع المستخدم)، فالترقيم بيتحسب على المراحل المختارة بس. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إلغاء">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="ترتيب مراحل الخطة" Foreground="{DynamicResource SidebarInkBrush}"
                                   FontSize="15.5" FontWeight="Bold" />
                        <TextBlock Foreground="{DynamicResource SidebarInkBrush}" FontSize="12"
                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="اسحب المرحلة لمكانها أو استخدم الزرارين. شيل علامة الصح عن أي مرحلة مش داخلة في الخطة دي" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBgBrush}"
                    CornerRadius="0,0,18,18" Padding="18,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Padding="18,8"
                                IsCancel="True" Content="إلغاء" />
                        <Button Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="8,0,0,0"
                                IsDefault="True" Content="تمام" Click="Confirm_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </DockPanel>
            </Border>

            <Border x:Name="ErrorBox" DockPanel.Dock="Bottom" Background="{DynamicResource DangerBgBrush}"
                    Padding="18,9" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
            </Border>

            <Grid Margin="18,14,18,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="9"
                                        Padding="12,8" Margin="0,0,0,7" Cursor="SizeAll"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Row_PreviewMouseMove"
                                        DragEnter="Row_DragEnter" DragLeave="Row_DragLeave" Drop="Row_Drop">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Padding="3"
                                                    ToolTip="تحريك لفوق" Click="MoveUp_Click">
                                                <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="3" Margin="2,0,0,0"
                                                    ToolTip="تحريك لتحت" Click="MoveDown_Click">
                                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" />
                                            </Button>
                                        </StackPanel>

                                        <!-- الرقم بيختفي للمرحلة المشيلة: مالهاش موقع في خطة مش داخلة فيها -->
                                        <Border DockPanel.Dock="Right" Width="32" Height="28" CornerRadius="13"
                                                VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{DynamicResource ChipBgBrush}"
                                                Visibility="{Binding RankVisibility}">
                                            <TextBlock Text="{Binding Rank}" FontSize="11.5" FontWeight="Bold"
                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrandBrush}" />
                                        </Border>

                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsIncluded}"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"
                                                  ToolTip="داخلة في الخطة دي؟" />

                                        <TextBlock Text="{Binding StageName}" FontSize="13.5" FontWeight="Bold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0"
                                                   Opacity="{Binding NameOpacity}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
