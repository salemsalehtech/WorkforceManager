<Window x:Class="WorkforceManager.UI.Views.DepartmentAccountProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        xmlns:ui="clr-namespace:WorkforceManager.UI"
        Title="بروفايل الحساب"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- بروفايل حساب إداري: حضوره وغيابه + سلفه وحوافزه. للقراءة بس لو
         مش مدير قسم (IsReadOnlyProfile في الشاشة الأم) — أزرار التصحيح
         والإضافة بتتخفي وقتها. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" Click="Close_Click"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <DockPanel VerticalAlignment="Center">
                        <views:WorkerAvatar DockPanel.Dock="Left" Diameter="34"
                                            PhotoData="{Binding PhotoData}" Initials="{Binding Initials}"
                                            Margin="0,0,10,0" />
                        <TextBlock Text="{Binding FullName}"
                                   Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                        <Border Background="{DynamicResource SidebarAltBrush}" CornerRadius="4"
                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoleName}" FontSize="10.5" Foreground="{DynamicResource SidebarInkBrush}" />
                        </Border>
                    </DockPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="18,14,18,16">
                <!-- الحضور والغياب -->
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" x:Name="AddCorrectionButton" Click="AddCorrection_Click"
                            Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarEditOutline" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="تصحيح يوم" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="الحضور والغياب" Style="{StaticResource SectionTitle}" FontSize="13.5" />
                </DockPanel>

                <Border Style="{StaticResource Card}" Padding="0" Height="230">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AttendanceList" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding WorkdaysText}" FontSize="12.5" FontWeight="Bold"
                                                   ui:ThemeBrush.ForegroundKey="{Binding StatusColor}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontSize="11.5" Margin="8,0,0,0"
                                                   ui:ThemeBrush.ForegroundKey="{Binding StatusColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DateText}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- السلف والحوافز -->
                <DockPanel Margin="0,16,0,8">
                    <Button DockPanel.Dock="Left" x:Name="AddAdjustmentButton" Click="AddAdjustment_Click"
                            Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="إضافة" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="السلف والحوافز" Style="{StaticResource SectionTitle}" FontSize="13.5" />
                </DockPanel>

                <!-- فورم الإضافة السريع: مطويّة، بتظهر بس لما تدوس "إضافة" -->
                <Border x:Name="AddAdjustmentPanel" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox x:Name="AdjustmentTypeBox" Width="90" FontSize="12.5"
                                      DisplayMemberPath="Display" SelectedValuePath="Type" />
                            <TextBlock Text="المبلغ:" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox x:Name="AdjustmentAmountBox" Width="90" FontSize="12.5" Margin="6,0,0,0" />
                            <TextBlock Text="البيان:" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox x:Name="AdjustmentNoteBox" Width="160" FontSize="12.5" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="AdjustmentErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                                   Margin="0,0,0,6" Visibility="Collapsed" TextWrapping="Wrap" />
                        <Button Content="حفظ" Click="SaveAdjustment_Click" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}" Padding="18,5" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" Height="150">
                    <Grid>
                        <TextBlock x:Name="NoAdjustmentsText" Text="مفيش سلف أو حوافز مسجّلة"
                                   FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AdjustmentsList" Margin="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Padding="5,3"
                                                    Click="RemoveAdjustment_Click" Tag="{Binding AdjustmentId}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding AmountText}" FontSize="12.5" FontWeight="Bold"
                                                       ui:ThemeBrush.ForegroundKey="{Binding TypeColor}" Margin="0,0,8,0" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding TypeName}" FontSize="11.5"
                                                       ui:ThemeBrush.ForegroundKey="{Binding TypeColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DateAndNote}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
