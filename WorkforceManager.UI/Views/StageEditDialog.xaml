<views:ChromelessDialogWindow x:Class="WorkforceManager.UI.Views.StageEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="إضافة مرحلة جديدة"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <views:ChromelessDialogWindow.HeaderContent>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
    </views:ChromelessDialogWindow.HeaderContent>

    <!-- نافذة إضافة/تعديل مرحلة تصنيع بيوميتها -->
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="اسم المرحلة (إجباري)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <TextBlock Text="اليومية: عدد القطع اللي بتساوي يومية عمل كاملة (إجباري)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="QuotaBox" Margin="0,0,0,4" />
        <!-- تنبيه مهم: تعديل اليومية مش بيأثر على السجلات القديمة (محمية بالـ Snapshot) -->
        <TextBlock Text="ملحوظة: تعديل اليومية يسري على التسجيلات الجديدة فقط — الحسابات القديمة محفوظة زي ما كانت."
                   FontSize="11.5" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="الترتيب داخل خط الإنتاج (اختياري — بياخد آخر ترتيب تلقائيًا)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="SortOrderBox" Margin="0,0,0,16" />

        <TextBlock Text="معامل صعوبة المرحلة (١ = عادي — اكتب رقم أعلى للمراحل الصعبة/الدقيقة)"
                   Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DifficultyBox" Text="1.0" Margin="0,0,0,4" />
        <!-- بيوضّح إن ده مالوش علاقة بالأجر أو الإنتاج الحقيقي -->
        <TextBlock Text="بيُستخدم بس في حساب ترتيب &quot;أحسن عامل&quot; — العدد الحقيقي والأجر مايتأثروش خالص."
                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                   Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
        </StackPanel>
    </StackPanel>
</views:ChromelessDialogWindow>
