<Window x:Class="WorkforceManager.UI.Views.MonthlyPlanSnapshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="لقطة محفوظة" Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- عرض بس — "لقطة نهاية اليوم" حفظ + قايمة، مفيش مقارنة تلقائية دلوقتي، شوف CLAUDE.md -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="HeaderText" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <ScrollViewer MaxHeight="440" Margin="18,16,18,16" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,9">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding EffectiveAchieved, Mode=OneWay}" /><Run Text=" من" />
                                        <Run Text="{Binding PlannedQuantity, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
