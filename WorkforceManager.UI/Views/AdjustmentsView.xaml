<UserControl x:Class="WorkforceManager.UI.Views.AdjustmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <!-- السلف والحوافز — كانت تبويب في التسجيل اليومي، بقت تبويب في إدارة العمال. نفس DailyEntryViewModel بالظبط. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:EntryDateBar Grid.Row="0" />
                <Grid Grid.Row="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- فورم تسجيل سلفة/حافز جديد -->
                    <Border Grid.Row="0" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="تسجيل سلفة أو حافز (بالجنيه)" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandBrush}" Margin="0,0,0,8" />
                            <!-- نفس ترتيب فورم الجزاء: الخانات صف 0، خطأ كل خانة تحتها صف 1 -->
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="العامل:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <views:WorkerSearchBox Grid.Column="1" Workers="{Binding AttendanceRows}"
                                                       SelectedWorker="{Binding AdjustmentWorker, Mode=TwoWay}"
                                                       Placeholder="دوّر على العامل بالاسم…"
                                                       Width="200" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="النوع:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding AdjustmentTypeOptions}" SelectedItem="{Binding SelectedAdjustmentType}"
                                          DisplayMemberPath="Display" Width="110" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="4" Text="المبلغ:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="5" Text="{Binding AdjustmentAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="110" Padding="8,6" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="ج" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Bold"  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <views:FieldError Grid.Row="1" Grid.Column="1" MaxWidth="200" Message="{Binding AdjustmentWorkerError}" />
                                <views:FieldError Grid.Row="1" Grid.Column="3" MaxWidth="160" Message="{Binding AdjustmentTypeError}" />
                                <views:FieldError Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" MaxWidth="180" Message="{Binding AdjustmentAmountError}" />
                            </Grid>
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="AddAdjustmentButton" DockPanel.Dock="Left" Command="{Binding AddAdjustmentCommand}"
                                        Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="تسجيل" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="البيان:" VerticalAlignment="Center" Margin="12,0,6,0" DockPanel.Dock="Left" />
                                <!-- بيان الحركة اختياري: سلفة نص الشهر، مكافأة تارجت، ... -->
                                <TextBox Text="{Binding AdjustmentNote, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintText}" FontSize="11.5" Margin="0,8,0,0"
                                       Text="السلفة بتتخصم من أجر العامل في كشف الفترة، والحافز بيتزاد. النوع بيحدد الاتجاه — المبلغ دايمًا موجب." />
                        </StackPanel>
                    </Border>

                    <!-- حركات اليوم المسجلة -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="سلف وحوافز اليوم المسجلة" Style="{StaticResource SectionTitle}" Margin="4,0,4,6" />
                        <DataGrid x:Name="AdjustmentsGrid" Grid.Row="1" ItemsSource="{Binding DayAdjustments}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العامل" Binding="{Binding WorkerName}" Width="Auto" MinWidth="150" />
                                <!-- النوع بلونه: سلفة حمرا، حافز أخضر -->
                                <DataGridTemplateColumn Header="النوع" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeName}" ui:ThemeBrush.ForegroundKey="{Binding TypeColor}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="110" />
                                <DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="2*" />
                                <!-- أيقونة بس من غير نص — زي عمود "سجلات اليوم"، شوف تعليقه في تبويب الجزاءات -->
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerBrush}"
                                                    ToolTip="حذف الحركة"
                                                    Command="{Binding DataContext.RemoveAdjustmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>
