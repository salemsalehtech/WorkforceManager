<views:ChromelessDialogWindow x:Class="WorkforceManager.UI.Views.DailySignOffSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="مراجعة قبل التوقيع" Width="560" SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <views:ChromelessDialogWindow.HeaderContent>
        <StackPanel>
            <TextBlock Text="حفظ نهائي — توقيع نهاية اليوم" Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
            <TextBlock x:Name="DateText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>
    </views:ChromelessDialogWindow.HeaderContent>

    <!-- آخر خطوة قبل توقيع اليوم — المستخدم بيراجع كل حاجة حصلت
         النهارده قبل ما يوافق -->
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="CountText" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"  Foreground="{DynamicResource TextPrimaryBrush}"/>

        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EventsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="8"
                                Padding="10,8" Margin="0,0,0,5">
                            <DockPanel>
                                <materialDesign:PackIcon DockPanel.Dock="Right" Width="18" Height="18"
                                                          VerticalAlignment="Top" Margin="8,2,0,0"
                                                          Kind="{Binding EventIcon}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding EventText}" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding EntityName}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Details}" FontSize="10.5" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="NothingHappened" Background="{DynamicResource SuccessBgBrush}" CornerRadius="8"
                Padding="12,10" Visibility="Collapsed">
            <TextBlock Text="مفيش أي عمليات اتسجلت النهارده — التوقيع بيقفل اليوم برضه."
                       FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource SuccessBrush}" />
        </Border>

        <TextBlock Text="التوقيع بيقفل اليوم للتطبيق كله — بعده مش هيفضل فيه أي عملية محتاجة توقيع."
                   FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextMutedBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Style="{StaticResource GhostButton}" Padding="16,8" IsCancel="True" Content="ارجع للتعديل" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Padding="16,8"
                    Margin="8,0,0,0" IsDefault="True" Click="Confirm_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="أكّد ووقّع اليوم" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</views:ChromelessDialogWindow>
