<UserControl x:Class="WorkforceManager.UI.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">

    <!--
      الإحصائيات: كل التحليل/المقارنات اللي كانت على شاشة الخطة الشهرية
      قبل كده (البند رقم كذا في إعادة التصميم) — رسم إنتاج الشهر، مقارنة
      كل منتج بنفس اليوم من الشهر اللي فات، تفاصيل وزن كل عيلة. بتقرأ نفس
      بيانات MonthlyPlanTrackingService، مفيش حساب مختلف هنا. شوف CLAUDE.md.
    -->
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource IconButton}" Padding="8">
                <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
            </Button>
            <TextBlock Text="{Binding MonthLabel}" FontSize="16" FontWeight="Bold" Margin="10,0"
                       VerticalAlignment="Center" MinWidth="130" TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Command="{Binding NextMonthCommand}" Style="{StaticResource IconButton}" Padding="8">
                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ═══════════ رسم إنتاج الشهر ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="إنتاج الشهر يوم بيوم" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <views:ProductOutputChart MinHeight="220" FillWidth="True" PlotAreaHeight="162"
                                                  Buckets="{Binding ChartBuckets}" HasData="{Binding ChartHasData}" />
                    </StackPanel>
                </Border>

                <!-- ═══════════ وزن كل عيلة ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding HasFamilyWeights, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="إجمالي وزن المحقق لكل عيلة" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding FamilyWeights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatisticsFamilyWeightRow}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding TotalWeightKg, StringFormat='{}{0:N1} كجم'}"
                                                   FontWeight="Bold" Foreground="{DynamicResource GoldDeepBrush}" />
                                        <TextBlock Text="{Binding FamilyName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══════════ مقارنة كل منتج بنفس اليوم من الشهر اللي فات ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="مقارنة بنفس اليوم من الشهر اللي فات" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ProductComparisons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatisticsProductRow}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding EffectiveAchieved}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ComparisonText}" FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
