<UserControl x:Class="WorkforceManager.UI.Views.HubLandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- صفحة الكروت: بتظهر أول ما تدخل شاشة فيها أكتر من صفحة (إدارة العمال، تسجيل الإنتاج اليومي،
         الإعدادات) بدل شريط تبويبات فوق. كارت لكل صفحة؛ الدوسة بتفتحها (CardChosen). -->
    <UserControl.Resources>
        <!-- الرقم الحي: بيختفي لو فاضي (لسه بيتحمّل أو الصفحة مالهاش رقم) -->
        <Style x:Key="CardStat" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource GoldDeepBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,14">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="6,0,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource HintText}" Margin="6,2,0,10" TextWrapping="Wrap" />

            <ItemsControl x:Name="CardsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="6" Width="270" MinHeight="150"
                                Click="Card_Click" AutomationProperties.Name="{Binding Title}">
                            <Border Style="{StaticResource Card}" Padding="18,16">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="28" Height="28"
                                                             Foreground="{DynamicResource GoldBrush}" />
                                    <TextBlock Text="{Binding Title}" Margin="0,10,0,0" FontWeight="Bold"
                                               FontSize="{DynamicResource FontBase}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               FontSize="{DynamicResource FontTiny}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StatText}" Style="{StaticResource CardStat}" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
