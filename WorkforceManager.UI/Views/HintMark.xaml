<UserControl x:Class="WorkforceManager.UI.Views.HintMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root">

    <!--
      علامة ؟ صغيرة جنب أي رقم أو حقل محتاج شرح.

      البرنامج مليان أرقام محسوبة (صافي اليوميات، القطع التامة، الشغل
      الواقف) — والمستخدم شايف الرقم ومش شايف إزاي اتحسب. العلامة دي
      بتحط الشرح **جنب الرقم نفسه** بدل ما يبقى في دليل حد يقراه.

      صغيرة وباهتة عن قصد: موجودة لما تحتاجها، ومش بتزاحم الرقم.
      استخدامها:  <views:HintMark Text="صافي اليوميات = المنتج − الغياب − الجزاءات" />
    -->
    <Border x:Name="Chip" Width="15" Height="15" CornerRadius="7.5"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            Cursor="Help" VerticalAlignment="Center"
            ToolTipService.InitialShowDelay="150"
            ToolTipService.ShowDuration="30000">

        <Border.ToolTip>
            <ToolTip Background="Transparent" BorderThickness="0" Padding="0"
                     HasDropShadow="False">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource GoldLineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,9" MaxWidth="300">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                          Opacity="0.18" Color="{DynamicResource ShadowColor}" />
                    </Border.Effect>
                    <TextBlock Text="{Binding Text, ElementName=Root}"
                               FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource InkBrush}" />
                </Border>
            </ToolTip>
        </Border.ToolTip>

        <TextBlock Text="؟" FontSize="10.5" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource InkFaintBrush}" />

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- بتتلوّن دهبي وانت واقف عليها — بتقول "أنا هنا" -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GoldTintBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>
