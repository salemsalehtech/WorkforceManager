<UserControl x:Class="WorkforceManager.UI.Views.PlanPeriodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkforceManager.UI.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <!--
      خطة بفترة مخصصة: تخطيط بس (مفيش تتبّع/محقق هنا، شوف CLAUDE.md).
        1. شريط علوي: اختيار فترة + فترة جديدة + انسخ الفترة اللي فاتت + الإجمالي
        2. الجدول الرئيسي مجمّع بالعيلة — خطة العيلة دايمًا SUM محسوب
    -->
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ 1. الشريط العلوي ═══════════ -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                <TextBlock Text="الفترة:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" />
                <ComboBox x:Name="PeriodCombo" ItemsSource="{Binding Periods}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedPeriod}" MinWidth="240"
                          SelectionChanged="PeriodCombo_SelectionChanged" />
            </StackPanel>

            <Button Command="{Binding NewPeriodCommand}" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Padding="14,9" Margin="0,0,16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarPlus" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="فترة جديدة" Margin="6,0,0,0" />
                </StackPanel>
            </Button>

            <Button Command="{Binding CopyFromPreviousPeriodCommand}" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Padding="14,9" Margin="0,0,16,8"
                    Visibility="{Binding HasPeriods, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="انسخ خطة الفترة اللي فاتت" Margin="6,0,0,0" />
                </StackPanel>
            </Button>

            <StackPanel Style="{StaticResource SummaryStat}" Margin="0,0,16,8">
                <TextBlock Text="{Binding GrandTotalPlan, StringFormat=N0}" Style="{StaticResource SummaryNumber}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="إجمالي المخطط" Style="{StaticResource SummaryLabel}" />
            </StackPanel>
        </WrapPanel>

        <!-- مفيش ولا فترة اتعملت لسه -->
        <TextBlock Grid.Row="1" Text="مفيش فترات متعملة لسه — دوس &quot;فترة جديدة&quot; عشان تبدأ"
                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0"
                   Visibility="{Binding HasPeriods, Converter={StaticResource InverseBoolToVis}}" />

        <!-- ═══════════ 2. الجدول الرئيسي — مجمّع بالعيلة ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasPeriods, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding FamilyGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlanPeriodFamilyGroupRow}">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="2,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource GoldDeepBrush}">
                                        <Run Text="مجموع الخطة:" /><Run Text="{Binding Subtotal, Mode=OneWay, StringFormat=N0}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionTitle}" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlanPeriodProductRow}">
                                            <Border Margin="0,0,0,8" Padding="14,11">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <TextBox Name="QuantityBox" DockPanel.Dock="Left"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="90" TextAlignment="Center" Tag="{Binding}"
                                                             LostFocus="QuantityBox_LostFocus" ToolTip="الكمية المخططة" />

                                                    <DockPanel VerticalAlignment="Center">
                                                        <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AlertOutline" Width="14" Height="14"
                                                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource WarnBrush}"
                                                                                 ToolTip="ناقصه وزن القطعة أو المادة"
                                                                                 Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVis}}" />
                                                        <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </DockPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
