<Window x:Class="WorkforceManager.UI.Views.PlanPeriodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="فترة جديدة" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- إنشاء فترة خطة مخصصة (start/end) — بديل موازي للخطة الشهرية، شوف
         PlanPeriodViewModel/CLAUDE.md. عدد أيام الشغل بيتحسب مباشرة هنا
         (نفس WorkCalendarRules اللي بيستخدمها PlanPeriodService.CreatePeriodAsync)
         عشان المستخدم يشوف الرقم قبل الحفظ. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="فترة جديدة" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="22,20,22,20">
                <TextBlock Text="من" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="StartDatePicker" Margin="0,0,0,12"
                            SelectedDateChanged="DatePicker_SelectedDateChanged" />

                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="EndDatePicker" Margin="0,0,0,12"
                            SelectedDateChanged="DatePicker_SelectedDateChanged" />

                <Border x:Name="PreviewBox" Background="{DynamicResource GoldTintBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="PreviewText" Foreground="{DynamicResource GoldDeepBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
