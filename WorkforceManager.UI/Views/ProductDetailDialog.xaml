<Window x:Class="WorkforceManager.UI.Views.ProductDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="تفاصيل المنتج" Width="820" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- تفاصيل منتج واحد (هيدر + أزرار الإدارة + خط الإنتاج) — نفس المحتوى
         اللي كان "لوحة تفاصيل" تحت شبكة الكروت في ProductsView بالظبط، منقول
         هنا Modal بناءً على طلب المستخدم (يفتح مباشرة عند الدوسة على الكارت
         بدل ما ينزل تحت الشبكة). الـ DataContext نفس ProductsViewModel
         المشترك — بيتظبط من ProductsView.xaml.cs وقت الفتح، مش نسخة تانية،
         عشان كل الأوامر (تعديل/حذف/مراحل...) تفضل شغالة زي ما هي من غير أي
         تغيير في الـ ViewModel. الـ 6 أوامر بتاعة المراحل هنا كانت
         RelativeSource AncestorType=UserControl وقت ما كانت جوه
         ProductsView مباشرة — اتحولت لـ AncestorType=Window عشان دلوقتي
         بقت جوه Window مش UserControl. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="{Binding SelectedProduct.Name}"
                               Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <Grid Margin="18,16,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- رأس المنتج + أزرار الإدارة -->
                <StackPanel Grid.Row="0">
                    <DockPanel>
                        <!-- صورة المنتج أكبر شوية هنا (بتظهر بس لو موجودة) -->
                        <Border DockPanel.Dock="Left"
                                Width="64"
                                Height="64"
                                CornerRadius="14"
                                Background="{DynamicResource SubtleBgBrush}"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top"
                                Visibility="{Binding SelectedProduct.HasImage, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding SelectedProduct.Image}"
                                    Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64"
                                            RadiusX="13"
                                            RadiusY="13"/>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProduct.Name}"
                                    Style="{StaticResource HeadingText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedProduct.Description}"
                                    FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                    Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- WrapPanel مش StackPanel أفقي: عمود التفاصيل
                         ثابت على 500px، والخمس أزرار دول محتاجين
                         ~587px لما "إضافة مرحلة الرص" تبان (منتج لسه
                         مالوش مرحلة رص). الـ StackPanel الأفقي مبيلفّش
                         ومبيضغطش — كان بيقص الزرار الدهبي الأخير عند
                         حرف البطاقة من غير أي علامة. الـ 6 السفلية على
                         كل زرار عشان السطرين ميلزقوش لما الصف يلف -->
                    <WrapPanel Margin="0,8,0,4">
                        <Button Command="{Binding EditProductCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,6"
                                Command="{Binding ToggleProductActiveCommand}">
                            <Button.Style>
                                <Style TargetType="Button"
                                        BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PackageVariantRemove"
                                                        Width="14"
                                                        Height="14"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="إيقاف المنتج"
                                                        Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProduct.IsActive}"
                                                Value="False">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Restore"
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Text="إعادة تفعيل"
                                                                Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- الحذف غير الإيقاف: بيمر على كلمة سر العمليات وبيتسجّل -->
                        <Button Command="{Binding DeleteProductCommand}"
                                Margin="0,0,6,6"
                                Style="{StaticResource GhostButton}"
                                Foreground="{DynamicResource DangerBrush}"
                                ToolTip="شيل المنتج من النظام نهائيًا — سجلات إنتاجه القديمة بتفضل محفوظة">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="حذف"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- مرة واحدة بس لكل منتج — بتختفي بعد ما تتضاف -->
                        <Button x:Name="AddRackingStageButton" Command="{Binding AddRackingStageCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,6,6"
                                Visibility="{Binding SelectedProduct.HasRackingStage, Converter={StaticResource InverseBoolToVis}}"
                                ToolTip="مرحلة آخر الخط لعامل الرص — من غير يومية ومن غير قطع في التسجيل">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة مرحلة الرص"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AddStageButton" Command="{Binding AddStageCommand}"
                                Style="{StaticResource SuccessButton}"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus"
                                        Width="15"
                                        Height="15"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة مرحلة"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <DockPanel x:Name="ProductionLineHeader" Grid.Row="1"
                        Margin="0,0,0,6">
                    <TextBlock Text="خط الإنتاج"
                            FontWeight="Bold"
                            VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="الترتيب مهم — نطاقات التسجيل بتتحسب بيه"
                            FontSize="11"
                               VerticalAlignment="Center"
                            Margin="10,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </DockPanel>

                <!-- خط الإنتاج: مرحلة تحت التانية بترتيبها الفعلي -->
                <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- رسالة لما المنتج لسه من غير مراحل -->
                        <Border x:Name="NoStagesWarning" Background="{DynamicResource WarnBgBrush}"
                                CornerRadius="10"
                                Padding="14,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stages.Count}"
                                                Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOutline"
                                        Width="18"
                                        Height="18"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource WarnBrush}"/>
                                <TextBlock Text="المنتج ده لسه من غير مراحل — ضيف مرحلة عشان ينفع يتسجل عليه إنتاج"
                                           FontSize="12.5"
                                        Margin="8,0,0,0"
                                        TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource WarnBrush}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ProductStagesList" ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource WorkerCard}"
                                            Margin="0,0,0,6"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- أزرار ترتيب المرحلة في الخط -->
                                            <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <Button Style="{StaticResource IconButton}"
                                                        Padding="3"
                                                        ToolTip="تحريك لفوق في الخط"
                                                        Command="{Binding DataContext.MoveStageUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="ChevronUp"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{DynamicResource GoldBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Padding="3"
                                                        ToolTip="تحريك لتحت في الخط"
                                                        Command="{Binding DataContext.MoveStageDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="ChevronDown"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{DynamicResource GoldBrush}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- رقم المرحلة في الخط.
                                                 كانت BrandBrush (= InkColor، بتتقلب مع الثيم) كخلفية
                                                 مع SidebarInkBrush (فاتحة في الثيمين، مخصوصة للسايدبار
                                                 الغامق دايمًا) كنص — في الثيم الأسود الاتنين بيبقوا فاتحين
                                                 قريبين من بعض فالرقم بيختفي. GoldBrush/InkOnAccentBrush
                                                 هو الزوج المضمون تباينه في الثيمين (نفس زرار Primary). -->
                                            <Border Grid.Column="1"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="16"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource GoldBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                    Value="False">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SurfaceAltBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DisplayOrder}"
                                                        FontSize="13.5"
                                                        FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource InkOnAccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                        Value="False">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- اسم المرحلة + اليومية + العمال المؤهلين -->
                                            <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StageName}"
                                                            FontSize="13.5"
                                                            FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                            TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Background="{DynamicResource DangerBgBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                            Value="False">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="موقوفة"
                                                                FontSize="10.5"
                                                                FontWeight="Medium"
                                                                   Foreground="{DynamicResource DangerBrush}"/>
                                                    </Border>

                                                    <!-- مرحلة إدارية برّه خط الإنتاج — شوف ProductionStage.IsRackingStage -->
                                                    <Border Background="{DynamicResource InfoTintBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsRackingStage, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="رص"
                                                                FontSize="10.5"
                                                                FontWeight="Medium"
                                                                   Foreground="{DynamicResource InfoBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                        Margin="0,4,0,0">
                                                    <materialDesign:PackIcon Kind="Speedometer"
                                                            Width="13"
                                                            Height="13"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding QuotaText}"
                                                            FontSize="11.5"
                                                            Margin="4,0,14,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>

                                                    <!-- عدد المؤهلين: بيتلون تحذير لو صفر. مش موجود خالص
                                                         لمرحلة الرص — التأهيل هناك بدور العامل (HourlyRole)
                                                         مش بربط مهارة، فـ"مفيش عمال مؤهلين" هنا معناها غلط:
                                                         عمال الرص فعلاً بيشتغلوا عليها بس بطريقة مختلفة -->
                                                    <materialDesign:PackIcon Kind="AccountGroupOutline"
                                                            Width="13"
                                                            Height="13"
                                                                             VerticalAlignment="Center"
                                                                             Visibility="{Binding IsRackingStage, Converter={StaticResource InverseBoolToVis}}">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNoQualifiedWorkers}"
                                                                            Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource WarnBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock Text="{Binding WorkersText}"
                                                            FontSize="11.5"
                                                            Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsRackingStage, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNoQualifiedWorkers}"
                                                                            Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource WarnBrush}"/>
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- بيبان بس لو معامل الصعوبة مختلف عن العادي — للترتيب الأسبوعي/الشهري بس -->
                                                    <materialDesign:PackIcon Kind="WeightLifter"
                                                            Width="13"
                                                            Height="13"
                                                                             Margin="14,0,0,0"
                                                            VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                                             Visibility="{Binding HasCustomDifficulty, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding DifficultyText}"
                                                            FontSize="11.5"
                                                            Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Visibility="{Binding HasCustomDifficulty, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- مين مؤهل / تعديل / إيقاف -->
                                            <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                                <!-- بيفتح قايمة المؤهلين بتقييماتهم — نفس ترتيب شاشة التسجيل.
                                                     مش موجود لمرحلة الرص: التأهيل هناك بدور العامل مش بربط
                                                     مهارة، فالقايمة هتفضل فاضية دايمًا برغم إن عمال الرص
                                                     فعلاً بيشتغلوا عليها -->
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="مين يعرف يعمل المرحلة دي؟"
                                                        Visibility="{Binding IsRackingStage, Converter={StaticResource InverseBoolToVis}}"
                                                        Command="{Binding DataContext.ShowQualifiedWorkersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="AccountSearchOutline"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{DynamicResource GoldBrush}"/>
                                                </Button>
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="تعديل المرحلة"
                                                        Command="{Binding DataContext.EditStageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="PencilOutline"
                                                            Width="14"
                                                            Height="14"
                                                            Foreground="{DynamicResource GoldBrush}"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.ToggleStageActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                                BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource GoldBrush}"/>
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <materialDesign:PackIcon Kind="PauseCircleOutline"
                                                                            Width="14"
                                                                            Height="14"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="ToolTip"
                                                                    Value="إيقاف المرحلة"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                        Value="False">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <materialDesign:PackIcon Kind="Restore"
                                                                                    Width="14"
                                                                                    Height="14"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="ToolTip"
                                                                            Value="إعادة تفعيل"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- حذف المرحلة: بكلمة سر وسبب مسجّلين -->
                                                <Button Command="{Binding DataContext.DeleteStageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButton}"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        ToolTip="حذف المرحلة نهائيًا">
                                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                            Width="14"
                                                            Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
