<views:ChromelessDialogWindow x:Class="WorkforceManager.UI.Views.PenaltyEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkforceManager.UI.Views"
        Title="تعديل جزاء" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        HeaderBrush="{DynamicResource DangerBrush}"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <views:ChromelessDialogWindow.HeaderContent>
        <StackPanel>
            <TextBlock Text="تعديل جزاء" Foreground="{DynamicResource SidebarInkBrush}" FontSize="15.5" FontWeight="Bold" />
            <TextBlock x:Name="WorkerText" Foreground="{DynamicResource SidebarInkBrush}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>
    </views:ChromelessDialogWindow.HeaderContent>

    <!-- تعديل سبب الجزاء وخصمه. الجزاءات التلقائية بترفضها الخدمة نفسها،
         فالنافذة دي مش محتاجة تعرف الفرق. -->
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="سبب الجزاء" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ReasonBox" Margin="0,0,0,14" Padding="8,6"
                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock Text="الخصم" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="DeductionBox" Margin="0,0,0,14"
                  DisplayMemberPath="Display" SelectedValuePath="Value" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                   Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حفظ" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
        </StackPanel>
    </StackPanel>
</views:ChromelessDialogWindow>
