<UserControl x:Class="WorkforceManager.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <!--
      ═══════════ شاشة الرئيسية ═══════════

      أول شاشة بعد تسجيل الدخول، وبيرجعلها المستخدم من عنصر تنقّل
      "الرئيسية" في أي وقت. كل رقم هنا نسخة عرض من HomeSummaryDto —
      مفيش حساب جديد هنا، شوف HomeViewModel/HomeSummaryService.

      ScrollViewer + MaxWidth عشان الشاشة تتدهور كويس عند 900×560
      (أقل مقاس مدعوم) من غير ما المحتوى يتمدد لعرض غير مريح على
      شاشة واسعة.

      الكروت التلاتة وزرار الفعل الرئيسي بيبدأوا Opacity="0" مع
      RenderTransform انزياح لتحت — الحالة دي بتتشال بحركة متدرجة
      (AnimateCardsIn جوّه HomeView.xaml.cs) بعد ما LoadAsync يخلص،
      مش قبلها، عشان المستخدم مايشوفش كروت فاضية بتتحرك.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Stretch">

            <!-- ═══════════ ترحيب ═══════════ -->
            <TextBlock Text="مرحبًا" Style="{DynamicResource Title}" />
            <TextBlock Text="{Binding WeekRangeText}" Style="{DynamicResource Muted}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding DaysLeftInWeekText}" Style="{DynamicResource Muted}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding MotivationalMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                       FontSize="{DynamicResource FontBase}" FontWeight="SemiBold"
                       Foreground="{DynamicResource GoldDeepBrush}" />

            <!-- ═══════════ ملخص الأسبوع ═══════════
                 WrapPanel مش StackPanel أفقي — عدد البنود بقى متغيّر (لغاية
                 5 بنود لو أكتر منتج ونسبة الحضور ظاهرين مع بعض)، وStackPanel
                 أفقي كان هيقصّ أي بند زايد صامت عند 900px من غير أي تنبيه
                 (نفس مشكلة شاشة المنتجات الموثّقة في CLAUDE.md). -->
            <Border x:Name="WeeklyStatsCard" Style="{StaticResource Card}" Margin="0,18,0,0"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="14" />
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="18" Height="18"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                        <TextBlock Text="ملخص الأسبوع" Margin="8,0,0,0" FontWeight="Bold" FontSize="15.5"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <WrapPanel Margin="0,12,0,-8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                                <Run x:Name="TotalPiecesRun" Text="0" FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" قطعة الأسبوع ده" />
                            </TextBlock>
                            <!-- نسبة التغيير عن الأسبوع اللي فات — مختفية لو الأسبوع اللي
                                 فات كان صفر (النسبة مش معرّفة رياضيًا وقتها) -->
                            <Border CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasPieceComparison, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PieceChangeIsPositive}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PieceChangeDisplayText, Mode=OneWay}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PieceChangeIsPositive}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                                <Run x:Name="ActiveWorkersRun" Text="0" FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" عامل نشط" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                                <Run x:Name="NetWorkdaysRun" Text="0" FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" يومية معتمدة" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8"
                                    Visibility="{Binding HasTopProduct, Converter={StaticResource BoolToVis}}">
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                                <Run Text="أكتر منتج: " /><Run Text="{Binding TopProductName, Mode=OneWay}" FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" /><Run
                                    Text="{Binding TopProductPieces, Mode=OneWay, StringFormat=' ({0} قطعة)'}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8"
                                    Visibility="{Binding HasAttendanceRate, Converter={StaticResource BoolToVis}}">
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Muted}">
                                <Run Text="نسبة الحضور " /><Run x:Name="AttendanceRateRun" Text="0" FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════ أفضل عامل الأسبوع ═══════════
                 رقم 1 بس بشكل بارز (مش تلات بطاقات زي شاشة العمال) —
                 قرار مؤكد مع المستخدم وقت التخطيط. -->
            <Border x:Name="BestWorkerCard" Style="{StaticResource Card}" Margin="0,12,0,0"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="14" />
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="TrophyIcon" Kind="TrophyOutline" Width="18" Height="18"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}"
                                                 RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <ScaleTransform />
                            </materialDesign:PackIcon.RenderTransform>
                        </materialDesign:PackIcon>
                        <TextBlock Text="أفضل عامل الأسبوع" Margin="8,0,0,0" FontWeight="Bold" FontSize="15.5"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                Visibility="{Binding HasBestWorker, Converter={StaticResource BoolToVis}}">
                        <views:WorkerAvatar Diameter="46" Initials="{Binding BestWorkerInitials}"
                                            VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BestWorkerName}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource SidebarInkBrush}" />
                    </StackPanel>

                    <TextBlock Text="لسه مفيش نجم للأسبوع ده — سجّل إنتاج كام يوم وهيبان هنا"
                               Margin="0,14,0,0" TextWrapping="Wrap" Style="{DynamicResource Muted}"
                               Visibility="{Binding HasBestWorker, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ═══════════ محتاج انتباهك ═══════════
                 بندين بس (أرصدة قديمة، خطط مستحقة) — قرار مؤكد مع
                 المستخدم؛ "أيام غير موقّعة" مستبعد عمدًا لأن الديالوج
                 الإجباري عند الدخول بيغطيها أصلاً. -->
            <Border x:Name="AttentionCard" Style="{StaticResource Card}" Margin="0,12,0,0"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="14" />
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}" />
                        <TextBlock Text="محتاج انتباهك" Margin="8,0,0,0" FontWeight="Bold" FontSize="15.5"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding HasAnyAttentionItems, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding HasStaleBalances, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button x:Name="GoToStaleBalancesButton" DockPanel.Dock="Left"
                                        Style="{DynamicResource GhostButton}" Click="GoToProducts_Click"
                                        Content="اعرضها" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarnBrush}">
                                    <Run Text="{Binding StaleBalanceCount, Mode=OneWay}" FontWeight="Bold" /><Run
                                        Text=" رصيد أولي فاتح من أكتر من أسبوع" />
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="8" Padding="10,8"
                                Visibility="{Binding HasDueMemories, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button x:Name="GoToDueMemoriesButton" DockPanel.Dock="Left"
                                        Style="{DynamicResource GhostButton}" Click="GoToMemory_Click"
                                        Content="اعرضها" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarnBrush}">
                                    <Run Text="{Binding DueMemoriesCount, Mode=OneWay}" FontWeight="Bold" /><Run
                                        Text=" خطة إنتاج مستحقة" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="كل حاجة مظبوطة، مفيش حاجة محتاجة متابعة دلوقتي"
                               Margin="0,12,0,0" Style="{DynamicResource Muted}"
                               Visibility="{Binding HasAnyAttentionItems, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ═══════════ الفعل الرئيسي ═══════════
                 تكبير خفيف عند المرور (نفس فكرة تكبير عناصر القايمة
                 الجانبية) — إشارة بصرية إضافية إن الزرار ده هو الفعل
                 المتوقّع، مش بس لونه الدهبي. -->
            <Button x:Name="StartProductionDayButton" Click="StartProductionDay_Click"
                    HorizontalAlignment="Stretch"
                    Margin="0,20,0,0" Padding="18,15"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="14" />
                        <ScaleTransform />
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Style>
                    <!-- Storyboard.TargetName مش مسموح جوّه Style.Triggers (MC4011) —
                         بديله المعتمد في WPF: من غير TargetName (يستهدف العنصر
                         نفسه بشكل افتراضي) مع TargetProperty مركّب يوصل
                         لـScaleTransform التاني جوّه TransformGroup -->
                    <Style TargetType="Button" BasedOn="{StaticResource GoldButton}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)"
                                                To="1.03" Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)"
                                                To="1.03" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="20" Height="20"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="بداية إنتاج يوم جديد" Margin="8,0,0,0"
                               FontSize="{DynamicResource FontLarge}" FontWeight="Bold" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
