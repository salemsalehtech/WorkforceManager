<UserControl x:Class="WorkforceManager.UI.Views.PasswordEntryBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root" Padding="10,8">

    <!--
      PasswordBox عادي بالظبط (بيرث شكل الـStyle الضمني بتاع PasswordBox
      في Core.xaml — بس هنا مرسوم على Border الأب مش على الصندوق نفسه،
      شوف تحت)، زائد أيقونة "عين" جوّه نفس الحقل بتكشف كلمة المرور مؤقتًا
      زي أي موقع. WPF's PasswordBox مالوش خاصية Visible خالص (أمان)،
      فالحل الوحيد كود-behind هو TextBox تاني بيتبادل الظهور معاه،
      ومحتواهم متزامن مع بعض في الكود.

      **حقل واحد بصريًا، مش عمودين منفصلين**: الـBorder الخارجي هو اللي
      بيرسم الشكل (خلفية/حدود/زوايا مدوّرة، نفس الـStyle الضمني بالظبط)،
      والصندوقين جواه بلا حدود ولا خلفية خاصة بيهم (Transparent/0) عشان
      يبانوا حتة واحدة مع الأيقونة، مش حقل جوه حقل.

      Padding/FontSize بتتوصّل للصندوقين صراحة عن طريق Binding لـRoot —
      Setter بتاع الـStyle الضمني كان هياخد أولوية على أي حاجة موروثة.

      **الأيقونة في العمود التاني (index 1) عشان تتحط أقصى يسار الحقل
      فعليًا — اتأكد بالعين من سكرين شوت حقيقي**: تجربة أولى حطّت الأيقونة
      في العمود الأول (index 0) وطلعت أقصى اليمين، عكس المطلوب. ترتيب
      أعمدة Grid في التطبيق ده بيتبع اتجاه RTL فعليًا (مش ثابت بالإحداثيات
      زي ما افترضت الأول)، فالعمود الأخير هو اللي بيترسم أقصى يسار.
    -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="HiddenBox" Grid.Column="0" BorderThickness="0" Background="Transparent"
                         PasswordChanged="HiddenBox_PasswordChanged"
                         Padding="{Binding Padding, ElementName=Root}" FontSize="{Binding FontSize, ElementName=Root}" />
            <TextBox x:Name="VisibleBox" Grid.Column="0" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                     TextChanged="VisibleBox_TextChanged"
                     Padding="{Binding Padding, ElementName=Root}" FontSize="{Binding FontSize, ElementName=Root}" />

            <Button x:Name="ToggleVisibilityButton" Grid.Column="1" Style="{StaticResource IconButton}"
                    Width="26" Height="26" Padding="4" VerticalAlignment="Center" Margin="0,0,6,0"
                    Foreground="{DynamicResource TextMutedBrush}" Click="ToggleVisibilityButton_Click"
                    ToolTip="إظهار كلمة المرور" AutomationProperties.Name="إظهار كلمة المرور">
                <materialDesign:PackIcon x:Name="EyeIcon" Kind="EyeOutline" Width="16" Height="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
