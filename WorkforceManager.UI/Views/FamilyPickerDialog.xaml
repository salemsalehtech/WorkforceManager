<Window x:Class="WorkforceManager.UI.Views.FamilyPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تعيين عيلة" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft" FontSize="14" FontFamily="{StaticResource AppFont}">

    <!-- تعيين جماعي: عيلة واحدة تتطبّق على كل المنتجات المحددة في شاشة
         المنتجات دفعة واحدة (شوف ProductsViewModel.AssignSelectedToFamilyAsync) —
         "+ عيلة جديدة" بتتحفظ فورًا زي فورم المنتج بالظبط. -->
    <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                    CornerRadius="18,18,0,0" Padding="18,14" MouseLeftButtonDown="Window_Drag">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Foreground="{DynamicResource SidebarInkBrush}"
                            Style="{StaticResource IconButton}" Padding="7,4" IsCancel="True"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                    <TextBlock Text="تعيين عيلة" Foreground="{DynamicResource SidebarInkBrush}"
                               FontSize="15.5" FontWeight="Bold" />
                </DockPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,0,0,14"
                           TextWrapping="Wrap" />

                <TextBlock Text="العيلة" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FamilyBox" DisplayMemberPath="Name" Margin="0,0,0,4"
                          SelectionChanged="FamilyBox_SelectionChanged" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                    <Button Content="تطبيق" Click="Apply_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="26,9" Margin="0,0,8,0" />
                    <Button Content="إلغاء" IsCancel="True" Style="{StaticResource GhostButton}" Padding="26,9" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
