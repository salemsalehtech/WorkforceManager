<UserControl x:Class="WorkforceManager.UI.Views.ProductOutputChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WorkforceManager.UI"
             xmlns:views="clr-namespace:WorkforceManager.UI.Views">

    <!--
      ═══════════ رسم إنتاج المنتجات (الأعمدة المكدّسة) ═══════════

      المكوّن الوحيد اللي بيرسم أعمدة إنتاج المنتجات في البرنامج — شاشة
      "التقييم والمتابعة" (المدى الكامل) وشاشة الرئيسية (أسبوع الشغل
      الحالي) الاتنين بيستخدموه. البيانات جاية جاهزة من
      ProductOutputChartBuilder (Buckets)، والمكوّن بيرسم بس.

      كل الربط على خصايص المكوّن نفسه بـRelativeSource (مش ElementName) —
      جوّه DataTemplate الاسم مش دايمًا بيتحل برّه نطاق القالب.
    -->
    <Grid>
        <!-- رسالة لما مفيش بيانات -->
        <TextBlock Text="{Binding EmptyText, RelativeSource={RelativeSource AncestorType=views:ProductOutputChart}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap"
                   TextAlignment="Center" MaxWidth="400">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasData, RelativeSource={RelativeSource AncestorType=views:ProductOutputChart}}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- محور الزمن ثابت شمال ← يمين زي أي رسم بياني (مع بقاء النصوص عربي) -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      FlowDirection="LeftToRight" VerticalAlignment="Bottom">
            <ItemsControl ItemsSource="{Binding Buckets, RelativeSource={RelativeSource AncestorType=views:ProductOutputChart}}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <!-- الافتراضي: أعمدة بعرضها الطبيعي جنب بعض (مدى طويل بيتزحلق).
                             FillWidth: الأعمدة بتتوزّع على عرض الكارت كله — للرسم
                             القصير (7 أيام الرئيسية) اللي كان هيتكوّم في جنب واحد -->
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FillWidth, RelativeSource={RelativeSource AncestorType=views:ProductOutputChart}}" Value="True">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- عمود مكدّس لفترة واحدة: طول العمود = إنتاج
                             الفترة كلها، والشرايح = نصيب كل منتج،
                             والشريحة الحمرا اللي فوق = الهالك. -->
                        <StackPanel Margin="9,0" MinWidth="46">
                            <TextBlock Text="{Binding TotalText}" FontSize="11.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <!-- لازم يفضل أكبر شوية من أقصى ارتفاع عمود
                                 (PlotHeight = maxBarHeight في ProductOutputChartBuilder)،
                                 وإلا أطول عمود بيتقص من فوق — PlotAreaHeight بيزوّد الهامش -->
                            <Grid Height="{Binding PlotAreaHeight, RelativeSource={RelativeSource AncestorType=views:ProductOutputChart}}">
                                <!-- خط المتوسط: كل عمود بيرسم قطعته منه،
                                     فمع بعض بيقروا خط واحد. المسافة من
                                     تحت بترتفع بارتفاع فاضي مش بـ Margin
                                     مربوط — Thickness نوع قيمة والربط
                                     عليه بيكسر القالب وقت التشغيل. -->
                                <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False"
                                            Visibility="{Binding ShowAverage, Converter={StaticResource BoolToVis}}">
                                    <Border Height="1.2" Background="{DynamicResource LineStrongBrush}"
                                            Opacity="0.85" />
                                    <Border Height="{Binding AverageOffset}" Background="Transparent" />
                                </StackPanel>

                                <!-- الشرايح مثبتة على خط الأرض -->
                                <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom"
                                              HorizontalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- الفاصل تحت كل شريحة بيخلي حدود المنتجات
                                                 تبان من غير خط إضافي. رقم ثابت مش Binding:
                                                 Thickness نوع قيمة مش عنصر، فالربط عليه
                                                 بيكسر القالب كله وقت التشغيل. -->
                                            <Border Width="26" Height="{Binding Height}"
                                                    ui:ThemeBrush.BackgroundKey="{Binding Color}" CornerRadius="3"
                                                    Margin="0,0,0,2"
                                                    ToolTip="{Binding Tooltip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- خط الأرض + تاريخ الفترة -->
                            <Border Height="1.5" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <!-- الفترة الجارية: المقارنة بيها ناقصة لأنها لسه مكملتش -->
                            <TextBlock Text="{Binding CurrentNote}" FontSize="9.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
