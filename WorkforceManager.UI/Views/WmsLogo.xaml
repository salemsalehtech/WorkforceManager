<UserControl x:Class="WorkforceManager.UI.Views.WmsLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="44" d:DesignWidth="44"
             FlowDirection="LeftToRight">

    <!--
      لوجو قسم الصنفرة: صامولة سداسية بحنفية ونقطة ميّة ولمعة في مربع مدوّر (كان مونوجرام WMS).

      مرسوم بـ XAML مش صورة عن قصد: بيفضل حاد في أي مقاس ومع أي دقة
      شاشة، وبيتلوّن مع الثيم لوحده، ومبيزوّدش ملف على الحزمة.

      الشكل: مربع أسود دافي (SidebarBrush — مفيش كحلي في الهوية) بحدّة
      دهبية، وجوّاه الحروف دهبي. الحدّة الدهبية رفيعة عن قصد — التخانة
      بتحوّل الفخامة لثقل.
    -->
    <UserControl.Resources>
        <!-- ألوان العلامة ثابتة (مش من الثيم) عشان تطلع نفسها في أيقونة البرنامج المتولّدة Assets/app.ico -->
        <LinearGradientBrush x:Key="MarkGold" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3D27A" Offset="0" />
            <GradientStop Color="#C2A14D" Offset="0.55" />
            <GradientStop Color="#8A6D1F" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100">

            <!-- المربع: الزاوية 26% من الضلع — أنعم من مربع وأصلب من دايرة -->
            <Border CornerRadius="26" Background="{DynamicResource SidebarBrush}" />

            <!-- الحدّة الدهبية -->
            <Border CornerRadius="26" BorderThickness="2.5"
                    BorderBrush="{DynamicResource GoldGradientBrush}" />

            <!-- بريق خفيف من فوق — بيدي إحساس المعدن من غير تدرّج صارخ -->
            <Border CornerRadius="26" Margin="2.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#22FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- العلامة الافتراضية: صامولة سداسية (رمز السباكة) وجواها حنفية بخط واحد سميك ونقطة ميّة ولمعة —
                 قسم صنفرة الحنفيات والمحابس. رسم مسطّح بخط موحّد عشان يفضل واضح في أي مقاس. بيتشال لو
                 المستخدم رفع شعاره هو من الإعدادات (شوف Refresh في الكود)؛ الإطار الأسود بالحدّ الدهبي فاضل زي ما هو. -->
            <Canvas x:Name="DefaultMark" Width="100" Height="100">
                <Polygon Points="50,10 84,30 84,70 50,90 16,70 16,30" Stroke="{StaticResource MarkGold}" StrokeThickness="4"
                         StrokeLineJoin="Round" Fill="#10FFFFFF" />
                <Path Data="M 36,29 L 56,29" Stroke="{StaticResource MarkGold}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 46,30 L 46,41 M 30,64 L 30,50 Q 30,41 39,41 L 66,41 Q 71,41 71,46 L 71,52"
                      Stroke="{StaticResource MarkGold}" StrokeThickness="7" StrokeLineJoin="Round"
                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                <Path Fill="{StaticResource MarkGold}" Data="M 71,58 C 71,58 64,67 64,71 A 7,7 0 0 0 78,71 C 78,67 71,58 71,58 Z" />
                <Path Canvas.Left="23" Canvas.Top="76" Fill="#FFF3C4"
                      Data="M 0,-7 L 1.8,-1.8 L 7,0 L 1.8,1.8 L 0,7 L -1.8,1.8 L -7,0 L -1.8,-1.8 Z" />
            </Canvas>

            <!-- شعار المصنع المرفوع من الإعدادات — جوّه نفس المربع
                 والحدّ الدهبي، بديل "WMS" مش زيادة عليه -->
            <Image x:Name="CustomMark" Visibility="Collapsed" Stretch="Uniform" Margin="16" />
        </Grid>
    </Viewbox>
</UserControl>
